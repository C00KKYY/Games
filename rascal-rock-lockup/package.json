{
  "name": "rascal-rock-lockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "qa": "playwright test",
    "economy": "tsx tools/economy-sheet.ts",
    "art:build": "tsx tools/art-build.ts",
    "art:sheet": "tsx tools/art-sheet.ts",
    "audio:build": "tsx tools/audio/build.ts && tsx tools/audio/measure.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/inter": "5.2.8",
    "lz-string": "1.5.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "eslint": "9.39.1",
    "playwright": "1.63.0",
    "rollup-plugin-license": "3.7.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "4.1.12"
  }
}
