        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[-- Translation and number formatting (web lang.js tr/setLang/fmtDec, util.js fmtNum/fmtTime). German is the source
-- language: German strings are the keys, En.luau maps them to English.
local En = if script then require(script.Parent.En) else require("./En")
local EnRoblox = if script then require(script.Parent.EnRoblox) else require("./EnRoblox")

local Lang = {}

-- English text of a German key (nil when missing)
function Lang.en(key: string): string?
	return En[key] or EnRoblox[key]
end

local current = "en"
Lang.misses = {} -- keys without English text (for tests)

function Lang.setLang(l: string?)
	current = if l == "de" then "de" else "en"
end

function Lang.get(): string
	return current
end

-- "de-DE" / "de" -> "de", everything else -> "en"
function Lang.fromLocale(locale: string?): string
	if type(locale) == "string" and string.lower(string.sub(locale, 1, 2)) == "de" then
		return "de"
	end
	return "en"
end

-- marks a German text key that is stored in a table and translated later (lang.spec scans for Lang.key("..."))
function Lang.key(key: string): string
	return key
end

function Lang.tr(key: string, ...: any): string
	local s = key
	if current == "en" then
		local v = En[key] or EnRoblox[key]
		if v == nil then
			Lang.misses[key] = true
		else
			s = v
		end
	end
	local n = select("#", ...)
	if n > 0 then
		local args = { ... }
		s = string.gsub(s, "{(%d)}", function(i)
			local v = args[tonumber(i) + 1]
			return if v == nil then "" else tostring(v)
		end)
	end
	return s
end

function Lang.fmtDec(v: number): string
	local s = tostring(v)
	return if current == "de" then (string.gsub(s, "%.", ",")) else s
end

local function group(n: number, sep: string): string
	local s = tostring(math.floor(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1" .. string.reverse(sep))))
	if string.sub(out, 1, #sep) == sep then
		out = string.sub(out, #sep + 1)
	end
	return out
end

function Lang.fmtNum(n: number): string
	n = math.floor(n)
	local de = current == "de"
	local function dec(x: string)
		return if de then (string.gsub(x, "%.", ",")) else x
	end
	if n >= 1e6 then
		return dec(string.format("%.1f", n / 1e6)) .. (if de then " Mio." else "M")
	end
	if n >= 1e4 then
		return dec(string.format("%.1f", n / 1e3)) .. "k"
	end
	return group(n, if de then "." else ",")
end

function Lang.fmtTime(s: number): string
	s = math.max(0, math.floor(s))
	local m, r = math.floor(s / 60), s % 60
	return m .. ":" .. (if r < 10 then "0" else "") .. r
end

return Lang
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Codec</string>
            <string name="Source"><![CDATA[--!native
-- Binary wire formats (docs/DESIGN.md Appendix B): snapshot packets (Snap, unreliable, <= 900 bytes each), move
-- packets (Move, 14 bytes) and per-step event buffers (Ev, reliable). Little-endian `buffer`. Pure: used by the
-- server, the client and the Lune tests.
local Protocol = if script then require(script.Parent.Protocol) else require("./Protocol")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Codec = {}

local floor, clamp, pi = math.floor, math.clamp, math.pi
local TAU = pi * 2
local EV = Protocol.EV
local TYPE_INDEX = Protocol.TYPE_INDEX
local NONE = 0x7fff

-- ---------- growable writer ----------
local Writer = {}
Writer.__index = Writer

function Codec.writer(cap: number?)
	return setmetatable({ b = buffer.create(cap or 256), n = 0 }, Writer)
end

local function ensure(w, k: number)
	local len = buffer.len(w.b)
	if w.n + k > len then
		local nb = buffer.create(math.max(len * 2, w.n + k))
		buffer.copy(nb, 0, w.b, 0, w.n)
		w.b = nb
	end
end

local function u8(w, v: number)
	ensure(w, 1)
	buffer.writeu8(w.b, w.n, clamp(floor(v + 0.5), 0, 255))
	w.n += 1
end
local function i8(w, v: number)
	ensure(w, 1)
	buffer.writei8(w.b, w.n, clamp(floor(v + 0.5), -128, 127))
	w.n += 1
end
local function u16(w, v: number)
	ensure(w, 2)
	buffer.writeu16(w.b, w.n, clamp(floor(v + 0.5), 0, 65535))
	w.n += 2
end
local function i16(w, v: number)
	ensure(w, 2)
	buffer.writei16(w.b, w.n, clamp(floor(v + 0.5), -32768, 32767))
	w.n += 2
end
local function i32(w, v: number)
	ensure(w, 4)
	buffer.writei32(w.b, w.n, clamp(floor(v + 0.5), -2147483648, 2147483647))
	w.n += 4
end
local function f32(w, v: number)
	ensure(w, 4)
	buffer.writef32(w.b, w.n, v)
	w.n += 4
end
local function str(w, s: string)
	local n = math.min(#s, 255)
	u8(w, n)
	ensure(w, n)
	buffer.writestring(w.b, w.n, s, n)
	w.n += n
end
local function angle(a: number): number
	a = (a + pi) % TAU - pi
	return a * 1000
end

function Writer.finish(self): buffer
	local out = buffer.create(self.n)
	buffer.copy(out, 0, self.b, 0, self.n)
	return out
end

-- ---------- reader ----------
local Reader = {}
Reader.__index = Reader
function Codec.reader(b: buffer)
	return setmetatable({ b = b, n = 0, len = buffer.len(b) }, Reader)
end
local function ru8(r)
	local v = buffer.readu8(r.b, r.n)
	r.n += 1
	return v
end
local function ru16(r)
	local v = buffer.readu16(r.b, r.n)
	r.n += 2
	return v
end
local function ri16(r)
	local v = buffer.readi16(r.b, r.n)
	r.n += 2
	return v
end
local function ri32(r)
	local v = buffer.readi32(r.b, r.n)
	r.n += 4
	return v
end
local function rf32(r)
	local v = buffer.readf32(r.b, r.n)
	r.n += 4
	return v
end
local function rstr(r)
	local n = ru8(r)
	local s = buffer.readstring(r.b, r.n, n)
	r.n += n
	return s
end

-- ---------- move packet (B.2) ----------
function Codec.encodeMove(seq: number, x: number, y: number, dirX: number, dirY: number, moving: boolean): buffer
	local b = buffer.create(14)
	buffer.writeu8(b, 0, Protocol.MSG_MOVE)
	buffer.writeu16(b, 1, seq % 65536)
	buffer.writef32(b, 3, x)
	buffer.writef32(b, 7, y)
	buffer.writei8(b, 11, clamp(floor(dirX * 127 + 0.5), -127, 127))
	buffer.writei8(b, 12, clamp(floor(dirY * 127 + 0.5), -127, 127))
	buffer.writeu8(b, 13, if moving then 1 else 0)
	return b
end

-- returns nil for anything malformed (server input: never trusted)
function Codec.decodeMove(b: any)
	if typeof(b) ~= "buffer" or buffer.len(b) ~= 14 or buffer.readu8(b, 0) ~= Protocol.MSG_MOVE then
		return nil
	end
	local x, y = buffer.readf32(b, 3), buffer.readf32(b, 7)
	if x ~= x or y ~= y or math.abs(x) > 1e7 or math.abs(y) > 1e7 then
		return nil
	end
	return {
		seq = buffer.readu16(b, 1),
		x = x,
		y = y,
		dirX = math.max(-1, buffer.readi8(b, 11) / 127), -- -128 would be -1.008
		dirY = math.max(-1, buffer.readi8(b, 12) / 127),
		moving = bit32.band(buffer.readu8(b, 13), 1) == 1,
	}
end

-- sequence numbers wrap at 65536: is a newer than b?
function Codec.seqNewer(a: number, b: number): boolean
	local d = (a - b) % 65536
	return d ~= 0 and d < 32768
end

-- ---------- snapshot (B.1) ----------
local HEADER = 13
local HERO_B = 12
local ENEMY_B = 8
-- ~100 bytes of margin under the 900-byte unreliable limit for the remote's own overhead (buffer type tag, length,
-- event id); 90 + 2 x 98 = 286 >= SNAP_ENEMY_CAP, so a snapshot still fits in 3 packets
local PART0_MAX = 90 -- packet 0: 13 + 1 + 4 x 12 + 1 + 90 x 8 = 783 bytes
local PART_MAX = 98 -- other packets: 13 + 1 + 98 x 8 = 798 bytes

local function enemyTypeFlags(e): number
	local t = TYPE_INDEX[e.type] or 0
	if e.elite then
		t += 16
	end
	if e.boss then
		t += 32
	end
	if e.swarm then
		t += 64
	end
	return t
end

local function enemyState(e): number
	local s = 0
	if e.flash > 0 then
		s += 1
	end
	if e.slowF < 1 then
		s += 2
	end
	if e.freezeT > 0 then
		s += 4
	end
	if e.windT > 0 or (e.boss and (e.mode == "windup" or e.mode == "cast")) then
		s += 8
	end
	if e.face < 0 then
		s += 16
	end
	if e.elite or e.boss then
		s += clamp(floor(e.hp / e.maxHp * 7 + 0.5), 0, 7) * 32
	end
	return s
end

local function heroFlags(p): number
	local f = 0
	if p.state == "downed" then
		f += 1
	end
	if p.state == "fallen" or p.state == "left" then
		f += 2
	end
	if p.wardT > 0 then
		f += 4
	end
	if p.iframe > 0 then
		f += 8
	end
	if p.moving then
		f += 16
	end
	if p.face < 0 then
		f += 32
	end
	return f
end

-- select the enemies one client sees: interest rectangle around (ox, oy), nearest first, cap; bosses always
function Codec.selectEnemies(run, ox: number, oy: number, cap: number, out: { any }?): { any }
	local list = out or {}
	table.clear(list)
	local hw, hh = Tuning.INTEREST_HW, Tuning.INTEREST_HH
	local bosses = {}
	for _, e in run.enemies do
		if not e.dead then
			local dx, dy = e.x - ox, e.y - oy
			if e.boss then
				table.insert(bosses, e)
			elseif math.abs(dx) <= hw and math.abs(dy) <= hh then
				e._sd = dx * dx + dy * dy
				list[#list + 1] = e
			end
		end
	end
	if #list > cap then
		table.sort(list, function(a, b)
			return a._sd < b._sd
		end)
		for i = #list, cap + 1, -1 do
			list[i] = nil
		end
	end
	for _, b in bosses do
		table.insert(list, 1, b)
	end
	return list
end

-- encode the snapshot for one recipient; returns an array of buffers (1..3 packets, each <= UR_MAX_BYTES)
function Codec.encodeSnapshot(run, tick: number, ox: number, oy: number, cap: number?)
	ox, oy = floor(ox + 0.5), floor(oy + 0.5)
	local enemies = Codec.selectEnemies(run, ox, oy, cap or Tuning.SNAP_ENEMY_CAP)
	local n = #enemies
	local parts = 1
	if n > PART0_MAX then
		parts = 1 + math.ceil((n - PART0_MAX) / PART_MAX)
	end
	parts = math.min(parts, 3)
	local out = {}
	local idx = 1
	for part = 0, parts - 1 do
		local maxE = if part == 0 then PART0_MAX else PART_MAX
		local cnt = math.min(maxE, n - idx + 1)
		local heroes = if part == 0 then run.plist else {}
		local size = HEADER + 1 + cnt * ENEMY_B
		if part == 0 then
			size += 1 + #heroes * HERO_B
		end
		local w = { b = buffer.create(size), n = 0 }
		u8(w, Protocol.MSG_SNAP)
		u16(w, tick % 65536)
		u8(w, part)
		u8(w, parts)
		f32(w, ox)
		f32(w, oy)
		if part == 0 then
			u8(w, #heroes)
			for _, p in heroes do
				u8(w, p.slot)
				f32(w, p.x)
				f32(w, p.y)
				u8(w, heroFlags(p))
				u8(w, if p.stats then p.hp / p.stats.maxHp * 255 else 0)
				u8(w, (p.reviveFrac or 0) * 255)
			end
		end
		u8(w, cnt)
		for _ = 1, cnt do
			local e = enemies[idx]
			idx += 1
			u16(w, e.id)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, enemyTypeFlags(e))
			u8(w, enemyState(e))
		end
		out[#out + 1] = w.b
	end
	return out
end

function Codec.decodeSnapshot(b: buffer)
	local r = Codec.reader(b)
	if ru8(r) ~= Protocol.MSG_SNAP then
		return nil
	end
	local s = { tick = ru16(r), part = ru8(r), parts = ru8(r) }
	s.ox = rf32(r)
	s.oy = rf32(r)
	s.heroes = {}
	if s.part == 0 then
		for _ = 1, ru8(r) do
			local h = { slot = ru8(r), x = rf32(r), y = rf32(r) }
			local f = ru8(r)
			h.downed = bit32.btest(f, 1)
			h.fallen = bit32.btest(f, 2)
			h.ward = bit32.btest(f, 4)
			h.iframe = bit32.btest(f, 8)
			h.moving = bit32.btest(f, 16)
			h.faceLeft = bit32.btest(f, 32)
			h.hp = ru8(r) / 255
			h.revive = ru8(r) / 255
			table.insert(s.heroes, h)
		end
	end
	s.enemies = {}
	for _ = 1, ru8(r) do
		local id = ru16(r)
		local x, y = s.ox + ri16(r), s.oy + ri16(r)
		local tf, st = ru8(r), ru8(r)
		table.insert(s.enemies, {
			id = id,
			x = x,
			y = y,
			type = Protocol.TYPE_NAME[bit32.band(tf, 15) + 1],
			elite = bit32.btest(tf, 16),
			boss = bit32.btest(tf, 32),
			swarm = bit32.btest(tf, 64),
			flash = bit32.btest(st, 1),
			slowed = bit32.btest(st, 2),
			frozen = bit32.btest(st, 4),
			winding = bit32.btest(st, 8),
			faceLeft = bit32.btest(st, 16),
			hpBucket = bit32.rshift(st, 5),
		})
	end
	return s
end

-- ---------- events (B.3) ----------
local DMG_PER_STEP = 24
local SHOT_KIND = Protocol.SHOT_KINDS
local COLOR = Protocol.COLOR_INDEX
local PICK = Protocol.PICK_INDEX
local SFX = Protocol.SFX_INDEX

local function teleKind(tl): number
	local k = tl.kind
	if k == "circle" then
		return 1
	elseif k == "lane" then
		return 2
	elseif k == "line" then
		return 3
	elseif k == "aim" then
		return 4
	elseif k == "charge" and tl.wedge then
		return 5
	end
	return 6
end

local function encodeTele(w, tl, ox, oy)
	local kind = teleKind(tl)
	u16(w, tl.id)
	u8(w, kind)
	u8(w, tl.life * 20)
	u16(w, if tl.follow then tl.follow.id else 0)
	i16(w, tl.x - ox)
	i16(w, tl.y - oy)
	if kind == 1 then
		u16(w, tl.rad)
		local f = 0
		if tl.small then
			f += 1
		end
		if tl.track then
			f += 2
		end
		if tl.onImpact == "ember" then
			f += 4
		elseif tl.onImpact == "slow" then
			f += 8
		end
		u8(w, f)
	elseif kind == 2 or kind == 3 then
		i16(w, angle(tl.a))
		u16(w, tl.len)
		u8(w, tl.w)
	elseif kind == 4 then
		i16(w, angle(tl.a))
		u16(w, tl.len)
		u8(w, tl.hr)
		u8(w, tl.lockAt * 20)
	elseif kind == 5 then
		i16(w, angle(tl.a))
		local n = #tl.shots
		u8(w, n)
		local spread = if n > 1 then tl.shots[n].o - tl.shots[1].o else 0
		i16(w, spread * 1000)
		u8(w, tl.wedge)
		u8(w, tl.sr)
		u8(w, tl.lockAt * 20)
	else
		local shots = tl.shots
		local rings = 1
		for _, sh in shots do
			if sh.d and sh.d > 0 then
				rings = math.max(rings, floor(sh.d / 0.3 + 0.5) + 1)
			end
		end
		local n = floor(#shots / rings)
		u8(w, n)
		u8(w, rings)
		i16(w, angle(shots[1].a))
		u8(w, tl.sr)
		u8(w, (if tl.boss then 1 else 0) + (if tl.arms then 2 else 0))
	end
end

-- encode the events of one step for the client in `slot`; nil when nothing is relevant
function Codec.encodeEvents(events, slot: number, tick: number, ox: number, oy: number): buffer?
	ox, oy = floor(ox + 0.5), floor(oy + 0.5)
	local w = Codec.writer(256)
	u8(w, Protocol.MSG_EV)
	u16(w, tick % 65536)
	f32(w, ox)
	f32(w, oy)
	local head = w.n
	local dmgN = 0
	for _, e in events do
		local k = e.k
		local code = EV[k]
		if not code then
			continue
		end
		if k == "dmg" then
			local own = e.slot == slot
			if not (own or e.boss) or dmgN >= DMG_PER_STEP then
				continue
			end
			dmgN += 1
			u8(w, code)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u16(w, e.amount)
			u8(w, (if e.crit then 1 else 0) + (if e.boss then 2 else 0) + (if own then 4 else 0))
		elseif k == "kill" then
			u8(w, code)
			u16(w, e.id)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, (TYPE_INDEX[e.type] or 0) + (if e.elite then 16 else 0) + (if e.boss then 32 else 0))
		elseif k == "eshot+" then
			local s = e.s
			u8(w, code)
			u16(w, s.id)
			i16(w, s.x - ox)
			i16(w, s.y - oy)
			i16(w, s.vx)
			i16(w, s.vy)
			u8(w, s.r)
			u8(w, SHOT_KIND[s.kind] or 0)
			u8(w, s.life * 20)
		elseif k == "eshot-" or k == "tele-" or k == "haz-" or k == "shot-" or k == "despawn" or k == "warp" then
			u8(w, code)
			u16(w, e.id)
		elseif k == "tele+" then
			u8(w, code)
			encodeTele(w, e.tl, ox, oy)
		elseif k == "tele~" then
			local tl = e.tl
			u8(w, code)
			u16(w, tl.id)
			i16(w, angle(tl.a or 0))
			i16(w, tl.x - ox)
			i16(w, tl.y - oy)
		elseif k == "haz+" then
			local h = e.h
			u8(w, code)
			u16(w, h.id)
			u8(w, if h.kind == "ember" then 1 else 2)
			i16(w, h.x - ox)
			i16(w, h.y - oy)
			u8(w, h.rad)
			u8(w, h.life * 10)
		elseif k == "haz~" then
			u8(w, code)
			u16(w, e.id)
			u8(w, e.life * 10)
		elseif k == "pick+" then
			u8(w, code)
			u16(w, e.id)
			u8(w, PICK[e.kind] or 1)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, e.owner or 0)
		elseif k == "pick~" or k == "pick-" or k == "gemPull" or k == "gemGot" then
			u8(w, code)
			u16(w, e.id)
			u8(w, e.slot or 0)
		elseif k == "gem+" then
			u8(w, code)
			u16(w, e.id)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u16(w, math.max(1, e.v))
		elseif k == "fire" then
			u8(w, code)
			u8(w, e.slot)
			u8(w, Protocol.WEAPON_INDEX[e.weapon] or 0)
			u8(w, if e.evo then 1 else 0)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			i16(w, angle(e.a or 0))
			u16(w, e.speed or 0)
			u8(w, (e.area or 1) * 50)
			u16(w, e.extra or 0)
		elseif k == "orbit" then
			u8(w, code)
			u8(w, e.slot)
			u8(w, if e.active then 1 else 0)
			u8(w, e.amount)
			u16(w, e.radius)
			u8(w, e.speed * 20)
			u8(w, e.orb)
			i16(w, angle(e.ang))
			u8(w, if e.evo then 1 else 0)
		elseif k == "aura" then
			u8(w, code)
			u8(w, e.slot)
			u16(w, e.rad)
			u8(w, if e.evo then 1 else 0)
		elseif k == "sfx" then
			local si = SFX[e.name]
			if not si then
				continue
			end
			u8(w, code)
			u8(w, si)
			if e.x then
				i16(w, clamp(e.x - ox, -32000, 32000))
				i16(w, clamp(e.y - oy, -32000, 32000))
			else
				i16(w, NONE)
				i16(w, NONE)
			end
		elseif k == "shake" then
			if e.slot and e.slot ~= slot then
				continue
			end
			u8(w, code)
			u8(w, e.amount)
			if e.x then
				i16(w, clamp(e.x - ox, -32000, 32000))
				i16(w, clamp(e.y - oy, -32000, 32000))
			else
				i16(w, NONE)
				i16(w, NONE)
			end
		elseif k == "prop-" then
			u8(w, code)
			i16(w, e.cx)
			i16(w, e.cy)
		elseif k == "boom" then
			u8(w, code)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u16(w, e.rad)
			u8(w, COLOR[e.color] or 1)
		elseif k == "burst" then
			u8(w, code)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, COLOR[e.color] or 1)
			u8(w, e.n)
		elseif k == "arc" then
			u8(w, code)
			u8(w, e.slot)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			i16(w, e.x2 - ox)
			i16(w, e.y2 - oy)
		elseif k == "pool" then
			u8(w, code)
			u8(w, e.slot)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, e.rad)
			u8(w, e.life * 10)
			u8(w, if e.evo then 1 else 0)
		elseif k == "flash" then
			u8(w, code)
			u8(w, e.slot)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
		elseif k == "text" then
			if e.slot and e.slot ~= slot then
				continue
			end
			u8(w, code)
			i16(w, e.x - ox)
			i16(w, e.y - oy)
			u8(w, COLOR[e.color] or 9)
			u8(w, (e.scale or 1) * 20)
			str(w, e.text)
			i32(w, if e.args and type(e.args[1]) == "number" then e.args[1] else -2147483648)
		end
	end
	if w.n == head then
		return nil
	end
	return w:finish()
end

function Codec.decodeEvents(b: buffer)
	local r = Codec.reader(b)
	if ru8(r) ~= Protocol.MSG_EV then
		return nil
	end
	local tick = ru16(r)
	local ox, oy = rf32(r), rf32(r)
	local out = {}
	local NAME = Protocol.EV_NAME
	while r.n < r.len do
		local code = ru8(r)
		local k = NAME[code]
		local e = { k = k }
		if k == "dmg" then
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.amount = ru16(r)
			local f = ru8(r)
			e.crit, e.boss, e.own = bit32.btest(f, 1), bit32.btest(f, 2), bit32.btest(f, 4)
		elseif k == "kill" then
			e.id = ru16(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			local tf = ru8(r)
			e.type = Protocol.TYPE_NAME[bit32.band(tf, 15) + 1]
			e.elite, e.boss = bit32.btest(tf, 16), bit32.btest(tf, 32)
		elseif k == "eshot+" then
			e.id = ru16(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.vx, e.vy = ri16(r), ri16(r)
			e.r = ru8(r)
			e.kind = Protocol.SHOT_KIND_NAME[ru8(r)] or "orb"
			e.life = ru8(r) / 20
		elseif k == "eshot-" or k == "tele-" or k == "haz-" or k == "shot-" or k == "despawn" or k == "warp" then
			e.id = ru16(r)
		elseif k == "tele+" then
			e.id = ru16(r)
			local kind = ru8(r)
			e.kind = Protocol.TELE_KINDS[kind]
			e.life = ru8(r) / 20
			e.follow = ru16(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			if kind == 1 then
				e.rad = ru16(r)
				local f = ru8(r)
				e.small, e.track = bit32.btest(f, 1), bit32.btest(f, 2)
				e.ember, e.slow = bit32.btest(f, 4), bit32.btest(f, 8)
			elseif kind == 2 or kind == 3 then
				e.a = ri16(r) / 1000
				e.len = ru16(r)
				e.w = ru8(r)
			elseif kind == 4 then
				e.a = ri16(r) / 1000
				e.len = ru16(r)
				e.hr = ru8(r)
				e.lockAt = ru8(r) / 20
			elseif kind == 5 then
				e.a = ri16(r) / 1000
				e.n = ru8(r)
				e.spread = ri16(r) / 1000
				e.wedge = ru8(r)
				e.sr = ru8(r)
				e.lockAt = ru8(r) / 20
			else
				e.n = ru8(r)
				e.rings = ru8(r)
				e.off = ri16(r) / 1000
				e.sr = ru8(r)
				local f = ru8(r)
				e.boss, e.arms = bit32.btest(f, 1), bit32.btest(f, 2)
			end
		elseif k == "tele~" then
			e.id = ru16(r)
			e.a = ri16(r) / 1000
			e.x, e.y = ox + ri16(r), oy + ri16(r)
		elseif k == "haz+" then
			e.id = ru16(r)
			e.kind = if ru8(r) == 1 then "ember" else "slow"
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.rad = ru8(r)
			e.life = ru8(r) / 10
		elseif k == "haz~" then
			e.id = ru16(r)
			e.life = ru8(r) / 10
		elseif k == "pick+" then
			e.id = ru16(r)
			e.kind = Protocol.PICK_KINDS[ru8(r)]
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.owner = ru8(r)
		elseif k == "pick~" or k == "pick-" or k == "gemPull" or k == "gemGot" then
			e.id = ru16(r)
			e.slot = ru8(r)
		elseif k == "gem+" then
			e.id = ru16(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.v = ru16(r)
		elseif k == "fire" then
			e.slot = ru8(r)
			e.weapon = Protocol.WEAPON_NAME[ru8(r) + 1]
			e.evo = ru8(r) == 1
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.a = ri16(r) / 1000
			e.speed = ru16(r)
			e.area = ru8(r) / 50
			e.extra = ru16(r)
		elseif k == "orbit" then
			e.slot = ru8(r)
			e.active = ru8(r) == 1
			e.amount = ru8(r)
			e.radius = ru16(r)
			e.speed = ru8(r) / 20
			e.orb = ru8(r)
			e.ang = ri16(r) / 1000
			e.evo = ru8(r) == 1
		elseif k == "aura" then
			e.slot = ru8(r)
			e.rad = ru16(r)
			e.evo = ru8(r) == 1
		elseif k == "sfx" then
			e.name = Protocol.SFX[ru8(r)]
			local x, y = ri16(r), ri16(r)
			if x ~= NONE then
				e.x, e.y = ox + x, oy + y
			end
		elseif k == "shake" then
			e.amount = ru8(r)
			local x, y = ri16(r), ri16(r)
			if x ~= NONE then
				e.x, e.y = ox + x, oy + y
			end
		elseif k == "prop-" then
			e.cx, e.cy = ri16(r), ri16(r)
		elseif k == "boom" then
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.rad = ru16(r)
			e.color = Protocol.COLORS[ru8(r)]
		elseif k == "burst" then
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.color = Protocol.COLORS[ru8(r)]
			e.n = ru8(r)
		elseif k == "arc" then
			e.slot = ru8(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.x2, e.y2 = ox + ri16(r), oy + ri16(r)
		elseif k == "pool" then
			e.slot = ru8(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.rad = ru8(r)
			e.life = ru8(r) / 10
			e.evo = ru8(r) == 1
		elseif k == "flash" then
			e.slot = ru8(r)
			e.x, e.y = ox + ri16(r), oy + ri16(r)
		elseif k == "text" then
			e.x, e.y = ox + ri16(r), oy + ri16(r)
			e.color = Protocol.COLORS[ru8(r)]
			e.scale = ru8(r) / 20
			e.text = rstr(r)
			local a = ri32(r)
			if a ~= -2147483648 then
				e.arg = a
			end
		else
			error("unknown event code " .. tostring(code))
		end
		out[#out + 1] = e
	end
	return out, tick
end

Codec.i8 = i8
return Codec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Protocol</string>
            <string name="Source"><![CDATA[-- Remote names, message ids, event kinds and lookup tables shared by server and client (docs/DESIGN.md §3.1,
-- Appendix B). Pure data.
local Enemies = if script then require(script.Parent.Parent.Sim.Data.Enemies) else require("../Sim/Data/Enemies")
local Weapons = if script then require(script.Parent.Parent.Sim.Data.Weapons) else require("../Sim/Data/Weapons")

local Protocol = {}

Protocol.REMOTES = {
	Move = "UnreliableRemoteEvent", -- client -> server, Move packet (buffer, 14 B)
	Snap = "UnreliableRemoteEvent", -- server -> client, snapshot packets (buffer, <= 900 B)
	Ev = "RemoteEvent", -- server -> client, one event buffer per step
	Ui = "RemoteEvent", -- server -> client, Lua tables (low frequency)
	Cmd = "RemoteEvent", -- client -> server, { op = "...", ... }
	Query = "RemoteFunction", -- client -> server, profile view / shop data
}

Protocol.MSG_SNAP = 1
Protocol.MSG_MOVE = 2
Protocol.MSG_EV = 3

-- binary event kinds (Appendix B.3); everything else goes out as Ui tables
Protocol.EV = {
	kill = 1,
	dmg = 2,
	["eshot+"] = 3,
	["eshot-"] = 4,
	["tele+"] = 5,
	["tele~"] = 6,
	["tele-"] = 7,
	["haz+"] = 8,
	["haz-"] = 9,
	["pick+"] = 10,
	["pick~"] = 11,
	["pick-"] = 12,
	gemPull = 13,
	gemGot = 14,
	fire = 15,
	orbit = 16,
	sfx = 17,
	shake = 18,
	["prop-"] = 19,
	["gem+"] = 20,
	boom = 21,
	burst = 22,
	arc = 23,
	pool = 24,
	["shot-"] = 25,
	despawn = 26,
	warp = 27,
	aura = 28,
	flash = 29,
	["haz~"] = 30,
	text = 31,
}
Protocol.EV_NAME = {}
for k, v in Protocol.EV do
	Protocol.EV_NAME[v] = k
end

-- sim events that become Ui messages (reliable tables)
Protocol.UI_EVENTS = {
	banner = true,
	countdown = true,
	levelup = true,
	levelupDone = true,
	chest = true,
	state = true,
	victory = true,
	gameOver = true,
	boss = true,
	hurt = true,
	down = true,
	revived = true,
	ward = true,
	correct = true,
	vote = true,
	endless = true,
	left = true,
	start = true,
}

-- enemy type index (wire): 0-based position in Enemies.ORDER
Protocol.TYPE_INDEX = {}
for i, id in Enemies.ORDER do
	Protocol.TYPE_INDEX[id] = i - 1
end
Protocol.TYPE_NAME = Enemies.ORDER

Protocol.WEAPON_INDEX = {}
for i, id in Weapons.ORDER do
	Protocol.WEAPON_INDEX[id] = i - 1
end
Protocol.WEAPON_NAME = Weapons.ORDER

Protocol.SFX = {
	"hit",
	"kill",
	"shoot",
	"slash",
	"zap",
	"throw",
	"knife",
	"nova",
	"orbit",
	"flask",
	"gem",
	"coin",
	"heal",
	"magnet",
	"bomb",
	"chestpick",
	"chest",
	"levelup",
	"hurt",
	"death",
	"revive",
	"boss",
	"bossdown",
	"summon",
	"dash",
	"slam",
	"break",
	"alarm",
	"warn",
	"tick",
	"surge",
	"achievement",
	"ewind",
	"efire",
	"eimpact",
	"victory",
}
Protocol.SFX_INDEX = {}
for i, n in Protocol.SFX do
	Protocol.SFX_INDEX[n] = i
end

Protocol.PICK_KINDS = { "coin", "bag", "heart", "magnet", "bomb", "chest" }
Protocol.PICK_INDEX = {}
for i, n in Protocol.PICK_KINDS do
	Protocol.PICK_INDEX[n] = i
end

Protocol.TELE_KINDS = { "circle", "lane", "line", "aim", "wedge", "ring" }
Protocol.SHOT_KINDS = { orb = 0, needle = 1, lance = 2 }
Protocol.SHOT_KIND_NAME = { [0] = "orb", [1] = "needle", [2] = "lance" }

Protocol.COLORS = { "#ff3d5a", "#ff8a5c", "#fff3c4", "#c9b8ff", "#5dff8f", "#ff5a6e", "#ffe27a", "#ffd23f", "#ffffff" }
Protocol.COLOR_INDEX = {}
for i, c in Protocol.COLORS do
	Protocol.COLOR_INDEX[c] = i
end

-- client commands accepted by the server, with their argument checks (server validates everything)
Protocol.COMMANDS = {
	pick = { i = "int1_4" },
	reroll = {},
	skip = {},
	banish = { i = "int1_4" },
	chestClose = {},
	pause = {},
	resume = {},
	vote = { endless = "bool" },
	giveup = {},
	-- lobby
	selectHero = { hero = "heroId" },
	selectStage = { stage = "stageId", heat = "int0_5" },
	ready = { on = "bool" },
	start = {},
	lang = { lang = "lang" },
	-- hub / meta (Server/Services/Meta.luau)
	forgeBuy = { id = "forgeId" },
	forgeRefund = {},
	equip = { slot = "cosSlot", id = "cosIdOrEmpty" },
	setting = { key = "settingKey", value = "settingValue" },
	storySeen = { stage = "stageId" },
	-- purchases (Server/Services/Purchases.luau)
	buy = { key = "productKey" },
	useRevive = {},
}

return Protocol
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Views</string>
            <string name="Source"><![CDATA[-- Plain-table views of sim state for Ui messages (docs/DESIGN.md Appendix B.4). Pure; used by the server
-- replicator and tested in Lune. Never puts sim objects (enemy tables, telegraphs) into a message.
local Protocol = if script then require(script.Parent.Protocol) else require("./Protocol")

local Views = {}

-- own-hero state for its owner (HUD, pause screen)
function Views.hero(run, pl)
	local ws, ps = {}, {}
	for _, w in pl.weapons do
		table.insert(ws, { id = w.id, level = w.level, evo = w.evo })
	end
	for _, p in pl.passives do
		table.insert(ps, { id = p.id, level = p.level })
	end
	local s = pl.stats
	return {
		t = "hero",
		slot = pl.slot,
		hp = math.floor(pl.hp + 0.5),
		maxHp = s.maxHp,
		xp = pl.xp,
		xpNext = pl.xpNext,
		level = pl.level,
		gold = pl.gold,
		kills = run.kills,
		ownKills = pl.kills,
		weapons = ws,
		passives = ps,
		speed = s.speed,
		magnet = s.magnet,
		rerolls = pl.rerolls,
		skips = pl.skips,
		banishes = pl.banishes,
		state = pl.state,
		bleed = pl.bleedT,
		revive = pl.reviveFrac,
		stats = {
			maxHp = s.maxHp,
			armor = s.armor,
			regen = s.regen,
			might = s.might,
			area = s.area,
			cooldown = s.cooldown,
			amount = s.amount,
			duration = s.duration,
			projSpeed = s.projSpeed,
			magnet = s.magnet,
			luck = s.luck,
			growth = s.growth,
			greed = s.greed,
			crit = s.crit,
			speed = s.speed,
		},
	}
end

-- cheap change signature for throttled hero updates
function Views.heroSig(run, pl): string
	return string.format(
		"%d|%d|%.0f|%d|%d|%d|%s|%d|%d",
		math.floor(pl.hp + 0.5),
		pl.level,
		pl.xp,
		pl.gold,
		run.kills,
		#pl.weapons + #pl.passives * 10,
		pl.state,
		math.floor(pl.bleedT),
		math.floor((pl.reviveFrac or 0) * 20)
	)
end

-- run clock and boss bar (4 Hz for everybody)
function Views.runInfo(run)
	local boss = nil
	for _, b in run.bosses do
		if not b.dead then
			boss = { name = b.boss.name, frac = math.max(0, b.hp / b.maxHp), final = b.boss.final == true }
			break
		end
	end
	local teammates = {}
	for _, p in run.plist do
		table.insert(teammates, {
			slot = p.slot,
			hp = if p.stats then p.hp / p.stats.maxHp else 0,
			state = p.state,
			level = p.level,
			hero = p.heroId,
			bleed = p.bleedT,
			revive = p.reviveFrac,
		})
	end
	return {
		t = "run",
		time = run.t,
		state = run.state,
		stage = run.stage.id,
		heat = run.heat,
		length = run.length,
		boss = boss,
		team = teammates,
		lastChance = if run.state == "lastchance" then run.lastT else nil,
		vote = if run.state == "victory" then run.voteT else nil,
		endless = run.endless,
	}
end

-- a sim event that becomes a Ui message (nil when it is not one); `slot` filters per-player events
function Views.uiFromEvent(e, slot: number?)
	if not Protocol.UI_EVENTS[e.k] then
		return nil
	end
	if
		e.slot
		and slot
		and e.slot ~= slot
		and e.k ~= "down"
		and e.k ~= "revived"
		and e.k ~= "left"
		and e.k ~= "vote"
	then
		return nil
	end
	local msg = { t = e.k }
	for k, v in e do
		-- options / chest results / args are plain data; UI events carry no sim objects
		if k ~= "k" and type(v) ~= "function" then
			msg[k] = v
		end
	end
	return msg
end

return Views
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Server</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RateLimit</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key (player) for remote rate limits (docs/DESIGN.md §3.6). Pure: the caller passes the time.
local RateLimit = {}
RateLimit.__index = RateLimit

export type RateLimit = typeof(setmetatable(
	{} :: { rate: number, burst: number, buckets: { [any]: { tokens: number, t: number } } },
	RateLimit
))

-- rate = tokens per second, burst = bucket size
function RateLimit.new(rate: number, burst: number): RateLimit
	return setmetatable({ rate = rate, burst = burst, buckets = {} }, RateLimit)
end

-- true when the request of `key` at time `now` (seconds) is allowed
function RateLimit.allow(self: RateLimit, key: any, now: number): boolean
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.burst, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.burst, b.tokens + (now - b.t) * self.rate)
	b.t = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function RateLimit.forget(self: RateLimit, key: any)
	self.buckets[key] = nil
end

return RateLimit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[-- Argument checks for client commands (docs/DESIGN.md §3.6: every argument is type- and range-checked on the
-- server). Pure. Returns a clean copy of the command or nil.
local Protocol = if script then require(script.Parent.Parent.Net.Protocol) else require("../Net/Protocol")
local Heroes = if script then require(script.Parent.Parent.Sim.Data.Heroes) else require("../Sim/Data/Heroes")
local Stages = if script then require(script.Parent.Parent.Sim.Data.Stages) else require("../Sim/Data/Stages")
local Forge = if script then require(script.Parent.Parent.Sim.Data.Forge) else require("../Sim/Data/Forge")
local Products = if script then require(script.Parent.Parent.Config.Products) else require("../Config/Products")
local Cosmetics = if script then require(script.Parent.Parent.Config.Cosmetics) else require("../Config/Cosmetics")

local Validate = {}

local stageIds = {}
for _, s in Stages.list do
	stageIds[s.id] = true
end
local forgeIds = {}
for _, it in Forge.list do
	forgeIds[it.id] = true
end
local SETTING_KEYS = { sfx = true, music = true, dmgNums = true, shake = true, lowFx = true, camZoom = true }

local CHECK = {
	int1_4 = function(v)
		return type(v) == "number" and v == math.floor(v) and v >= 1 and v <= 4
	end,
	int0_5 = function(v)
		return type(v) == "number" and v == math.floor(v) and v >= 0 and v <= 5
	end,
	bool = function(v)
		return type(v) == "boolean"
	end,
	heroId = function(v)
		return type(v) == "string" and Heroes.byId[v] ~= nil
	end,
	stageId = function(v)
		return type(v) == "string" and stageIds[v] == true
	end,
	lang = function(v)
		return v == "de" or v == "en"
	end,
	forgeId = function(v)
		return type(v) == "string" and forgeIds[v] == true
	end,
	cosSlot = function(v)
		return type(v) == "string" and table.find(Cosmetics.SLOTS, v) ~= nil
	end,
	cosIdOrEmpty = function(v)
		return v == "" or (type(v) == "string" and Cosmetics.byId[v] ~= nil)
	end,
	settingKey = function(v)
		return type(v) == "string" and SETTING_KEYS[v] == true
	end,
	settingValue = function(v)
		return type(v) == "boolean" or (type(v) == "number" and v == v and math.abs(v) < 100)
	end,
	productKey = function(v)
		return type(v) == "string" and #v <= 40 and Products.byKey[v] ~= nil
	end,
}

function Validate.command(cmd: any)
	if type(cmd) ~= "table" or type(cmd.op) ~= "string" then
		return nil
	end
	local spec = Protocol.COMMANDS[cmd.op]
	if not spec then
		return nil
	end
	local out = { op = cmd.op }
	for field, kind in spec do
		local v = cmd[field]
		if not CHECK[kind](v) then
			return nil
		end
		out[field] = v
	end
	return out
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Sim</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Bosses</string>
            <string name="Source"><![CDATA[-- Boss AI and the five ranged attack primitives (web bossAI, castParams, castShots, canCast, startCast, rainPlan,
-- rainPlace, castStep, castRelease). Co-op: every skill picks a target (nearest active player with p = 0.6, else a
-- random active player); all telegraphs of that skill refer to him (docs/DESIGN.md §2.7).
local K = if script then require(script.Parent.K) else require("./K")
local Enemies = if script then require(script.Parent.Data.Enemies) else require("./Data/Enemies")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Coop = if script then require(script.Parent.Coop) else require("./Coop")

local Bosses = {}

local TAU, DEG = Util.TAU, Util.DEG
local cos, sin, atan2 = math.cos, math.sin, math.atan2
local WIND = { nova = 0.6, fan = 0.6, lances = 0.85, spiral = 0.6, rain = 0, lanes = 0 }

local function skillTarget(run, e)
	local act = run.act
	if #act <= 1 then
		return act[1]
	end
	if run.rng:next() < 0.6 then
		return (K.nearestActive(run, e.x, e.y))
	end
	return run.rng:pick(act)
end

function K.castParams(e, sk: string)
	if sk == "nova" then
		return { prim = "nova", n = if e.boss.final then 22 else 16 }
	end
	local c = e.boss.cast and e.boss.cast[sk]
	return c
end

function K.castShots(cp): number
	if cp.prim == "nova" or cp.prim == "fan" then
		return cp.n
	end
	if cp.prim == "lances" then
		return 3
	end
	if cp.prim == "spiral" then
		return cp.arms * math.ceil(2.4 / 0.14)
	end
	return 0
end

function K.canCast(run, e, p, d: number, cp): boolean
	if not K.inViewRect(p, e.x, e.y, 30, e.r * 0.6) or d <= 140 then
		return false
	end
	local nt = if cp.prim == "rain" then (cp.k or 1) elseif cp.prim == "lanes" or cp.prim == "lances" then 3 else 1
	return #run.eshots + K.castShots(cp) <= K.eshotCapBoss(run) and #run.tele + nt <= K.teleCap(run)
end

function K.startCast(run, e, p, sk: string, cp)
	local rng = run.rng
	local prim = cp.prim
	local wind = WIND[prim]
	local c = {
		k = sk,
		prim = prim,
		p = cp,
		t = 0,
		wind = wind,
		dur = 0,
		q = nil,
		fired = 0,
		tgt = p,
		off = 0,
		spd = 0,
		next = 0,
	}
	e.cast = c
	e.mode = "cast"
	e.windT = wind
	e.windMax = wind
	e.windStart = run.t
	e.teles = {}
	local function base(tl)
		tl.follow = e
		tl.own = e
		tl.ws = run.t
		tl.x = e.x
		tl.y = e.y
		tl.t = 0
		tl.life = wind
		tl.target = p
		return tl
	end
	if wind > 0 then
		K.sfx(run, "ewind", e.x, e.y)
	end
	if prim == "nova" then
		local off = rng:range(0, TAU)
		local spd = K.eSpeed(run, 165, 210)
		local shots = {}
		for i = 0, cp.n - 1 do
			shots[#shots + 1] = { a = off + i / cp.n * TAU, spd = spd, r = 9, dmg = e.dmg * 0.6, life = 3.5 }
		end
		table.insert(e.teles, base({ kind = "charge", ring = true, boss = true, sr = e.r + 10, shots = shots }))
	elseif prim == "fan" then
		local spd = math.min(math.max(210, cp.spd), cp.spd * run.heatDef.speed)
		local shots = {}
		for i = 0, cp.n - 1 do
			local o = (if cp.n > 1 then i / (cp.n - 1) - 0.5 else 0) * cp.spread * DEG
			shots[#shots + 1] = { a = 0, o = o, spd = spd, r = 8, dmg = e.dmg * 0.6, life = 3.5 }
		end
		local tl = base({
			kind = "charge",
			wedge = 140,
			boss = true,
			a = K.leadAim(p, e.x, e.y, 0, spd),
			lockAt = wind - 0.15,
			lead = 0,
			spd = spd,
			sr = e.r * 0.7,
			shots = shots,
		})
		K.aimShots(tl)
		table.insert(e.teles, tl)
	elseif prim == "lances" then
		local spd = K.eSpeed(run, 520, 560)
		for _, o in { -22 * DEG, 0, 22 * DEG } do
			table.insert(
				e.teles,
				base({
					kind = "aim",
					len = 900,
					lockAt = 0.5,
					lead = 0.5,
					spd = spd,
					o = o,
					a = K.leadAim(p, e.x, e.y, 0.5, spd) + o,
					hr = 9,
					dmg = e.dmg * 0.8,
					boss = true,
				})
			)
		end
	elseif prim == "spiral" then
		local off = rng:range(0, TAU)
		local spd = K.eSpeed(run, 135, 210)
		local shots = {}
		for i = 0, cp.arms - 1 do
			shots[#shots + 1] = { a = off + i / cp.arms * TAU, spd = spd, r = 8, dmg = e.dmg * 0.5, life = 3.5 }
		end
		c.off = off
		c.spd = spd
		c.dur = 2.4
		c.next = 0
		table.insert(
			e.teles,
			base({ kind = "charge", ring = true, boss = true, arms = true, sr = e.r + 10, shots = shots })
		)
	elseif prim == "rain" then
		c.q = K.rainPlan(cp)
		local m = 0
		for _, q in c.q do
			m = math.max(m, q.at)
		end
		c.dur = m + 0.05
	elseif prim == "lanes" then
		local L = {}
		if cp.pat == "x" then
			local a0 = rng:range(0, math.pi)
			for _, a in { a0, a0 + math.pi / 2 } do
				table.insert(L, {
					x = p.x - cos(a) * 500,
					y = p.y - sin(a) * 500,
					a = a,
					len = 1000,
					w = 44,
					life = 1.1,
					dmg = e.dmg * 1.0,
				})
			end
		else
			local a0 = atan2(p.y - e.y, p.x - e.x)
			for _, o in { -30, 0, 30 } do
				table.insert(
					L,
					{ x = e.x, y = e.y, a = a0 + o * DEG, len = 800, w = 50, life = 1.0, dmg = e.dmg * 1.1 }
				)
			end
		end
		for _, l in L do
			l.kind = "lane"
			l.t = 0
			K.addTele(run, l)
		end
		K.sfx(run, "ewind", e.x, e.y)
		c.dur = 1.1
	end
	for _, tl in e.teles do
		K.addTele(run, tl)
	end
end

function K.rainPlan(cp)
	local q = {}
	local v = cp.v
	if v == "scatter" then
		for i = 0, cp.k - 1 do
			table.insert(q, { at = i * 0.15, i = i })
		end
	elseif v == "flank" or v == "walk" or v == "track" then
		table.insert(q, { at = 0, i = 0 })
	elseif v == "stars" then
		for i = 0, 8 do
			table.insert(q, { at = i * 0.2, i = i })
		end
	end
	return q
end

function K.rainPlace(run, e, p, cp, i: number)
	local rng = run.rng
	local v = cp.v
	local out = {}
	local function mk(x, y, rad, life, dmg, onImpact, track)
		local cx, cy = K.clampView(p, x, y, 20)
		table.insert(out, {
			kind = "circle",
			x = cx,
			y = cy,
			rad = rad,
			t = 0,
			life = life,
			dmg = dmg,
			src = "area",
			small = rad < 70 and not track,
			onImpact = onImpact,
			track = track,
			target = p,
		})
	end
	if v == "scatter" then
		if i == 0 then
			mk(p.x, p.y, cp.rad, 1.0, e.dmg)
		else
			local a, dd = rng:range(0, TAU), rng:range(90, 240)
			mk(p.x + cos(a) * dd, p.y + sin(a) * dd, cp.rad, 1.0, e.dmg)
		end
	elseif v == "flank" then
		local a = if p.moving then atan2(p.vy, p.vx) + math.pi / 2 else rng:range(0, TAU)
		for _, k in { 0, 1, -1 } do
			mk(p.x + cos(a) * 70 * k, p.y + sin(a) * 70 * k, 48, 1.0, e.dmg * 0.8, "slow")
		end
	elseif v == "walk" then
		local a = atan2(p.y - e.y, p.x - e.x)
		for k = 0, 6 do
			local dd = 120 + k * 70
			mk(e.x + cos(a) * dd, e.y + sin(a) * dd, 36, 0.75 + 0.12 * k, e.dmg * 0.9)
		end
	elseif v == "stars" then
		if i % 2 == 0 then
			mk(p.x + p.vx * 0.8 + rng:range(-20, 20), p.y + p.vy * 0.8 + rng:range(-20, 20), 32, 0.8, e.dmg * 0.7)
		else
			local a, dd = rng:range(0, TAU), rng:range(0, 260)
			mk(p.x + cos(a) * dd, p.y + sin(a) * dd, 32, 0.8, e.dmg * 0.7)
		end
	elseif v == "track" then
		mk(p.x, p.y, 80, 1.6, e.dmg * 1.4, nil, { spd = p.stats.speed * 0.85, ["until"] = 0.9 })
	end
	return out
end

function K.castRelease(run, e)
	local c = e.cast
	local teles = e.teles or {}
	if c.prim == "nova" or c.prim == "fan" then
		local tl = teles[1]
		if tl then
			for _, sh in tl.shots do
				K.enemyShot(
					run,
					e.x + cos(sh.a) * tl.sr,
					e.y + sin(sh.a) * tl.sr,
					cos(sh.a),
					sin(sh.a),
					sh.spd,
					sh.dmg,
					sh.r,
					nil,
					nil,
					"bossShot"
				)
			end
		end
		K.sfx(run, if c.prim == "nova" then "summon" else "efire", e.x, e.y)
	elseif c.prim == "lances" then
		for _, tl in teles do
			K.enemyShot(
				run,
				e.x + cos(tl.a) * e.r * 0.8,
				e.y + sin(tl.a) * e.r * 0.8,
				cos(tl.a),
				sin(tl.a),
				tl.spd,
				tl.dmg,
				tl.hr,
				1.6,
				"lance",
				"bossShot"
			)
		end
		K.sfx(run, "efire", e.x, e.y)
	end
	K.endWind(run, e)
	e.windT = 0
end

local function castStep(run, e, dx, dy, d, dt): (number, number)
	local c = e.cast
	local cp = c.p
	local ox, oy = 0, 0
	if c.prim ~= "spiral" then
		local sp = e.speed * 0.3 * (if e.slowF < 1 then 0.8 else 1)
		ox, oy = dx / d * sp, dy / d * sp
	end
	local k = if c.t < c.wind then (e.slowF or 1) else 1
	c.t += dt * k
	if c.wind > 0 and e.windT > 0 then
		e.windT = math.max(0, c.wind - c.t)
		if e.windT <= 0 then
			K.castRelease(run, e)
		end
	end
	local tt = c.t - c.wind
	local p = c.tgt
	if p.state ~= "active" then
		p = e.tgt
	end
	if c.prim == "rain" then
		for _, q in c.q do
			if not q.done and tt >= q.at then
				q.done = true
				if p then
					for _, m in K.rainPlace(run, e, p, cp, q.i) do
						if #run.tele < K.teleCap(run) then
							K.addTele(run, m)
						end
					end
				end
				K.sfx(run, "ewind", e.x, e.y)
			end
		end
	elseif c.prim == "spiral" and tt >= 0 then
		while c.next <= tt and c.next < c.dur do
			local rot = c.off + 120 * DEG * c.next
			for i = 0, cp.arms - 1 do
				if #run.eshots < K.eshotCapBoss(run) then
					local a = rot + i / cp.arms * TAU
					K.enemyShot(
						run,
						e.x + cos(a) * (e.r + 10),
						e.y + sin(a) * (e.r + 10),
						cos(a),
						sin(a),
						c.spd,
						e.dmg * 0.5,
						8,
						nil,
						nil,
						"bossShot"
					)
				end
			end
			if c.next == 0 then
				K.sfx(run, "efire", e.x, e.y)
			end
			c.next += 0.14
		end
	end
	if c.t >= c.wind + c.dur then
		e.mode = "chase"
		e.skillT = if e.boss.final then 2.6 else 3.6
		e.cast = nil
		K.endWind(run, e)
	end
	return ox, oy
end

-- returns the boss's movement vector
function K.bossAI(run, e, p, dx, dy, d, dt): (number, number)
	local rng = run.rng
	local ox, oy = 0, 0
	if e.mode == "chase" then
		local sp = e.speed * (if e.slowF < 1 then 0.8 else 1)
		ox, oy = dx / d * sp, dy / d * sp
		e.skillT -= dt
		if e.skillT <= 0 then
			local sk = e.boss.skills[e.skillIdx % #e.boss.skills + 1]
			-- co-op: compared with the scaled cap (the plain wave cap would turn nearly every summon into a dash)
			if sk == "summon" and #run.enemies > K.wave(run).cap * Coop.f(Coop.spawnCap, run.nPlayers) then
				sk = "dash"
			end
			e.skillIdx += 1
			e.skillT = if e.boss.final then 2.6 else 3.6
			-- every skill picks its target
			local tp = skillTarget(run, e) or p
			e.tgt = tp
			local tdx, tdy = tp.x - e.x, tp.y - e.y
			local td = math.max(1e-6, Util.hypot(tdx, tdy))
			local cp = K.castParams(e, sk)
			if cp then
				if K.canCast(run, e, tp, td, cp) then
					K.startCast(run, e, tp, sk, cp)
					return ox, oy
				end
				sk = "dash"
			end
			if sk == "dash" then
				e.mode = "windup"
				e.modeT = 0.75
				e.dashA = atan2(tdy, tdx)
				K.addTele(run, {
					kind = "line",
					x = e.x,
					y = e.y,
					a = e.dashA,
					len = 520,
					w = e.r * 1.6,
					t = 0,
					life = 0.75,
					follow = e,
				})
			elseif sk == "summon" then
				local etype = e.boss.summon
				if not etype then
					if e.type == "skel" or e.type == "night" then
						etype = "skel"
					else
						etype = rng:weighted(K.wave(run).pool)
					end
				end
				local n = if e.boss.final then 12 else 9
				for i = 0, n - 1 do
					local a = i / n * TAU
					if run.nonBoss < 450 then
						local s = K.spawnEnemy(run, etype, e.x + cos(a) * (e.r + 40), e.y + sin(a) * (e.r + 40))
						s.tgt = tp
					end
				end
				K.ev(run, { k = "burst", x = e.x, y = e.y, color = "#c9b8ff", n = 26 })
				K.sfx(run, "summon", e.x, e.y)
			elseif sk == "slam" then
				K.addTele(run, {
					kind = "circle",
					x = tp.x,
					y = tp.y,
					rad = 100,
					t = 0,
					life = 1.05,
					dmg = e.dmg * 1.2,
					src = "area",
				})
			end
		end
	elseif e.mode == "cast" then
		ox, oy = castStep(run, e, dx, dy, d, dt)
	elseif e.mode == "windup" then
		e.modeT -= dt
		if e.modeT <= 0 then
			e.mode = "dash"
			e.modeT = 0.6
			K.sfx(run, "dash", e.x, e.y)
		end
	elseif e.mode == "dash" then
		e.modeT -= dt
		ox, oy = cos(e.dashA) * 560, sin(e.dashA) * 560
		if e.modeT <= 0 then
			e.mode = "chase"
		end
	end
	return ox, oy
end

Bosses.COLORS = Enemies.COLORS
return Bosses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!native
-- Damage, kills, explosions, hurting heroes (web inCircle, damage, kill, blast, hurtPlayer, playerDies).
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")

local Combat = {}

local sqrt = math.sqrt
local DMG_EVENTS_PER_STEP = 40

-- enemies whose circle overlaps (x, y, rad); returns a reusable buffer (rotating over 5, nested calls are safe)
function K.circle(run, x: number, y: number, rad: number): { any }
	run.qd = run.qd % 5 + 1
	local buf = run.qbufs[1 + run.qd]
	run.grid:query(x, y, rad + 70, buf)
	local n = 0
	for i = 1, #buf do
		local e = buf[i]
		if not e.dead then
			local rr = rad + e.r
			local dx, dy = x - e.x, y - e.y
			if dx * dx + dy * dy <= rr * rr then
				n += 1
				buf[n] = e
			end
		end
	end
	for i = #buf, n + 1, -1 do
		buf[i] = nil
	end
	K.hitProps(run, x, y, rad)
	return buf
end

-- enemies within distance r of the segment (x0,y0)-(x1,y1) (swept projectile)
function K.sweep(run, x0: number, y0: number, x1: number, y1: number, rad: number): { any }
	run.qd = run.qd % 5 + 1
	local buf = run.qbufs[1 + run.qd]
	local mx, my = (x0 + x1) * 0.5, (y0 + y1) * 0.5
	local sx, sy = x1 - x0, y1 - y0
	local len2 = sx * sx + sy * sy
	local half = sqrt(len2) * 0.5
	run.grid:query(mx, my, rad + half + 70, buf)
	local n = 0
	for i = 1, #buf do
		local e = buf[i]
		if not e.dead then
			local t = 0
			if len2 > 1e-9 then
				t = math.clamp(((e.x - x0) * sx + (e.y - y0) * sy) / len2, 0, 1)
			end
			local px, py = x0 + sx * t - e.x, y0 + sy * t - e.y
			local rr = rad + e.r
			if px * px + py * py <= rr * rr then
				n += 1
				buf[n] = e
			end
		end
	end
	for i = #buf, n + 1, -1 do
		buf[i] = nil
	end
	K.hitProps(run, x1, y1, rad)
	return buf
end

function K.damage(
	run,
	e,
	amount: number,
	wid: string,
	kbForce: number,
	crit: number?,
	fromX: number?,
	fromY: number?,
	slot: number
)
	if e.dead then
		return 0
	end
	local rng = run.rng
	local pl = run.players[slot]
	local dmg = amount * rng:range(0.9, 1.1)
	local cc = if crit and crit > 0 then crit else 0.05
	local isCrit = rng:next() < cc
	if isCrit then
		dmg *= 2
	end
	if pl then
		pl.dmgBy[wid] = (pl.dmgBy[wid] or 0) + math.min(dmg, math.max(0, e.hp))
	end
	e.hp -= dmg
	e.flash = 0.06
	if kbForce > 0 and e.kb > 0 then
		local fx = fromX or (if pl then pl.x else e.x)
		local fy = fromY or (if pl then pl.y else e.y)
		local dx, dy = e.x - fx, e.y - fy
		local d = sqrt(dx * dx + dy * dy)
		if d == 0 then
			d = 1
		end
		e.kx += dx / d * kbForce * e.kb
		e.ky += dy / d * kbForce * e.kb
	end
	if run.dmgEvN < DMG_EVENTS_PER_STEP or e.boss then
		run.dmgEvN += 1
		K.ev(
			run,
			{ k = "dmg", x = e.x, y = e.y - e.r - 4, amount = dmg, crit = isCrit, boss = e.boss ~= nil, slot = slot }
		)
	end
	K.sfx(run, "hit", e.x, e.y)
	e.lastHit = slot
	if e.hp <= 0 then
		K.kill(run, e, slot)
	end
	return dmg
end

function K.kill(run, e, slot: number)
	local rng = run.rng
	e.dead = true
	if e.windT > 0 or e.teles then
		K.endWind(run, e)
	end
	run.kills += 1
	local killer = run.players[slot]
	if killer then
		killer.kills += 1
		killer.bank.kills += 1
	end
	K.ev(run, { k = "kill", id = e.id, x = e.x, y = e.y, type = e.type, elite = e.elite, boss = e.boss ~= nil })
	if e.swarm and rng:next() < 0.5 then
		return
	end
	if e.boss then
		run.bossKills += 1
		for _, pl in run.plist do
			if pl.state ~= "left" then
				pl.bank.bosses[e.boss.id] = true
				pl.bank.bossKills += 1
			end
		end
		for _ = 1, 26 do
			K.dropGem(run, e.x + rng:range(-60, 60), e.y + rng:range(-60, 60), math.ceil(e.xp / 26))
		end
		for _ = 1, 8 do
			K.drop(run, e.x + rng:range(-50, 50), e.y + rng:range(-50, 50), "coin", 3)
		end
		K.dropChests(run, e.x, e.y)
		K.shake(run, 14)
		K.sfx(run, "bossdown")
		K.banner(run, "{0} besiegt!", "win", nil, nil, nil, { e.boss.name })
		if e.boss.final and not run.won and run.state ~= "over" then
			run.won = true
			K.enterVictory(run)
		end
		return
	end
	K.sfx(run, "kill", e.x, e.y)
	K.dropGem(run, e.x, e.y, e.xp)
	if e.elite then
		K.dropChests(run, e.x, e.y)
		for _ = 1, 4 do
			K.drop(run, e.x + rng:range(-30, 30), e.y + rng:range(-30, 30), "coin", 2)
		end
		return
	end
	local luck = if killer then killer.stats.luck else 1
	local roll = rng:next()
	if roll < 0.022 * luck then
		K.drop(run, e.x, e.y, "coin", 1)
	elseif roll < 0.022 * luck + 0.0025 * luck then
		K.drop(run, e.x, e.y, "heart")
	elseif roll < 0.022 * luck + 0.0035 * luck then
		K.drop(run, e.x, e.y, "magnet")
	elseif roll < 0.022 * luck + 0.0042 * luck then
		K.drop(run, e.x, e.y, "bomb")
	end
end

-- explosion (bomb pickup, revival)
function K.blast(run, x: number, y: number, rad: number, dmg: number, wid: string, slot: number)
	local list = table.clone(K.circle(run, x, y, rad))
	for _, e in list do
		K.damage(run, e, if e.boss then math.min(dmg, 400) else dmg, wid, 400, 0, x, y, slot)
	end
	K.ev(run, { k = "boom", x = x, y = y, rad = rad, color = "#fff3c4" })
end

-- src: what hit (contact, shot, needle, mortar, puddle, ring, bossShot, area, lane ...), remembered for stats
function K.hurtPlayer(run, pl, dmg: number, src: string)
	if pl.iframe > 0 or pl.wardT > 0 or pl.state ~= "active" or run.state ~= "play" then
		return
	end
	pl.lastHitSrc = src
	local taken = math.max(1, dmg - pl.stats.armor)
	pl.hp -= taken
	pl.iframe = 0.5
	pl.flash = 0.25
	if pl.firstHit == nil then
		pl.firstHit = run.t
	end
	pl.surgeHits += 1
	K.ev(run, { k = "hurt", slot = pl.slot, amount = taken, src = src })
	K.ev(run, { k = "shake", amount = math.min(9, 3 + taken * 0.3), slot = pl.slot })
	if pl.hp <= 0 then
		K.playerDies(run, pl)
	end
end

function K.playerDies(run, pl)
	if pl.revivals > 0 then
		pl.revivals -= 1
		K.reviveBlast(run, pl, "revive")
		K.banner(run, "Wiedergeboren!", "event", nil, nil, pl.slot)
		return
	end
	pl.hp = 0
	K.ev(run, { k = "burst", x = pl.x, y = pl.y, color = "#ff5a6e", n = 60 })
	K.sfx(run, "death", pl.x, pl.y)
	K.downPlayer(run, pl)
end

-- revival effect shared by forge revival and the Robux revive: 50 % HP, 3 s i-frames, blast 320 px
function K.reviveBlast(run, pl, wid: string)
	pl.hp = pl.stats.maxHp * 0.5
	pl.iframe = 3
	K.blast(run, pl.x, pl.y, 320, 99999, wid, pl.slot)
	K.ev(run, { k = "burst", x = pl.x, y = pl.y, color = "#ffe27a", n = 80 })
	K.sfx(run, "revive", pl.x, pl.y)
end

Combat.round = Util.round
return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Coop</string>
            <string name="Source"><![CDATA[--!strict
-- Co-op scaling with the number of players N (docs/DESIGN.md §2.6). Tune only here.
local Coop = {}

Coop.spawnRate = { 1, 1.6, 2.1, 2.5 }
Coop.spawnCap = { 1, 1.55, 2.0, 2.35 } -- tuned with the bot (docs/BALANCE.md): DESIGN start values 1, 1.5, 1.9, 2.2
Coop.enemyHp = { 1, 1.2, 1.35, 1.5 }
Coop.eliteHp = { 1, 1.6, 2.2, 2.8 }
Coop.bossHp = { 1, 1.8, 2.5, 3.2 }
Coop.eventCount = { 1, 1.4, 1.7, 2.0 }
Coop.rangedCap = { 1, 1.35, 1.7, 2.05 }
Coop.windMax = { 0, 1, 2, 3 }
Coop.xpShare = { 1, 0.62, 0.48, 0.40 }
Coop.goldShare = { 1, 0.7, 0.6, 0.5 }
Coop.eshotCap = { 120, 168, 216, 240 }
Coop.eshotCapBoss = { 160, 224, 288, 320 }
Coop.teleCap = { 32, 48, 64, 72 }

-- factor table t at player count n (clamped 1..4)
function Coop.f(t: { number }, n: number): number
	return t[math.clamp(n, 1, 4)]
end

return Coop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Countdown</string>
            <string name="Source"><![CDATA[-- Countdown bar and surge (web buildCountdowns, countdownTick, surgeStart, surgeEnd, countdownState; M10 spec).
local K = if script then require(script.Parent.K) else require("./K")
local Enemies = if script then require(script.Parent.Data.Enemies) else require("./Data/Enemies")
local Util = if script then require(script.Parent.Util) else require("./Util")

local Countdown = {}

function K.buildCountdowns(run)
	local list = {}
	for _, s in run.stage.surges or {} do
		table.insert(list, {
			kind = "surge",
			s = s,
			b = nil,
			start = s.t - s.lead,
			at = s.t,
			["end"] = s.t + s.dur,
			ph = 0,
			last = 0,
			t10 = false,
		})
	end
	local fb = nil
	for _, b in run.bossList do
		if not b.final then
			fb = b
			break
		end
	end
	if fb then
		table.insert(list, {
			kind = "boss",
			s = nil,
			b = fb,
			start = fb.t - 20,
			at = fb.t,
			["end"] = fb.t,
			ph = 0,
			last = 0,
			t10 = false,
		})
	end
	local out = {}
	for _, c in list do
		if c.start < run.length then
			table.insert(out, c)
		end
	end
	-- stable insertion sort by start (JS Array.sort is stable)
	for i = 2, #out do
		local c = out[i]
		local j = i - 1
		while j >= 1 and out[j].start > c.start do
			out[j + 1] = out[j]
			j -= 1
		end
		out[j + 1] = c
	end
	return out
end

function K.surgeNow(run)
	local c = run.cdList[run.cdIdx]
	if c and c.kind == "surge" and c.ph == 2 then
		return c
	end
	return nil
end

local function phaseEvent(run, c)
	local on = c.ph == 2
	K.ev(run, {
		k = "countdown",
		kind = c.kind,
		phase = if c.ph == 1 then "warn" elseif on then "on" else "off",
		start = c.start,
		at = c.at,
		["end"] = c["end"],
		icon = if c.kind == "surge" then c.s.icon else c.b.sprite,
		tint = if c.kind == "surge" then (run.stage.tints and run.stage.tints[c.s.icon]) else c.b.tint,
		label = if c.kind == "boss" then c.b.name else "",
	})
end

function K.countdownTick(run)
	local L = run.cdList
	while run.cdIdx <= #L do
		local c = L[run.cdIdx]
		if run.t < c.start then
			return
		end
		if c.ph == 0 and run.t >= c["end"] then
			c.ph = 3
			run.cdIdx += 1
			continue
		end
		if c.ph == 0 then
			c.ph = 1
			c.last = math.ceil(c.at - run.t)
			if c.kind == "surge" then
				K.sfx(run, "warn")
			end
			phaseEvent(run, c)
		end
		if c.ph == 1 then
			if run.t < c.at then
				local n = math.ceil(c.at - run.t)
				if n ~= c.last then
					c.last = n
					if n <= (if c.kind == "surge" then 5 else 3) then
						K.sfx(run, "tick")
					end
				end
				if c.kind == "surge" and not c.t10 and run.t >= c.at - 10 then
					c.t10 = true
					K.banner(run, "Mach dich bereit!", "event ready", c.s.hint, 2.6)
				end
				return
			end
			if c.kind == "boss" then
				c.ph = 3
				run.cdIdx += 1
				phaseEvent(run, c)
				continue
			end
			c.ph = 2
			K.surgeStart(run, c)
			phaseEvent(run, c)
		end
		if c.ph == 2 then
			if run.t < c["end"] then
				return
			end
			c.ph = 3
			run.cdIdx += 1
			phaseEvent(run, c)
			K.surgeEnd(run, c)
		end
	end
end

function K.surgeStart(run, c)
	local s = c.s
	local wv = K.wave(run)
	-- melee of the wave replaced by the surge mix; ranged keep their weights (order: surge pool, then ranged)
	local pool = {}
	for _, e in s.pool do
		table.insert(pool, { k = e.k, w = e.w })
	end
	for _, e in wv.pool do
		if Enemies.byId[e.k].ranged then
			local found = false
			for _, q in pool do
				if q.k == e.k then
					q.w = e.w
					found = true
				end
			end
			if not found then
				table.insert(pool, { k = e.k, w = e.w })
			end
		end
	end
	run.surgeWave = { pool = pool, rate = wv.rate, cap = wv.cap }
	for _, pl in run.plist do
		pl.surgeHits = 0
	end
	local hk = run.heat >= 3
	run.surgeK = { xp = if hk then 1 else s.xp, speed = if hk then 1 + (s.speed - 1) * 0.7 else s.speed }
	local ev = { text = s.text, quiet = true, surge = run.surgeK }
	for k, v in s.open do
		ev[k] = v
	end
	K.runEvent(run, ev)
	K.sfx(run, "surge")
	K.shake(run, 6)
end

function K.surgeEnd(run, c)
	run.surgeWave = nil
	if run.state == "over" then
		return
	end
	for _, pl in run.act do
		local g = Util.round(c.s.gold * pl.stats.greed * run.heatDef.gold) * (if pl.surgeHits > 0 then 1 else 2)
		pl.gold += g
		K.text(run, pl.x, pl.y - 26, "+{0} Gold", "#ffd23f", 1.4, pl.slot, { g })
		if pl.surgeHits > 0 then
			K.banner(run, "Ansturm überstanden!", "win", "+{0} Gold", nil, pl.slot, { g })
		else
			K.banner(run, "Ansturm überstanden!", "win", "Ohne Treffer! +{0} Gold", nil, pl.slot, { g })
		end
	end
	K.sfx(run, "achievement")
end

-- read access for UI/tools: nil or { kind, phase, left, frac, since, icon, tint, label }
function K.countdownState(run)
	local c = run.cdList and run.cdList[run.cdIdx]
	if not c or (c.ph ~= 1 and c.ph ~= 2) then
		return nil
	end
	local on = c.ph == 2
	local t = run.t
	local o = {}
	o.kind = c.kind
	o.phase = if on then "on" else "warn"
	o.since = math.max(0, if on then t - c.at else t - c.start)
	o.left = math.max(0, if on then c["end"] - t else c.at - t)
	o.frac = math.clamp(o.left / (if on then c["end"] - c.at else c.at - c.start), 0, 1)
	if c.kind == "surge" then
		o.icon = c.s.icon
		o.tint = run.stage.tints and run.stage.tints[c.s.icon]
		o.label = ""
	else
		o.icon = c.b.sprite
		o.tint = c.b.tint
		o.label = c.b.name
	end
	return o
end

return Countdown
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Curves</string>
            <string name="Source"><![CDATA[--!strict
-- Enemy HP curve and XP curve (web game.js hpCurve, hpCurveBridged, xpFor).
local Curves = {}

function Curves.hpCurve(m: number): number
	local q = math.max(0, m - 3)
	return 1 + 0.12 * m + 0.012 * m * m + 0.22 * q + 0.125 * q * q
end

local HP_BRIDGE_A, HP_BRIDGE_B = 1.25, 4
function Curves.hpCurveBridged(m: number): number
	local h = Curves.hpCurve(m)
	if m <= HP_BRIDGE_A or m >= HP_BRIDGE_B then
		return h
	end
	local a, b = Curves.hpCurve(HP_BRIDGE_A), Curves.hpCurve(HP_BRIDGE_B)
	return math.max(h, a * math.pow(b / a, (m - HP_BRIDGE_A) / (HP_BRIDGE_B - HP_BRIDGE_A)))
end

local XP_EARLY = { 6, 11, 17, 24, 32, 42, 53, 66, 80, 95 }
function Curves.xpFor(level: number): number
	if level <= #XP_EARLY then
		return XP_EARLY[level]
	end
	if level < 20 then
		return 5 + (level - 1) * 10
	end
	if level < 40 then
		return 200 + (level - 20) * 28
	end
	return 760 + (level - 40) * 40
end

return Curves
]]></string>
          </Properties>
        </Item>
