		P("Cylinder", V(0.5, 1.6, 1.6), V(0, 2.2, 0), "body", { rot = V(0, 90, 0) }),
		P("Block", V(2.0, 0.25, 1.0), V(0, 0.1, 0.4), "dark"),
	},
	cross = {
		P("Block", V(0.35, 2.6, 0.35), V(0, 1.3, 0), "body"),
		P("Block", V(1.4, 0.35, 0.35), V(0, 1.9, 0), "body"),
	},
	bones = {
		P("Cylinder", V(1.4, 0.22, 0.22), V(0, 0.15, 0), "light", { rot = V(0, 30, 0) }),
		P("Cylinder", V(1.2, 0.2, 0.2), V(0.2, 0.15, 0.3), "light", { rot = V(0, -50, 0) }),
		P("Ball", V(0.6, 0.55, 0.6), V(-0.6, 0.28, -0.3), "light"),
	},
	rock = {
		P("Ball", V(2.4, 1.4, 2.0), V(0, 0.45, 0), "body"),
		P("Ball", V(1.2, 0.9, 1.1), V(0.9, 0.3, 0.6), "dark"),
	},
	mush = {
		P("Cylinder", V(0.9, 0.4, 0.4), V(0, 0.45, 0), "light", { rot = V(0, 0, 90) }),
		P("Ball", V(1.4, 0.7, 1.4), V(0, 1.0, 0), "glow", { mat = NEON }),
	},
	stump = {
		P("Cylinder", V(1.0, 1.5, 1.5), V(0, 0.5, 0), "body", { rot = V(0, 0, 90) }),
		P("Cylinder", V(0.05, 1.2, 1.2), V(0, 1.02, 0), "light", { rot = V(0, 0, 90) }),
	},
	flower = {
		P("Cylinder", V(0.7, 0.1, 0.1), V(0, 0.35, 0), "dark", { rot = V(0, 0, 90) }),
		P("Ball", V(0.55, 0.3, 0.55), V(0, 0.75, 0), "glow", { mat = NEON }),
	},
}
local DECOR_COLOR = {
	grave = "#7d8494",
	cross = "#6d5a48",
	bones = "#e8e0c8",
	rock = "#6a6f78",
	mush = "#ff8ad8",
	stump = "#6b4a2e",
	flower = "#ffd84f",
}

-- ---------- colours ----------
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(16, 12, 22)
local GOLD = Color3.fromHex("#ffcf3f")
local SKIN = Color3.fromRGB(255, 220, 190)
local EYES = Color3.fromHex("#ffe066")

export type Palette = {
	body: Color3,
	glow: Color3?,
	eye: Color3?,
	accent: Color3?,
	skin: Color3?,
	weapon: Color3?,
	owner: Color3?,
}

local function roleColor(role: string, pal: Palette): Color3
	local b = pal.body
	if role == "body" then
		return b
	elseif role == "glow" then
		return pal.glow or b
	elseif role == "dark" then
		return b:Lerp(BLACK, 0.45)
	elseif role == "light" then
		return b:Lerp(WHITE, 0.4)
	elseif role == "eye" then
		return pal.eye or EYES
	elseif role == "white" then
		return WHITE
	elseif role == "black" then
		return BLACK
	elseif role == "gold" then
		return GOLD
	elseif role == "accent" then
		return pal.accent or b:Lerp(BLACK, 0.3)
	elseif role == "skin" then
		return pal.skin or SKIN
	elseif role == "weapon" then
		return pal.weapon or WHITE
	elseif role == "owner" then
		return pal.owner or GOLD
	elseif role == "glass" then
		return Color3.fromRGB(220, 240, 255)
	elseif role == "spark" then
		return Color3.fromHex("#ffb347")
	end
	return b
end

-- ---------- rigs ----------
export type Rig = {
	parts: { BasePart },
	specs: { PartSpec },
	offs: { CFrame },
	r: number,
	kind: string,
	light: PointLight?,
	bodyColor: Color3,
	state: string,
	phase: number,
}

local function rotCF(r: Vector3?): CFrame
	if not r then
		return CFrame.identity
	end
	return CFrame.Angles(rad(r.X), rad(r.Y), rad(r.Z))
end

-- build a rig from part specs, sizes scaled by r (studs)
local function buildFrom(
	kind: string,
	specs: { PartSpec },
	r: number,
	pal: Palette,
	materialOverride: Enum.Material?
): Rig
	local rig: Rig = {
		parts = {},
		specs = specs,
		offs = {},
		r = r,
		kind = kind,
		light = nil,
		bodyColor = pal.body,
		state = "",
		phase = math.random() * 10,
	}
	for i, sp in specs do
		local shape = sp.shape
		if shape == "Ball" and (sp.size.X ~= sp.size.Y or sp.size.Y ~= sp.size.Z) then
			shape = "Ellipsoid"
		end
		local part = Pool.get(
			shape,
			sp.size * r,
			roleColor(sp.role, pal),
			sp.mat or materialOverride or Enum.Material.SmoothPlastic,
			sp.tr or 0
		)
		rig.parts[i] = part
		rig.offs[i] = CFrame.new(sp.pos * r) * rotCF(sp.rot)
	end
	return rig
end

-- an enemy (or boss: bossName given) model
function ModelKit.enemy(etype: string, elite: boolean, bossName: string?, tints: { [string]: string }?): Rig
	local r = ModelKit.enemyRadius(etype, elite, bossName)
	local kind = (bossName and bossSprite[bossName]) or etype
	local spec = SPECS[kind] or SPECS.slime
	local body = ModelKit.enemyColor(etype, tints, bossName)
	if kind == "night" then
		body = Coords.color(Enemies.COLORS.night)
	end
	local specs = table.clone(spec.parts)
	if elite or bossName then
		for _, p in SPECS.eliteRing.parts do
			table.insert(specs, p)
		end
	end
	if bossName and kind ~= "night" then
		local top = 0
		for _, p in spec.parts do
			top = math.max(top, p.pos.Y + p.size.Y / 2)
		end
		for _, p in SPECS.crown.parts do
			local q = table.clone(p)
			q.pos = p.pos + V(0, top + 0.1, 0)
			q.anim = spec.parts[1].anim
			table.insert(specs, q)
		end
	end
	local rig = buildFrom(kind, specs, r, { body = body, eye = if elite then GOLD else nil })
	if bossName then
		local l = Instance.new("PointLight")
		l.Range = spec.light or 16
		l.Brightness = 1.6
		l.Color = body:Lerp(WHITE, 0.3)
		l.Shadows = false
		l.Parent = rig.parts[1]
		rig.light = l
	end
	return rig
end

local function heroSpecs(heroId: string?, pal: Palette): { PartSpec }
	local h = heroId and Heroes.byId[heroId]
	local weapon = if h then h.weapon else "whip"
	local specs = table.clone(SPECS.hero.parts)
	for _, p in WEAPON[weapon] or {} do
		table.insert(specs, p)
	end
	pal.weapon = pal.weapon or Coords.color(WEAPON_COLOR[weapon])
	return specs
end

-- a hero model (r = hero radius in studs); pal.body = hero or skin colour, pal.accent = skin accent
function ModelKit.hero(heroId: string?, r: number, pal: Palette): Rig
	return buildFrom("hero", heroSpecs(heroId, pal), r, pal)
end

-- a standalone (not pooled) copy of a hero model under `parent`, standing at the origin facing +X; for
-- ViewportFrame previews in the hub
function ModelKit.heroPreview(heroId: string?, r: number, pal: Palette, parent: Instance)
	for _, sp in heroSpecs(heroId, pal) do
		local part: BasePart
		local uniform = sp.size.X == sp.size.Y and sp.size.Y == sp.size.Z
		if sp.shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			local q = Instance.new("Part")
			q.Shape = if sp.shape == "Ball" and uniform
				then Enum.PartType.Ball
				elseif sp.shape == "Cylinder" then Enum.PartType.Cylinder
				else Enum.PartType.Block
			if sp.shape == "Ball" and not uniform then
				local m = Instance.new("SpecialMesh")
				m.MeshType = Enum.MeshType.Sphere
				m.Parent = q
			end
			part = q
		end
		part.Anchored = true
		part.CanCollide = false
		part.CastShadow = false
		part.Size = sp.size * r
		part.Color = roleColor(sp.role, pal)
		part.Material = sp.mat or Enum.Material.SmoothPlastic
		part.Transparency = sp.tr or 0
		part.CFrame = CFrame.new(sp.pos * r) * rotCF(sp.rot)
		part.Parent = parent
	end
end

function ModelKit.pickup(kind: string, pal: Palette?): Rig
	local spec = PICKUP[kind] or PICKUP.coin
	local p = pal or { body = Coords.color(PICKUP_COLOR[kind]) }
	return buildFrom(kind, spec.parts, 1, p)
end

-- gems by value (web colours: blue 1, green 5+, red 20+)
function ModelKit.gem(v: number): Rig
	local col = if v >= 20 then "#ff5a8e" elseif v >= 5 then "#5dff8f" else "#5ab8ff"
	local size = if v >= 20 then 1.45 elseif v >= 5 then 1.2 else 1
	return buildFrom("gem", PICKUP.gem.parts, size, { body = Coords.color(col) })
end

-- a decor model; tint (land decorTint) darkens/tints its colours like the web sprites
function ModelKit.decor(kind: string, scale: number, tint: string?): Rig
	local body = Coords.color(DECOR_COLOR[kind] or "#777777")
	if tint then
		body = body:Lerp(Coords.color(tint), 0.55)
	end
	return buildFrom("decor", DECOR[kind] or DECOR.rock, scale, { body = body })
end

ModelKit.DECOR_KINDS = DECOR

-- a model from a caller's spec (braziers, effects)
function ModelKit.build(spec: Spec, r: number, pal: Palette): Rig
	return buildFrom("custom", spec.parts, r, pal)
end

function ModelKit.release(rig: Rig)
	if rig.light then
		rig.light:Destroy()
		rig.light = nil
	end
	for _, p in rig.parts do
		Pool.put(p)
	end
	table.clear(rig.parts)
end

-- body colour override (hit flash, frozen, slowed); only touches parts with role body/light/dark/glow on change
function ModelKit.tint(rig: Rig, state: string, base: Color3)
	if rig.state == state and rig.bodyColor == base then
		return
	end
	rig.state = state
	rig.bodyColor = base
	local col = base
	local mat: Enum.Material? = nil
	if state == "flash" then
		col = WHITE
	elseif state == "frozen" then
		col = Color3.fromRGB(170, 220, 255)
		mat = ICE
	elseif state == "slowed" then
		col = base:Lerp(Color3.fromRGB(150, 200, 255), 0.45)
	end
	for i, sp in rig.specs do
		local role = sp.role
		if role == "body" or role == "dark" or role == "light" then
			local part = rig.parts[i]
			part.Color = roleColor(role, { body = col })
			local m = mat or sp.mat or Enum.Material.SmoothPlastic
			if part.Material ~= m then
				part.Material = m
			end
		end
	end
end

-- ---------- animation ----------
-- st: moving (bool), winding (bool), speed factor; returns the extra local transform of a part
local IDENT = CFrame.identity
local function anim(name: string?, t: number, st: any, rig: Rig): CFrame
	if not name then
		return IDENT
	end
	local wind = st.winding
	if name == "flutter" then
		return CFrame.new(0, sin(t * 9) * 0.12 * rig.r, 0)
	elseif name == "wingR" or name == "wingL" then
		-- hinge at the body's side
		local s = if name == "wingR" then 1 else -1
		local hinge = CFrame.new(0, 1.85 * rig.r, 0.5 * rig.r * s)
		local f = sin(t * 22) * 0.7
		return CFrame.new(0, sin(t * 9) * 0.12 * rig.r, 0) * hinge * CFrame.Angles(-f * s, 0, 0) * hinge:Inverse()
	elseif name == "squash" then
		return CFrame.new(0, math.abs(sin(t * 6)) * 0.18 * rig.r, 0)
	elseif name == "waddle" then
		return CFrame.Angles(sin(t * 8) * 0.14, 0, 0)
	elseif name == "float" then
		return CFrame.new(0, sin(t * 3) * 0.25 * rig.r, 0)
	elseif name == "lurch" then
		return CFrame.Angles(0, 0, sin(t * 5) * 0.12) * CFrame.new(0, math.abs(sin(t * 5)) * 0.08 * rig.r, 0)
	elseif name == "breathe" then
		return CFrame.new(0, sin(t * (if wind then 30 else 4)) * (if wind then 0.06 else 0.05) * rig.r, 0)
	elseif name == "snout" then
		if wind then
			return CFrame.new(-0.25 * rig.r + sin(t * 30) * 0.08 * rig.r, 0, 0)
		end
		return IDENT
	elseif name == "rock" then
		local a = if wind then sin(t * 26) * 0.18 else sin(t * 3) * 0.05
		return CFrame.Angles(a, 0, a * 0.6)
	elseif name == "flit" then
		return CFrame.new(0, sin(t * 7) * 0.2 * rig.r, cos(t * 5) * 0.1 * rig.r)
	elseif name == "mothR" or name == "mothL" then
		local s = if name == "mothR" then 1 else -1
		local hinge = CFrame.new(0, 2.0 * rig.r, 0.3 * rig.r * s)
		return CFrame.new(0, sin(t * 7) * 0.2 * rig.r, cos(t * 5) * 0.1 * rig.r)
			* hinge
			* CFrame.Angles(-sin(t * 16) * 0.5 * s, 0, 0)
			* hinge:Inverse()
	elseif name == "swing" or name == "clapper" then
		local a = if wind then sin(t * 18) * 0.35 else sin(t * 2) * 0.06
		local pivot = CFrame.new(0, 2.4 * rig.r, 0)
		local k = if name == "clapper" then 1.6 else 1
		return pivot * CFrame.Angles(a * k, 0, 0) * pivot:Inverse()
	elseif name == "hover" then
		return CFrame.new(0, sin(t * 2.5) * 0.25 * rig.r, 0)
	elseif name == "stomp" or name == "fistR" or name == "fistL" then
		local b = math.abs(sin(t * 5)) * 0.1 * rig.r
		if name == "fistR" then
			return CFrame.new(sin(t * 5) * 0.2 * rig.r, b, 0)
		elseif name == "fistL" then
			return CFrame.new(-sin(t * 5) * 0.2 * rig.r, b, 0)
		end
		return CFrame.new(0, b, 0)
	elseif name == "slowstomp" then
		return CFrame.Angles(sin(t * 2.5) * 0.06, 0, 0) * CFrame.new(0, math.abs(sin(t * 2.5)) * 0.06 * rig.r, 0)
	elseif name == "pulse" then
		return CFrame.new(0, sin(t * 2) * 0.15 * rig.r, 0)
	elseif string.sub(name, 1, 5) == "orbit" and name ~= "orbitHero" then
		local k = tonumber(string.sub(name, 6)) or 1
		local a = t * 1.6 + k * math.pi / 2
		-- shards circle the body: undo the part's +X offset, then rotate it about the model's vertical axis
		local c = CFrame.new(0, 2.2 * rig.r, 0)
		return c * CFrame.Angles(0, a, 0) * c:Inverse()
	elseif name == "walk" then
		if st.moving then
			return CFrame.new(0, math.abs(sin(t * 11)) * 0.12 * rig.r, 0) * CFrame.Angles(sin(t * 11) * 0.06, 0, 0)
		end
		return CFrame.new(0, sin(t * 2) * 0.03 * rig.r, 0)
	elseif name == "cape" then
		local w = if st.moving then 0.25 + sin(t * 11) * 0.08 else 0.05
		local c = CFrame.new(-0.55 * rig.r, 1.9 * rig.r, 0)
		return c * CFrame.Angles(0, 0, w) * c:Inverse()
	elseif name == "orbitHero" then
		local a = t * 3
		return CFrame.new(cos(a) * 1.1 * rig.r, sin(t * 4) * 0.2 * rig.r, sin(a) * 1.1 * rig.r)
	elseif name == "spin" then
		return CFrame.new(0, sin(t * 3) * 0.15 * rig.r, 0) * CFrame.Angles(0, t * 2.2, 0)
	elseif name == "bob" then
		return CFrame.new(0, sin(t * 3) * 0.1 * rig.r, 0)
	elseif name == "spinBob" then
		return CFrame.new(0, sin(t * 3) * 0.15 * rig.r, 0) * CFrame.Angles(0, t * 1.5, 0)
	elseif name == "spark" then
		return CFrame.new(0, sin(t * 3) * 0.1 * rig.r + sin(t * 37) * 0.05, 0)
	elseif name == "chest" then
		return CFrame.new(0, sin(t * 2) * 0.05, 0)
	end
	return IDENT
end

-- append the rig's parts and world CFrames (base = position + facing) to the bulk arrays; returns the new count
function ModelKit.pose(
	rig: Rig,
	base: CFrame,
	t: number,
	st: any,
	outP: { BasePart },
	outC: { CFrame },
	n: number
): number
	local tt = t + rig.phase
	local parts, offs, specs = rig.parts, rig.offs, rig.specs
	for i = 1, #parts do
		local sp = specs[i]
		local a = sp.anim
		n += 1
		outP[n] = parts[i]
		if a then
			-- animations act in the model frame: pivot-style ones already include their pivot
			outC[n] = base * anim(a, tt, st, rig) * offs[i]
		else
			outC[n] = base * offs[i]
		end
	end
	return n
end

return ModelKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">Particles</string>
              <string name="Source"><![CDATA[-- Particle bursts on a budget (docs/DESIGN.md §4.4): one shared ParticleEmitter per colour and style on an invisible
-- anchor part; a burst moves the anchor and calls Emit(n), so no Instance is created per effect. A leaky bucket caps
-- the particles per second (PC 600, phone 300, reduced effects 120); bursts over the budget are thinned, never queued.
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local Device = require(script.Parent.Parent.Device)

local Particles = {}

type Style = {
	size: number,
	speed: number,
	life: number,
	drag: number,
	gravity: number,
	light: number,
	spread: number,
	up: boolean?,
}
-- burst styles
local STYLES: { [string]: Style } = {
	spark = { size = 0.35, speed = 14, life = 0.35, drag = 4, gravity = -8, light = 1, spread = 180 },
	puff = { size = 1.1, speed = 5, life = 0.5, drag = 3, gravity = 2, light = 0.3, spread = 180 },
	big = { size = 0.6, speed = 26, life = 0.8, drag = 2.5, gravity = -6, light = 1, spread = 180 },
	rise = { size = 0.4, speed = 8, life = 0.9, drag = 1, gravity = 6, light = 1, spread = 35, up = true },
}
local MAX_EMITTERS = 24

local emitters: { [string]: { part: BasePart, em: ParticleEmitter } } = {}
local count = 0
local budget = 600
local tokens = 600
local lastT = os.clock()
local lowFx = false
Particles.emitted = 0
Particles.dropped = 0

local function make(style: string, color: Color3)
	local key = string.format("%s%02x%02x%02x", style, color.R * 255, color.G * 255, color.B * 255)
	local e = emitters[key]
	if e then
		return e
	end
	if count >= MAX_EMITTERS then
		-- reuse any emitter of the same style (colour stays as it was)
		for k, v in emitters do
			if string.sub(k, 1, #style) == style then
				return v
			end
		end
	end
	local st = STYLES[style] or STYLES.spark
	local p = Pool.get("Block", Vector3.one * 0.2, nil, Enum.Material.SmoothPlastic, 1)
	local em = Instance.new("ParticleEmitter")
	em.Rate = 0
	em.Enabled = true
	em.LockedToPart = false
	em.Color = ColorSequence.new(color)
	em.LightEmission = st.light
	em.LightInfluence = 0
	em.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, st.size),
		NumberSequenceKeypoint.new(1, st.size * 0.2),
	})
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Lifetime = NumberRange.new(st.life * 0.6, st.life)
	em.Speed = NumberRange.new(st.speed * 0.4, st.speed)
	em.SpreadAngle = Vector2.new(st.spread, st.spread)
	em.Drag = st.drag
	em.Acceleration = Vector3.new(0, st.gravity, 0)
	em.EmissionDirection = Enum.NormalId.Top
	em.Shape = Enum.ParticleEmitterShape.Sphere
	em.Parent = p
	e = { part = p, em = em }
	emitters[key] = e
	count += 1
	return e
end

function Particles.setLowFx(on: boolean)
	lowFx = on
end

local function refill()
	local now = os.clock()
	budget = if lowFx then 120 elseif Device.phone() then 300 else 600
	tokens = math.min(budget * 0.5, tokens + (now - lastT) * budget)
	lastT = now
end

-- a burst of n particles at sim (x, y), height h (studs)
function Particles.burst(style: string, x: number, y: number, h: number, color: Color3, n: number)
	refill()
	local k = math.min(n, math.floor(tokens))
	if k <= 0 then
		Particles.dropped += n
		return
	end
	tokens -= k
	Particles.dropped += n - k
	Particles.emitted += k
	local e = make(style, color)
	e.part.CFrame = Coords.cf(x, y, h)
	e.em:Emit(k)
end

function Particles.clear()
	for _, e in emitters do
		e.em:Clear()
		e.part.CFrame = Pool.FAR
	end
end

return Particles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">PickupView</string>
              <string name="Source"><![CDATA[--!native
-- Gems and pickups (docs/DESIGN.md §3.5, §4.3): spawned once, attracted toward a hero when the sim says so, removed
-- when collected. Models from ModelKit: gems are neon diamonds (blue 1, green 5+, pink 20+), coins spin, bags,
-- hearts, magnets, bombs with a sparking fuse; chests carry a band in their owner's hero colour (only the owner can
-- open them) in neon so they are found in the dark.
local ModelKit = require(script.Parent.ModelKit)
local Coords = require(script.Parent.Coords)

local PickupView = {}

local S = Coords.S
type Item = { rig: ModelKit.Rig, x: number, y: number, slot: number, sp: number, owner: number? }
local items: { [number]: Item } = {}
local bulkP: { BasePart } = {}
local bulkC: { CFrame } = {}
local st = { moving = false }
local heroPos: (number) -> (number?, number?) = function(_)
	return nil, nil
end
local ownerColor: (number) -> Color3 = function(_)
	return Color3.new(1, 1, 1)
end

function PickupView.setHeroPosition(fn, colorFn)
	heroPos = fn
	ownerColor = colorFn
end

function PickupView.gem(e)
	items[e.id] = { rig = ModelKit.gem(e.v), x = e.x, y = e.y, slot = 0, sp = 0 }
end

function PickupView.pickup(e)
	local rig
	if e.kind == "chest" then
		local owner = if e.owner and e.owner > 0 then ownerColor(e.owner) else Color3.fromHex("#ffcf3f")
		rig = ModelKit.pickup("chest", { body = Color3.fromHex("#8a5a2a"), owner = owner })
	else
		rig = ModelKit.pickup(e.kind)
	end
	items[e.id] = { rig = rig, x = e.x, y = e.y, slot = 0, sp = 0, owner = e.owner }
end

function PickupView.pull(id: number, slot: number)
	local it = items[id]
	if it then
		it.slot = slot
		it.sp = -100
	end
end

function PickupView.remove(id: number)
	local it = items[id]
	if it then
		ModelKit.release(it.rig)
		items[id] = nil
	end
end

-- chests the given slot may open (for the off-screen arrows): calls fn(x, y)
function PickupView.eachChest(slot: number, fn: (number, number) -> ())
	for _, it in items do
		if it.rig.kind == "chest" and (not it.owner or it.owner == 0 or it.owner == slot) then
			fn(it.x, it.y)
		end
	end
end

function PickupView.render(dt: number, now: number)
	local n = 0
	table.clear(bulkP)
	table.clear(bulkC)
	for _, it in items do
		if it.slot > 0 then
			local hx, hy = heroPos(it.slot)
			if hx then
				local dx, dy = hx - it.x, hy - it.y
				local d = math.max(1, math.sqrt(dx * dx + dy * dy))
				it.sp += 1100 * dt
				local step = it.sp * dt
				if step >= d then
					it.x, it.y = hx, hy
				else
					it.x += dx / d * step
					it.y += dy / d * step
				end
			end
		end
		n = ModelKit.pose(it.rig, CFrame.new(it.x * S, 0, it.y * S), now, st, bulkP, bulkC, n)
	end
	if n > 0 then
		workspace:BulkMoveTo(bulkP, bulkC, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function PickupView.clear()
	for id in items do
		PickupView.remove(id)
	end
end

return PickupView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">Pool</string>
              <string name="Source"><![CDATA[-- Part pools for the arena (no Instance creation per frame in steady state, docs/DESIGN.md §3.4). Parts are anchored,
-- non-colliding, non-queryable, without shadows; unused parts wait far below the arena. Roblox keeps Ball parts
-- round (all axes equal), so stretched balls are "Ellipsoid": a Block with a SpecialMesh sphere that follows the size.
local Pool = {}

local FAR = CFrame.new(0, -300, 0) -- under the ground plates, above FallenPartsDestroyHeight (-500)
local folder: Folder? = nil
local free: { [string]: { BasePart } } = { Ball = {}, Block = {}, Cylinder = {}, Wedge = {}, Ellipsoid = {} }
local MESH = "EN_Mesh"
local ellipsoids: { [BasePart]: boolean } = {}

function Pool.folder(): Folder
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "Arena"
		f.Parent = workspace
		folder = f
	end
	return folder :: Folder
end

local function make(shape: string): BasePart
	local p: BasePart
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "Ellipsoid" then
		local q = Instance.new("Part")
		q.Shape = Enum.PartType.Block
		local m = Instance.new("SpecialMesh")
		m.Name = MESH
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = q
		ellipsoids[q] = true
		p = q
	else
		local q = Instance.new("Part")
		q.Shape = (Enum.PartType :: any)[shape]
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = FAR
	p.Parent = Pool.folder()
	return p
end

function Pool.prewarm(shape: string, n: number)
	local list = free[shape]
	for _ = 1, n do
		table.insert(list, make(shape))
	end
end

function Pool.get(
	shape: string,
	size: Vector3?,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?
): BasePart
	local list = free[shape]
	local p = table.remove(list) or make(shape)
	if size then
		p.Size = size
	end
	if color then
		p.Color = color
	end
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	return p
end

function Pool.put(p: BasePart)
	p.CFrame = FAR
	for _, c in p:GetChildren() do
		if c.Name ~= MESH then
			c:Destroy()
		end
	end
	local shape = if p:IsA("WedgePart") then "Wedge" elseif ellipsoids[p] then "Ellipsoid" else (p :: Part).Shape.Name
	table.insert(free[shape], p)
end

Pool.FAR = FAR
return Pool
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">ShotView</string>
              <string name="Source"><![CDATA[--!native
-- Projectiles and weapon visuals (docs/DESIGN.md §3.5, §4.4). Enemy shots are spawned once and moved here
-- (straight lines); player weapons come from `fire` events and are simulated visually (bolts, knives, sickles,
-- flasks, slashes, zaps, novas), orbit balls and auras follow their hero. Enemy shots have their own look that no
-- player effect uses (red neon with a light core inside a dark ring, §7.4); on phones they are drawn at least
-- 1.4 studs wide (about 14 px on a 720 px tall screen).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Sim.Data.Weapons)
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local Device = require(script.Parent.Parent.Device)

local ShotView = {}

local S = Coords.S
local ESHOT = Color3.fromHex("#ff3d5a")
local ECORE = Color3.fromHex("#ffd6dc")
local ERING = Color3.fromRGB(20, 6, 12)
local COL = {
	wand = Color3.fromHex("#b48cff"),
	wandEvo = Color3.fromHex("#ff7cf5"),
	knives = Color3.fromHex("#d8f3ff"),
	sickle = Color3.fromHex("#e8e0c8"),
	fire = Color3.fromHex("#ff7a2f"),
	whip = Color3.fromHex("#ffffff"),
	whipEvo = Color3.fromHex("#ff4b6b"),
	lightning = Color3.fromHex("#9fe8ff"),
	nova = Color3.fromHex("#a8e4ff"),
	orbit = Color3.fromHex("#ffe27a"),
	aura = Color3.fromHex("#ff9a3c"),
}

type Shot = {
	part: BasePart,
	ring: BasePart,
	core: BasePart,
	x: number,
	y: number,
	vx: number,
	vy: number,
	t: number,
	life: number,
	round: boolean,
}
local eshots: { [number]: Shot } = {}
local pshots: { [number]: any } = {}
local fx: { any } = {}
local orbits: { [number]: any } = {}
local auras: { [number]: any } = {}
local bulkP: { BasePart } = {}
local bulkC: { CFrame } = {}
local heroPos: (number) -> (number?, number?) = function(_)
	return nil, nil
end

function ShotView.setHeroPosition(fn)
	heroPos = fn
end

-- weapon colour cosmetics (docs/DESIGN.md §7.1): slot -> list of Color3 (several = cycled, "prism")
local fxColors: { [number]: { Color3 } } = {}
function ShotView.setFxColors(slot: number, colors: { Color3 }?)
	fxColors[slot] = colors
end
local function tint(slot: number?, default: Color3): Color3
	local list = slot and fxColors[slot]
	if not list or #list == 0 then
		return default
	end
	return list[1 + math.floor(os.clock() * 3) % #list]
end

function ShotView.eshot(e)
	local d = math.max(if Device.touch() then 1.4 else 1.0, e.r * 2 * S)
	local shot: Shot
	if e.kind == "needle" or e.kind == "lance" then
		local len = d * (if e.kind == "lance" then 4 else 2.4)
		local w = d * 0.55
		shot = {
			ring = Pool.get("Block", Vector3.new(len + 0.5, w * 0.9, w + 0.5), ERING, Enum.Material.SmoothPlastic, 0.3),
			part = Pool.get("Block", Vector3.new(len, w, w), ESHOT, Enum.Material.Neon, 0),
			core = Pool.get("Block", Vector3.new(len * 0.7, w * 1.05, w * 0.35), ECORE, Enum.Material.Neon, 0),
			x = e.x,
			y = e.y,
			vx = e.vx,
			vy = e.vy,
			t = 0,
			life = e.life,
			round = false,
		}
	else
		shot = {
			ring = Pool.get("Ball", Vector3.one * (d * 1.35), ERING, Enum.Material.SmoothPlastic, 0.3),
			part = Pool.get("Ball", Vector3.one * d, ESHOT, Enum.Material.Neon, 0),
			core = Pool.get("Ball", Vector3.one * (d * 0.45), ECORE, Enum.Material.Neon, 0),
			x = e.x,
			y = e.y,
			vx = e.vx,
			vy = e.vy,
			t = 0,
			life = e.life,
			round = true,
		}
	end
	eshots[e.id] = shot
end

local function freeShot(s: Shot)
	Pool.put(s.part)
	Pool.put(s.ring)
	Pool.put(s.core)
end

function ShotView.eshotGone(id: number)
	local s = eshots[id]
	if s then
		freeShot(s)
		eshots[id] = nil
	end
end

-- enemy shots in flight (for the off-screen warning arrows): calls fn(x, y, vx, vy)
function ShotView.eachEnemyShot(fn: (number, number, number, number) -> ())
	for _, s in eshots do
		fn(s.x, s.y, s.vx, s.vy)
	end
end

local function transient(shape, size, color, life, update, tr)
	local p = Pool.get(shape, size, color, Enum.Material.Neon, tr or 0.2)
	table.insert(fx, { part = p, t = 0, life = life, update = update })
	return p
end

function ShotView.fire(e)
	local w = e.weapon
	if w == "wand" or w == "knives" or w == "sickle" then
		local size = if w == "sickle" then 3.4 * e.area elseif w == "wand" then 1.4 * e.area else 1.2 * e.area
		local col = tint(e.slot, if w == "wand" then (if e.evo then COL.wandEvo else COL.wand) else COL[w])
		local shape = if w == "knives" then "Block" else "Ball"
		local sz = if w == "knives" then Vector3.new(1.6, 0.3, 0.4) else Vector3.one * size
		local p = Pool.get(shape, sz, col, Enum.Material.Neon, 0)
		local vx, vy = math.cos(e.a) * e.speed, math.sin(e.a) * e.speed
		pshots[e.extra] = {
			part = p,
			kind = w,
			x = e.x,
			y = e.y,
			vx = vx,
			vy = vy,
			vx0 = vx,
			vy0 = vy,
			back = false,
			slot = e.slot,
			t = 0,
			life = if w == "sickle" then 3.2 elseif w == "knives" then 0.9 else 3,
			a = e.a,
			speed = e.speed,
		}
	elseif w == "fire" then
		local tx, ty = e.x + math.cos(e.a) * e.speed * 0.45, e.y + math.sin(e.a) * e.speed * 0.45
		local sx, sy = e.x, e.y
		transient("Ball", Vector3.one * 1.2, tint(e.slot, COL.fire), 0.45, function(p, k)
			local x, y = sx + (tx - sx) * k, sy + (ty - sy) * k
			p.CFrame = Coords.cf(x, y, 1 + math.sin(k * math.pi) * 7)
		end)
	elseif w == "whip" then
		local R = 112 * e.area * S
		local hx, hy = e.x, e.y
		transient(
			"Block",
			Vector3.new(R, 0.2, R * 0.9),
			tint(e.slot, if e.evo then COL.whipEvo else COL.whip),
			0.22,
			function(p, k)
				local x, y = heroPos(e.slot)
				x = x or hx
				y = y or hy
				p.CFrame = Coords.cf(x, y, 1.2) * Coords.yaw(e.a) * CFrame.new(R * 0.55, 0, 0)
				p.Transparency = 0.3 + 0.7 * k
			end
		)
	elseif w == "lightning" then
		local R = 36 * e.area * S * 2
		local x, y = e.x, e.y
		local lc = tint(e.slot, COL.lightning)
		transient("Cylinder", Vector3.new(0.2, R, R), lc, 0.25, function(p, k)
			p.CFrame = Coords.cf(x, y, 0.3) * CFrame.Angles(0, 0, math.rad(90))
			p.Transparency = 0.2 + 0.8 * k
		end)
		transient("Block", Vector3.new(0.4, 14, 0.4), lc, 0.12, function(p, k)
			p.CFrame = Coords.cf(x, y, 7)
			p.Transparency = k
		end)
	elseif w == "nova" then
		local maxD = 150 * e.area * S * 2
		local sx, sy = e.x, e.y
		transient("Cylinder", Vector3.new(0.3, 1, 1), tint(e.slot, COL.nova), 0.55, function(p, k)
			local x, y = heroPos(e.slot)
			local kk = math.min(1, k / 0.9)
			local d = maxD * (1 - (1 - kk) * (1 - kk))
			p.Size = Vector3.new(0.3, math.max(0.2, d), math.max(0.2, d))
			p.CFrame = Coords.cf(x or sx, y or sy, 0.4) * CFrame.Angles(0, 0, math.rad(90))
			p.Transparency = 0.4 + 0.6 * k
		end)
	end
end

function ShotView.shotGone(id: number)
	local s = pshots[id]
	if s then
		Pool.put(s.part)
		pshots[id] = nil
	end
end

function ShotView.pool(e)
	local d = e.rad * 2 * S
	local x, y = e.x, e.y
	transient("Cylinder", Vector3.new(0.15, d, d), tint(e.slot, COL.fire), e.life, function(p, k)
		p.CFrame = Coords.cf(x, y, 0.15) * CFrame.Angles(0, 0, math.rad(90))
		p.Transparency = 0.35 + 0.5 * k
	end, 0.35)
end

function ShotView.arc(e)
	local x1, y1, x2, y2 = e.x, e.y, e.x2, e.y2
	local len = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2) * S
	transient("Block", Vector3.new(len, 0.25, 0.25), tint(e.slot, COL.lightning), 0.22, function(p, k)
		local mid = Coords.v3((x1 + x2) / 2, (y1 + y2) / 2, 1.5)
		p.CFrame = CFrame.lookAt(mid, Coords.v3(x2, y2, 1.5)) * CFrame.Angles(0, math.rad(90), 0)
		p.Transparency = k
	end)
end

function ShotView.orbit(e)
	local o = orbits[e.slot]
	if not o then
		o = { parts = {}, ang = 0 }
		orbits[e.slot] = o
	end
	for _, p in o.parts do
		Pool.put(p)
	end
	table.clear(o.parts)
	o.active = e.active
	o.radius = e.radius
	o.speed = e.speed
	o.ang = e.ang
	if e.active then
		for _ = 1, e.amount do
			table.insert(
				o.parts,
				Pool.get("Ball", Vector3.one * e.orb * 2 * S, tint(e.slot, COL.orbit), Enum.Material.Neon, 0)
			)
		end
	end
end

function ShotView.aura(e)
	local a = auras[e.slot]
	if not a then
		a = { part = Pool.get("Cylinder", Vector3.one, tint(e.slot, COL.aura), Enum.Material.Neon, 0.8) }
		auras[e.slot] = a
	end
	local d = e.rad * 2 * S
	a.part.Size = Vector3.new(0.1, d, d)
end

function ShotView.render(dt: number, now: number)
	local n = 0
	table.clear(bulkP)
	table.clear(bulkC)
	for id, s in eshots do
		s.t += dt
		if s.t >= s.life then
			freeShot(s)
			eshots[id] = nil
		else
			s.x += s.vx * dt
			s.y += s.vy * dt
			local cf = CFrame.new(s.x * S, 1.2, s.y * S)
			if not s.round then
				cf *= Coords.yaw(math.atan2(s.vy, s.vx))
			end
			bulkP[n + 1] = s.ring
			bulkC[n + 1] = cf
			bulkP[n + 2] = s.part
			bulkC[n + 2] = cf
			bulkP[n + 3] = s.core
			bulkC[n + 3] = if s.round then cf * CFrame.new(0, 0.15, 0) else cf
			n += 3
		end
	end
	for id, s in pshots do
		s.t += dt
		if s.kind == "sickle" then
			if not s.back then
				s.vx -= s.vx0 * 1.7 * dt
				s.vy -= s.vy0 * 1.7 * dt
				if s.vx * s.vx0 + s.vy * s.vy0 <= 0 then
					s.back = true
				end
			else
				local hx, hy = heroPos(s.slot)
				if hx then
					local dx, dy = hx - s.x, hy - s.y
					local d = math.max(1, math.sqrt(dx * dx + dy * dy))
					s.ret = math.min(s.speed * 1.4, (s.ret or 60) + 900 * dt)
					s.vx, s.vy = dx / d * s.ret, dy / d * s.ret
					if d < 20 then
						s.t = 1e9
					end
				end
			end
		end
		s.x += s.vx * dt
		s.y += s.vy * dt
		if s.t > s.life then
			Pool.put(s.part)
			pshots[id] = nil
		else
			n += 1
			bulkP[n] = s.part
			local spin = if s.kind == "sickle"
				then CFrame.Angles(0, now * 14, 0)
				else Coords.yaw(math.atan2(s.vy, s.vx))
			bulkC[n] = CFrame.new(s.x * S, 1.4, s.y * S) * spin
		end
	end
	for slot, o in orbits do
		if o.active and #o.parts > 0 then
			o.ang += dt * o.speed
			local hx, hy = heroPos(slot)
			if hx then
				for i, p in o.parts do
					local a = o.ang + (i - 1) / #o.parts * math.pi * 2
					n += 1
					bulkP[n] = p
					bulkC[n] = CFrame.new((hx + math.cos(a) * o.radius) * S, 1.4, (hy + math.sin(a) * o.radius) * S)
				end
			end
		end
	end
	for slot, a in auras do
		local hx, hy = heroPos(slot)
		if hx then
			n += 1
			bulkP[n] = a.part
			bulkC[n] = CFrame.new(hx * S, 0.1, hy * S) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
	if n > 0 then
		workspace:BulkMoveTo(bulkP, bulkC, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for i = #fx, 1, -1 do
		local f = fx[i]
		f.t += dt
		if f.t >= f.life then
			Pool.put(f.part)
			table.remove(fx, i)
		else
			f.update(f.part, f.t / f.life)
		end
	end
end

function ShotView.clear()
	for id, s in eshots do
		freeShot(s)
		eshots[id] = nil
	end
	for id, s in pshots do
		Pool.put(s.part)
		pshots[id] = nil
	end
	for _, f in fx do
		Pool.put(f.part)
	end
	table.clear(fx)
	for slot, o in orbits do
		for _, p in o.parts do
			Pool.put(p)
		end
		orbits[slot] = nil
	end
	for slot, a in auras do
		Pool.put(a.part)
		auras[slot] = nil
	end
end

ShotView.WEAPONS = Weapons
return ShotView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">TeleView</string>
              <string name="Source"><![CDATA[-- Telegraphs (docs/DESIGN.md §4.4), the most important visuals: flat red (#ff3d5a) neon shapes just above the
-- ground with a darker outline and a fill that grows with the wind-up (same timing as the sim): circles (outline
-- disk + growing fill), lanes and dash lines (outline + fill growing along the lane), aim lines (thin, pulsing once
-- locked), fan wedges (rays growing outwards) and charge rings (exit points pulsing). They follow their enemy
-- (rendered position) and update their aim from tele~ events. On touch screens the outlines are stronger.
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local EnemyView = require(script.Parent.EnemyView)
local Device = require(script.Parent.Parent.Device)

local TeleView = {}

local S = Coords.S
local RED = Color3.fromHex("#ff3d5a")
local HOT = Color3.fromHex("#ffb0bc")
local DARK = Color3.fromRGB(40, 8, 16)
local FLAT = CFrame.Angles(0, 0, math.rad(90))
local H = 0.12

type Tele = { e: any, parts: { BasePart }, fill: BasePart?, edge: BasePart?, t0: number }
local live: { [number]: Tele } = {}
local outlineTr = 0.55

local function flat(shape: string, size: Vector3, tr: number, color: Color3?, neon: boolean?): BasePart
	return Pool.get(
		shape,
		size,
		color or RED,
		if neon == false then Enum.Material.SmoothPlastic else Enum.Material.Neon,
		tr
	)
end

function TeleView.add(e, now: number)
	outlineTr = if Device.touch() then 0.4 else 0.55
	local tl: Tele = { e = e, parts = {}, fill = nil, edge = nil, t0 = now }
	local k = e.kind
	if k == "circle" then
		local d = e.rad * 2 * S
		-- dark base, red edge disk slightly larger, growing fill
		tl.edge = flat("Cylinder", Vector3.new(0.04, d + 0.5, d + 0.5), outlineTr, RED)
		table.insert(tl.parts, flat("Cylinder", Vector3.new(0.05, d, d), 0.45, DARK, false))
		tl.fill = flat("Cylinder", Vector3.new(0.07, 0.1, 0.1), 0.35)
	elseif k == "lane" or k == "line" then
		local w = math.max(0.6, e.w * S)
		tl.edge = flat("Block", Vector3.new(e.len * S + 0.4, 0.04, w + 0.4), outlineTr, RED)
		table.insert(tl.parts, flat("Block", Vector3.new(e.len * S, 0.05, w), 0.5, DARK, false))
		tl.fill = flat("Block", Vector3.new(0.1, 0.07, w), 0.35)
	elseif k == "aim" then
		table.insert(tl.parts, flat("Block", Vector3.new(e.len * S, 0.05, math.max(0.3, e.hr * S)), 0.5))
	elseif k == "wedge" then
		for _ = 1, math.max(1, e.n) do
			table.insert(tl.parts, flat("Block", Vector3.new(e.wedge * S, 0.05, 0.35), 0.45))
		end
	else -- ring: exit points
		for _ = 1, math.max(1, e.n * e.rings) do
			table.insert(tl.parts, flat("Ball", Vector3.one * 0.8, 0.2))
		end
	end
	live[e.id] = tl
end

function TeleView.update(id: number, a: number, x: number, y: number)
	local tl = live[id]
	if tl then
		tl.e.a = a
		if tl.e.follow == 0 then
			tl.e.x, tl.e.y = x, y
		end
	end
end

function TeleView.remove(id: number)
	local tl = live[id]
	if tl then
		for _, p in tl.parts do
			Pool.put(p)
		end
		if tl.fill then
			Pool.put(tl.fill)
		end
		if tl.edge then
			Pool.put(tl.edge)
		end
		live[id] = nil
	end
end

function TeleView.count(): number
	local n = 0
	for _ in live do
		n += 1
	end
	return n
end

function TeleView.render(now: number)
	for id, tl in live do
		local e = tl.e
		local age = now - tl.t0
		if age > e.life + 3 then
			TeleView.remove(id)
			continue
		end
		local x, y = e.x, e.y
		if e.follow ~= 0 then
			local fx, fy = EnemyView.position(e.follow)
			if fx then
				x, y = fx, fy
			end
		end
		local prog = math.clamp(age / math.max(e.life, 0.05), 0, 1)
		-- the last fifth flashes brighter so the moment of impact reads
		local hot = prog > 0.8 and math.floor(now * 16) % 2 == 0
		local k = e.kind
		if k == "circle" then
			local base = Coords.cf(x, y, H) * FLAT
			tl.parts[1].CFrame = base;
			(tl.edge :: BasePart).CFrame = base * CFrame.new(-0.02, 0, 0)
			local d = e.rad * 2 * S * prog
			local fill = tl.fill :: BasePart
			fill.Size = Vector3.new(0.07, math.max(0.1, d), math.max(0.1, d))
			fill.CFrame = base * CFrame.new(0.02, 0, 0)
			fill.Color = if hot then HOT else RED
		elseif k == "lane" or k == "line" then
			local len = e.len * S
			local base = Coords.cf(x, y, H) * Coords.yaw(e.a)
			tl.parts[1].CFrame = base * CFrame.new(len / 2, 0, 0);
			(tl.edge :: BasePart).CFrame = base * CFrame.new(len / 2, -0.02, 0)
			local fl = math.max(0.1, len * prog)
			local fill = tl.fill :: BasePart
			fill.Size = Vector3.new(fl, 0.07, fill.Size.Z)
			fill.CFrame = base * CFrame.new(fl / 2, 0.02, 0)
			fill.Color = if hot then HOT else RED
		elseif k == "aim" then
			local len = e.len * S
			local locked = age >= (e.lockAt or 0)
			tl.parts[1].CFrame = Coords.cf(x, y, H) * Coords.yaw(e.a) * CFrame.new(len / 2, 0, 0)
			tl.parts[1].Transparency = if locked then 0.15 + 0.25 * (0.5 + 0.5 * math.sin(now * 40)) else 0.6
		elseif k == "wedge" then
			local n = #tl.parts
			local len = e.wedge * S
			for i, p in tl.parts do
				local o = if n > 1 then ((i - 1) / (n - 1) - 0.5) * e.spread else 0
				p.CFrame = Coords.cf(x, y, H) * Coords.yaw(e.a + o) * CFrame.new(e.sr * S + len / 2, 0, 0)
				p.Transparency = 0.7 - 0.45 * prog
			end
		else
			local n = math.max(1, e.n)
			local adds = { 0, 0.5, 0.25 }
			local i = 0
			for ring = 1, e.rings do
				for j = 0, n - 1 do
					i += 1
					local p = tl.parts[i]
					if p then
						local a = e.off + (j + adds[ring]) * (math.pi * 2 / n)
						p.CFrame = Coords.cf(x + math.cos(a) * e.sr, y + math.sin(a) * e.sr, 1)
						p.Transparency = 0.6 - 0.5 * prog
					end
				end
			end
		end
	end
end

function TeleView.clear()
	for id in live do
		TeleView.remove(id)
	end
end

return TeleView
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="134">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>