        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Mix</string>
            <string name="Source"><![CDATA[-- Sound mixing rules ported from the web game's audio.js (docs/DESIGN.md §9). Pure (no Instances): which recordings
-- a sound name plays, at which volume, speed and delay, the minimum gap per sound, the copy and voice limits, the
-- distance fade, and the music track per intensity. The client players (src/client/Audio) only execute the plans.
local Mix = {}

Mix.MASTER = 0.8
Mix.MUSIC = 0.5
Mix.FADE = 1.5
Mix.MAX_COPIES = 6
Mix.MAX_VOICES = 40
-- a voice counts as busy this long after it started (Roblox reports no end time for unloaded sounds)
Mix.VOICE_TIME = 0.35

-- volume per recording (audio.js VOL; measured level -> target level by role)
Mix.VOL = {
	hit = 0.33,
	kill = 0.27,
	gem = 0.32,
	coin = 0.2,
	shoot = 0.15,
	knife = 0.1,
	slash = 0.22,
	throw = 0.13,
	zap = 0.22,
	["break"] = 0.31,
	hurt = 0.28,
	flask = 0.56,
	orbit = 0.22,
	dash = 0.35,
	nova = 1.5,
	magnet = 0.31,
	chestpick = 0.54,
	click = 0.83,
	deny = 0.26,
	item = 0.22,
	buy = 1.33,
	chest_open = 0.5,
	summon = 0.37,
	slam = 0.45,
	levelup = 0.39,
	chest = 1.5,
	evolve = 0.46,
	boss = 0.45,
	bomb = 0.48,
	death = 0.36,
	revive = 0.5,
	alarm = 0.79,
	achievement = 0.55,
	heal = 0.44,
	warn = 0.5,
	tick = 1.4,
	surge = 0.7,
}
-- music tracks brought to about -20 LUFS
Mix.TRACK_VOL = { menu = 1.7, battle = 0.47, boss = 0.89, victory = 0.77, gameover = 0.45 }
-- minimum gap in seconds between two plays of a name (audio.js GATE, ms)
Mix.GATE = {
	hit = 0.035,
	kill = 0.028,
	gem = 0.03,
	coin = 0.05,
	shoot = 0.07,
	knife = 0.045,
	slash = 0.06,
	zap = 0.05,
	throw = 0.08,
	flask = 0.09,
	["break"] = 0.06,
	hurt = 0.12,
	ewind = 0.09,
	efire = 0.08,
	eimpact = 0.12,
	tick = 0.5,
}
-- random detune in cents so fast repeats do not sound mechanical
Mix.DETUNE = {
	hit = 40,
	kill = 40,
	shoot = 20,
	knife = 30,
	slash = 25,
	throw = 25,
	zap = 30,
	["break"] = 30,
	flask = 20,
	coin = 10,
	hurt = 25,
	dash = 20,
	summon = 30,
}
-- gem combo: pentatonic, at most +12 semitones
Mix.GEM_STEPS = { 0, 2, 4, 7, 9, 12 }

local function cents(c: number): number
	return 2 ^ (c / 1200)
end
Mix.cents = cents

local VOL = Mix.VOL
-- names that play other recordings (audio.js SAMPLED); everything else plays the recording of the same name
Mix.COMPOSITE = {
	chest = { { key = "chest_open" }, { key = "chest", delay = 0.12 } },
	bossdown = { { key = "bomb" }, { key = "boss", rate = 0.75, delay = 0.05 } },
	ewind = { { key = "zap", vol = VOL.zap * 0.6, rate = cents(-300) } },
	efire = { { key = "throw", vol = VOL.throw * 0.75 } },
	eimpact = { { key = "slam", vol = VOL.slam * 0.6 } },
	warn = { { key = "summon", rate = 0.7, vol = VOL.warn } },
	tick = { { key = "click", rate = cents(300), vol = VOL.tick } },
	surge = {
		{ key = "slam", vol = VOL.slam * VOL.surge / 0.7 },
		{ key = "alarm", delay = 0.05, vol = VOL.alarm * VOL.surge / 0.7 },
	},
}
-- names that are music stings, not effects
Mix.STINGS = { victory = true, gameover = true }

-- positional sounds: full volume within NEAR studs of the own hero, silent beyond FAR
Mix.NEAR = 40
Mix.FAR = 120
function Mix.distanceGain(studs: number): number
	if studs <= Mix.NEAR then
		return 1
	end
	if studs >= Mix.FAR then
		return 0
	end
	return 1 - (studs - Mix.NEAR) / (Mix.FAR - Mix.NEAR)
end

export type Voice = { key: string, vol: number, rate: number, delay: number }
export type State = {
	last: { [string]: number },
	busy: { [string]: { number } },
	rng: () -> number,
	dropped: number,
}

-- rng: () -> [0, 1); the players use Random, tests a fixed sequence
function Mix.new(rng: (() -> number)?): State
	return { last = {}, busy = {}, rng = rng or math.random, dropped = 0 }
end

local function liveVoices(st: State, key: string?, now: number): number
	local n = 0
	for k, list in st.busy do
		for i = #list, 1, -1 do
			if now - list[i] >= Mix.VOICE_TIME then
				table.remove(list, i)
			end
		end
		if key == nil or k == key then
			n += #list
		end
	end
	return n
end

-- the voices to start for `name` at time `now` (seconds); nil when gated, muted by distance or over a limit.
-- opts.combo = gem combo, opts.dist = distance to the own hero in studs (nil = not positional)
function Mix.plan(st: State, name: string, now: number, opts: { combo: number?, dist: number? }?): { Voice }?
	if Mix.STINGS[name] then
		return nil
	end
	local o = opts or {}
	local gain = if o.dist then Mix.distanceGain(o.dist) else 1
	if gain <= 0 then
		return nil
	end
	local gate = Mix.GATE[name]
	if gate then
		local l = st.last[name]
		if l and now - l < gate then
			return nil
		end
		st.last[name] = now
	end
	local parts = Mix.COMPOSITE[name]
	if not parts then
		local rate = 1
		if name == "gem" then
			local steps = Mix.GEM_STEPS
			rate = 2 ^ (steps[math.min(#steps, math.floor((o.combo or 0) / 2) + 1)] / 12)
		end
		parts = { { key = name, rate = rate } }
	end
	local total = liveVoices(st, nil, now)
	local out = {}
	for _, p in parts do
		local key = p.key
		local copies = liveVoices(st, key, now)
		if copies >= Mix.MAX_COPIES or total >= Mix.MAX_VOICES then
			st.dropped += 1
			continue
		end
		local det = Mix.DETUNE[key]
		local rate = (p.rate or 1) * (if det then cents((st.rng() * 2 - 1) * det) else 1)
		local vol = (p.vol or VOL[key] or 0.4) * (1 + (st.rng() * 2 - 1) * 0.08) * gain
		table.insert(out, { key = key, vol = vol, rate = rate, delay = p.delay or 0 })
		st.busy[key] = st.busy[key] or {}
		table.insert(st.busy[key], now + (p.delay or 0))
		total += 1
	end
	return if #out > 0 then out else nil
end

-- every recording a name can play (for id checks)
function Mix.keys(name: string): { string }
	if Mix.STINGS[name] then
		return {}
	end
	local parts = Mix.COMPOSITE[name]
	if not parts then
		return { name }
	end
	local out = {}
	for _, p in parts do
		table.insert(out, p.key)
	end
	return out
end

-- music: 0 = hub/menu, 1 = early battle (muffled), 2 = battle, 3 = boss (main.js setIntensity)
function Mix.intensity(inRun: boolean, boss: boolean, t: number, surge: boolean): number
	if not inRun then
		return 0
	end
	if boss or t > 600 then
		return 3
	end
	if t > 240 or surge then
		return 2
	end
	return 1
end

function Mix.trackFor(intensity: number): string
	if intensity <= 0 then
		return "menu"
	elseif intensity >= 3 then
		return "boss"
	end
	return "battle"
end

-- high-frequency cut for the battle loop at intensity 1 (EqualizerSoundEffect.HighGain, dB)
function Mix.muffle(intensity: number): number
	return if intensity <= 1 then -18 else 0
end

-- keys whose id is 0 (sorted), for the one Studio note
function Mix.missing(ids: { [string]: number }): { string }
	local out = {}
	for k, v in ids do
		if type(v) ~= "number" or v <= 0 then
			table.insert(out, k)
		end
	end
	table.sort(out)
	return out
end

return Mix
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="5">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">AudioIds</string>
            <string name="Source"><![CDATA[-- Roblox audio asset ids (docs/DESIGN.md §9). Every id is 0 until the user uploads the files from assets/audio/
-- (tools/export-audio.sh copies them from the web game; see README "Audio"). An id of 0 means silence for that sound:
-- no Sound instance is created, nothing errors, and Studio prints one note listing the missing keys.
-- The uploads must belong to the same owner (user or group) as the experience, otherwise Roblox blocks them.
-- key = file name without .mp3
return {
	sfx = {
		achievement = 0, -- assets/audio/sfx/achievement.mp3
		alarm = 0,
		bomb = 0,
		boss = 0,
		["break"] = 0,
		buy = 0,
		chest = 0,
		chest_open = 0,
		chestpick = 0,
		click = 0,
		coin = 0,
		dash = 0,
		death = 0,
		deny = 0,
		evolve = 0,
		flask = 0,
		gem = 0,
		heal = 0,
		hit = 0,
		hurt = 0,
		item = 0,
		kill = 0,
		knife = 0,
		levelup = 0,
		magnet = 0,
		nova = 0,
		orbit = 0,
		revive = 0,
		shoot = 0,
		slam = 0,
		slash = 0,
		summon = 0,
		throw = 0,
		zap = 0,
	},
	music = {
		menu = 0, -- assets/audio/music/menu.mp3 (loop)
		battle = 0, -- loop
		boss = 0, -- loop
		victory = 0, -- sting
		gameover = 0, -- sting
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- Cosmetics (docs/DESIGN.md §7.1, §7.4): hero skins (palettes for every hero), weapon effect colours and trails.
-- Visual only. Paid ones are sold as stored developer products (Config/Products.luau, or all of them with the
-- collection pass); free ones are earned by achievements. Pure data + validate() (Lune test cosmetics.spec).
local Cosmetics = {}

export type Cosmetic = {
	id: string,
	slot: string, -- "skin" | "fx" | "trail"
	name: string, -- German text key
	source: string, -- "product:<key>" | "achievement:<id>"
	body: string?, -- skin: main colour
	accent: string?, -- skin: head/trim colour
	colors: { string }?, -- fx: one colour, or several cycled (prism)
	color: string?, -- trail
}

Cosmetics.SLOTS = { "skin", "fx", "trail" }

-- stylua: ignore
local list: { Cosmetic } = {
	{ id = "skin_ashen", slot = "skin", name = "Aschgrau", source = "product:skin_ashen", body = "#8f8a99", accent = "#e2ddd6" },
	{ id = "skin_frost", slot = "skin", name = "Frostglanz", source = "product:skin_frost", body = "#8fdcff", accent = "#effbff" },
	{ id = "skin_nightbloom", slot = "skin", name = "Nachtblüte", source = "product:skin_nightbloom", body = "#8a5cff", accent = "#ffb3f2" },
	{ id = "skin_gilded", slot = "skin", name = "Vergoldet", source = "achievement:stars15", body = "#ffcf4a", accent = "#fff1b8" },
	{ id = "skin_dawn", slot = "skin", name = "Morgenrot", source = "achievement:night", body = "#ffb07a", accent = "#fff0d6" },
	{ id = "fx_emerald", slot = "fx", name = "Smaragd", source = "product:fx_emerald", colors = { "#4dffa6" } },
	{ id = "fx_azure", slot = "fx", name = "Azur", source = "product:fx_azure", colors = { "#5cc4ff" } },
	{ id = "fx_solar", slot = "fx", name = "Sonnenglanz", source = "product:fx_solar", colors = { "#fff09a" } },
	{ id = "fx_prism", slot = "fx", name = "Prisma", source = "product:fx_prism",
		colors = { "#5cc4ff", "#4dffa6", "#fff09a", "#c08cff" } },
	{ id = "trail_frost", slot = "trail", name = "Raureif", source = "product:trail_frost", color = "#bdf2ff" },
	{ id = "trail_star", slot = "trail", name = "Sternenstaub", source = "product:trail_star", color = "#fff3a8" },
	{ id = "trail_shadow", slot = "trail", name = "Schatten", source = "product:trail_shadow", color = "#8a72d6" },
	{ id = "trail_ember", slot = "trail", name = "Glutspur", source = "achievement:win", color = "#ffa040" },
}

Cosmetics.list = list
Cosmetics.byId = {} :: { [string]: Cosmetic }
for _, c in list do
	Cosmetics.byId[c.id] = c
end

-- "#rrggbb" -> r, g, b in 0..1 (nil when malformed)
function Cosmetics.parseHex(s: any): (number?, number?, number?)
	if type(s) ~= "string" or not string.match(s, "^#%x%x%x%x%x%x$") then
		return nil, nil, nil
	end
	local r = tonumber(string.sub(s, 2, 3), 16) :: number
	local g = tonumber(string.sub(s, 4, 5), 16) :: number
	local b = tonumber(string.sub(s, 6, 7), 16) :: number
	return r / 255, g / 255, b / 255
end

-- hue in degrees (0..360), saturation (HSV) and relative luminance (sRGB)
function Cosmetics.hsl(r: number, g: number, b: number): (number, number, number)
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local d = mx - mn
	local h = 0
	if d > 0 then
		if mx == r then
			h = 60 * (((g - b) / d) % 6)
		elseif mx == g then
			h = 60 * ((b - r) / d + 2)
		else
			h = 60 * ((r - g) / d + 4)
		end
	end
	local s = if mx > 0 then d / mx else 0
	local function lin(c: number): number
		return if c <= 0.04045 then c / 12.92 else ((c + 0.055) / 1.055) ^ 2.4
	end
	local lum = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
	return h, s, lum
end

-- readability rules (§7.4): no player effect or trail in the enemy-shot hue family (#ff3d5a, hue ~351°),
-- no skin that is near-black on the darkest ground
Cosmetics.ENEMY_HUE = 351
Cosmetics.HUE_GAP = 25 -- degrees an effect colour must stay away from ENEMY_HUE (when saturated)
Cosmetics.MIN_SKIN_LUM = 0.12 -- relative luminance

local function hueDist(a: number, b: number): number
	local d = math.abs(a - b) % 360
	return math.min(d, 360 - d)
end

-- returns a list of problems (empty when everything is fine); validProducts / validAchievements are id sets
function Cosmetics.validate(validProducts: { [string]: any }?, validAchievements: { [string]: any }?): { string }
	local errs = {}
	local function err(c: Cosmetic, msg: string)
		table.insert(errs, c.id .. ": " .. msg)
	end
	local function effectColor(c: Cosmetic, hex: string?)
		local r, g, b = Cosmetics.parseHex(hex)
		if not r then
			err(c, "bad colour " .. tostring(hex))
			return
		end
		local h, s = Cosmetics.hsl(r, g :: number, b :: number)
		if s > 0.35 and hueDist(h, Cosmetics.ENEMY_HUE) < Cosmetics.HUE_GAP then
			err(c, "colour " .. tostring(hex) .. " looks like an enemy shot")
		end
	end
	local seen = {}
	for _, c in list do
		if seen[c.id] then
			err(c, "duplicate id")
		end
		seen[c.id] = true
		if not table.find(Cosmetics.SLOTS, c.slot) then
			err(c, "bad slot")
		end
		if string.sub(c.id, 1, #c.slot + 1) ~= c.slot .. "_" then
			err(c, "id must start with its slot")
		end
		local kind, ref = string.match(c.source, "^(%a+):(.+)$")
		if kind == "product" then
			if validProducts and not validProducts[ref] then
				err(c, "unknown product " .. tostring(ref))
			end
		elseif kind == "achievement" then
			if validAchievements and not validAchievements[ref] then
				err(c, "unknown achievement " .. tostring(ref))
			end
		else
			err(c, "bad source")
		end
		if c.slot == "skin" then
			for _, hex in { c.body, c.accent } do
				local r, g, b = Cosmetics.parseHex(hex)
				if not r then
					err(c, "bad colour " .. tostring(hex))
				else
					local _, _, lum = Cosmetics.hsl(r, g :: number, b :: number)
					if lum < Cosmetics.MIN_SKIN_LUM then
						err(c, "colour " .. tostring(hex) .. " too dark")
					end
				end
			end
		elseif c.slot == "fx" then
			if type(c.colors) ~= "table" or #c.colors == 0 then
				err(c, "no colours")
			else
				for _, hex in c.colors do
					effectColor(c, hex)
				end
			end
		elseif c.slot == "trail" then
			effectColor(c, c.color)
		end
	end
	return errs
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[-- Robux products and game passes (docs/DESIGN.md §7.1). Pure data + lookups, shared by server and client.
--
-- HOW TO CONFIGURE: create the developer products and game passes in the Creator Hub (experience → Monetization),
-- then paste each id into `id` below and rebuild. An item whose id is 0 is hidden everywhere and the server refuses
-- to prompt or grant it. `price` is only a suggestion for the Creator Hub; the shop always shows the live price from
-- MarketplaceService (fetched by the server).
--
-- kind = "product" (developer product, granted through ProcessReceipt) | "pass" (game pass, ownership checked live)
-- grant (products): gold = n | revive = n (tokens) | cosmetic = cosmetic id (stored, non-consumable)
-- pass effects:     gold2x = true | heroes = { heroId, ... } | allCosmetics = true
-- tab = shop tab ("gold", "heroes", "cosmetics", "passes"); name = German text key (Lang.tr)
local Products = {}

export type Item = {
	key: string,
	kind: string,
	id: number,
	price: number,
	tab: string,
	name: string,
	desc: string,
	grant: { gold: number?, revive: number?, cosmetic: string? }?,
	gold2x: boolean?,
	heroes: { string }?,
	allCosmetics: boolean?,
	order: number,
}

local HERO_PASSES = { "kael", "sela", "brom", "nyx", "eira", "lio", "ignis" }
Products.HERO_PASSES = HERO_PASSES

-- Game pass ids of the seven single-hero passes (pass_hero_<hero>); paste each id here (0 = not on sale)
local HERO_PASS_IDS: { [string]: number } = {
	kael = 0,
	sela = 0,
	brom = 0,
	nyx = 0,
	eira = 0,
	lio = 0,
	ignis = 0,
}

-- stylua: ignore
local list: { Item } = {
	{ key = "revive", kind = "product", id = 0, price = 25, tab = "none", name = "Zweite Glut",
		desc = "Steh mit halber Kraft wieder auf (einmal pro Lauf)", grant = { revive = 1 } },
	{ key = "gold_s", kind = "product", id = 0, price = 49, tab = "gold", name = "Goldbeutel",
		desc = "+{0} Gold", grant = { gold = 1000 } },
	{ key = "gold_m", kind = "product", id = 0, price = 129, tab = "gold", name = "Goldtruhe",
		desc = "+{0} Gold", grant = { gold = 3500 } },
	{ key = "gold_l", kind = "product", id = 0, price = 299, tab = "gold", name = "Goldschatz",
		desc = "+{0} Gold", grant = { gold = 10000 } },
	{ key = "pass_gold2x", kind = "pass", id = 0, price = 199, tab = "passes", name = "Doppeltes Gold",
		desc = "Doppeltes Gold aus jedem Lauf (nicht für Erfolge und gekauftes Gold)", gold2x = true },
	{ key = "pass_heroes_all", kind = "pass", id = 0, price = 399, tab = "heroes", name = "Alle Helden",
		desc = "Schaltet alle sieben Helden frei", heroes = HERO_PASSES },
	{ key = "pass_cosmetics", kind = "pass", id = 0, price = 349, tab = "passes", name = "Sammlung",
		desc = "Alle käuflichen Aussehen, Waffenfarben und Spuren (auch künftige)", allCosmetics = true },
	{ key = "skin_ashen", kind = "product", id = 0, price = 79, tab = "cosmetics", name = "Aussehen: Aschgrau",
		desc = "Farben für alle Helden", grant = { cosmetic = "skin_ashen" } },
	{ key = "skin_frost", kind = "product", id = 0, price = 79, tab = "cosmetics", name = "Aussehen: Frostglanz",
		desc = "Farben für alle Helden", grant = { cosmetic = "skin_frost" } },
	{ key = "skin_nightbloom", kind = "product", id = 0, price = 79, tab = "cosmetics", name = "Aussehen: Nachtblüte",
		desc = "Farben für alle Helden", grant = { cosmetic = "skin_nightbloom" } },
	{ key = "fx_emerald", kind = "product", id = 0, price = 59, tab = "cosmetics", name = "Waffenfarbe: Smaragd",
		desc = "Färbt deine Waffeneffekte", grant = { cosmetic = "fx_emerald" } },
	{ key = "fx_azure", kind = "product", id = 0, price = 59, tab = "cosmetics", name = "Waffenfarbe: Azur",
		desc = "Färbt deine Waffeneffekte", grant = { cosmetic = "fx_azure" } },
	{ key = "fx_solar", kind = "product", id = 0, price = 59, tab = "cosmetics", name = "Waffenfarbe: Sonnenglanz",
		desc = "Färbt deine Waffeneffekte", grant = { cosmetic = "fx_solar" } },
	{ key = "fx_prism", kind = "product", id = 0, price = 99, tab = "cosmetics", name = "Waffenfarbe: Prisma",
		desc = "Wechselnde Farben für deine Waffeneffekte", grant = { cosmetic = "fx_prism" } },
	{ key = "trail_frost", kind = "product", id = 0, price = 49, tab = "cosmetics", name = "Spur: Raureif",
		desc = "Eine Spur hinter deinem Helden", grant = { cosmetic = "trail_frost" } },
	{ key = "trail_star", kind = "product", id = 0, price = 49, tab = "cosmetics", name = "Spur: Sternenstaub",
		desc = "Eine Spur hinter deinem Helden", grant = { cosmetic = "trail_star" } },
	{ key = "trail_shadow", kind = "product", id = 0, price = 49, tab = "cosmetics", name = "Spur: Schatten",
		desc = "Eine Spur hinter deinem Helden", grant = { cosmetic = "trail_shadow" } },
}

-- one pass per hero that is normally earned by an achievement
for i, hid in HERO_PASSES do
	table.insert(
		list,
		6 + i,
		{
			key = "pass_hero_" .. hid,
			kind = "pass",
			id = HERO_PASS_IDS[hid] or 0,
			price = 99,
			tab = "heroes",
			name = "Held freischalten",
			desc = "Schaltet den Helden sofort frei (auch durch seinen Erfolg erreichbar)",
			heroes = { hid },
		} :: any
	)
end

for i, it in list do
	it.order = i
end

Products.list = list
Products.byKey = {} :: { [string]: Item }
for _, it in list do
	Products.byKey[it.key] = it
end

-- the item behind a key when it is configured (id > 0), else nil
function Products.get(key: string): Item?
	local it = Products.byKey[key]
	if it and it.id > 0 then
		return it
	end
	return nil
end

function Products.configured(key: string): boolean
	return Products.get(key) ~= nil
end

-- developer product id -> item (configured products only)
function Products.byProductId(id: number): Item?
	for _, it in list do
		if it.kind == "product" and it.id > 0 and it.id == id then
			return it
		end
	end
	return nil
end

-- game pass id -> item (configured passes only)
function Products.byPassId(id: number): Item?
	for _, it in list do
		if it.kind == "pass" and it.id > 0 and it.id == id then
			return it
		end
	end
	return nil
end

-- the product that sells a cosmetic (nil for free cosmetics)
function Products.forCosmetic(cosmeticId: string): Item?
	for _, it in list do
		if it.grant and it.grant.cosmetic == cosmeticId then
			return it
		end
	end
	return nil
end

-- set ids at runtime (Lune tests only; real ids are written into the list above)
function Products.setIds(ids: { [string]: number })
	for key, id in ids do
		local it = Products.byKey[key]
		assert(it, "unknown product key " .. key)
		it.id = id
	end
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Tuning</string>
            <string name="Source"><![CDATA[--!strict
-- Ember Night: shared constants (docs/DESIGN.md, Appendix A). Pure table, usable from Roblox and Lune.

local Tuning = {
	STUDS_PER_PX = 0.1, -- 1 stud = 10 world px (sim keeps the web game's units)

	SIM_HZ = 30,
	SIM_DT = 1 / 30,
	SIM_SUBSTEPS = 2, -- the sim advances in 2 half steps per 1/30 s tick (the web game runs at ~1/60 s)
	MAX_STEPS_PER_FRAME = 3,
	SNAP_HZ = 15,
	MOVE_HZ = 20,
	MOVE_RATE = 1.08, -- validated network moves: long-run speed margin over the hero's speed
	MOVE_BURST = 0.5, -- s of movement the budget may hold (packet jitter / bunching)
	MOVE_SLACK = 16, -- px of extra slack in the budget
	INTERP_DELAY = 0.133,
	SUBSTEP_PX = 10,

	VIEW_HW = 640,
	VIEW_HH = 360,
	VIEW_TOP = 70,
	INTEREST_HW = 900,
	INTEREST_HH = 620,
	SNAP_ENEMY_CAP = 260,
	SNAP_FAR_EVERY = 1,
	UR_MAX_BYTES = 900,

	ENEMY_CAP_TOTAL = 450,
	PLAYER_SHOT_CAP = 400,
	GEM_CAP = 320,
	PICKUP_CAP = 120,

	MAX_PLAYERS = 4,
	LEASH_RADIUS = 900,
	WARD_TIME = 1.5,
	WARD_RADIUS = 120,
	WARD_COOLDOWN = 6,
	AUTO_PICK_TIME = 15,
	BLEED_OUT = 30,
	REVIVE_RADIUS = 70,
	REVIVE_TIME = 3,
	REVIVE_TIME_STEP = 1,
	REVIVE_TIME_MAX = 6,
	REVIVE_MAX_PER_RUN = 1,
	LAST_CHANCE_TIME = 10,
	VOTE_TIME = 20,
	START_COUNTDOWN = 5,

	CAM_PITCH = 58,
	CAM_FOV = 40,
	CAM_DIST = 100,
	CAM_AIM_SOUTH = 3, -- studs the camera aims south of the hero (perspective: 519 px visible north, 376 south)
	HUB_ORIGIN = { 0, 2000, 0 }, -- studs (x, y, z); plain numbers so the module stays Instance-free

	LOCK_STALE = 1800,
	AUTOSAVE = 60,
	FORCE_MEMORY_STORE = false,
}

return Tuning
]]></string>
          </Properties>
        </Item>
      </Item>
