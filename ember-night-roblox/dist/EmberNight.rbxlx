          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Story</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/port-data.js from glutnacht/js/*.js – do not edit by hand; re-run the generator.
-- Story texts (German keys; translate with Lang.tr).

return {
	premise = "Die Nacht verschlingt die Welt, Land um Land. Nur noch eine Handvoll Helden hütet die Glut. Trag sie durch fünf finstere Länder und hol den Morgen zurück.",
	ending = "In fünf Ländern glimmt wieder Glut. Der Himmel wird grau, dann golden. Irgendwann kehrt die Nacht zurück – doch nun weiß wieder jemand, wie man ein Feuer entfacht.",
	PREMISE_SHORT = "Trag die letzte Glut durch die Nacht und hol den Morgen zurück.",
	TIPS = { "Jede Waffe auf Stufe 8 plus ihr passiver Partner – dann entwickelt sie sich in der nächsten Truhe.", "Elitegegner (goldener Schein) tragen Truhen. Bosse auch.", "Kohlebecken auf der Karte zerschlagen: Gold, Herzen, Magnete und Bomben.", "Gold bleibt nach dem Tod erhalten – in der Schmiede wirst du dauerhaft stärker.", "Rote Flächen am Boden: Der Boss holt zum Schlag oder Sturmangriff aus. Raus da!", "Der Magnet zieht alle Edelsteine auf der Karte zu dir.", "Bei „Umzingelt!“ nicht warten – brich früh durch eine Lücke.", "Glück erhöht die Chance auf eine vierte Karte und auf große Truhen.", "Verbannen entfernt eine neue Waffe oder ein Passiv für den Rest des Laufs.", "Siege schalten Nachtstufen frei: härter, aber deutlich mehr Gold." },
}
]]></string>
            </Properties>
          </Item>
