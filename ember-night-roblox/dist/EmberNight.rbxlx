        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Director</string>
            <string name="Source"><![CDATA[--!native
-- Spawning: waves, elites, bosses, events, endless mode (web director, spawnPos, spawnEnemy, spawnBoss, runEvent).
-- Co-op: spawns around an anchor player chosen round-robin among the active players (docs/DESIGN.md §2.6, §2.7).
local K = if script then require(script.Parent.K) else require("./K")
local Enemies = if script then require(script.Parent.Data.Enemies) else require("./Data/Enemies")
local Heat = if script then require(script.Parent.Data.Heat) else require("./Data/Heat")
local Curves = if script then require(script.Parent.Curves) else require("./Curves")
local Coop = if script then require(script.Parent.Coop) else require("./Coop")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Director = {}

local TAU, DEG = Util.TAU, Util.DEG
local EDEF = Enemies.byId
local EARLY_SPEED = 0.2
local round = Util.round
local VIEW_HW, VIEW_HH = Tuning.VIEW_HW, Tuning.VIEW_HH

function K.wave(run)
	local m = math.floor(run.t / 60)
	local w = run.stage.waves
	return w[math.min(m + 1, #w)]
end

function K.hpMul(run, t: number): number
	local st = run.stage
	local m = t / 60
	local c = if st.hpBridge and run.heat < 3 then Curves.hpCurveBridged(m) else Curves.hpCurve(m)
	return run.heatDef.hp * st.mult.hp * c
end

-- ranged enemies appear from rangedFrom and at most rangedCap at once
function K.pickType(run, wv): string
	local ent = wv.pool
	if run.t < (run.stage.rangedFrom or 0) then
		local f = {}
		for _, e in ent do
			if not EDEF[e.k].ranged then
				f[#f + 1] = e
			end
		end
		ent = f
	end
	local k = run.rng:weighted(ent)
	if EDEF[k].ranged and run.rangedAlive >= K.rangedCap(run) then
		local melee = {}
		for _, e in ent do
			if not EDEF[e.k].ranged then
				melee[#melee + 1] = e
			end
		end
		if #melee > 0 then
			k = run.rng:weighted(melee)
		end
	end
	return k
end

function K.rangedCap(run): number
	return round(math.min(3 + math.floor(run.t / 60), 14) * run.heatDef.rate * Coop.f(Coop.rangedCap, run.nPlayers))
end

function K.cdMul(run): number
	return math.max(0.75, 1 - 0.025 * math.floor(run.t / 60)) * (1 - 0.04 * run.heat) * (run.stage.rangedCd or 1)
end

function K.eSpeed(run, base: number, cap: number): number
	return math.min(cap, base * run.heatDef.speed)
end

-- volley director: how many enemies may wind up at the same time and how close after each other
function K.canWind(run, e): boolean
	local v = run.vol
	local m = math.floor(run.t / 60)
	local max = if m < 2 then 3 elseif m < 6 then 5 else 7
	local gap = if m < 2 then 0.3 elseif m < 6 then 0.2 else 0.14
	if run.heat >= 3 then
		max += 1
	end
	max += Coop.f(Coop.windMax, run.nPlayers)
	if v.active >= max or run.t - v.lastStart < gap then
		return false
	end
	if e.rk == "ring" and v.bells >= 2 then
		return false
	end
	return true
end

-- next anchor player (round robin over active players)
function K.anchor(run)
	local act = run.act
	if #act == 0 then
		return run.plist[1]
	end
	run.anchorI = run.anchorI % #act + 1
	return act[run.anchorI]
end

-- random point on the edge of the anchor's view + 50 px, preferring his walking direction; retries when the point
-- is inside another active player's view
function K.spawnPos(run, p): (number, number)
	local rng = run.rng
	local hw, hh = VIEW_HW + 50, VIEW_HH + 50
	local x, y = 0, 0
	for try = 1, 5 do
		local side
		if p.moving and rng:next() < 0.45 then
			if math.abs(p.dirX) > math.abs(p.dirY) then
				side = if p.dirX > 0 then 1 else 3
			else
				side = if p.dirY > 0 then 2 else 0
			end
		else
			side = rng:int(0, 3)
		end
		if side == 0 then
			x, y = rng:range(-hw, hw), -hh
		elseif side == 1 then
			x, y = hw, rng:range(-hh, hh)
		elseif side == 2 then
			x, y = rng:range(-hw, hw), hh
		else
			x, y = -hw, rng:range(-hh, hh)
		end
		x += p.x
		y += p.y
		if #run.act <= 1 or try == 5 or not K.inAnyView(run, x, y, p) then
			break
		end
	end
	return x, y
end

function K.spawnEnemy(run, etype: string, x: number, y: number)
	local d = EDEF[etype]
	local heat = run.heatDef
	local rng = run.rng
	local mods = run.stage.mods or {}
	local ma, mt = mods.all or {}, mods[etype] or {}
	local hp = d.hp * K.hpMul(run, run.t) * (ma.hp or 1) * (mt.hp or 1) * Coop.f(Coop.enemyHp, run.nPlayers)
	local early = if d.speed < 90 then 1 + EARLY_SPEED * math.max(0, 1 - run.t / 180) else 1
	local id = run.nextId
	run.nextId = if id >= 65535 then 1 else id + 1
	local e = {
		id = id,
		type = etype,
		x = x,
		y = y,
		r = d.r,
		hp = hp,
		maxHp = hp,
		speed = d.speed * heat.speed * (ma.speed or 1) * (mt.speed or 1) * rng:range(0.92, 1.08) * early,
		dmg = d.dmg * heat.dmg * run.stage.mult.dmg * (1 + run.t / 60 * 0.07),
		tint = run.stage.tints and run.stage.tints[etype] or nil,
		xp = d.xp * (ma.xp or 1) * (mt.xp or 1),
		kb = d.kb,
		kx = 0,
		ky = 0,
		flash = 0,
		slowT = 0,
		slowF = 1,
		freezeT = 0,
		elite = false,
		boss = nil,
		swarm = false,
		dead = false,
		hitOrbit = {},
		anim = rng:next() * 10,
		shootT = rng:range(1.5, 3),
		ranged = d.ranged ~= nil,
		rk = d.ranged,
		windT = 0,
		windMax = 0,
		windStart = -1,
		side = if rng:next() < 0.5 then -1 else 1,
		flitT = rng:range(0, 1.2),
		flitD = 0,
		fadeT = 0,
		teles = nil,
		pend = nil,
		life = 0,
		sdx = 0,
		sdy = 0,
		skillT = 0,
		skillIdx = 0,
		mode = "chase",
		modeT = 0,
		cast = nil,
		dashA = 0,
		tgt = nil,
		lastHit = 0,
		face = 1,
	}
	local en = run.enemies
	en[#en + 1] = e
	run.nonBoss += 1
	return e
end

function K.spawnBoss(run, def, mult: number)
	local anchor = K.anchor(run)
	local x, y = K.spawnPos(run, anchor)
	local sprite = if EDEF[def.sprite] then def.sprite else "golem"
	local e = K.spawnEnemy(run, sprite, x, y)
	run.nonBoss -= 1
	local heat = run.heatDef
	e.boss = def
	e.type = def.sprite
	e.tint = def.tint
	e.hp = def.hp * (1 + (heat.hp - 1) * 0.6) * mult * Coop.f(Coop.bossHp, run.nPlayers)
	e.maxHp = e.hp
	e.r = def.r
	e.speed = def.speed * heat.speed
	e.dmg = def.dmg * heat.dmg * run.stage.mult.dmg * (if mult > 1 then 1 + mult * 0.15 else 1)
	e.xp = def.xp
	e.kb = 0.05
	e.skillT = 3
	e.skillIdx = 0
	e.mode = "chase"
	e.modeT = 0
	e.tgt = anchor
	table.insert(run.bosses, e)
	K.banner(run, "{0} erscheint!", "boss", nil, nil, nil, { def.name })
	K.ev(run, { k = "boss", id = e.id, name = def.name, final = def.final == true })
	K.sfx(run, "boss")
	K.shake(run, 10)
	return e
end

-- enemy types of an event: type x n or mix (evenly interleaved: always the type with the largest remaining share)
function K.evTypes(run, ev): { string }
	local f = Coop.f(Coop.eventCount, run.nPlayers)
	if not ev.mix then
		local n = if ev.kind == "arc" then ev.n else round(ev.n * f)
		local out = table.create(n, ev.type)
		return out
	end
	local left, want = {}, {}
	local total = 0
	for _, e in ev.mix do
		local c = round(e.w * f)
		left[e.k] = c
		want[e.k] = c
		total += c
	end
	local out = {}
	for _ = 1, total do
		local best, bs = nil, -1
		for _, e in ev.mix do
			local k = e.k
			if left[k] > 0 then
				local sc = left[k] / want[k]
				if sc > bs then
					bs = sc
					best = k
				end
			end
		end
		out[#out + 1] = best
		left[best] -= 1
	end
	return out
end

local function capOk(run): boolean
	return run.nonBoss < Tuning.ENEMY_CAP_TOTAL
end

function K.runEvent(run, ev)
	local p = K.randomActive(run)
	if not p then
		return
	end
	local rng = run.rng
	K.banner(run, ev.text, "event")
	if not ev.quiet then
		K.sfx(run, "alarm")
	end
	local vr = K.viewRadius()
	local sg = ev.surge or (if ev.xp and run.heat < 3 then { xp = ev.xp, speed = 1 } else nil)
	if ev.kind == "swarm" then
		local a = rng:range(0, TAU)
		local ca, sa = math.cos(a), math.sin(a)
		local cx, cy = p.x - ca * (vr + 60), p.y - sa * (vr + 60)
		local n = round(ev.n * Coop.f(Coop.eventCount, run.nPlayers))
		for _ = 1, n do
			local off, back = rng:range(-260, 260), rng:range(0, 200)
			if not capOk(run) then
				break
			end
			local e = K.spawnEnemy(run, ev.type, cx - sa * off - ca * back, cy + ca * off - sa * back)
			if sg then
				e.xp *= sg.xp
				e.speed *= sg.speed
			end
			e.swarm = true
			e.sdx = ca
			e.sdy = sa
			e.speed *= 1.35
			e.life = (vr * 2 + 500) / e.speed
		end
	elseif ev.kind == "arc" then
		local types = K.evTypes(run, ev)
		local n = #types
		local mv = if p.moving then math.atan2(p.dirY, p.dirX) else rng:range(0, TAU)
		for i = 1, n do
			if not capOk(run) then
				break
			end
			local a = mv + (if n > 1 then (i - 1) / (n - 1) - 0.5 else 0) * 120 * DEG
			local R = 0.8 * K.edgeDist(a)
			local e = K.spawnEnemy(run, types[i], p.x + math.cos(a) * R, p.y + math.sin(a) * R)
			if sg then
				e.xp *= sg.xp
				e.speed *= sg.speed
			end
			e.shootT = rng:range(1.6, 2.4)
			e.fadeT = 0.4
			e.tgt = p
			K.ev(run, { k = "burst", x = e.x, y = e.y, color = "#ff3d5a", n = 6 })
		end
	else
		local types = K.evTypes(run, ev)
		local n = #types
		for i = 1, n do
			if not capOk(run) then
				break
			end
			local a = (i - 1) / n * TAU
			local R = if ev.mix then 0.95 * K.edgeDist(a) else vr * 0.85
			local e = K.spawnEnemy(run, types[i], p.x + math.cos(a) * R, p.y + math.sin(a) * R)
			if sg then
				e.xp *= sg.xp
				e.speed *= sg.speed
			end
			e.tgt = p
			if e.ranged then
				e.shootT = rng:range(1.6, 2.6)
			end
		end
	end
end

-- a small group in view right at the start (melee only), around the first player
function K.openingGroup(run)
	local p = run.plist[1]
	local wv = K.wave(run)
	local rng = run.rng
	local n = 6
	local melee = {}
	for _, e in wv.pool do
		if not EDEF[e.k].ranged then
			melee[#melee + 1] = e
		end
	end
	local a0 = rng:range(0, TAU)
	for i = 0, n - 1 do
		local a, k = a0 + i / n * TAU, rng:range(0.62, 0.82)
		local j = 0
		while j < 12 and Util.hypot(math.cos(a) * VIEW_HW, math.sin(a) * VIEW_HH) * k < 230 do
			a = rng:range(0, TAU)
			j += 1
		end
		K.spawnEnemy(run, rng:weighted(melee), p.x + math.cos(a) * VIEW_HW * k, p.y + math.sin(a) * VIEW_HH * k)
	end
end

function K.director(run, dt: number)
	local rng = run.rng
	K.countdownTick(run)
	local heat = run.heatDef
	local wv = K.wave(run)
	local N = run.nPlayers
	local extra = if run.t > run.length then 1 + (run.t - run.length) / 120 else 1
	local rate = wv.rate * heat.rate * run.stage.mult.rate * extra * Coop.f(Coop.spawnRate, N)
	local cap = round(wv.cap * math.min(1.6, heat.rate) * math.min(extra, 1.5))
	cap = round(cap * Coop.f(Coop.spawnCap, N))
	local sc = K.surgeNow(run)
	local surge = sc and sc.s
	local wvUse = wv
	if surge then
		local k = if run.heat >= 3 then 0.7 else 1
		rate *= 1 + (surge.rate - 1) * k
		cap = round(cap * (1 + (surge.cap - 1) * k))
		wvUse = run.surgeWave or wv
	end
	local alive = 0
	for _, e in run.enemies do
		if not e.swarm and not e.boss and not e.dead then
			alive += 1
		end
	end
	if alive < cap * 0.35 then
		rate *= 2.2
	end
	for _, b in run.bosses do
		if b.boss.final and not b.dead then
			rate *= 0.6
			break
		end
	end
	run.spawnAcc += rate * dt
	while run.spawnAcc >= 1 do
		run.spawnAcc -= 1
		if alive >= cap or not capOk(run) then
			run.spawnAcc = 0
			break
		end
		local anchor = K.anchor(run)
		local x, y = K.spawnPos(run, anchor)
		local e = K.spawnEnemy(run, K.pickType(run, wvUse), x, y)
		e.tgt = anchor
		if surge then
			e.xp *= run.surgeK.xp
			e.speed *= run.surgeK.speed
		elseif wv.xp and run.heat < 3 then
			e.xp *= wv.xp
		end
		alive += 1
	end

	-- elite
	run.eliteT -= dt
	if run.eliteT <= 0 and #run.act > 0 then
		run.eliteT = 60
		local first = run.t < 60
		run.eliteN += 1
		local pool
		if first then
			local best, bs = nil, -1
			for _, e in wv.pool do
				local d = EDEF[e.k]
				if not d.ranged and d.speed > bs then
					bs = d.speed
					best = e.k
				end
			end
			pool = { { k = best, w = 1 } }
		else
			local rk = {}
			if run.t >= 180 and run.eliteN % 2 == 0 then
				for _, e in wv.pool do
					if EDEF[e.k].ranged then
						rk[#rk + 1] = { k = e.k, w = e.w }
					end
				end
			end
			if #rk > 0 then
				pool = rk
			else
				pool = {}
				for _, e in wv.pool do
					pool[#pool + 1] = { k = e.k, w = e.w * EDEF[e.k].hp }
				end
			end
		end
		local ref = K.randomActive(run)
		local a = rng:range(-math.pi / 6, math.pi * 7 / 6)
		local x, y
		if first then
			x, y = ref.x + math.cos(a) * VIEW_HW * 0.6, ref.y + math.sin(a) * VIEW_HH * 0.6
		else
			ref = K.anchor(run)
			x, y = K.spawnPos(run, ref)
		end
		local e = K.spawnEnemy(run, rng:weighted(pool), x, y)
		e.tgt = ref
		e.elite = true
		local raw = e.maxHp / Coop.f(Coop.enemyHp, N)
		e.hp = (if first then math.max(90, raw * 3) else math.max(160, raw * 14)) * Coop.f(Coop.eliteHp, N)
		e.maxHp = e.hp
		e.r *= 1.55
		e.xp *= 8
		e.kb *= 0.3
		e.dmg *= 1.4
		e.speed = if first then math.max(e.speed, ref.stats.speed * 0.9) else e.speed * 0.95
		local cd = run.cdList[run.cdIdx]
		if cd and cd.kind == "surge" and math.abs(run.t - cd.start) < 2 then
			run.eliteBanT = cd.start + 3.2
		else
			K.banner(run, "Ein Elitegegner taucht auf – er trägt eine Truhe!", "elite")
		end
	end
	if run.eliteBanT > 0 and run.t >= run.eliteBanT then
		run.eliteBanT = 0
		K.banner(run, "Ein Elitegegner taucht auf – er trägt eine Truhe!", "elite")
	end

	-- bosses
	local bl = run.bossList
	if run.bossIdx <= #bl and run.t >= bl[run.bossIdx].t then
		K.spawnBoss(run, bl[run.bossIdx], 1)
		run.bossIdx += 1
	end
	if run.endless then
		run.endlessBossT -= dt
		if run.endlessBossT <= 0 then
			run.endlessBossT = 120
			local k = 1 + (run.t - run.length) / 120
			local pool = {}
			for _, b in bl do
				if not b.final then
					pool[#pool + 1] = b
				end
			end
			local src = rng:pick(if #pool > 0 then pool else bl)
			local def = table.clone(src)
			def.final = false
			K.spawnBoss(run, def, 1.5 + k)
		end
	end

	-- events
	local ev = run.stage.events
	while run.eventIdx <= #ev and run.t >= ev[run.eventIdx].t do
		K.runEvent(run, ev[run.eventIdx])
		run.eventIdx += 1
	end
end

Director.Heat = Heat
return Director
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Enemies</string>
            <string name="Source"><![CDATA[--!native
-- Enemy movement and ranged AI (web updateEnemies, rangedAI, capOK, leadAim, startWind, endWind, releaseWind,
-- pendStep, enemyShot). Co-op: every enemy chases its target player (nearest active, re-evaluated every 0.5 s with
-- hysteresis), touches any active player, relocates when far from all active players (docs/DESIGN.md §2.7).
local K = if script then require(script.Parent.K) else require("./K")
local Enemies = if script then require(script.Parent.Data.Enemies) else require("./Data/Enemies")
local Coop = if script then require(script.Parent.Coop) else require("./Coop")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local EnemiesMod = {}

local EDEF = Enemies.byId
local TAU, DEG = Util.TAU, Util.DEG
local sqrt, exp, atan2, cos, sin = math.sqrt, math.exp, math.atan2, math.cos, math.sin
local WARD_RADIUS = Tuning.WARD_RADIUS

function K.eshotCap(run): number
	return Coop.f(Coop.eshotCap, run.nPlayers)
end
function K.eshotCapBoss(run): number
	return Coop.f(Coop.eshotCapBoss, run.nPlayers)
end
function K.teleCap(run): number
	return Coop.f(Coop.teleCap, run.nPlayers)
end

-- ---------- telegraphs and enemy shots (with ids and replication events) ----------
function K.addTele(run, tl)
	tl.id = K.oid(run)
	local tele = run.tele
	tele[#tele + 1] = tl
	K.ev(run, { k = "tele+", tl = tl })
end

function K.enemyShot(run, x, y, dx, dy, speed, dmg, rad, life, kind, src)
	local s = {
		id = K.oid(run),
		x = x,
		y = y,
		vx = dx * speed,
		vy = dy * speed,
		dmg = dmg,
		r = rad,
		life = life or 3.5,
		kind = kind or "orb",
		src = src or "shot",
	}
	local es = run.eshots
	es[#es + 1] = s
	K.ev(run, { k = "eshot+", s = s })
	return s
end

-- aim with lead: target position + velocity x lead x flight time
function K.leadAim(p, x: number, y: number, lead: number, spd: number): number
	if lead == 0 then
		return atan2(p.y - y, p.x - x)
	end
	local tt = Util.hypot(p.x - x, p.y - y) / spd
	return atan2(p.y + p.vy * lead * tt - y, p.x + p.vx * lead * tt - x)
end

function K.aimShots(tl)
	if tl.shots then
		for _, sh in tl.shots do
			sh.a = tl.a + sh.o
		end
	end
end

-- does the whole volley still fit under the caps?
function K.capOK(run, e): boolean
	local el = e.elite
	local rk = e.rk
	local n, nt
	if rk == "spit" then
		n = if el then 5 elseif run.t >= 240 then 3 else 1
		nt = 1
	elseif rk == "needle" then
		n = if el then 3 else 1
		nt = if el then 3 else 1
	elseif rk == "ring" then
		n = if el then 36 else 20
		nt = 1
	else
		n = 0
		nt = if el then 3 else 1
	end
	return #run.eshots + n <= K.eshotCap(run) and #run.tele + nt <= K.teleCap(run)
end

function K.startWind(run, e, p)
	local def = EDEF[e.type]
	local rng = run.rng
	e.windT = def.wind
	e.windMax = def.wind
	e.windStart = run.t
	local v = run.vol
	v.active += 1
	v.lastStart = run.t
	if e.rk == "ring" then
		v.bells += 1
	end
	K.sfx(run, "ewind", e.x, e.y)
	local el = e.elite
	local function base(tl)
		tl.follow = e
		tl.own = e
		tl.ws = run.t
		tl.x = e.x
		tl.y = e.y
		tl.t = 0
		tl.life = def.wind
		tl.target = p
		return tl
	end
	e.teles = {}
	if e.rk == "spit" then
		local n = if el then 5 elseif run.t >= 240 then 3 else 1
		local step = (if el then 14 else 16) * DEG
		local spd = K.eSpeed(run, 170, 210)
		local offs = {}
		for i = 0, n - 1 do
			offs[#offs + 1] = (i - (n - 1) / 2) * step
		end
		local dmg = e.dmg * (if n > 1 and not el then 0.8 elseif el then 0.8 else 1)
		local shots = {}
		for _, o in offs do
			shots[#shots + 1] = { a = 0, o = o, spd = spd, r = 7, dmg = dmg, life = 3.5 }
		end
		local tl = base({
			kind = "charge",
			wedge = 90,
			a = K.leadAim(p, e.x, e.y, 0, spd),
			lockAt = def.wind - 0.15,
			lead = 0,
			spd = spd,
			offs = offs,
			sr = e.r * 0.6,
			shots = shots,
		})
		K.aimShots(tl)
		table.insert(e.teles, tl)
	elseif e.rk == "needle" then
		local spd = K.eSpeed(run, 460, 520)
		local os = if el then { -10 * DEG, 0, 10 * DEG } else { 0 }
		for _, o in os do
			table.insert(
				e.teles,
				base({
					kind = "aim",
					len = 700,
					lockAt = 0.6,
					lead = 0.5,
					spd = spd,
					o = o,
					a = K.leadAim(p, e.x, e.y, 0.5, spd) + o,
					hr = 6,
					dmg = e.dmg * 0.8,
				})
			)
		end
	elseif e.rk == "ring" then
		local n = if el then 12 else 10
		local rings = if el then 3 else 2
		local off = rng:range(0, TAU)
		local step = TAU / n
		local spd = K.eSpeed(run, 110, 210)
		local shots = {}
		for k = 0, rings - 1 do
			local add = if k == 1 then 0.5 elseif k == 2 then 0.25 else 0
			for i = 0, n - 1 do
				shots[#shots + 1] =
					{ a = off + (i + add) * step, spd = spd, r = 8, dmg = e.dmg * 0.6, life = 4.0, d = k * 0.3 }
			end
		end
		table.insert(e.teles, base({ kind = "charge", ring = true, sr = e.r + 18, shots = shots }))
	end
	for _, tl in e.teles do
		K.addTele(run, tl)
	end
end

function K.endWind(_run, e)
	e.windT = 0
	e.windStart = -1
	if e.teles then
		for _, tl in e.teles do
			tl.dead = true
		end
		e.teles = nil
	end
end

function K.releaseWind(run, e)
	local rng = run.rng
	local teles = e.teles or {}
	local def = EDEF[e.type]
	K.sfx(run, "efire", e.x, e.y)
	e.shootT = rng:range(def.cd[1], def.cd[2]) * K.cdMul(run)
	if e.rk == "spit" or e.rk == "ring" then
		local tl = teles[1]
		if tl then
			local later = nil
			for _, sh in tl.shots do
				local sx, sy = e.x + cos(sh.a) * tl.sr, e.y + sin(sh.a) * tl.sr
				if sh.d and sh.d > 0 then
					later = later or {}
					table.insert(later, { t = sh.d, sh = sh })
				else
					K.enemyShot(
						run,
						sx,
						sy,
						cos(sh.a),
						sin(sh.a),
						sh.spd,
						sh.dmg,
						sh.r,
						sh.life,
						nil,
						if e.rk == "ring" then "ring" else "shot"
					)
				end
			end
			if later then
				e.pend = later
			end
		end
	elseif e.rk == "needle" then
		for _, tl in teles do
			K.enemyShot(
				run,
				e.x + cos(tl.a) * e.r,
				e.y + sin(tl.a) * e.r,
				cos(tl.a),
				sin(tl.a),
				tl.spd,
				tl.dmg,
				tl.hr,
				1.6,
				"needle",
				"needle"
			)
		end
	elseif e.rk == "mortar" then
		local p = e.tgt
		if p then
			local fl = 1.1
			local sa, sc = rng:range(0, TAU), rng:range(0, 30)
			local tx, ty =
				K.clampView(p, p.x + p.vx * 0.6 * fl + cos(sa) * sc, p.y + p.vy * 0.6 * fl + sin(sa) * sc, 20)
			local pts = { { tx, ty } }
			if e.elite then
				pts = {}
				for i = 0, 2 do
					local a = -math.pi / 2 + i * TAU / 3
					local qx, qy = K.clampView(p, tx + cos(a) * 40.4, ty + sin(a) * 40.4, 20)
					table.insert(pts, { qx, qy })
				end
			end
			for _, q in pts do
				K.addTele(run, {
					kind = "circle",
					x = q[1],
					y = q[2],
					rad = 40,
					t = 0,
					life = fl,
					dmg = e.dmg,
					src = "mortar",
					onImpact = "ember",
					pdmg = e.dmg * 0.45,
					coalX = e.x,
					coalY = e.y - e.r * 0.7,
					small = true,
				})
			end
		end
	end
	K.endWind(run, e)
end

-- delayed second/third bell rings
function K.pendStep(run, e, dt: number)
	local pd = e.pend
	for i = #pd, 1, -1 do
		local q = pd[i]
		q.t -= dt
		if q.t <= 0 then
			local sh = q.sh
			local sr = e.r + 18
			if #run.eshots < K.eshotCapBoss(run) then
				K.enemyShot(
					run,
					e.x + cos(sh.a) * sr,
					e.y + sin(sh.a) * sr,
					cos(sh.a),
					sin(sh.a),
					sh.spd,
					sh.dmg,
					sh.r,
					sh.life,
					nil,
					"ring"
				)
			end
			table.remove(pd, i)
		end
	end
	if #pd == 0 then
		e.pend = nil
	end
end

-- ranged movement: keep distance D (band, but inside the view), retreat below, approach above, strafe between.
local function rangedAI(run, e, p, dx, dy, d, dt): (number, number)
	local def = EDEF[e.type]
	local rng = run.rng
	local sp = e.speed * e.slowF
	local ux, uy = dx / d, dy / d
	if e.pend then
		K.pendStep(run, e, dt)
	end
	if e.windT > 0 then
		if not (e.freezeT > 0) then
			e.windT -= dt * e.slowF
			if e.windT <= 0 then
				K.releaseWind(run, e)
			end
		end
		return 0, 0
	end
	local kEdge = if e.rk == "needle" then 0.85 else 0.8
	local D = math.min(def.band[2] - 30, kEdge * K.edgeDist(atan2(-dy, -dx)))
	local retreat = if e.elite then 0 else def.retreat
	local dir = 0
	if d < D - 40 then
		dir = -retreat
	elseif d > D + 40 then
		dir = 1
	end
	if rng:next() < dt * 0.25 then
		e.side = -e.side
	end
	local st = def.strafe * e.side
	if e.rk == "needle" then
		e.flitT -= dt
		if e.flitT <= 0 then
			e.flitT = 1.2
			e.flitD = 0.25
			e.side = if rng:next() < 0.5 then -1 else 1
		end
		if e.flitD > 0 then
			e.flitD -= dt
			st = 1.4 * e.side
		end
	end
	local ox, oy = ux * sp * dir - uy * sp * st, uy * sp * dir + ux * sp * st
	if e.freezeT > 0 then
		return ox, oy
	end
	e.shootT -= dt * e.slowF
	if e.shootT <= 0 then
		if d < def.band[2] + 120 and K.inViewRect(p, e.x, e.y, 24, 12) and K.canWind(run, e) and K.capOK(run, e) then
			K.startWind(run, e, p)
		else
			e.shootT = 0.3
		end
	end
	return ox, oy
end

-- choose / refresh the target of a non-boss enemy (nearest active player, 15 % hysteresis, every 0.5 s staggered)
local function retarget(run, e)
	local cur = e.tgt
	if cur and cur.state == "active" and (run.tick + e.id) % run.retargetPeriod ~= 0 then
		return cur
	end
	local best, bd = K.nearestActive(run, e.x, e.y)
	if cur and cur.state == "active" and best ~= cur then
		local cx, cy = cur.x - e.x, cur.y - e.y
		local cd2 = cx * cx + cy * cy
		-- new target must be 15 % closer (distance), i.e. 0.7225 in squared distance
		if bd > cd2 * 0.7225 then
			best = cur
		end
	end
	e.tgt = best
	return best
end

function K.updateEnemies(run, dt: number)
	local act = run.act
	if #act == 0 then
		return
	end
	local g = run.grid
	local near = run.qbufs[1]
	local reloc = K.viewRadius() * 1.5 + 100
	local reloc2 = reloc * reloc
	local decay = exp(-9 * dt)
	local nact, bells, ra, nonBoss = 0, 0, 0, 0
	for _, e in run.enemies do
		if not e.dead then
			if e.windT > 0 or (e.boss and e.mode == "cast") then
				nact += 1
				if e.rk == "ring" then
					bells += 1
				end
			end
			if e.ranged and not e.boss then
				ra += 1
			end
			if not e.boss then
				nonBoss += 1
			end
		end
	end
	run.vol.active = nact
	run.vol.bells = bells
	run.rangedAlive = ra
	run.nonBoss = nonBoss
	local wards = run.wardList
	local enemies = run.enemies
	-- like the web game's for-of loop, enemies spawned during the loop (boss summons) are updated in this step too
	local ei = 0
	while ei < #enemies do
		ei += 1
		local e = enemies[ei]
		if #act == 0 then
			break -- the last active player went down during this loop
		end
		if e.dead then
			continue
		end
		e.anim += dt
		if e.fadeT > 0 then
			e.fadeT -= dt
		end
		if e.flash > 0 then
			e.flash -= dt
		end
		if e.slowT > 0 then
			e.slowT -= dt
			if e.slowT <= 0 then
				e.slowF = 1
			end
		end
		local p
		if e.boss then
			p = e.tgt
			if not p or p.state ~= "active" then
				p = K.nearestActive(run, e.x, e.y)
				e.tgt = p
			end
		else
			p = retarget(run, e)
		end
		local mx, my = 0, 0
		local dx, dy = p.x - e.x, p.y - e.y
		local d = sqrt(dx * dx + dy * dy)
		if d == 0 then
			d = 1
		end
		if e.swarm then
			e.life -= dt * e.slowF
			if e.life <= 0 then
				e.dead = true
				K.ev(run, { k = "despawn", id = e.id })
				continue
			end
			mx, my = e.sdx * e.speed * e.slowF, e.sdy * e.speed * e.slowF
		elseif e.boss then
			mx, my = K.bossAI(run, e, p, dx, dy, d, dt)
		else
			local sp = e.speed * e.slowF
			if e.rk then
				mx, my = rangedAI(run, e, p, dx, dy, d, dt)
			else
				mx, my = dx / d * sp, dy / d * sp
			end
		end
		if dx < -1 then
			e.face = -1
		elseif dx > 1 then
			e.face = 1
		end
		if e.freezeT > 0 then
			e.freezeT -= dt
			mx, my = 0, 0
			if e.windT > 0 and not e.boss then
				K.endWind(run, e)
				e.shootT = 1.0
			end
		end
		-- co-op ember ward: slow within 200 px, push outward within WARD_RADIUS
		if #wards > 0 and not e.boss then
			for _, w in wards do
				local wx, wy = e.x - w.x, e.y - w.y
				local wd2 = wx * wx + wy * wy
				if wd2 < 40000 then
					mx *= 0.5
					my *= 0.5
					if wd2 < WARD_RADIUS * WARD_RADIUS then
						local wd = sqrt(wd2)
						if wd < 0.01 then
							wx, wy, wd = 1, 0, 1
						end
						mx += wx / wd * 300
						my += wy / wd * 300
					end
				end
			end
		end
		-- separation
		if not e.swarm then
			g:query(e.x, e.y, e.r + 30, near)
			local sx, sy = 0, 0
			for i = 1, #near do
				local o = near[i]
				if o ~= e and not o.dead and not o.swarm then
					local ox, oy = e.x - o.x, e.y - o.y
					local rr = e.r + o.r
					local d2 = ox * ox + oy * oy
					if d2 < rr * rr and d2 > 0.01 then
						local dd = sqrt(d2)
						local push = (rr - dd) / rr
						local w = if e.boss then 0.1 elseif o.boss then 3 else 1
						sx += ox / dd * push * w
						sy += oy / dd * push * w
					end
				end
			end
			mx += sx * 90
			my += sy * 90
		end
		local ex0, ey0 = e.x, e.y
		e.x += (mx + e.kx) * dt
		e.y += (my + e.ky) * dt
		e.kx *= decay
		e.ky *= decay

		-- too far from every active player: relocate
		if not e.swarm and d > reloc then
			local far = true
			if #act > 1 then
				for _, q in act do
					local qx, qy = q.x - e.x, q.y - e.y
					if qx * qx + qy * qy <= reloc2 then
						far = false
						break
					end
				end
			end
			if far then
				if e.boss then
					local a = atan2(dy, dx)
					e.x = p.x - cos(a) * K.viewRadius()
					e.y = p.y - sin(a) * K.viewRadius()
				else
					local anchor = K.anchor(run)
					e.x, e.y = K.spawnPos(run, anchor)
					e.tgt = anchor
					if e.windT > 0 then
						K.endWind(run, e)
					end
				end
				K.ev(run, { k = "warp", id = e.id })
			end
		end

		-- contact with any active player (pre-move distance, like the web game)
		for _, q in act do
			local rr = e.r + q.r - 3
			local qx, qy = q.x - ex0, q.y - ey0
			if qx * qx + qy * qy < rr * rr then
				K.hurtPlayer(
					run,
					q,
					e.dmg,
					if e.boss then "boss" elseif e.elite then "elite" elseif e.swarm then "swarm" else "contact"
				)
			end
		end
	end
end

return EnemiesMod
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!native
-- Player area effects (fire pools, frost novas), telegraphs and hazards (web updateFx, circleImpact, laneImpact,
-- addHaz). Telegraph and hazard changes are replicated as events.
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")

local Fx = {}

local HAZ_CAP = 8
local sqrt = math.sqrt

local function hitRadius(run, pl): number
	return pl.r - run.hitShrink
end

function K.addHaz(run, h)
	local hz = run.haz
	if #hz >= HAZ_CAP then
		local old = nil
		for _, o in hz do
			if o.life - o.t > 0.3 and (not old or o.t > old.t) then
				old = o
			end
		end
		if old then
			old.life = old.t + 0.3
			K.ev(run, { k = "haz~", id = old.id, life = 0.3 })
		end
	end
	h.t = 0
	h.id = K.oid(run)
	hz[#hz + 1] = h
	K.ev(run, { k = "haz+", h = h })
end

function K.circleImpact(run, t)
	for _, p in run.act do
		local rr = t.rad + hitRadius(run, p)
		if Util.dist2(p.x, p.y, t.x, t.y) < rr * rr then
			K.hurtPlayer(run, p, t.dmg, t.src or "area")
		end
	end
	if t.small then
		K.ev(run, { k = "boom", x = t.x, y = t.y, rad = t.rad, color = "#ff3d5a" })
		K.shake(run, 3, t.x, t.y)
		K.sfx(run, "eimpact", t.x, t.y)
	else
		K.ev(run, { k = "boom", x = t.x, y = t.y, rad = t.rad, color = "#ff8a5c" })
		K.shake(run, 8, t.x, t.y)
		K.sfx(run, "slam", t.x, t.y)
	end
	if t.onImpact == "ember" then
		K.addHaz(run, { kind = "ember", x = t.x, y = t.y, rad = 32, life = 2.6, dmg = t.pdmg or t.dmg * 0.4 })
	elseif t.onImpact == "slow" then
		K.addHaz(run, { kind = "slow", x = t.x, y = t.y, rad = t.rad, life = 3.0, dmg = 0 })
	end
end

function K.laneImpact(run, t)
	local ca, sa = math.cos(t.a), math.sin(t.a)
	for _, p in run.act do
		local pr = hitRadius(run, p)
		local rx, ry = p.x - t.x, p.y - t.y
		local along = rx * ca + ry * sa
		local perp = math.abs(-rx * sa + ry * ca)
		if along > -pr and along < t.len + pr and perp < t.w / 2 + pr then
			K.hurtPlayer(run, p, t.dmg, "lane")
		end
	end
	K.shake(run, 5, t.x + ca * t.len / 2, t.y + sa * t.len / 2)
	K.sfx(run, "eimpact", t.x + ca * t.len / 2, t.y + sa * t.len / 2)
end

function K.updateFx(run, dt: number)
	local fx = run.fx
	for i = #fx, 1, -1 do
		local f = fx[i]
		f.t += dt
		local pl = run.players[f.slot]
		if f.kind == "pool" then
			f.tick -= dt
			if f.tick <= 0 then
				f.tick = 0.35
				local list = table.clone(K.circle(run, f.x, f.y, f.rad))
				for _, e in list do
					K.damage(run, e, f.dmg, f.wid, 0, if pl then pl.stats.crit else 0.05, nil, nil, f.slot)
				end
			end
		elseif f.kind == "nova" then
			local k = math.min(1, f.t / 0.5)
			local rad = f.maxRad * (1 - (1 - k) * (1 - k))
			f.rad = rad
			local list = table.clone(K.circle(run, f.x, f.y, rad))
			for _, e in list do
				if not f.hit[e] then
					f.hit[e] = true
					if f.freeze and not e.boss then
						e.freezeT = math.max(e.freezeT, f.slowDur * 0.6)
					end
					e.slowT = math.max(e.slowT, f.slowDur)
					e.slowF = 0.45
					K.damage(run, e, f.dmg, f.wid, 140, if pl then pl.stats.crit else 0.05, f.x, f.y, f.slot)
				end
			end
		end
		if f.t >= f.life then
			fx[i] = fx[#fx]
			fx[#fx] = nil
		end
	end

	-- telegraphs (bosses and ranged); those attached to a wind-up live exactly as long as the wind-up
	local tele = run.tele
	for i = #tele, 1, -1 do
		local t = tele[i]
		local gone = t.dead == true
		if t.own then
			local o = t.own
			if o.dead or o.windStart ~= t.ws or not (o.windT > 0) then
				gone = true
			else
				t.life = o.windMax
				t.t = o.windMax - o.windT
			end
		else
			t.t += dt
		end
		if t.follow then
			t.x = t.follow.x
			t.y = t.follow.y
		end
		if not gone and t.lockAt ~= nil and t.t < t.lockAt and t.follow then
			local p = t.target
			if p and p.state == "active" then
				t.a = K.leadAim(p, t.x, t.y, t.lead, t.spd) + (t.o or 0)
				K.aimShots(t)
				t.aimDirty = true
			end
		end
		if t.track and t.t < t.track["until"] then
			local p = t.target
			if p and p.state == "active" then
				local dx, dy = p.x - t.x, p.y - t.y
				local d = sqrt(dx * dx + dy * dy)
				local st = math.min(d, t.track.spd * dt)
				if d > 0.01 then
					t.x += dx / d * st
					t.y += dy / d * st
				end
				t.x, t.y = K.clampView(p, t.x, t.y, 20)
				t.aimDirty = true
			end
		end
		if not gone and not t.own and t.t >= t.life then
			gone = true
			if t.kind == "circle" then
				K.circleImpact(run, t)
			elseif t.kind == "lane" then
				K.laneImpact(run, t)
			end
		end
		if gone then
			tele[i] = tele[#tele]
			tele[#tele] = nil
			K.ev(run, { k = "tele-", id = t.id })
		elseif t.aimDirty then
			t.aimDirty = false
			K.ev(run, { k = "tele~", tl = t })
		end
	end

	-- hazards: embers hurt, slime slows
	local hz = run.haz
	for i = #hz, 1, -1 do
		local h = hz[i]
		h.t += dt
		if h.t >= h.life then
			hz[i] = hz[#hz]
			hz[#hz] = nil
			K.ev(run, { k = "haz-", id = h.id })
		else
			for _, p in run.act do
				local rr = h.rad + p.r - 4
				if Util.dist2(p.x, p.y, h.x, h.y) < rr * rr then
					if h.kind == "ember" then
						K.hurtPlayer(run, p, h.dmg, "puddle")
					else
						p.slowT = 0.15
					end
				end
			end
		end
	end
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Grid</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- Spatial hash for collision queries (web util.js Grid). Cells keyed by a single integer; buckets are reused.
local Grid = {}
Grid.__index = Grid

export type Grid = typeof(setmetatable(
	{} :: { cs: number, cells: { [number]: { any } }, used: { { any } }, nCells: number },
	Grid
))

function Grid.new(cell: number): Grid
	return setmetatable({ cs = cell, cells = {}, used = {}, nCells = 0 }, Grid)
end

local floor, band = math.floor, bit32.band

local function keyOf(cx: number, cy: number): number
	return band(cx, 16383) * 16384 + band(cy, 16383)
end

function Grid.clear(self: Grid)
	local used = self.used
	for i = 1, #used do
		table.clear(used[i])
		used[i] = nil
	end
	if self.nCells > 6000 then
		table.clear(self.cells)
		self.nCells = 0
	end
end

function Grid.insert(self: Grid, e: any)
	local cs = self.cs
	local k = keyOf(floor(e.x / cs), floor(e.y / cs))
	local a = self.cells[k]
	if not a then
		a = {}
		self.cells[k] = a
		self.nCells += 1
	end
	if #a == 0 then
		table.insert(self.used, a)
	end
	a[#a + 1] = e
end

-- fills `out` (cleared first) with candidates within the square around (x, y) of half size r
function Grid.query(self: Grid, x: number, y: number, r: number, out: { any }): { any }
	table.clear(out)
	local cs = self.cs
	local x0, x1 = floor((x - r) / cs), floor((x + r) / cs)
	local y0, y1 = floor((y - r) / cs), floor((y + r) / cs)
	local cells = self.cells
	local n = 0
	for cx = x0, x1 do
		for cy = y0, y1 do
			local a = cells[keyOf(cx, cy)]
			if a then
				for i = 1, #a do
					n += 1
					out[n] = a[i]
				end
			end
		end
	end
	return out
end

return Grid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">K</string>
            <string name="Source"><![CDATA[-- Late-bound function registry of the simulation. Every Sim module registers its functions here
-- (`function K.damage(run, ...)`), and calls other modules through K at call time. This breaks the require cycles
-- of the web game's single `Game` object (damage -> kill -> drop -> ... -> damage) without changing its structure.
-- Sim/Run.luau requires every module once, so the registry is complete before the first step.
local K = {}
return K
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">LevelUp</string>
            <string name="Source"><![CDATA[-- Level-up offers and choices, chests (web buildOptions, optionCount, applyOption, chooseLevel, skipLevel, reroll,
-- banish, openChest). Solo pauses the world like the web game; co-op shows a non-modal tray with an auto-pick
-- (docs/DESIGN.md §2.5).
local K = if script then require(script.Parent.K) else require("./K")
local Weapons = if script then require(script.Parent.Data.Weapons) else require("./Data/Weapons")
local Passives = if script then require(script.Parent.Data.Passives) else require("./Data/Passives")
local Stats = if script then require(script.Parent.Stats) else require("./Stats")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local LevelUp = {}

local WDEF, PDEF = Weapons.byId, Passives.byId

local function findWeapon(pl, id)
	for _, w in pl.weapons do
		if w.id == id then
			return w
		end
	end
	return nil
end
local function findPassive(pl, id)
	for _, p in pl.passives do
		if p.id == id then
			return p
		end
	end
	return nil
end

function K.buildOptions(run, pl, count: number)
	local rng = run.rng
	local cands = {}
	for _, w in pl.weapons do
		if w.level < Weapons.WEAPON_MAX and not w.evo then
			table.insert(cands, { kind = "weapon", id = w.id, level = w.level + 1, weight = 10 })
		end
	end
	for _, pa in pl.passives do
		if pa.level < PDEF[pa.id].max then
			table.insert(cands, { kind = "passive", id = pa.id, level = pa.level + 1, weight = 8 })
		end
	end
	if #pl.weapons < Weapons.MAX_WEAPONS then
		for _, id in Weapons.ORDER do
			if not findWeapon(pl, id) and not pl.banished[id] then
				table.insert(cands, { kind = "weapon", id = id, level = 1, isNew = true, weight = 7 })
			end
		end
	end
	if #pl.passives < Passives.MAX_PASSIVES then
		for _, id in Passives.ORDER do
			if not findPassive(pl, id) and not pl.banished[id] then
				table.insert(cands, { kind = "passive", id = id, level = 1, isNew = true, weight = 6 })
			end
		end
	end
	local out = {}
	while #out < count and #cands > 0 do
		local sum = 0
		for _, c in cands do
			sum += c.weight
		end
		local x = rng:next() * sum
		local idx = 1
		while idx <= #cands do
			x -= cands[idx].weight
			if x <= 0 then
				break
			end
			idx += 1
		end
		idx = math.min(idx, #cands)
		table.insert(out, cands[idx])
		table.remove(cands, idx)
	end
	-- early levels: always offer a new weapon (the most visible upgrade)
	if #pl.weapons == 1 and pl.level <= 4 and #out > 0 then
		local has = false
		for _, o in out do
			if o.kind == "weapon" and o.isNew then
				has = true
			end
		end
		if not has then
			local nw = {}
			for _, c in cands do
				if c.kind == "weapon" and c.isNew then
					table.insert(nw, c)
				end
			end
			if #nw > 0 then
				out[#out] = rng:pick(nw)
			end
		end
	end
	if #out == 0 then
		table.insert(out, { kind = "gold", id = "gold", amount = 25 })
		table.insert(out, { kind = "heal", id = "heal", amount = 40 })
	end
	return out
end

function K.optionCount(run, pl): number
	return if run.rng:next() < (pl.stats.luck - 1) * 0.6 + 0.05 then 4 else 3
end

function K.applyOption(run, pl, o)
	if o.kind == "weapon" then
		local w = findWeapon(pl, o.id)
		if w then
			w.level += 1
			Stats.weapon(w, pl.stats)
		else
			K.addWeapon(run, pl, o.id)
		end
	elseif o.kind == "passive" then
		local pa = findPassive(pl, o.id)
		if pa then
			pa.level += 1
		else
			table.insert(pl.passives, { id = o.id, level = 1 })
		end
		K.refreshStats(run, pl)
	elseif o.kind == "gold" then
		pl.gold += o.amount
	elseif o.kind == "heal" then
		pl.hp = math.min(pl.stats.maxHp, pl.hp + o.amount)
	end
	K.ev(run, { k = "build", slot = pl.slot })
end

local function sendOffer(run, pl)
	K.ev(run, {
		k = "levelup",
		slot = pl.slot,
		options = pl.offer,
		rerolls = pl.rerolls,
		skips = pl.skips,
		banishes = pl.banishes,
		deadline = if run.solo then nil else run.t + pl.offerT,
	})
end

-- creates the offer for the player's next pending level (solo: pauses; co-op: tray + ward + auto-pick timer)
function K.openLevelUp(run, pl)
	pl.offer = K.buildOptions(run, pl, K.optionCount(run, pl))
	pl.offerT = Tuning.AUTO_PICK_TIME
	if run.solo then
		run.state = "levelup"
	elseif not pl.trayOpen then
		pl.trayOpen = true
		if pl.state == "active" and run.t - pl.wardLast >= Tuning.WARD_COOLDOWN then
			pl.wardLast = run.t
			pl.wardT = Tuning.WARD_TIME
			K.ev(run, { k = "ward", slot = pl.slot, dur = Tuning.WARD_TIME })
		end
	end
	K.sfx(run, "levelup", pl.x, pl.y)
	sendOffer(run, pl)
end

local function afterChoice(run, pl)
	pl.offer = nil
	if run.solo then
		K.afterModal(run)
	elseif pl.pendingLevels <= 0 then
		pl.trayOpen = false
		K.ev(run, { k = "levelupDone", slot = pl.slot })
	end
end

function K.chooseLevel(run, pl, i: number): boolean
	local o = pl.offer and pl.offer[i]
	if not o then
		return false
	end
	K.applyOption(run, pl, o)
	pl.pendingLevels -= 1
	afterChoice(run, pl)
	return true
end

function K.skipLevel(run, pl): boolean
	if not pl.offer or pl.skips <= 0 then
		return false
	end
	pl.skips -= 1
	pl.pendingLevels -= 1
	K.gainXp(run, pl, 0)
	afterChoice(run, pl)
	return true
end

function K.reroll(run, pl): boolean
	if not pl.offer or pl.rerolls <= 0 then
		return false
	end
	pl.rerolls -= 1
	pl.offer = K.buildOptions(run, pl, K.optionCount(run, pl))
	sendOffer(run, pl)
	return true
end

function K.banish(run, pl, i: number): boolean
	local o = pl.offer and pl.offer[i]
	if not o or pl.banishes <= 0 or not o.isNew then
		return false
	end
	pl.banishes -= 1
	pl.banished[o.id] = true
	local rest = {}
	for _, x in pl.offer do
		if x ~= o then
			table.insert(rest, x)
		end
	end
	local more = K.buildOptions(run, pl, 6)
	for _, x in more do
		local dup = false
		for _, y in rest do
			if y.kind == x.kind and y.id == x.id then
				dup = true
			end
		end
		if not dup and x.kind ~= "gold" and x.kind ~= "heal" then
			table.insert(rest, x)
			break
		end
	end
	if #rest == 0 then
		rest = K.buildOptions(run, pl, 3)
	end
	pl.offer = rest
	sendOffer(run, pl)
	return true
end

-- solo: after a dialog continue with the next level-up or chest, else play
function K.afterModal(run)
	local pl = run.plist[1]
	if pl.pendingLevels > 0 then
		K.openLevelUp(run, pl)
	elseif pl.pendingChests > 0 then
		K.openChest(run, pl)
	elseif run.state ~= "over" and run.state ~= "victory" and run.state ~= "lastchance" then
		K.resumePlay(run)
	end
end

-- co-op: tray handling and auto-pick, every step for every player in the run
function K.updateTrays(run, dt: number)
	for _, pl in run.plist do
		if pl.state ~= "left" then
			if pl.offer then
				pl.offerT -= dt
				if pl.offerT <= 0 then
					K.chooseLevel(run, pl, 1)
				end
			elseif pl.pendingLevels > 0 then
				K.openLevelUp(run, pl)
			end
		end
	end
end

-- ---------- chests ----------
function K.gotChest(run, pl)
	if run.solo then
		pl.pendingChests += 1
	else
		K.openChest(run, pl)
	end
end

local function evolve(_run, pl, w, res)
	w.evo = true
	Stats.weapon(w, pl.stats)
	res.evolved = w.id
	pl.evolvedCount += 1
	pl.bank.evolutions += 1
	pl.bank.evolved[w.id] = true
end

function K.openChest(run, pl)
	local rng = run.rng
	if run.solo then
		pl.pendingChests -= 1
		run.state = "chest"
	end
	pl.chestsOpened += 1
	pl.bank.chests += 1
	local res = { evolved = nil, items = {}, gold = 0 }
	local evo = nil
	for _, w in pl.weapons do
		if K.canEvolve(pl, w) then
			evo = w
			break
		end
	end
	if evo then
		evolve(run, pl, evo, res)
	else
		local luck = pl.stats.luck
		local roll = rng:next()
		local n = if roll < 0.05 * luck then 5 elseif roll < 0.25 * luck then 3 else 1
		for i = 0, n - 1 do
			local cands = {}
			for _, w in pl.weapons do
				if w.level < Weapons.WEAPON_MAX and not w.evo then
					table.insert(cands, { kind = "weapon", id = w.id, level = w.level + 1 })
				end
			end
			for _, pa in pl.passives do
				if pa.level < PDEF[pa.id].max then
					table.insert(cands, { kind = "passive", id = pa.id, level = pa.level + 1 })
				end
			end
			if #cands == 0 then
				break
			end
			local o = rng:pick(cands)
			K.applyOption(run, pl, o)
			table.insert(res.items, o)
			local ev2 = nil
			for _, w in pl.weapons do
				if K.canEvolve(pl, w) then
					ev2 = w
					break
				end
			end
			if ev2 and not res.evolved and i == n - 1 and n > 1 then
				evolve(run, pl, ev2, res)
			end
		end
	end
	res.gold = Util.round(rng:int(15, 40) * pl.stats.greed * run.heatDef.gold)
	pl.gold += res.gold
	K.sfx(run, "chest", pl.x, pl.y)
	K.ev(run, { k = "chest", slot = pl.slot, res = res })
	return res
end

function K.closeChest(run)
	if run.state == "chest" then
		K.afterModal(run)
	end
end

LevelUp.WDEF = WDEF
return LevelUp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Party</string>
            <string name="Source"><![CDATA[-- Players in a run: movement (local integration for bots/solo tests, validated network positions for clients),
-- leash, ember ward, downed / teammate revive / fallen, last chance, Robux revive, victory vote, leaving
-- (docs/DESIGN.md §2.5, §2.7, §2.8, §3.6).
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Party = {}

local sqrt, min, abs = math.sqrt, math.min, math.abs

-- ---------- movement ----------
local function moveDir(_run, p, dt)
	local s = p.stats
	local ix, iy = p.inX, p.inY
	local il = sqrt(ix * ix + iy * iy)
	p.moving = il > 0.05
	p.vx, p.vy = 0, 0
	if p.moving then
		local k = min(1, il) * (if p.slowT > 0 then 0.55 else 1)
		p.dirX, p.dirY = ix / il, iy / il
		p.vx, p.vy = p.dirX * s.speed * k, p.dirY * s.speed * k
		p.x += p.vx * dt
		p.y += p.vy * dt
		if abs(p.dirX) > 0.1 then
			p.face = if p.dirX > 0 then 1 else -1
		end
	end
end

-- validated network position (client-predicted movement, server-validated; §3.6)
function K.applyMove(run, p)
	local m = p.net
	if not m or m.seq == p.netApplied then
		return
	end
	p.netApplied = m.seq
	local elapsed = min(0.5, math.max(0, run.t - p.moveT))
	p.moveT = run.t
	-- movement budget (token bucket over sim time): it refills at the hero's speed (+ a small rate margin) and
	-- holds at most a short burst, so packet jitter is tolerated but the long-run speed can't exceed
	-- speed * MOVE_RATE (a per-packet slack would add up with the packet rate)
	local spd = p.stats.speed * (if p.slowT > 0 then 0.55 else 1)
	local cap = spd * Tuning.MOVE_BURST + Tuning.MOVE_SLACK
	local budget = min(cap, (p.moveBudget or Tuning.MOVE_SLACK) + spd * Tuning.MOVE_RATE * elapsed)
	local dx, dy = m.x - p.x, m.y - p.y
	local d = sqrt(dx * dx + dy * dy)
	local clamped = false
	if d > budget then
		dx, dy = dx / d * budget, dy / d * budget
		d = budget
		clamped = true
	end
	p.moveBudget = budget - d
	local ox, oy = p.x, p.y
	p.x += dx
	p.y += dy
	K.leash(run, p)
	-- derived velocity (lead aim), smoothed over ~0.2 s
	if elapsed > 0 then
		local k = min(1, elapsed / 0.2)
		p.vx += ((p.x - ox) / elapsed - p.vx) * k
		p.vy += ((p.y - oy) / elapsed - p.vy) * k
	end
	p.moving = m.moving
	if m.moving and (m.dirX ~= 0 or m.dirY ~= 0) then
		local l = sqrt(m.dirX * m.dirX + m.dirY * m.dirY)
		p.dirX, p.dirY = m.dirX / l, m.dirY / l
		if abs(p.dirX) > 0.1 then
			p.face = if p.dirX > 0 then 1 else -1
		end
	end
	-- corrections: 3 clamps within 2 s or a deviation > 40 px
	if clamped then
		table.insert(p.clampTimes, run.t)
		while #p.clampTimes > 0 and p.clampTimes[1] < run.t - 2 do
			table.remove(p.clampTimes, 1)
		end
	end
	local dev = Util.hypot(m.x - p.x, m.y - p.y)
	if dev > 40 or #p.clampTimes >= 3 then
		table.clear(p.clampTimes)
		K.ev(run, { k = "correct", slot = p.slot, x = p.x, y = p.y })
	end
end

-- keep active players within LEASH_RADIUS of the centroid of all active players (co-op only)
function K.leash(run, p)
	local act = run.act
	if #act < 2 or p.state ~= "active" then
		return
	end
	local cx, cy = 0, 0
	for _, q in act do
		cx += q.x
		cy += q.y
	end
	cx /= #act
	cy /= #act
	local dx, dy = p.x - cx, p.y - cy
	local d = sqrt(dx * dx + dy * dy)
	local L = Tuning.LEASH_RADIUS
	if d > L then
		p.x, p.y = cx + dx / d * L, cy + dy / d * L
	end
end

function K.movePlayers(run, dt: number)
	local wards = run.wardList
	table.clear(wards)
	for _, p in run.plist do
		if p.state == "left" then
			continue
		end
		if p.slowT > 0 then
			p.slowT -= dt
		end
		if p.iframe > 0 then
			p.iframe -= dt
		end
		if p.flash > 0 then
			p.flash -= dt
		end
		if p.wardT > 0 then
			p.wardT -= dt
		end
		if p.state == "active" then
			if p.inputMode == "pos" then
				K.applyMove(run, p)
			else
				moveDir(run, p, dt)
				K.leash(run, p)
			end
			local s = p.stats
			if s.regen > 0 and p.hp < s.maxHp then
				p.hp = min(s.maxHp, p.hp + s.regen * dt)
			end
			if p.wardT > 0 then
				wards[#wards + 1] = p
			end
		else
			p.moving = false
			p.vx, p.vy = 0, 0
		end
	end
end

-- ---------- downed, revive, fallen ----------
function K.downPlayer(run, p)
	p.hp = 0
	p.wardT = 0
	if run.solo then
		p.state = "fallen"
	else
		p.state = "downed"
		p.bleedT = Tuning.BLEED_OUT
		p.reviveP = 0
	end
	K.ev(run, { k = "down", slot = p.slot, state = p.state })
	K.checkTeam(run)
end

-- can this player still buy a Robux revive in this run?
-- (offer: the player's own flag set by the server via Run.setReviveOffer, else the run-wide default)
function K.canRobuxRevive(run, p): boolean
	local offer = if p.reviveOffer ~= nil then p.reviveOffer else run.reviveOffer
	return offer == true and (p.state == "downed" or p.state == "fallen") and p.robuxRevives < Tuning.REVIVE_MAX_PER_RUN
end

-- after somebody went down: last chance or end of the run when nobody is active
function K.checkTeam(run)
	K.refreshPlayers(run)
	if #run.act > 0 or run.state ~= "play" then
		return
	end
	for _, p in run.plist do
		if K.canRobuxRevive(run, p) then
			run.state = "lastchance"
			run.lastT = Tuning.LAST_CHANCE_TIME
			K.ev(run, { k = "state", state = run.state, left = run.lastT })
			return
		end
	end
	K.endRun(run, false)
end

local function revive(run, p, hpFrac: number, iframe: number)
	p.state = "active"
	p.hp = p.stats.maxHp * hpFrac
	p.iframe = iframe
	p.reviveP = 0
	p.bleedT = 0
	K.ev(run, { k = "revived", slot = p.slot })
end

-- Robux revive ("Second Ember"): 50 % HP, 3 s i-frames, blast 320 px; max REVIVE_MAX_PER_RUN per player and run
function K.robuxRevive(run, p): boolean
	if not (p.state == "downed" or p.state == "fallen") or p.robuxRevives >= Tuning.REVIVE_MAX_PER_RUN then
		return false
	end
	if run.state ~= "play" and run.state ~= "lastchance" then
		return false
	end
	p.robuxRevives += 1
	revive(run, p, 0.5, 3)
	K.reviveBlast(run, p, "revive")
	K.banner(run, "Zweite Glut!", "event", nil, nil, p.slot)
	if run.state == "lastchance" then
		run.state = "play"
		K.ev(run, { k = "state", state = run.state })
	end
	K.refreshPlayers(run)
	return true
end

-- teammate revive and bleed-out (co-op), every play step
function K.updateDowned(run, dt: number)
	for _, p in run.plist do
		if p.state == "downed" then
			local helper = nil
			local r2 = Tuning.REVIVE_RADIUS * Tuning.REVIVE_RADIUS
			for _, q in run.act do
				if Util.dist2(p.x, p.y, q.x, q.y) <= r2 then
					helper = q
					break
				end
			end
			local need = min(Tuning.REVIVE_TIME + p.revives * Tuning.REVIVE_TIME_STEP, Tuning.REVIVE_TIME_MAX)
			if helper then
				p.reviveP += dt
				if p.reviveP >= need then
					p.revives += 1
					helper.bank.revivesGiven += 1
					revive(run, p, 0.4, 2)
					K.banner(run, "Wieder auf den Beinen!", "event", nil, nil, p.slot)
				end
			else
				p.reviveP = math.max(0, p.reviveP - 0.5 * dt)
				p.bleedT -= dt
				if p.bleedT <= 0 then
					p.state = "fallen"
					K.ev(run, { k = "down", slot = p.slot, state = p.state })
				end
			end
			p.reviveFrac = p.reviveP / need
		end
	end
end

-- ---------- victory, vote, end ----------
function K.enterVictory(run)
	run.state = "victory"
	run.voteT = Tuning.VOTE_TIME
	table.clear(run.votes)
	K.sfx(run, "victory")
	K.ev(run, { k = "victory" })
	K.ev(run, { k = "state", state = run.state, left = if run.solo then nil else run.voteT })
end

function K.continueEndless(run)
	if run.state ~= "victory" then
		return
	end
	run.endless = true
	run.endlessBossT = 120
	K.ev(run, { k = "endless" })
	-- downed players stay downed, fallen stay fallen; nobody active -> the run ends here
	K.refreshPlayers(run)
	if #run.act == 0 then
		K.endRun(run, true)
		return
	end
	if run.solo then
		run.state = "play"
		K.afterModal(run)
	else
		run.state = "play"
	end
	K.ev(run, { k = "state", state = run.state })
end

-- majority of the players in the run wins; a tie or the timeout means Finish
local function resolveVote(run, timeout: boolean)
	local yes, no, n = 0, 0, 0
	for _, p in run.plist do
		if p.state ~= "left" then
			n += 1
			local v = run.votes[p.slot]
			if v == true then
				yes += 1
			elseif v == false then
				no += 1
			end
		end
	end
	if yes * 2 > n then
		K.continueEndless(run)
	elseif no * 2 >= n or timeout then
		K.endRun(run, true)
	end
end

function K.vote(run, p, endless: boolean)
	if run.state ~= "victory" then
		return false
	end
	run.votes[p.slot] = endless == true
	K.ev(run, { k = "vote", slot = p.slot, endless = endless == true })
	resolveVote(run, false)
	return true
end

function K.voteTick(run, dt: number)
	if run.solo then
		return
	end
	run.voteT -= dt
	if run.voteT <= 0 then
		resolveVote(run, true)
	end
end

function K.endRun(run, _won: boolean?)
	if run.state == "over" then
		return
	end
	run.state = "over"
	run.over = true
	K.ev(run, { k = "gameOver", won = run.won })
	K.ev(run, { k = "state", state = run.state })
end

-- solo: back to play after a dialog, with the 0.45 s slow-motion ramp when something is flying or telegraphed
function K.resumePlay(run)
	local prev = run.state
	run.state = "play"
	if
		run.solo
		and (prev == "levelup" or prev == "chest" or prev == "paused")
		and (#run.eshots > 0 or #run.tele > 0)
	then
		run.resume = 0.45
	end
	if prev ~= "play" then
		K.ev(run, { k = "state", state = run.state })
	end
end

Party.sqrt = sqrt
return Party
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Pickups</string>
            <string name="Source"><![CDATA[--!native
-- Gems, coins, hearts, magnets, bombs, chests (web dropGem, drop, updatePickups, collect, gainXp).
-- Co-op: XP and coin gold are shared by the team (docs/DESIGN.md §2.4); chests have an owner.
local K = if script then require(script.Parent.K) else require("./K")
local Coop = if script then require(script.Parent.Coop) else require("./Coop")
local Curves = if script then require(script.Parent.Curves) else require("./Curves")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Pickups = {}

local sqrt = math.sqrt
local GEM_CAP, PICKUP_CAP = Tuning.GEM_CAP, Tuning.PICKUP_CAP
local VIEW_HW, VIEW_HH = Tuning.VIEW_HW, Tuning.VIEW_HH

function K.dropGem(run, x: number, y: number, v: number)
	local gems = run.gems
	if #gems > GEM_CAP then
		gems[1].v += v
		return
	end
	local g = { id = K.oid(run), x = x, y = y, v = v, mag = nil, sp = 0 }
	gems[#gems + 1] = g
	K.ev(run, { k = "gem+", id = g.id, x = x, y = y, v = v })
end

function K.drop(run, x: number, y: number, kind: string, v: number?, owner: number?)
	local pk = run.pickups
	if #pk >= PICKUP_CAP and kind ~= "chest" then
		return nil
	end
	local it = { id = K.oid(run), x = x, y = y, kind = kind, v = v or 0, mag = nil, sp = 0, owner = owner }
	pk[#pk + 1] = it
	K.ev(run, { k = "pick+", id = it.id, kind = kind, x = x, y = y, owner = owner or 0 })
	return it
end

-- one chest per player in the run, marked with the owner
function K.dropChests(run, x: number, y: number)
	local n = 0
	for _, pl in run.plist do
		if pl.state ~= "left" then
			local ox = if run.solo then 0 else (n - 1.5) * 44
			K.drop(run, x + ox, y, "chest", 0, pl.slot)
			n += 1
		end
	end
end

function K.gainXp(_run, pl, v: number)
	pl.xp += v * pl.stats.growth
	while pl.xp >= pl.xpNext do
		pl.xp -= pl.xpNext
		pl.level += 1
		pl.xpNext = Curves.xpFor(pl.level)
		pl.pendingLevels += 1
	end
end

-- team XP: every player in the run gains v x xpShare(N), scaled by his own growth
function K.teamXp(run, v: number)
	if run.solo then
		K.gainXp(run, run.plist[1], v)
		return
	end
	local share = Coop.f(Coop.xpShare, run.nPlayers)
	for _, pl in run.plist do
		if pl.state ~= "left" then
			K.gainXp(run, pl, v * share)
		end
	end
end

-- team gold from coins/bags
local function teamGold(run, base: number, collector)
	local share = if run.solo then 1 else Coop.f(Coop.goldShare, run.nPlayers)
	for _, pl in run.plist do
		if pl.state ~= "left" then
			local v = Util.round(base * share * pl.stats.greed * run.heatDef.gold)
			pl.gold += v
			K.text(run, pl.x, pl.y - 26, "+{0} Gold", "#ffd23f", 1, pl.slot, { v })
		end
	end
	K.sfx(run, "coin", collector.x, collector.y)
end

function K.collect(run, it, p)
	if it.kind == "coin" or it.kind == "bag" then
		local base = if it.kind == "bag" then (if it.v > 0 then it.v else 15) else (if it.v > 0 then it.v else 1)
		teamGold(run, base, p)
	elseif it.kind == "heart" then
		local h = math.min(30, p.stats.maxHp - p.hp)
		p.hp += h
		K.text(run, p.x, p.y - 26, "+" .. Util.round(h), "#5dff8f", 1.1, p.slot)
		K.ev(run, { k = "burst", x = p.x, y = p.y, color = "#5dff8f", n = 14 })
		K.sfx(run, "heal", p.x, p.y)
	elseif it.kind == "magnet" then
		for _, g in run.gems do
			if not g.mag then
				g.mag = p
				g.sp = -60
				K.ev(run, { k = "gemPull", id = g.id, slot = p.slot })
			end
		end
		for _, c in run.pickups do
			if c.kind == "coin" then
				c.mag = p
				K.ev(run, { k = "pick~", id = c.id, slot = p.slot })
			end
		end
		K.sfx(run, "magnet", p.x, p.y)
	elseif it.kind == "bomb" then
		local list = {}
		for _, e in run.enemies do
			if not e.dead and math.abs(e.x - p.x) <= VIEW_HW + 40 and math.abs(e.y - p.y) <= VIEW_HH + 40 then
				list[#list + 1] = e
			end
		end
		for _, e in list do
			K.damage(run, e, if e.boss then 300 else 99999, "bomb", 300, nil, nil, nil, p.slot)
		end
		K.ev(run, { k = "flash", x = p.x, y = p.y, slot = p.slot })
		K.shake(run, 16, p.x, p.y)
		K.sfx(run, "bomb", p.x, p.y)
	elseif it.kind == "chest" then
		K.sfx(run, "chestpick", p.x, p.y)
		K.gotChest(run, p)
	end
end

function K.updatePickups(run, dt: number)
	local act = run.act
	if #act == 0 then
		return
	end
	local gems = run.gems
	for i = #gems, 1, -1 do
		local g = gems[i]
		local p = g.mag
		if p and p.state ~= "active" then
			p = nil
			g.mag = nil
		end
		if not p then
			-- the first active player (slot order) whose magnet radius covers the gem attracts it
			for _, q in act do
				local dx, dy = q.x - g.x, q.y - g.y
				local m = q.stats.magnet
				if dx * dx + dy * dy < m * m then
					p = q
					g.mag = q
					g.sp = -120
					K.ev(run, { k = "gemPull", id = g.id, slot = q.slot })
					break
				end
			end
		end
		if p then
			local dx, dy = p.x - g.x, p.y - g.y
			local d = sqrt(dx * dx + dy * dy)
			if d == 0 then
				d = 1
			end
			g.sp += 1100 * dt
			local step = g.sp * dt
			if step >= d then
				g.x, g.y = p.x, p.y
			else
				g.x += dx / d * step
				g.y += dy / d * step
			end
			if d < p.r + 8 or step >= d then
				K.teamXp(run, g.v)
				K.ev(run, { k = "gemGot", id = g.id, slot = p.slot })
				K.sfx(run, "gem", p.x, p.y)
				gems[i] = gems[#gems]
				gems[#gems] = nil
			end
		end
	end
	local pk = run.pickups
	for i = #pk, 1, -1 do
		local it = pk[i]
		local p = it.mag
		if p and p.state ~= "active" then
			p = nil
			it.mag = nil
		end
		if it.kind == "coin" and not p then
			for _, q in act do
				local dx, dy = q.x - it.x, q.y - it.y
				local m = q.stats.magnet
				if dx * dx + dy * dy < m * m then
					p = q
					it.mag = q
					it.sp = -100
					K.ev(run, { k = "pick~", id = it.id, slot = q.slot })
					break
				end
			end
		end
		local reached = nil
		local ix0, iy0 = it.x, it.y -- the reach test uses the position before the magnet step (web game)
		if p then
			local dx, dy = p.x - it.x, p.y - it.y
			local d = sqrt(dx * dx + dy * dy)
			if d == 0 then
				d = 1
			end
			it.sp += 1000 * dt
			local step = it.sp * dt
			if step >= d then
				it.x, it.y = p.x, p.y
				reached = p
			else
				it.x += dx / d * step
				it.y += dy / d * step
			end
		end
		if not reached then
			for _, q in act do
				if it.kind ~= "chest" or it.owner == q.slot then
					local reach = q.r + (if it.kind == "chest" then 22 else 14)
					local dx, dy = q.x - ix0, q.y - iy0
					if dx * dx + dy * dy < reach * reach then
						reached = q
						break
					end
				end
			end
		end
		if reached then
			pk[i] = pk[#pk]
			pk[#pk] = nil
			K.ev(run, { k = "pick-", id = it.id, slot = reached.slot })
			K.collect(run, it, reached)
		end
	end
end

return Pickups
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[-- Player profile (DataStore value, docs/DESIGN.md Appendix C): defaults, migration, sanitizing, stage and forge
-- helpers (web defaultSave, Store.load, stageBest, stageStars, stageUnlocked, stageMaxHeat, totalStars, shopPrice,
-- shopRefundValue). Pure; no Roblox services.
local Stages = if script then require(script.Parent.Data.Stages) else require("./Data/Stages")
local Heat = if script then require(script.Parent.Data.Heat) else require("./Data/Heat")
local Forge = if script then require(script.Parent.Data.Forge) else require("./Data/Forge")
local Heroes = if script then require(script.Parent.Data.Heroes) else require("./Data/Heroes")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Cosmetics = if script then require(script.Parent.Parent.Config.Cosmetics) else require("../Config/Cosmetics")
local Products = if script then require(script.Parent.Parent.Config.Products) else require("../Config/Products")

local Profile = {}

-- version history: 1 = R1/R2 schema (Appendix C); 2 = R3: weapon colour "fx_crimson" became "fx_solar" (the
-- validator forbids effect colours in the enemy-shot hue family), equipped cosmetics are checked against the list
Profile.VERSION = 2
local STAT_KEYS = {
	"kills",
	"runs",
	"bestTime",
	"bestLevel",
	"bestKills",
	"wins",
	"evolutions",
	"bossKills",
	"chests",
	"goldEarned",
	"playTime",
	"coopRuns",
	"revivesGiven",
}
Profile.STAT_KEYS = STAT_KEYS

function Profile.default()
	local stats = {}
	for _, k in STAT_KEYS do
		stats[k] = 0
	end
	return {
		v = Profile.VERSION,
		gold = 0,
		shop = {},
		shopSpent = 0,
		giftGiven = false,
		chars = { "aron", "mira" },
		achievements = {},
		evolved = {},
		bosses = {},
		stats = stats,
		stages = {},
		stageSel = "graveyard",
		stageHeat = {},
		storySeen = {},
		lastChar = "aron",
		settings = { sfx = true, music = true, dmgNums = true, shake = true, lang = nil, camZoom = 1, lowFx = false },
		cosmetics = { owned = {}, equipped = {} }, -- equipped = { skin = id?, fx = id?, trail = id? }
		reviveTokens = 0,
		receipts = {},
		passCache = {},
		created = 0,
		lastSave = 0,
	}
end

local function num(v, lo: number, hi: number, def: number): number
	if type(v) ~= "number" or v ~= v then
		return def
	end
	return math.clamp(v, lo, hi)
end
local function int(v, lo, hi, def)
	return math.floor(num(v, lo, hi, def))
end
local function boolMap(t, valid: ((string) -> boolean)?)
	local out = {}
	if type(t) == "table" then
		for k, v in t do
			if type(k) == "string" and v == true and (not valid or valid(k)) then
				out[k] = true
			end
		end
	end
	return out
end

local stageIds, heroIds, forgeById = {}, {}, {}
for _, s in Stages.list do
	stageIds[s.id] = true
end
for _, id in Heroes.ORDER do
	heroIds[id] = true
end
for _, it in Forge.list do
	forgeById[it.id] = it
end

-- fill missing fields and fix types/ranges after loading (never trusts stored data)
function Profile.sanitize(d: any)
	local def = Profile.default()
	if type(d) ~= "table" then
		return def
	end
	local p = def
	p.v = Profile.VERSION
	p.gold = int(d.gold, 0, 1e12, 0)
	if type(d.shop) == "table" then
		for id, lvl in d.shop do
			local it = forgeById[id]
			if it then
				local l = int(lvl, 0, it.max, 0)
				if l > 0 then
					p.shop[id] = l
				end
			end
		end
	end
	p.shopSpent = int(d.shopSpent, 0, 1e12, 0)
	p.giftGiven = d.giftGiven == true
	if type(d.chars) == "table" then
		local seen = {}
		p.chars = {}
		for _, id in { "aron", "mira" } do
			table.insert(p.chars, id)
			seen[id] = true
		end
		for _, id in d.chars do
			if type(id) == "string" and heroIds[id] and not seen[id] then
				seen[id] = true
				table.insert(p.chars, id)
			end
		end
	end
	p.achievements = boolMap(d.achievements)
	p.evolved = boolMap(d.evolved)
	p.bosses = boolMap(d.bosses)
	if type(d.stats) == "table" then
		for _, k in STAT_KEYS do
			p.stats[k] = num(d.stats[k], 0, 1e15, 0)
		end
	end
	if type(d.stages) == "table" then
		for id, h in d.stages do
			if stageIds[id] then
				p.stages[id] = int(h, -1, #Heat.list - 1, -1)
				if p.stages[id] < 0 then
					p.stages[id] = nil
				end
			end
		end
	end
	p.stageSel = if type(d.stageSel) == "string" and stageIds[d.stageSel] then d.stageSel else "graveyard"
	if type(d.stageHeat) == "table" then
		for id, h in d.stageHeat do
			if stageIds[id] then
				p.stageHeat[id] = int(h, 0, #Heat.list - 1, 0)
			end
		end
	end
	p.storySeen = boolMap(d.storySeen)
	p.lastChar = if type(d.lastChar) == "string" and heroIds[d.lastChar] then d.lastChar else "aron"
	if type(d.settings) == "table" then
		local s = d.settings
		for _, k in { "sfx", "music", "dmgNums", "shake", "lowFx" } do
			if type(s[k]) == "boolean" then
				p.settings[k] = s[k]
			end
		end
		p.settings.lang = if s.lang == "de" or s.lang == "en" then s.lang else nil
		p.settings.camZoom = num(s.camZoom, 0.7, 1.3, 1)
	end
	if type(d.cosmetics) == "table" then
		p.cosmetics.owned = boolMap(d.cosmetics.owned, function(id)
			return Cosmetics.byId[id] ~= nil
		end)
		if type(d.cosmetics.equipped) == "table" then
			for _, k in Cosmetics.SLOTS do
				local v = d.cosmetics.equipped[k]
				local c = type(v) == "string" and Cosmetics.byId[v]
				if c and c.slot == k then
					p.cosmetics.equipped[k] = v
				end
			end
		end
	end
	p.reviveTokens = int(d.reviveTokens, 0, 1000, 0)
	if type(d.receipts) == "table" then
		for k, v in d.receipts do
			if type(k) == "string" and type(v) == "number" then
				p.receipts[k] = v
			end
		end
	end
	p.passCache = boolMap(d.passCache, function(key)
		local it = Products.byKey[key]
		return it ~= nil and it.kind == "pass"
	end)
	p.created = num(d.created, 0, 1e12, 0)
	p.lastSave = num(d.lastSave, 0, 1e12, 0)
	local lock = d._lock
	if type(lock) == "table" and type(lock.job) == "string" and type(lock.t) == "number" then
		p._lock = { job = lock.job, t = lock.t }
	end
	return p
end

local function deepCopy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in t do
		out[k] = deepCopy(v)
	end
	return out
end
Profile.deepCopy = deepCopy

-- one step per version: MIGRATIONS[v] turns a version-v table into version v + 1 (works on a copy)
local MIGRATIONS = {
	[1] = function(d)
		local c = d.cosmetics
		if type(c) == "table" then
			if type(c.owned) == "table" and c.owned.fx_crimson then
				c.owned.fx_crimson = nil
				c.owned.fx_solar = true
			end
			if type(c.equipped) == "table" and c.equipped.fx == "fx_crimson" then
				c.equipped.fx = "fx_solar"
			end
		end
		if type(d.passCache) == "table" then
			d.passCache.fx_crimson = nil
		end
	end,
}
Profile.MIGRATIONS = MIGRATIONS

-- stored value -> current profile. Returns nil, "newer" for data written by a newer server version (a rolling
-- update): such a profile must not be loaded here, or saving would drop its new fields. A missing or broken
-- version counts as 1. Never mutates `d`.
function Profile.migrate(d: any): (any, string?)
	if type(d) ~= "table" then
		return Profile.default(), nil
	end
	local v = if type(d.v) == "number" and d.v == math.floor(d.v) and d.v >= 1 then d.v else 1
	if v > Profile.VERSION then
		return nil, "newer"
	end
	local c = deepCopy(d)
	while v < Profile.VERSION do
		MIGRATIONS[v](c)
		v += 1
	end
	return Profile.sanitize(c), nil
end

-- ---------- stages ----------
function Profile.stageBest(p, id: string): number
	local v = p.stages and p.stages[id]
	return if type(v) == "number" then v else -1
end
function Profile.stageStars(p, id: string): number
	local b = Profile.stageBest(p, id)
	return if b < 0 then 0 elseif b >= 3 then 3 elseif b >= 1 then 2 else 1
end
-- i = 1-based land index
function Profile.stageUnlocked(p, i: number): boolean
	return i == 1 or Profile.stageBest(p, Stages.list[i - 1].id) >= 0
end
function Profile.stageMaxHeat(p, id: string): number
	return math.min(#Heat.list - 1, Profile.stageBest(p, id) + 1)
end
function Profile.totalStars(p): number
	local n = 0
	for _, s in Stages.list do
		n += Profile.stageStars(p, s.id)
	end
	return n
end

-- ---------- forge ----------
function Profile.forgePrice(p, item): number
	local lvl = p.shop[item.id] or 0
	local bought = 0
	for _, it in Forge.list do
		bought += p.shop[it.id] or 0
	end
	return Util.round(item.cost * (lvl + 1) * (1 + 0.05 * bought) / 5) * 5
end

-- refund value of a shop table (cheapest possible buying order)
function Profile.forgeRefundValue(shop): number
	local back = 0
	local tmp = { shop = {} }
	local items = table.clone(Forge.list)
	-- stable sort by cost descending (JS Array.sort is stable)
	for i = 2, #items do
		local it = items[i]
		local j = i - 1
		while j >= 1 and items[j].cost < it.cost do
			items[j + 1] = items[j]
			j -= 1
		end
		items[j + 1] = it
	end
	for _, it in items do
		local lvl = shop[it.id] or 0
		for _ = 1, lvl do
			back += Profile.forgePrice(tmp, it)
			tmp.shop[it.id] = (tmp.shop[it.id] or 0) + 1
		end
	end
	return back
end

-- buy one forge level; returns ok, reason
function Profile.forgeBuy(p, id: string): (boolean, string?)
	local it = forgeById[id]
	if not it then
		return false, "unknown"
	end
	local lvl = p.shop[id] or 0
	if lvl >= it.max then
		return false, "max"
	end
	local price = Profile.forgePrice(p, it)
	if p.gold < price then
		return false, "gold"
	end
	p.gold -= price
	p.shopSpent += price
	p.shop[id] = lvl + 1
	return true, nil
end

-- refund all forge levels (the amount actually spent)
function Profile.forgeRefund(p): number
	local back = p.shopSpent
	p.gold += back
	p.shopSpent = 0
	p.shop = {}
	return back
end

function Profile.cheapestForgePrice(p): number
	local m = math.huge
	for _, it in Forge.list do
		m = math.min(m, Profile.forgePrice(p, it))
	end
	return m
end

-- heroes the player may pick: earned by achievement (profile.chars) or owned through a pass
-- ownedPasses = { [heroId] = true } (already resolved from game pass ownership by the server)
function Profile.unlockedHeroes(p, ownedPasses: { [string]: boolean }?): { string }
	local out = {}
	for _, id in Heroes.ORDER do
		local earned = table.find(p.chars, id) ~= nil
		if earned or (ownedPasses and ownedPasses[id]) then
			table.insert(out, id)
		end
	end
	return out
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- Braziers ("Kohlebecken") per 620 px chunk, placed by hash (web updateProps, hitProps). `Props.position` is
-- shared with the client so it can draw braziers without replication; only broken ones are sent as events.
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Props = {}

local CHUNK = 620
Props.CHUNK = CHUNK
local hash2 = Util.hash2
local VIEW_HW, VIEW_HH = Tuning.VIEW_HW, Tuning.VIEW_HH

-- world position of the brazier in chunk (cx, cy), or nil when the chunk has none
function Props.position(cx: number, cy: number): (number?, number?)
	if hash2(cx, cy, 7) > 0.5 or (cx == 0 and cy == 0) then
		return nil, nil
	end
	return (cx + 0.15 + hash2(cx, cy, 8) * 0.7) * CHUNK, (cy + 0.15 + hash2(cx, cy, 9) * 0.7) * CHUNK
end

function Props.key(cx: number, cy: number): number
	return (cx + 32768) * 65536 + (cy + 32768)
end

local function around(run, p)
	local cx0, cx1 = math.floor((p.x - VIEW_HW - 200) / CHUNK), math.floor((p.x + VIEW_HW + 200) / CHUNK)
	local cy0, cy1 = math.floor((p.y - VIEW_HH - 200) / CHUNK), math.floor((p.y + VIEW_HH + 200) / CHUNK)
	local props, broken = run.props, run.broken
	for cx = cx0, cx1 do
		for cy = cy0, cy1 do
			local key = Props.key(cx, cy)
			if props[key] == nil and not broken[key] then
				local x, y = Props.position(cx, cy)
				if not x then
					props[key] = false
				else
					local pr = { key = key, cx = cx, cy = cy, x = x, y = y, r = 14 }
					props[key] = pr
					table.insert(run.propList, pr)
				end
				run.propCount += 1
			end
		end
	end
end

function K.updateProps(run)
	for _, p in run.act do
		around(run, p)
	end
	if run.propCount > 300 then
		local props = run.props
		local keep = {}
		local n = 0
		local function nearAny(x, y)
			for _, p in run.act do
				if math.abs(x - p.x) <= 3000 and math.abs(y - p.y) <= 3000 then
					return true
				end
			end
			return false
		end
		-- remove empty chunks and far braziers (iteration order does not matter: only deletions)
		for k, v in props do
			if not v or not nearAny(v.x, v.y) then
				props[k] = nil
			else
				n += 1
			end
		end
		for _, pr in run.propList do
			if props[pr.key] == pr then
				keep[#keep + 1] = pr
			end
		end
		run.propList = keep
		run.propCount = n
	end
end

function K.hitProps(run, x: number, y: number, rad: number)
	local list = run.propList
	for i = #list, 1, -1 do
		local pr = list[i]
		local rr = rad + pr.r
		if Util.dist2(x, y, pr.x, pr.y) <= rr * rr then
			table.remove(list, i)
			run.props[pr.key] = nil
			run.propCount -= 1
			run.broken[pr.key] = true
			K.ev(run, { k = "prop-", cx = pr.cx, cy = pr.cy, x = pr.x, y = pr.y })
			K.sfx(run, "break", pr.x, pr.y)
			local kind = run.rng:weighted(run.propDrops)
			K.drop(run, pr.x, pr.y, kind, if kind == "bag" then run.rng:int(10, 25) else 2)
		end
	end
end

Props.DROPS = {
	{ k = "bag", w = 40 },
	{ k = "heart", w = 26 },
	{ k = "magnet", w = 14 },
	{ k = "bomb", w = 12 },
	{ k = "coin", w = 8 },
}

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Results</string>
            <string name="Source"><![CDATA[-- End of a run per player and achievements (web checkAchievements, recordClear, endRun). Works on one player's
-- run view (Run.playerView) and his profile table; mutates the profile (pure, no services).
local Achievements = if script then require(script.Parent.Data.Achievements) else require("./Data/Achievements")
local Heroes = if script then require(script.Parent.Data.Heroes) else require("./Data/Heroes")
local Stages = if script then require(script.Parent.Data.Stages) else require("./Data/Stages")
local Heat = if script then require(script.Parent.Data.Heat) else require("./Data/Heat")
local Profile = if script then require(script.Parent.Profile) else require("./Profile")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Run = if script then require(script.Parent.Run) else require("./Run")

local Results = {}

local function count(t): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- check functions by achievement id: (r = run view, s = profile)
local CHECK = {
	t1 = function(r)
		return r.t >= 60
	end,
	t5 = function(r)
		return r.t >= 300
	end,
	t10 = function(r)
		return r.t >= 600
	end,
	win = function(r)
		return r.won
	end,
	stage3 = function(_, s)
		return Profile.stageBest(s, "frostlake") >= 0
	end,
	night = function(_, s)
		return Profile.stageBest(s, "nightheart") >= 0
	end,
	stars10 = function(_, s)
		return Profile.totalStars(s) >= 10
	end,
	stars15 = function(_, s)
		return Profile.totalStars(s) >= 15
	end,
	lvl10 = function(r)
		return r.level >= 10
	end,
	lvl20 = function(r)
		return r.level >= 20
	end,
	lvl40 = function(r)
		return r.level >= 40
	end,
	lvl60 = function(r)
		return r.level >= 60
	end,
	kill500 = function(r)
		return r.kills >= 500
	end,
	kill2000 = function(r)
		return r.kills >= 2000
	end,
	kill5000 = function(r)
		return r.kills >= 5000
	end,
	kills3000 = function(_, s)
		return s.stats.kills >= 3000
	end,
	kills25k = function(_, s)
		return s.stats.kills >= 25000
	end,
	evo1 = function(_, s)
		return s.stats.evolutions >= 1
	end,
	evo3 = function(_, s)
		return count(s.evolved) >= 3
	end,
	evoall = function(_, s)
		return count(s.evolved) >= 9
	end,
	evo2run = function(r)
		return r.evolvedCount >= 2
	end,
	boss_slimeking = function(_, s)
		return s.bosses.slimeking == true
	end,
	boss_bonelord = function(_, s)
		return s.bosses.bonelord == true
	end,
	boss_bloodcount = function(_, s)
		return s.bosses.bloodcount == true
	end,
	boss_colossus = function(_, s)
		return s.bosses.colossus == true
	end,
	chest10 = function(_, s)
		return s.stats.chests >= 10
	end,
	gold2000 = function(_, s)
		return s.stats.goldEarned >= 2000
	end,
	nohit3 = function(r)
		return r.t >= 180 and r.firstHit == nil
	end,
	full = function(r)
		return #r.weapons >= 6 and #r.passives >= 6
	end,
	heat3 = function(r)
		return r.won and r.heat >= 3
	end,
	heat5 = function(r)
		return r.won and r.heat >= 5
	end,
}
Results.CHECK = CHECK

-- move lifetime counters gathered in the run (not yet booked) into the profile
function Results.bank(run, slot: number, profile)
	local pl = run.players[slot]
	if not pl then
		return
	end
	local b = pl.bank
	local st = profile.stats
	st.kills += b.kills
	st.evolutions += b.evolutions
	st.chests += b.chests
	st.bossKills += b.bossKills
	st.revivesGiven += b.revivesGiven
	b.kills, b.evolutions, b.chests, b.bossKills, b.revivesGiven = 0, 0, 0, 0, 0
	for id in b.bosses do
		profile.bosses[id] = true
	end
	for id in b.evolved do
		profile.evolved[id] = true
	end
	table.clear(b.bosses)
	table.clear(b.evolved)
end

-- returns the list of newly earned achievement ids (gold and hero unlocks applied to the profile)
function Results.checkAchievements(run, slot: number, profile): { string }
	Results.bank(run, slot, profile)
	local r = Run.playerView(run, slot)
	local out = {}
	for _, a in Achievements.list do
		if not profile.achievements[a.id] then
			local f = CHECK[a.id]
			local ok = false
			if f then
				local good, res = pcall(f, r, profile)
				ok = good and res == true
			end
			if ok then
				profile.achievements[a.id] = true
				profile.gold += a.gold
				profile.stats.goldEarned += a.gold
				table.insert(out, a.id)
				for _, hid in Heroes.ORDER do
					if Heroes.byId[hid].unlock == a.id and not table.find(profile.chars, hid) then
						table.insert(profile.chars, hid)
					end
				end
			end
		end
	end
	return out
end

-- land cleared: best heat, stars and unlocks (for the victory screen)
function Results.recordClear(run, slot: number, profile)
	local id = run.stage.id
	local idx = run.stageIdx
	local nextS = Stages.list[idx + 1]
	local starsBefore = Profile.stageStars(profile, id)
	local heatBefore = Profile.stageMaxHeat(profile, id)
	local nextBefore = if nextS then Profile.stageUnlocked(profile, idx + 1) else true
	profile.stages[id] = math.max(Profile.stageBest(profile, id), run.heat)
	profile.stats.wins += 1
	local pl = run.players[slot]
	if pl then
		pl.cleared = true
	end
	return {
		starsBefore = starsBefore,
		stars = Profile.stageStars(profile, id),
		newStage = if nextS and not nextBefore then nextS.id else nil,
		newHeat = if Profile.stageMaxHeat(profile, id) > heatBefore then Profile.stageMaxHeat(profile, id) else 0,
		last = nextS == nil,
	}
end

-- web endRun for one player: gold (collected + time bonus + boss bonus [+ x2 pass] + first-run gift), records,
-- achievements. opts = { gold2x = bool }. Returns the summary for the results screen.
function Results.finish(run, slot: number, profile, opts)
	opts = opts or {}
	local pl = run.players[slot]
	local r = Run.playerView(run, slot)
	if run.won and pl and not pl.cleared then
		Results.recordClear(run, slot, profile)
	end
	local mul = Heat.list[run.heat + 1].gold
	local timeBonus = Util.round(math.floor(r.t / 60) * 6 * mul)
	local bossBonus = Util.round(run.bossKills * 25 * mul)
	local runGold = r.gold + timeBonus + bossBonus
	local pass2x = if opts.gold2x then runGold else 0
	local cheapest = Profile.cheapestForgePrice(profile)
	local gift = 0
	if not profile.giftGiven then
		gift = math.max(0, cheapest - profile.gold - runGold - pass2x)
	end
	profile.giftGiven = true
	local total = runGold + pass2x + gift
	profile.gold += total
	profile.stats.goldEarned += total
	profile.stats.runs += 1
	if r.coop then
		profile.stats.coopRuns += 1
	end
	profile.stats.playTime += r.t
	profile.stats.bestTime = math.max(profile.stats.bestTime, r.t)
	profile.stats.bestLevel = math.max(profile.stats.bestLevel, r.level)
	profile.stats.bestKills = math.max(profile.stats.bestKills, r.kills)
	if pl then
		profile.lastChar = pl.heroId
	end
	local ach = Results.checkAchievements(run, slot, profile)
	return {
		won = run.won,
		t = r.t,
		level = r.level,
		kills = r.kills,
		ownKills = r.ownKills,
		collected = r.gold,
		timeBonus = timeBonus,
		bossBonus = bossBonus,
		pass2x = pass2x,
		gift = gift,
		heatMul = mul,
		total = total,
		achievements = ach,
		heroId = r.heroId,
		dmgBy = r.dmgBy,
	}
end

return Results
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic RNG for the simulation (docs/DESIGN.md §0): xoshiro128** on 32-bit integers (bit32), seeded with
-- splitmix32. Only 32-bit operations and small exact multiplications (x5, x9), so results are identical in Roblox and
-- Lune. The sim never uses math.random.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { s0: number, s1: number, s2: number, s3: number }, Rng))

local band, bxor, lrotate, lshift, rshift = bit32.band, bit32.bxor, bit32.lrotate, bit32.lshift, bit32.rshift
local TWO32 = 4294967296

-- 32-bit multiplication (Math.imul semantics, unsigned result)
local function imul(a: number, b: number): number
	local lo = a % 65536
	local hi = (a - lo) / 65536
	return (lo * b + ((hi * b) % 65536) * 65536) % TWO32
end
Rng.imul = imul

local function splitmix(state: number): (number, number)
	state = (state + 0x9E3779B9) % TWO32
	local z = state
	z = imul(bxor(z, rshift(z, 16)), 0x85EBCA6B)
	z = imul(bxor(z, rshift(z, 13)), 0xC2B2AE35)
	z = bxor(z, rshift(z, 16))
	return state, z
end

function Rng.new(seed: number): Rng
	local st = math.floor(seed) % TWO32
	local a, b, c, d
	st, a = splitmix(st)
	st, b = splitmix(st)
	st, c = splitmix(st)
	st, d = splitmix(st)
	if a == 0 and b == 0 and c == 0 and d == 0 then
		a = 1
	end
	return setmetatable({ s0 = a, s1 = b, s2 = c, s3 = d }, Rng)
end

-- next uint32
function Rng.u32(self: Rng): number
	local s0, s1, s2, s3 = self.s0, self.s1, self.s2, self.s3
	local result = (lrotate((s1 * 5) % TWO32, 7) * 9) % TWO32
	local t = lshift(s1, 9)
	s2 = bxor(s2, s0)
	s3 = bxor(s3, s1)
	s1 = bxor(s1, s2)
	s0 = bxor(s0, s3)
	s2 = bxor(s2, t)
	s3 = lrotate(s3, 11)
	self.s0, self.s1, self.s2, self.s3 = s0, s1, s2, s3
	return result
end

-- float in [0, 1)
function Rng.next(self: Rng): number
	return self:u32() / TWO32
end

-- float in [a, b)  (web rand)
function Rng.range(self: Rng, a: number, b: number): number
	return a + self:u32() / TWO32 * (b - a)
end

-- integer in [a, b] (web randi)
function Rng.int(self: Rng, a: number, b: number): number
	return math.floor(a + self:u32() / TWO32 * (b - a + 1))
end

-- random element of an array (web pick)
function Rng.pick<T>(self: Rng, t: { T }): T
	return t[math.floor(self:u32() / TWO32 * #t) + 1]
end

-- entries: array of { k = value, w = weight } (web weightedPick)
function Rng.weighted(self: Rng, entries: { any }): any
	local sum = 0
	for _, e in entries do
		sum += e.w
	end
	local r = self:u32() / TWO32 * sum
	for _, e in entries do
		r -= e.w
		if r <= 0 then
			return e.k
		end
	end
	return entries[#entries].k
end

-- state snapshot (for determinism checks)
function Rng.state(self: Rng): string
	return string.format("%08x%08x%08x%08x", self.s0, self.s1, self.s2, self.s3)
end

-- band kept for callers that need it
Rng.band = band

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Run</string>
            <string name="Source"><![CDATA[-- A run: creation, fixed-step update, commands and inputs (web Game.newRun, Game.update, UI actions).
-- docs/DESIGN.md §3.3:
--   local run = Run.new({ seed, stageId, heat, players = { { slot, userId, heroId, forge, inputMode } }, reviveOffer })
--   Run.setInput(run, slot, x, y, seq, dirX, dirY, moving)  -- validated hero position from the network
--   Run.setMove(run, slot, mx, my)                          -- move vector (bots, tests): the sim moves the hero
--   Run.command(run, slot, { op = "pick", i = 2 })           -- pick | reroll | skip | banish | chestClose | pause |
--                                                           -- resume | vote | revive | giveup
--   Run.step(run, dt)                                       -- advances the world (the server calls it with 1/30)
--   run.events                                              -- emitted events, cleared by the caller
--   run.state  -- "play" | "levelup" | "chest" | "paused" (solo) | "lastchance" | "victory" | "over"
local K = if script then require(script.Parent.K) else require("./K")
local Rng = if script then require(script.Parent.Rng) else require("./Rng")
local Grid = if script then require(script.Parent.Grid) else require("./Grid")
local Curves = if script then require(script.Parent.Curves) else require("./Curves")
local Stats = if script then require(script.Parent.Stats) else require("./Stats")
local Stages = if script then require(script.Parent.Data.Stages) else require("./Data/Stages")
local Heat = if script then require(script.Parent.Data.Heat) else require("./Data/Heat")
local Heroes = if script then require(script.Parent.Data.Heroes) else require("./Data/Heroes")
local Props = if script then require(script.Parent.Props) else require("./Props")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")
-- modules that register their functions in K
local _World = if script then require(script.Parent.World) else require("./World")
local _Countdown = if script then require(script.Parent.Countdown) else require("./Countdown")
local _Director = if script then require(script.Parent.Director) else require("./Director")
local _Enemies = if script then require(script.Parent.Enemies) else require("./Enemies")
local _Bosses = if script then require(script.Parent.Bosses) else require("./Bosses")
local _Combat = if script then require(script.Parent.Combat) else require("./Combat")
local _Fx = if script then require(script.Parent.Fx) else require("./Fx")
local _Shots = if script then require(script.Parent.Shots) else require("./Shots")
local _Weapons = if script then require(script.Parent.Weapons) else require("./Weapons")
local _Pickups = if script then require(script.Parent.Pickups) else require("./Pickups")
local _LevelUp = if script then require(script.Parent.LevelUp) else require("./LevelUp")
local _Party = if script then require(script.Parent.Party) else require("./Party")

local Run = {}
Run.K = K

local START_OFFSETS = { { 0, 0 }, { 40, 0 }, { -40, 0 }, { 0, 40 } }

function Run.stageById(id: string?)
	for i, s in Stages.list do
		if s.id == id then
			return s, i
		end
	end
	return Stages.list[1], 1
end

local function newPlayer(run, o, idx: number)
	local heroId = if Heroes.byId[o.heroId] then o.heroId else "aron"
	local off = START_OFFSETS[idx] or { 0, 0 }
	local solo = run.solo
	local pl = {
		slot = o.slot,
		userId = o.userId or 0,
		heroId = heroId,
		forge = o.forge or {},
		inputMode = o.inputMode or "dir",
		x = if solo then 0 else off[1],
		y = if solo then 0 else off[2],
		r = 12,
		hp = 100,
		dirX = 1,
		dirY = 0,
		face = 1,
		moving = false,
		iframe = 0,
		flash = 0,
		vx = 0,
		vy = 0,
		slowT = 0,
		inX = 0,
		inY = 0,
		net = nil,
		netApplied = -1,
		moveT = 0,
		moveBudget = 16,
		clampTimes = {},
		stats = nil,
		weapons = {},
		passives = {},
		level = 1,
		xp = 0,
		xpNext = Curves.xpFor(1),
		pendingLevels = 0,
		pendingChests = 0,
		offer = nil,
		offerT = 0,
		trayOpen = false,
		rerolls = 0,
		skips = 0,
		banishes = 0,
		banished = {},
		revivals = 0,
		dmgBy = {},
		evolvedCount = 0,
		firstHit = nil,
		gold = 0,
		kills = 0,
		chestsOpened = 0,
		surgeHits = 0,
		lastHitSrc = nil,
		state = "active",
		bleedT = 0,
		reviveP = 0,
		reviveFrac = 0,
		revives = 0,
		robuxRevives = 0,
		wardT = 0,
		wardLast = -999,
		-- lifetime counters not yet booked into the profile (Results.bank)
		bank = { kills = 0, evolutions = 0, chests = 0, bossKills = 0, revivesGiven = 0, bosses = {}, evolved = {} },
	}
	K.refreshStats(run, pl)
	pl.hp = pl.stats.maxHp
	pl.rerolls = pl.stats.rerolls
	pl.skips = pl.stats.skips
	pl.banishes = pl.stats.banish
	pl.revivals = pl.stats.revival
	K.addWeapon(run, pl, Heroes.byId[heroId].weapon)
	return pl
end

function Run.new(opts)
	local stage, stageIdx = Run.stageById(opts.stageId)
	local heat = math.clamp(math.floor(opts.heat or 0), 0, #Heat.list - 1)
	local bossList = table.clone(stage.bosses)
	table.sort(bossList, function(a, b)
		return a.t < b.t
	end)
	local qbufs = {}
	for i = 1, 7 do
		qbufs[i] = {}
	end
	local plist = {}
	local run = {
		seed = opts.seed or 1,
		rng = Rng.new(opts.seed or 1),
		stage = stage,
		stageIdx = stageIdx,
		heat = heat,
		heatDef = Heat.list[heat + 1],
		length = stage.minutes * 60,
		bossList = bossList,
		solo = #opts.players <= 1,
		reviveOffer = opts.reviveOffer == true,
		t = 0,
		tick = 0,
		state = "play",
		players = {},
		plist = plist,
		act = {},
		nPlayers = #opts.players,
		enemies = {},
		shots = {},
		eshots = {},
		gems = {},
		pickups = {},
		fx = {},
		tele = {},
		haz = {},
		props = {},
		propList = {},
		propCount = 0,
		broken = {},
		propDrops = Props.DROPS,
		spawnAcc = 0,
		eliteT = 30,
		bossIdx = 1,
		eventIdx = 1,
		bosses = {},
		nextId = 1,
		nextOid = 1,
		vol = { active = 0, bells = 0, lastStart = -9 },
		rangedAlive = 0,
		nonBoss = 0,
		eliteN = 0,
		cdList = nil,
		cdIdx = 1,
		surgeWave = nil,
		surgeK = nil,
		eliteBanT = 0,
		kills = 0,
		bossKills = 0,
		won = false,
		endless = false,
		endlessBossT = 0,
		over = false,
		lastT = 0,
		voteT = 0,
		votes = {},
		resume = 0,
		anchorI = 0,
		retargetPeriod = 15 * (Tuning.SIM_SUBSTEPS or 1),
		hitShrink = if #opts.players <= 1 then 0 else 2,
		wardList = {},
		grid = Grid.new(64),
		qbufs = qbufs,
		qd = 0,
		dmgEvN = 0,
		sfxSeen = {},
		events = {},
	}
	run.cdList = K.buildCountdowns(run)
	for i, o in opts.players do
		local pl = newPlayer(run, o, i)
		run.players[pl.slot] = pl
		table.insert(plist, pl)
	end
	table.sort(plist, function(a, b)
		return a.slot < b.slot
	end)
	K.refreshPlayers(run)
	K.openingGroup(run)
	K.ev(run, { k = "start", stage = stage.id, heat = heat })
	return run
end

-- one play step of length dt (web Game.update)
local function playStep(run, dt: number)
	run.t += dt
	run.tick += 1
	K.refreshPlayers(run)
	K.movePlayers(run, dt)
	K.director(run, dt)
	local g = run.grid
	g:clear()
	for _, e in run.enemies do
		if not e.dead then
			g:insert(e)
		end
	end
	K.updateEnemies(run, dt)
	if run.state ~= "play" then
		return
	end
	for _, pl in run.act do
		K.updateWeapons(run, pl, dt)
	end
	K.updateShots(run, dt)
	K.updateEnemyShots(run, dt)
	K.updateFx(run, dt)
	K.updatePickups(run, dt)
	K.updateProps(run)
	local en = run.enemies
	for i = #en, 1, -1 do
		if en[i].dead then
			en[i] = en[#en]
			en[#en] = nil
		end
	end
	if run.state ~= "play" then
		return
	end
	if not run.solo then
		K.updateDowned(run, dt)
		K.updateTrays(run, dt)
	else
		local pl = run.plist[1]
		if pl.pendingLevels > 0 then
			K.openLevelUp(run, pl)
		elseif pl.pendingChests > 0 then
			K.openChest(run, pl)
		end
	end
end

function Run.step(run, dt: number)
	table.clear(run.sfxSeen)
	run.dmgEvN = 0
	local st = run.state
	if st == "play" then
		local n = Tuning.SIM_SUBSTEPS or 1
		local sdt = dt / n
		for _ = 1, n do
			if run.state ~= "play" then
				break
			end
			local gdt = sdt
			if run.resume > 0 then
				gdt = sdt * (0.3 + 0.7 * (1 - run.resume / 0.45))
				run.resume = math.max(0, run.resume - sdt)
			end
			playStep(run, gdt)
		end
	elseif st == "lastchance" then
		if not run.holdLast then
			run.lastT -= dt
		end
		if run.lastT <= 0 then
			K.endRun(run, false)
		end
	elseif st == "victory" then
		K.voteTick(run, dt)
	end
end

-- client move packet (pos mode); the newest seq wins
function Run.setInput(
	run,
	slot: number,
	x: number,
	y: number,
	seq: number,
	dirX: number?,
	dirY: number?,
	moving: boolean?
)
	local pl = run.players[slot]
	if not pl then
		return
	end
	local m = pl.net
	if m and seq <= m.seq then
		return
	end
	pl.inputMode = "pos"
	pl.net = { x = x, y = y, seq = seq, dirX = dirX or 0, dirY = dirY or 0, moving = moving == true }
end

-- move vector (dir mode)
function Run.setMove(run, slot: number, mx: number, my: number)
	local pl = run.players[slot]
	if pl then
		pl.inputMode = "dir"
		pl.inX, pl.inY = mx, my
	end
end

function Run.command(run, slot: number, cmd): boolean
	local pl = run.players[slot]
	if not pl or pl.state == "left" or type(cmd) ~= "table" then
		return false
	end
	local op = cmd.op
	local st = run.state
	if op == "pick" or op == "reroll" or op == "skip" or op == "banish" then
		if not pl.offer or (run.solo and st ~= "levelup") then
			return false
		end
		if op == "pick" then
			return K.chooseLevel(run, pl, tonumber(cmd.i) or 1)
		elseif op == "reroll" then
			return K.reroll(run, pl)
		elseif op == "skip" then
			return K.skipLevel(run, pl)
		else
			return K.banish(run, pl, tonumber(cmd.i) or 0)
		end
	elseif op == "chestClose" then
		if run.solo and st == "chest" then
			K.closeChest(run)
			return true
		end
	elseif op == "pause" then
		if run.solo and st == "play" then
			run.state = "paused"
			K.ev(run, { k = "state", state = run.state })
			return true
		end
	elseif op == "resume" then
		if run.solo and st == "paused" then
			K.afterModal(run)
			return true
		end
	elseif op == "vote" then
		if st == "victory" then
			if run.solo then
				if cmd.endless then
					K.continueEndless(run)
				else
					K.endRun(run, true)
				end
				return true
			end
			return K.vote(run, pl, cmd.endless == true)
		end
	elseif op == "revive" then
		return K.robuxRevive(run, pl)
	elseif op == "holdLast" then
		-- server: a revive purchase prompt is open during last chance (§7.3 point 6)
		run.holdLast = cmd.on == true
		return true
	elseif op == "giveup" then
		if run.solo then
			if st ~= "over" then
				K.endRun(run, false)
				return true
			end
		elseif pl.state == "active" or pl.state == "downed" then
			pl.hp = 0
			pl.state = "fallen"
			K.ev(run, { k = "down", slot = pl.slot, state = pl.state })
			K.checkTeam(run)
			return true
		end
	end
	return false
end

-- server: may this player be offered the Robux revive ("Second Ember")? (product configured or a token in his
-- profile; docs/DESIGN.md §2.8, §7.3). Overrides the run-wide `reviveOffer` for him.
function Run.setReviveOffer(run, slot: number, on: boolean)
	local pl = run.players[slot]
	if not pl then
		return
	end
	pl.reviveOffer = on
	if not on and run.state == "lastchance" then
		for _, p in run.plist do
			if K.canRobuxRevive(run, p) then
				return
			end
		end
		K.endRun(run, false)
	end
end

-- can this player use a Robux revive right now (downed or fallen, not used up this run, offered)?
function Run.canRobuxRevive(run, slot: number): boolean
	local pl = run.players[slot]
	return pl ~= nil
		and pl.state ~= "left"
		and K.canRobuxRevive(run, pl)
		and (run.state == "play" or run.state == "lastchance")
end

-- a player leaves mid-run; returns his result view (booked by the caller as a defeat)
function Run.removePlayer(run, slot: number)
	local pl = run.players[slot]
	if not pl or pl.state == "left" then
		return nil
	end
	local view = Run.playerView(run, slot)
	pl.state = "left"
	pl.offer = nil
	K.ev(run, { k = "left", slot = slot })
	K.refreshPlayers(run)
	if run.nPlayers == 0 then
		K.endRun(run, false)
	elseif #run.act == 0 and run.state == "play" then
		K.checkTeam(run)
	end
	return view
end

-- the web game's `run` object as seen by one player (achievement checks, results)
function Run.playerView(run, slot: number)
	local pl = run.players[slot]
	return {
		t = run.t,
		won = run.won,
		heat = run.heat,
		stage = run.stage,
		stageIdx = run.stageIdx,
		level = pl.level,
		kills = run.kills,
		ownKills = pl.kills,
		gold = pl.gold,
		bossKills = run.bossKills,
		evolvedCount = pl.evolvedCount,
		firstHit = pl.firstHit,
		weapons = pl.weapons,
		passives = pl.passives,
		heroId = pl.heroId,
		coop = not run.solo,
		dmgBy = pl.dmgBy,
	}
end

Run.Stats = Stats
return Run
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Shots</string>
            <string name="Source"><![CDATA[--!native
-- Player projectiles (bolt, knife, sickle, flask) and enemy shots (web updateShots, updateEnemyShots).
-- Collision is swept along the travelled segment, so the fixed 1/30 s step cannot tunnel (docs/DESIGN.md §1.2).
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Shots = {}

local sqrt, sin, pi = math.sqrt, math.sin, math.pi
local lerp = Util.lerp
local WARD_R2 = Tuning.WARD_RADIUS * Tuning.WARD_RADIUS
-- swept (segment) collision only when a step is longer than the web game's ~1/60 s; with SIM_SUBSTEPS = 2 the sim
-- tests the end point of every half step exactly like the web game (verified by tests/parity.spec.luau)
local SWEPT = (Tuning.SIM_DT / (Tuning.SIM_SUBSTEPS or 1)) > 1 / 59

function K.updateShots(run, dt: number)
	local shots = run.shots
	for i = #shots, 1, -1 do
		local s = shots[i]
		s.t += dt
		local alive = true
		if s.kind == "flask" then
			local k = s.t / s.T
			s.x = lerp(s.sx, s.tx, k)
			s.y = lerp(s.sy, s.ty, k) - sin(k * pi) * 70
			if k >= 1 then
				alive = false
				local f = {
					kind = "pool",
					x = s.tx,
					y = s.ty,
					rad = s.rad,
					t = 0,
					life = s.life,
					tick = 0,
					dmg = s.dmg,
					wid = s.wid,
					evo = s.evo,
					slot = s.slot,
				}
				table.insert(run.fx, f)
				K.ev(run, { k = "pool", slot = s.slot, x = s.tx, y = s.ty, rad = s.rad, life = s.life, evo = s.evo })
				K.sfx(run, "flask", s.tx, s.ty)
			end
		else
			if s.kind == "sickle" then
				s.spin += dt * 14
				if not s.back then
					s.vx -= s.vx0 * 1.7 * dt
					s.vy -= s.vy0 * 1.7 * dt
					if s.vx * s.vx0 + s.vy * s.vy0 <= 0 then
						s.back = true
					end
				else
					local o = run.players[s.slot]
					local ox, oy = if o then o.x else s.x, if o then o.y else s.y
					local dx, dy = ox - s.x, oy - s.y
					local d = sqrt(dx * dx + dy * dy)
					if d == 0 then
						d = 1
					end
					s.ret = math.min(s.speed * 1.4, (s.ret or 60) + 900 * dt)
					s.vx = dx / d * s.ret
					s.vy = dy / d * s.ret
					if d < 20 then
						alive = false
					end
				end
			end
			local x0, y0 = s.x, s.y
			s.x += s.vx * dt
			s.y += s.vy * dt
			if s.t > s.life then
				alive = false
			end
			if alive then
				local list =
					table.clone(if SWEPT then K.sweep(run, x0, y0, s.x, s.y, s.r) else K.circle(run, s.x, s.y, s.r))
				for _, e in list do
					if not alive then
						break
					end
					if s.kind == "sickle" then
						local nt = s.hits[e]
						if nt == nil or nt <= run.t then
							s.hits[e] = run.t + 0.45
							K.damage(run, e, s.dmg, s.wid, 90, s.crit, s.x, s.y, s.slot)
						end
					elseif not s.hit[e] then
						s.hit[e] = true
						K.damage(
							run,
							e,
							s.dmg,
							s.wid,
							if s.kind == "knife" then 60 else 120,
							s.crit,
							s.x - s.vx,
							s.y - s.vy,
							s.slot
						)
						s.pierce -= 1
						if s.pierce <= 0 then
							alive = false
						end
					end
				end
			end
		end
		if not alive then
			shots[i] = shots[#shots]
			shots[#shots] = nil
			if s.kind ~= "flask" then
				K.ev(run, { k = "shot-", id = s.id })
			end
		end
	end
end

function K.updateEnemyShots(run, dt: number)
	local es = run.eshots
	local act = run.act
	local wards = run.wardList
	local shrink = run.hitShrink
	for i = #es, 1, -1 do
		local s = es[i]
		local x0, y0 = s.x, s.y
		s.x += s.vx * dt
		s.y += s.vy * dt
		s.life -= dt
		local alive = s.life > 0
		local removed = false
		if alive then
			local sx, sy = s.x - x0, s.y - y0
			local len2 = sx * sx + sy * sy
			for _, p in act do
				local t = 1 -- end point (web game)
				if SWEPT and len2 > 1e-9 then
					t = math.clamp(((p.x - x0) * sx + (p.y - y0) * sy) / len2, 0, 1)
				end
				local px, py = x0 + sx * t - p.x, y0 + sy * t - p.y
				local rr = s.r + p.r - shrink
				if px * px + py * py < rr * rr then
					K.hurtPlayer(run, p, s.dmg, s.src or "shot")
					alive = false
					removed = true
					break
				end
			end
		end
		if alive and #wards > 0 then
			for _, w in wards do
				local dx, dy = s.x - w.x, s.y - w.y
				if dx * dx + dy * dy < WARD_R2 then
					alive = false
					removed = true
					break
				end
			end
		end
		if not alive then
			es[i] = es[#es]
			es[#es] = nil
			if removed then
				K.ev(run, { k = "eshot-", id = s.id })
			end
		end
	end
end

return Shots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[-- Hero stats and weapon stats (web computeStats, refreshStats, refreshWeapon), per player.
local K = if script then require(script.Parent.K) else require("./K")
local Heroes = if script then require(script.Parent.Data.Heroes) else require("./Data/Heroes")
local Forge = if script then require(script.Parent.Data.Forge) else require("./Data/Forge")
local Passives = if script then require(script.Parent.Data.Passives) else require("./Data/Passives")
local Weapons = if script then require(script.Parent.Data.Weapons) else require("./Data/Weapons")
local Util = if script then require(script.Parent.Util) else require("./Util")

local Stats = {}

-- keys of the stats table in a fixed order (adding bonuses in a fixed order keeps float results deterministic)
local KEYS = {
	"maxHp",
	"maxHpMul",
	"speedMul",
	"armor",
	"regen",
	"might",
	"area",
	"cooldown",
	"amount",
	"duration",
	"projSpeed",
	"magnetMul",
	"luck",
	"growth",
	"greed",
	"crit",
	"revival",
	"rerolls",
	"skips",
	"banish",
}
Stats.KEYS = KEYS

local function add(s, o, mul)
	-- iterate the fixed key list, not the bonus table (deterministic order, same as web insertion order effects)
	for _, k in KEYS do
		local v = o[k]
		if v ~= nil then
			s[k] += v * mul
		end
	end
end

-- heroId, forge = { [shopId] = level }, passives = { { id, level } }
function Stats.compute(heroId: string, forge: { [string]: number }?, passives: { any }): { [string]: number }
	local s = {
		maxHp = 100,
		maxHpMul = 1,
		speedMul = 1,
		armor = 0,
		regen = 0,
		might = 1,
		area = 1,
		cooldown = 1,
		amount = 0,
		duration = 1,
		projSpeed = 1,
		magnetMul = 1,
		luck = 1,
		growth = 1,
		greed = 1,
		crit = 0.05,
		revival = 0,
		rerolls = 0,
		skips = 0,
		banish = 0,
	}
	local hero = Heroes.byId[heroId] or Heroes.byId.aron
	add(s, hero.bonus, 1)
	if forge then
		for _, item in Forge.list do
			local lvl = forge[item.id] or 0
			if lvl > 0 then
				add(s, item.per, lvl)
			end
		end
	end
	for _, pa in passives do
		add(s, Passives.byId[pa.id].per, pa.level)
	end
	s.maxHp = Util.round(s.maxHp * s.maxHpMul)
	s.speed = 150 * s.speedMul
	s.magnet = 70 * s.magnetMul
	s.cooldown = math.max(0.45, s.cooldown)
	return s
end

local WKEYS = { "dmg", "cd", "amount", "speed", "pierce", "area", "dur", "crit" }

-- w = { id, level, evo }, s = hero stats -> w.st
function Stats.weapon(w: any, s: { [string]: number })
	local def = Weapons.byId[w.id]
	local st = { crit = 0 }
	for _, k in WKEYS do
		if def.base[k] ~= nil then
			st[k] = def.base[k]
		end
	end
	for i = 1, w.level - 1 do
		local inc = def.levels[i]
		for _, k in WKEYS do
			if inc[k] ~= nil then
				st[k] = (st[k] or 0) + inc[k]
			end
		end
	end
	if w.evo then
		for _, k in WKEYS do
			local v = def.evo.stats[k]
			if v ~= nil then
				st[k] = (st[k] or 0) + v
			end
		end
	end
	st.dmg *= s.might
	st.cd = math.max(0.1, st.cd * s.cooldown)
	st.amount = math.max(1, Util.round(st.amount + s.amount))
	st.area *= s.area
	st.dur *= s.duration
	st.speed *= s.projSpeed
	st.crit += s.crit
	w.st = st
end

-- player-level helpers
function K.refreshStats(_run, pl)
	local oldMax = if pl.stats then pl.stats.maxHp else 0
	pl.stats = Stats.compute(pl.heroId, pl.forge, pl.passives)
	if pl.stats.maxHp > oldMax and oldMax > 0 then
		pl.hp += pl.stats.maxHp - oldMax
	end
	pl.hp = math.min(pl.hp, pl.stats.maxHp)
	for _, w in pl.weapons do
		Stats.weapon(w, pl.stats)
	end
end

function K.addWeapon(_run, pl, id: string)
	local w = {
		id = id,
		level = 1,
		evo = false,
		cdT = 0.4,
		burst = 0,
		burstT = 0,
		burstI = 0,
		ang = 0,
		active = 0,
		aim = 0,
		st = nil,
		orbs = {},
		rad = 0,
		orbitSent = -1,
	}
	table.insert(pl.weapons, w)
	Stats.weapon(w, pl.stats)
	return w
end

function K.hasPassive(pl, id: string): boolean
	for _, p in pl.passives do
		if p.id == id then
			return true
		end
	end
	return false
end

function K.canEvolve(pl, w): boolean
	return not w.evo and w.level >= Weapons.WEAPON_MAX and K.hasPassive(pl, Weapons.byId[w.id].evo.with)
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!strict
-- Small pure helpers shared by the sim and the clients (web util.js).
local Rng = if script then require(script.Parent.Rng) else require("./Rng")

local Util = {}

Util.TAU = math.pi * 2
Util.DEG = math.pi / 180

function Util.clamp(v: number, a: number, b: number): number
	if v < a then
		return a
	elseif v > b then
		return b
	end
	return v
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Util.dist2(ax: number, ay: number, bx: number, by: number): number
	local dx, dy = ax - bx, ay - by
	return dx * dx + dy * dy
end

function Util.hypot(x: number, y: number): number
	return math.sqrt(x * x + y * y)
end

-- atan2 that matches JS Math.atan2 argument order (y, x)
Util.atan2 = math.atan2

local TWO32 = 4294967296
local imul = Rng.imul
local bxor, rshift = bit32.bxor, bit32.rshift

-- Deterministic hash for chunk decoration and braziers; identical results to web util.js hash2 (tested).
function Util.hash2(x: number, y: number, s: number?): number
	local v = x * 374761393 + y * 668265263 + (s or 0) * 2147483647
	local h = v % TWO32 -- JS `| 0` reinterpreted as uint32
	h = imul(bxor(h, rshift(h, 13)), 1274126177)
	h = bxor(h, rshift(h, 16))
	return h / TWO32
end

-- Fisher-Yates with the sim RNG
function Util.shuffle<T>(rng: any, a: { T }): { T }
	for i = #a, 2, -1 do
		local j = math.floor(rng:next() * i) + 1
		a[i], a[j] = a[j], a[i]
	end
	return a
end

-- JS Math.round (rounds .5 up, also for negatives)
function Util.round(v: number): number
	return math.floor(v + 0.5)
end

-- array helpers
function Util.indexOf<T>(t: { T }, v: T): number?
	for i, x in t do
		if x == v then
			return i
		end
	end
	return nil
end

function Util.removeSwap<T>(t: { T }, i: number)
	local n = #t
	t[i] = t[n]
	t[n] = nil
end

-- parse "#rrggbb" into 0..255 r, g, b
function Util.hex(c: string): (number, number, number)
	local r = tonumber(string.sub(c, 2, 3), 16) or 255
	local g = tonumber(string.sub(c, 4, 5), 16) or 255
	local b = tonumber(string.sub(c, 6, 7), 16) or 255
	return r, g, b
end

return Util
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--!native
-- The nine weapon behaviours (web weapons.js WEAPON_FN), per player. Visuals are replicated as `fire` events.
local K = if script then require(script.Parent.K) else require("./K")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local Weapons = {}

local TAU = Util.TAU
local cos, sin, atan2, ceil, pi = math.cos, math.sin, math.atan2, math.ceil, math.pi
local VIEW_HW, VIEW_HH = Tuning.VIEW_HW, Tuning.VIEW_HH
local SHOT_CAP = Tuning.PLAYER_SHOT_CAP

function K.nearestEnemy(run, x: number, y: number, maxD: number, skip: { [any]: boolean }?)
	local best, bd = nil, maxD * maxD
	for _, e in run.enemies do
		if not e.dead and not (skip and skip[e]) then
			local dx, dy = x - e.x, y - e.y
			local d = dx * dx + dy * dy
			if d < bd then
				bd = d
				best = e
			end
		end
	end
	return best
end

local function onScreenEnemies(run, p)
	local out = {}
	for _, e in run.enemies do
		if not e.dead and math.abs(e.x - p.x) < VIEW_HW and math.abs(e.y - p.y) < VIEW_HH then
			out[#out + 1] = e
		end
	end
	return out
end

-- cooldown + burst: fire(i) is called amount times, gap seconds apart (i is 0-based like the web game)
local function tickBurst(w, dt: number, gap: number, fire: (number) -> ())
	w.cdT -= dt
	if w.burst <= 0 and w.cdT <= 0 then
		w.cdT = w.st.cd
		w.burst = w.st.amount
		w.burstI = 0
		w.burstT = 0
	end
	if w.burst > 0 then
		w.burstT -= dt
		while w.burst > 0 and w.burstT <= 0 do
			local i = w.burstI
			w.burstI += 1
			fire(i)
			w.burst -= 1
			w.burstT += gap
		end
	end
end

local function addShot(run, s)
	if #run.shots >= SHOT_CAP then
		return false
	end
	s.id = K.oid(run)
	table.insert(run.shots, s)
	return true
end

local function fireEv(run, p, w, x, y, a, speed, area, extra)
	K.ev(run, {
		k = "fire",
		slot = p.slot,
		weapon = w.id,
		evo = w.evo,
		x = x,
		y = y,
		a = a,
		speed = speed,
		area = area,
		extra = extra,
	})
end

local FN = {}

FN.wand = function(run, p, w, dt)
	tickBurst(w, dt, if w.evo then 0.04 else 0.08, function()
		local st = w.st
		local t = K.nearestEnemy(run, p.x, p.y, K.viewRadius())
		local a = if t then atan2(t.y - p.y, t.x - p.x) else atan2(p.dirY, p.dirX)
		a += run.rng:range(-0.08, 0.08)
		local s = {
			kind = "bolt",
			x = p.x,
			y = p.y,
			vx = cos(a) * st.speed,
			vy = sin(a) * st.speed,
			r = 7 * st.area,
			dmg = st.dmg,
			pierce = st.pierce,
			life = st.dur,
			t = 0,
			hit = {},
			wid = "wand",
			crit = st.crit,
			evo = w.evo,
			slot = p.slot,
		}
		if addShot(run, s) then
			fireEv(run, p, w, p.x, p.y, a, st.speed, st.area, s.id)
		end
		K.sfx(run, "shoot", p.x, p.y)
	end)
end

local WHIP_OFF = { 0, pi, pi / 2, -pi / 2 }
FN.whip = function(run, p, w, dt)
	tickBurst(w, dt, 0.12, function(i)
		local st = w.st
		local R = 112 * st.area
		if i == 0 then
			local t = K.nearestEnemy(run, p.x, p.y, R * 1.3)
			w.aim = if t then atan2(t.y - p.y, t.x - p.x) else atan2(p.dirY, p.dirX)
		end
		local a = w.aim + WHIP_OFF[i % 4 + 1]
		local cx, cy = p.x + cos(a) * R * 0.5, p.y + sin(a) * R * 0.5
		local heals = 0
		local list = table.clone(K.circle(run, cx, cy, R * 0.6))
		for _, e in list do
			K.damage(run, e, st.dmg, "whip", 110, st.crit, nil, nil, p.slot)
			if w.evo and heals < 5 then
				heals += 1
				p.hp = math.min(p.stats.maxHp, p.hp + 0.5)
			end
		end
		fireEv(run, p, w, p.x, p.y, a, 0, st.area, 0)
		K.sfx(run, "slash", p.x, p.y)
	end)
end

FN.orbit = function(run, p, w, dt)
	local st = w.st
	if w.evo then
		w.active = 1
	elseif w.active > 0 then
		w.active -= dt
		if w.active <= 0 then
			w.cdT = st.cd
		end
	else
		w.cdT -= dt
		if w.cdT <= 0 then
			w.active = st.dur
			K.sfx(run, "orbit", p.x, p.y)
		end
	end
	local on = w.active > 0
	-- replicate orbit state changes (the client animates the orbs itself)
	local sig = if on then st.amount * 1000 + math.floor(st.area * 100) + st.speed else -1
	if sig ~= w.orbitSent then
		w.orbitSent = sig
		K.ev(run, {
			k = "orbit",
			slot = p.slot,
			active = on,
			amount = st.amount,
			radius = 92 * st.area,
			speed = 3.3 * st.speed,
			orb = 14 * st.area,
			ang = w.ang,
			evo = w.evo,
		})
	end
	if not on then
		return
	end
	w.ang += dt * 3.3 * st.speed
	local R, orb = 92 * st.area, 14 * st.area
	local orbs = w.orbs
	table.clear(orbs)
	for i = 0, st.amount - 1 do
		local a = w.ang + i / st.amount * TAU
		local ox, oy = p.x + cos(a) * R, p.y + sin(a) * R
		orbs[#orbs + 1] = ox
		orbs[#orbs + 1] = oy
		local list = table.clone(K.circle(run, ox, oy, orb))
		for _, e in list do
			local nt = e.hitOrbit[p.slot]
			if nt == nil or nt <= run.t then
				e.hitOrbit[p.slot] = run.t + 0.4
				K.damage(run, e, st.dmg, "orbit", 160, st.crit, p.x, p.y, p.slot)
			end
		end
	end
end

FN.aura = function(run, p, w, dt)
	local st = w.st
	w.rad = 82 * st.area
	if w.radSent ~= w.rad then
		w.radSent = w.rad
		K.ev(run, { k = "aura", slot = p.slot, rad = w.rad, evo = w.evo })
	end
	w.cdT -= dt
	if w.cdT > 0 then
		return
	end
	w.cdT = st.cd / st.amount
	local any = false
	local list = table.clone(K.circle(run, p.x, p.y, w.rad))
	for _, e in list do
		any = true
		if w.evo then
			e.slowT = math.max(e.slowT, 0.6)
			e.slowF = math.min(e.slowF, 0.6)
		end
		K.damage(run, e, st.dmg, "aura", 40, st.crit, nil, nil, p.slot)
	end
	if w.evo and any then
		p.hp = math.min(p.stats.maxHp, p.hp + 0.6)
	end
end

FN.lightning = function(run, p, w, dt)
	tickBurst(w, dt, 0.06, function()
		local st = w.st
		local list = onScreenEnemies(run, p)
		if #list == 0 then
			return
		end
		local t = run.rng:pick(list)
		local R = 36 * st.area
		local tx, ty = t.x, t.y
		local hits = table.clone(K.circle(run, tx, ty, R))
		for _, e in hits do
			K.damage(run, e, st.dmg, "lightning", 60, st.crit, tx, ty, p.slot)
		end
		fireEv(run, p, w, tx, ty, 0, 0, st.area, 0)
		if w.evo then
			local from = t
			local done = { [t] = true }
			for _ = 1, 4 do
				local n = K.nearestEnemy(run, from.x, from.y, 190, done)
				if not n then
					break
				end
				done[n] = true
				K.ev(run, { k = "arc", slot = p.slot, x = from.x, y = from.y, x2 = n.x, y2 = n.y })
				K.damage(run, n, st.dmg * 0.7, "lightning", 40, st.crit, from.x, from.y, p.slot)
				from = n
			end
		end
		K.sfx(run, "zap", tx, ty)
	end)
end

FN.sickle = function(run, p, w, dt)
	tickBurst(w, dt, 0.12, function(i)
		local st = w.st
		local t = K.nearestEnemy(run, p.x, p.y, 420)
		local a = if t then atan2(t.y - p.y, t.x - p.x) else atan2(p.dirY, p.dirX)
		a += (if i % 2 == 1 then 1 else -1) * ceil(i / 2) * 0.45
		local sp = st.speed * (if w.evo then 1.25 else 1)
		local s = {
			kind = "sickle",
			x = p.x,
			y = p.y,
			vx = cos(a) * sp,
			vy = sin(a) * sp,
			vx0 = cos(a) * sp,
			vy0 = sin(a) * sp,
			speed = sp,
			r = 17 * st.area,
			dmg = st.dmg,
			life = 3.2,
			t = 0,
			hits = {},
			wid = "sickle",
			crit = st.crit,
			spin = 0,
			back = false,
			evo = w.evo,
			slot = p.slot,
		}
		if addShot(run, s) then
			fireEv(run, p, w, p.x, p.y, a, sp, st.area, s.id)
		end
		K.sfx(run, "throw", p.x, p.y)
	end)
end

FN.fire = function(run, p, w, dt)
	tickBurst(w, dt, 0.12, function()
		local st = w.st
		local rng = run.rng
		local tx, ty
		local list = {}
		for _, e in run.enemies do
			if not e.dead and Util.dist2(e.x, e.y, p.x, p.y) < 260 * 260 then
				list[#list + 1] = e
			end
		end
		if #list > 0 and rng:next() < 0.8 then
			local e = rng:pick(list)
			tx, ty = e.x, e.y
		else
			local a, d = rng:range(0, TAU), rng:range(60, 200)
			tx, ty = p.x + cos(a) * d, p.y + sin(a) * d
		end
		local s = {
			kind = "flask",
			sx = p.x,
			sy = p.y,
			tx = tx,
			ty = ty,
			x = p.x,
			y = p.y,
			t = 0,
			T = 0.45,
			rad = 46 * st.area,
			life = st.dur,
			dmg = st.dmg,
			wid = "fire",
			evo = w.evo,
			slot = p.slot,
		}
		if addShot(run, s) then
			K.ev(run, {
				k = "fire",
				slot = p.slot,
				weapon = "fire",
				evo = w.evo,
				x = p.x,
				y = p.y,
				a = atan2(ty - p.y, tx - p.x),
				speed = Util.hypot(tx - p.x, ty - p.y) / 0.45,
				area = st.area,
				extra = s.id,
			})
		end
		K.sfx(run, "throw", p.x, p.y)
	end)
end

FN.nova = function(run, p, w, dt)
	tickBurst(w, dt, 0.35, function()
		local st = w.st
		table.insert(run.fx, {
			kind = "nova",
			x = p.x,
			y = p.y,
			rad = 0,
			maxRad = 150 * st.area,
			t = 0,
			life = 0.55,
			hit = {},
			dmg = st.dmg,
			slowDur = st.dur,
			freeze = w.evo,
			wid = "nova",
			slot = p.slot,
		})
		fireEv(run, p, w, p.x, p.y, 0, 0, st.area, 0)
		K.sfx(run, "nova", p.x, p.y)
	end)
end

FN.knives = function(run, p, w, dt)
	tickBurst(w, dt, if w.evo then 0.03 else 0.06, function(i)
		local st = w.st
		if i == 0 then
			local t = K.nearestEnemy(run, p.x, p.y, 380)
			w.aim = if t then atan2(t.y - p.y, t.x - p.x) else atan2(p.dirY, p.dirX)
		end
		local a = w.aim + run.rng:range(-0.07, 0.07)
		local side = ((i % 3) - 1) * 9
		local x, y = p.x - sin(a) * side, p.y + cos(a) * side
		local s = {
			kind = "knife",
			x = x,
			y = y,
			vx = cos(a) * st.speed,
			vy = sin(a) * st.speed,
			r = 6 * st.area,
			dmg = st.dmg,
			pierce = st.pierce,
			life = 0.9,
			t = 0,
			hit = {},
			wid = "knives",
			crit = st.crit,
			evo = w.evo,
			slot = p.slot,
		}
		if addShot(run, s) then
			fireEv(run, p, w, x, y, a, st.speed, st.area, s.id)
		end
		K.sfx(run, "knife", x, y)
	end)
end

Weapons.FN = FN

function K.updateWeapons(run, p, dt: number)
	for _, w in p.weapons do
		FN[w.id](run, p, w, dt)
	end
end

return Weapons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Shared world helpers: events, view rectangles, active players (web Game.view, inViewRect, clampView, edgeDist).
local K = if script then require(script.Parent.K) else require("./K")
local Tuning = if script then require(script.Parent.Parent.Config.Tuning) else require("../Config/Tuning")

local World = {}

local VIEW_HW, VIEW_HH, VIEW_TOP = Tuning.VIEW_HW, Tuning.VIEW_HH, Tuning.VIEW_TOP
local VIEW_R = math.sqrt(VIEW_HW * VIEW_HW + VIEW_HH * VIEW_HH)
World.VIEW_R = VIEW_R

-- ---------- events (web Hooks.* become run.events entries; Appendix B.3) ----------
function K.ev(run, e)
	local evs = run.events
	evs[#evs + 1] = e
end

-- sound cue; deduplicated per step by name (the client plays it once, positional by x/y if given)
function K.sfx(run, name: string, x: number?, y: number?)
	local seen = run.sfxSeen
	if seen[name] then
		return
	end
	seen[name] = true
	K.ev(run, { k = "sfx", name = name, x = x, y = y })
end

-- banner for everyone (slot = nil) or one player
function K.banner(run, text: string, kind: string?, sub: string?, dur: number?, slot: number?, args: { any }?)
	K.ev(run, { k = "banner", text = text, kind = kind or "", sub = sub, dur = dur, slot = slot, args = args })
end

function K.shake(run, amount: number, x: number?, y: number?)
	K.ev(run, { k = "shake", amount = amount, x = x, y = y })
end

-- floating text (gold, heal, damage taken), shown to `slot` only when given
function K.text(run, x: number, y: number, txt: string, color: string, scale: number, slot: number?, args: { any }?)
	K.ev(run, { k = "text", x = x, y = y, text = txt, color = color, scale = scale, slot = slot, args = args })
end

-- ---------- view geometry (fixed sim view, docs/DESIGN.md §1.2) ----------
function K.viewRadius(): number
	return VIEW_R
end

-- distance from the hero to the view edge in direction a
function K.edgeDist(a: number): number
	local c, s = math.abs(math.cos(a)), math.abs(math.sin(a))
	return math.min(if c > 1e-6 then VIEW_HW / c else 1e9, if s > 1e-6 then VIEW_HH / s else 1e9)
end

-- inside player pl's view rectangle (inset world px); top additionally below the HUD band (VIEW_TOP) plus pad
function K.inViewRect(pl, x: number, y: number, inset: number, pad: number?): boolean
	local dy = y - pl.y
	if math.abs(x - pl.x) >= VIEW_HW - inset or math.abs(dy) >= VIEW_HH - inset then
		return false
	end
	return -dy < VIEW_HH - VIEW_TOP - (pad or 0)
end

function K.clampView(pl, x: number, y: number, inset: number): (number, number)
	local hw, hh = VIEW_HW - inset, VIEW_HH - inset
	return math.clamp(x, pl.x - hw, pl.x + hw), math.clamp(y, pl.y - hh, pl.y + hh)
end

-- inside any active player's plain view rectangle except `skip`
function K.inAnyView(run, x: number, y: number, skip): boolean
	for _, pl in run.act do
		if pl ~= skip and math.abs(x - pl.x) < VIEW_HW and math.abs(y - pl.y) < VIEW_HH then
			return true
		end
	end
	return false
end

-- nearest active player to (x, y) and the squared distance (nil when nobody is active)
function K.nearestActive(run, x: number, y: number)
	local best, bd = nil, math.huge
	for _, pl in run.act do
		local dx, dy = pl.x - x, pl.y - y
		local d2 = dx * dx + dy * dy
		if d2 < bd then
			bd = d2
			best = pl
		end
	end
	return best, bd
end

-- a random active player (nil when nobody is active)
function K.randomActive(run)
	local act = run.act
	if #act == 0 then
		return nil
	end
	if #act == 1 then
		return act[1]
	end
	return run.rng:pick(act)
end

-- recompute run.act (active players in slot order) and run.nPlayers (players still in the run)
function K.refreshPlayers(run)
	local act = run.act
	table.clear(act)
	local n = 0
	for _, pl in run.plist do
		if pl.state ~= "left" then
			n += 1
			if pl.state == "active" then
				act[#act + 1] = pl
			end
		end
	end
	run.nPlayers = n
end

-- next id for shots, telegraphs, pickups, hazards and gems (u16 on the wire)
function K.oid(run): number
	local id = run.nextOid
	run.nextOid = if id >= 65535 then 1 else id + 1
	return id
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Version</string>
          <string name="Source"><![CDATA[--!strict
-- Version of the Roblox port; shown in settings and logged on start.
return {
	name = "Ember Night",
	version = "0.0.1-skeleton",
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="56">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="57">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Entitlements</string>
            <string name="Source"><![CDATA[-- What a player may use (docs/DESIGN.md §7.1, §7.2): heroes (earned or through a pass), cosmetics (bought, earned by
-- achievement or through the collection pass), double gold. Pure: the server passes the profile and the set of
-- game pass keys it confirmed with MarketplaceService ({ [passKey] = true }).
-- server-only (ServerScriptService): shared modules come from ReplicatedStorage.Shared
local Shared = if script then game:GetService("ReplicatedStorage"):WaitForChild("Shared") else nil
local Products = if script then require(Shared.Config.Products) else require("../../shared/Config/Products")
local Cosmetics = if script then require(Shared.Config.Cosmetics) else require("../../shared/Config/Cosmetics")
local Profile = if script then require(Shared.Sim.Profile) else require("../../shared/Sim/Profile")

local Entitlements = {}

-- only passes that are configured count (an id of 0 never grants anything)
local function hasPass(passes: { [string]: boolean }?, key: string): boolean
	return passes ~= nil and passes[key] == true and Products.configured(key)
end

-- { [heroId] = true } for heroes unlocked through passes
function Entitlements.passHeroes(passes: { [string]: boolean }?): { [string]: boolean }
	local out = {}
	for _, it in Products.list do
		if it.kind == "pass" and it.heroes and hasPass(passes, it.key) then
			for _, hid in it.heroes do
				out[hid] = true
			end
		end
	end
	return out
end

function Entitlements.heroes(profile, passes: { [string]: boolean }?): { string }
	return Profile.unlockedHeroes(profile, Entitlements.passHeroes(passes))
end

function Entitlements.heroAllowed(profile, passes: { [string]: boolean }?, heroId: string): boolean
	return table.find(Entitlements.heroes(profile, passes), heroId) ~= nil
end

function Entitlements.gold2x(passes: { [string]: boolean }?): boolean
	for _, it in Products.list do
		if it.kind == "pass" and it.gold2x and hasPass(passes, it.key) then
			return true
		end
	end
	return false
end

-- may the player use this cosmetic?
function Entitlements.ownsCosmetic(profile, passes: { [string]: boolean }?, id: string): boolean
	local c = Cosmetics.byId[id]
	if not c then
		return false
	end
	local kind, ref = string.match(c.source, "^(%a+):(.+)$")
	if kind == "achievement" then
		return profile.achievements[ref] == true
	end
	if profile.cosmetics.owned[id] then
		return true
	end
	for _, it in Products.list do
		if it.kind == "pass" and it.allCosmetics and hasPass(passes, it.key) then
			return true
		end
	end
	return false
end

-- { [cosmeticId] = true }
function Entitlements.cosmetics(profile, passes: { [string]: boolean }?): { [string]: boolean }
	local out = {}
	for _, c in Cosmetics.list do
		if Entitlements.ownsCosmetic(profile, passes, c.id) then
			out[c.id] = true
		end
	end
	return out
end

-- equipped cosmetics that are still owned ({ skin = id?, fx = id?, trail = id? }); anything else is dropped
function Entitlements.equipped(profile, passes: { [string]: boolean }?)
	local out = {}
	for _, slot in Cosmetics.SLOTS do
		local id = profile.cosmetics.equipped[slot]
		local c = id and Cosmetics.byId[id]
		if c and c.slot == slot and Entitlements.ownsCosmetic(profile, passes, id) then
			out[slot] = id
		end
	end
	return out
end

-- is the item already owned (passes and stored cosmetics cannot be bought twice)?
function Entitlements.ownsItem(profile, passes: { [string]: boolean }?, key: string): boolean
	local it = Products.byKey[key]
	if not it then
		return false
	end
	if it.kind == "pass" then
		if passes ~= nil and passes[key] == true then
			return true
		end
		-- a pass that would add nothing counts as owned (never sell Robux for nothing): hero passes whose heroes
		-- are all unlocked already (achievement or another pass), the collection pass when every cosmetic is owned
		if it.heroes and #it.heroes > 0 then
			local have = Entitlements.heroes(profile, passes)
			for _, hid in it.heroes do
				if not table.find(have, hid) then
					return false
				end
			end
			return true
		end
		if it.allCosmetics and not it.gold2x then
			for _, c in Cosmetics.list do
				if
					string.match(c.source, "^achievement:") == nil
					and not Entitlements.ownsCosmetic(profile, passes, c.id)
				then
					return false
				end
			end
			return true
		end
		return false
	end
	if it.grant and it.grant.cosmetic then
		return Entitlements.ownsCosmetic(profile, passes, it.grant.cosmetic)
	end
	return false
end

return Entitlements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LockLogic</string>
            <string name="Source"><![CDATA[-- Session lock decisions for the profile DataStore (docs/DESIGN.md §6.2). Pure.
-- A lock is { job = JobId, t = os.time() of the last write }; it is live while younger than LOCK_STALE.
local LockLogic = {}

-- does `lock` belong to this server?
function LockLogic.owns(lock: any, jobId: string): boolean
	return type(lock) == "table" and lock.job == jobId
end

-- is `lock` held by another server that is probably still alive?
function LockLogic.foreignLive(lock: any, jobId: string, now: number, stale: number): boolean
	if type(lock) ~= "table" or type(lock.job) ~= "string" or lock.job == jobId then
		return false
	end
	local t = if type(lock.t) == "number" then lock.t else 0
	return now - t < stale and now - t > -stale -- a clock far in the future counts as stale too
end

-- loading: "take" the profile or "wait" for the other server to release it (force = take over after retries)
function LockLogic.loadDecision(lock: any, jobId: string, now: number, stale: number, force: boolean?): string
	if not force and LockLogic.foreignLive(lock, jobId, now, stale) then
		return "wait"
	end
	return "take"
end

return LockLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[-- Profile sessions on top of a DataStore-like backend (docs/DESIGN.md §6.2, §7.3). Pure and Lune-testable: the
-- Roblox service (Server/Services/Profiles.luau) injects the backend (UpdateAsync wrapper), the clock and `sleep`.
--
--   local store = ProfileStore.new({ backend = b, now = os.time, sleep = task.wait, jobId = game.JobId })
--   store:load(userId)                 -- session lock; nil, "error" | "newer" when the profile cannot be used
--   store:get(userId)                  -- the in-memory profile (mutate it, then save sometime)
--   store:save(userId, release?)       -- UpdateAsync with lock check; release = drop the lock and the session
--   store:grant(userId, purchaseId, productId) -- ProcessReceipt core: "granted" | "notYet", item
--
-- backend.update(key, transform) must behave like DataStore:UpdateAsync: call transform(old) (possibly several
-- times), write its result unless it returned nil, and return ok, result-or-error. It may fail before or after
-- writing; every write carries a stamp `_w` so a retry recognises its own earlier write.
--
-- All operations on one profile are serialised (a per-user mutex), so an autosave can never overwrite a receipt
-- grant that finished while it was waiting.
-- server-only (ServerScriptService): shared modules come from ReplicatedStorage.Shared
local Shared = if script then game:GetService("ReplicatedStorage"):WaitForChild("Shared") else nil
local Profile = if script then require(Shared.Sim.Profile) else require("../../shared/Sim/Profile")
local Products = if script then require(Shared.Config.Products) else require("../../shared/Config/Products")
local LockLogic = if script then require(script.Parent.LockLogic) else require("./LockLogic")
local ReceiptLogic = if script then require(script.Parent.ReceiptLogic) else require("./ReceiptLogic")

local ProfileStore = {}
ProfileStore.__index = ProfileStore

local deepCopy = Profile.deepCopy

export type Session = { data: any, lost: boolean, busy: boolean, loaded: boolean, releasing: boolean? }

function ProfileStore.new(o)
	local self = setmetatable({}, ProfileStore)
	self.backend = o.backend
	self.now = o.now
	self.sleep = o.sleep
	self.jobId = o.jobId
	self.log = o.log or function(_) end
	self.loadTries = o.loadTries or 5 -- tries while another server holds a live lock ...
	self.loadWait = o.loadWait or 6 -- ... seconds apart, then the lock is taken over
	self.backoff = o.backoff or { 1, 2, 4 } -- retries of a failing call (4 attempts)
	self.lockStale = o.lockStale or 1800
	self.sessions = {} :: { [number]: Session }
	self.counter = 0
	return self
end

function ProfileStore.key(userId: number): string
	return "p_" .. tostring(userId)
end

-- up to #backoff + 1 attempts
function ProfileStore:retry(what: string, fn: () -> (boolean, any)): (boolean, any)
	local ok, res = false, nil
	for attempt = 1, #self.backoff + 1 do
		ok, res = fn()
		if ok then
			return true, res
		end
		self.log(string.format("%s failed (attempt %d): %s", what, attempt, tostring(res)))
		if attempt <= #self.backoff then
			self.sleep(self.backoff[attempt])
		end
	end
	return false, res
end

function ProfileStore:stamp(): string
	self.counter += 1
	return self.jobId .. "#" .. tostring(self.counter)
end

local function lock(s: Session, sleep)
	while s.busy do
		sleep(0.05)
	end
	s.busy = true
end

-- ---------- load ----------
function ProfileStore:load(userId: number): (any, string?)
	local existing = self.sessions[userId]
	-- a rejoin while the leave-save of the old session still runs: wait until that release is done (it removes
	-- the session and drops the DataStore lock), then load afresh. Reusing the releasing session would hand out
	-- data whose session vanishes a moment later (nothing would be saved any more).
	while existing and existing.releasing do
		self.sleep(0.05)
		existing = self.sessions[userId]
	end
	if existing then
		lock(existing, self.sleep)
		existing.busy = false
		if existing.loaded then
			return existing.data, nil
		end
		return nil, "error"
	end
	local s: Session = { data = nil, lost = false, busy = true, loaded = false }
	self.sessions[userId] = s
	local key = ProfileStore.key(userId)
	for try = 1, self.loadTries + 1 do
		local force = try > self.loadTries
		local status = "error"
		local ok, res = self:retry("load " .. key, function()
			return self.backend.update(key, function(old)
				local now = self.now()
				local lk = if type(old) == "table" then old._lock else nil
				if LockLogic.loadDecision(lk, self.jobId, now, self.lockStale, force) == "wait" then
					status = "locked"
					return nil
				end
				local prof, err = Profile.migrate(old)
				if not prof then
					status = err or "error"
					return nil
				end
				if old == nil then
					prof.created = now
				end
				prof._lock = { job = self.jobId, t = now }
				prof._w = self:stamp()
				status = "ok"
				return prof
			end)
		end)
		if not ok then
			status = "error"
		end
		if status == "ok" then
			local data = deepCopy(res)
			data._lock = nil
			data._w = nil
			s.data = data
			s.loaded = true
			s.busy = false
			return data, nil
		elseif status ~= "locked" then
			self.sessions[userId] = nil
			s.busy = false
			return nil, status
		end
		if force then
			break
		end
		self.log(string.format("load %s: locked by another server, waiting (%d)", key, try))
		self.sleep(self.loadWait)
	end
	self.sessions[userId] = nil
	s.busy = false
	return nil, "error"
end

function ProfileStore:get(userId: number): any
	local s = self.sessions[userId]
	return if s and s.loaded then s.data else nil
end

function ProfileStore:isLost(userId: number): boolean
	local s = self.sessions[userId]
	return s ~= nil and s.lost
end

-- write `value` (a full profile copy) if our lock still holds; returns "ok" | "lost" | "error"
function ProfileStore:write(userId: number, value: any, release: boolean): string
	local key = ProfileStore.key(userId)
	local stamp = self:stamp()
	local status = "error"
	local ok = self:retry("save " .. key, function()
		return self.backend.update(key, function(old)
			if type(old) == "table" and old._w == stamp then
				status = "ok" -- an earlier attempt of this very write went through before its call failed
				return nil
			end
			if type(old) == "table" and not LockLogic.owns(old._lock, self.jobId) then
				status = "lost"
				return nil
			end
			local v = deepCopy(value)
			v.v = Profile.VERSION
			v.lastSave = self.now()
			v._lock = if release then nil else { job = self.jobId, t = self.now() }
			v._w = stamp
			status = "ok"
			return v
		end)
	end)
	if not ok then
		return "error"
	end
	return status
end

-- ---------- save ----------
-- returns ok, reason ("lost": another server took the profile; the session stops saving)
function ProfileStore:save(userId: number, release: boolean?): (boolean, string?)
	local s = self.sessions[userId]
	if not s or not s.loaded then
		return false, "nosession"
	end
	if s.lost then
		if release then
			self.sessions[userId] = nil
		end
		return false, "lost"
	end
	if release then
		s.releasing = true
	end
	lock(s, self.sleep)
	local res = self:write(userId, s.data, release == true)
	s.busy = false
	if res == "lost" then
		s.lost = true
		self.log("save p_" .. tostring(userId) .. ": session lost to another server")
	end
	if release and self.sessions[userId] == s then
		self.sessions[userId] = nil
	end
	return res == "ok", if res == "ok" then nil else res
end

-- ---------- receipts ----------
-- ProcessReceipt core (§7.3): grants the product to the stored profile and records the receipt in ONE write; the
-- in-memory profile changes only after that write succeeded. Returns "granted" | "notYet", the item, a reason.
function ProfileStore:grant(userId: number, purchaseId: string, productId: number): (string, any, string)
	local item = Products.byProductId(productId)
	local s = self.sessions[userId]
	local decision, reason = ReceiptLogic.decide({
		item = item,
		loaded = s ~= nil and s.loaded,
		lost = s ~= nil and s.lost,
		already = false,
	})
	if decision ~= "apply" then
		return decision, item, reason
	end
	local sess = s :: Session
	lock(sess, self.sleep)
	-- re-check under the lock (a duplicate delivery may have finished while we waited)
	decision, reason = ReceiptLogic.decide({
		item = item,
		loaded = self.sessions[userId] == sess and sess.loaded,
		lost = sess.lost,
		already = sess.data and sess.data.receipts[purchaseId] ~= nil,
	})
	if decision ~= "apply" then
		sess.busy = false
		return decision, item, reason
	end
	local cand = deepCopy(sess.data)
	ReceiptLogic.apply(cand, item, purchaseId, self.now())
	local res = self:write(userId, cand, false)
	if res == "ok" then
		-- apply to the live table (not replace it: the run may have changed it while the write was waiting)
		ReceiptLogic.apply(sess.data, item, purchaseId, self.now())
		sess.busy = false
		return "granted", item, "granted"
	end
	if res == "lost" then
		sess.lost = true
	end
	sess.busy = false
	return "notYet", item, "save " .. res
end

-- every loaded session (for autosave and shutdown)
function ProfileStore:users(): { number }
	local out = {}
	for uid, s in self.sessions do
		if s.loaded then
			table.insert(out, uid)
		end
	end
	table.sort(out)
	return out
end

return ProfileStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">ReceiptLogic</string>
            <string name="Source"><![CDATA[-- Developer product receipts (docs/DESIGN.md §7.3). Pure: the decision table for ProcessReceipt and the grant that
-- is applied to the profile together with the ledger entry (one DataStore write, see ProfileStore.grant).
-- server-only (ServerScriptService): shared modules come from ReplicatedStorage.Shared
local Shared = if script then game:GetService("ReplicatedStorage"):WaitForChild("Shared") else nil
local Products = if script then require(Shared.Config.Products) else require("../../shared/Config/Products")

local ReceiptLogic = {}

ReceiptLogic.LEDGER_MAX = 200 -- entries kept in profile.receipts ...
ReceiptLogic.KEEP_SECONDS = 30 * 86400 -- ... but never one younger than this (Roblox's re-delivery window)
ReceiptLogic.LEDGER_HARD_MAX = 1000 -- absolute cap (profile size) even for young entries

-- "notYet" (Roblox retries later), "granted" (already done) or "apply"; second value = reason
-- s = { item = configured product or nil, loaded = profile in memory, lost = session lock lost, already = receipt
--       id in the ledger }
function ReceiptLogic.decide(s: { item: any, loaded: boolean, lost: boolean?, already: boolean? }): (string, string)
	if not s.item then
		return "notYet", "unknown product"
	end
	if not s.loaded then
		return "notYet", "profile not loaded"
	end
	if s.lost then
		return "notYet", "session lost"
	end
	if s.already then
		return "granted", "already granted"
	end
	return "apply", "new"
end

-- drop the oldest entries beyond LEDGER_MAX, keeping every entry younger than KEEP_SECONDS (up to LEDGER_HARD_MAX)
function ReceiptLogic.prune(receipts: { [string]: number }, now: number)
	local ids = {}
	for id in receipts do
		table.insert(ids, id)
	end
	if #ids <= ReceiptLogic.LEDGER_MAX then
		return
	end
	table.sort(ids, function(a, b)
		if receipts[a] ~= receipts[b] then
			return receipts[a] > receipts[b]
		end
		return a > b
	end)
	for i = ReceiptLogic.LEDGER_MAX + 1, #ids do
		local id = ids[i]
		if i > ReceiptLogic.LEDGER_HARD_MAX or now - receipts[id] >= ReceiptLogic.KEEP_SECONDS then
			receipts[id] = nil
		end
	end
end

-- apply the product's grant to `profile` and record the receipt (the caller writes the result in one save)
function ReceiptLogic.apply(profile, item: Products.Item, purchaseId: string, now: number)
	local g = item.grant or {}
	if g.gold then
		profile.gold += g.gold
	end
	if g.revive then
		profile.reviveTokens += g.revive
	end
	if g.cosmetic then
		-- an already owned cosmetic: the receipt is recorded, nothing else changes (the UI prevents this)
		profile.cosmetics.owned[g.cosmetic] = true
	end
	profile.receipts[purchaseId] = now
	ReceiptLogic.prune(profile.receipts, now)
end

return ReceiptLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ReviveFlow</string>
            <string name="Source"><![CDATA[-- Robux revive ("Second Ember", docs/DESIGN.md §2.8 points 5-6, §7.3 point 5). Pure: works on the run and the
-- player's profile. A purchase adds a token to the profile (persistent, idempotent); a token is consumed only when it
-- actually revives the player, at most REVIVE_MAX_PER_RUN times per player and run (enforced by the sim).
-- server-only (ServerScriptService): shared modules come from ReplicatedStorage.Shared
local Shared = if script then game:GetService("ReplicatedStorage"):WaitForChild("Shared") else nil
local Run = if script then require(Shared.Sim.Run) else require("../../shared/Sim/Run")

local ReviveFlow = {}

-- what the downed screen offers: use = a stored token can revive now, buy = the product may be prompted
function ReviveFlow.offer(
	run,
	slot: number,
	profile,
	productConfigured: boolean
): { use: boolean, buy: boolean, tokens: number }
	local can = run ~= nil and Run.canRobuxRevive(run, slot)
	local tokens = if profile then profile.reviveTokens else 0
	return {
		use = can and tokens > 0,
		buy = can and tokens == 0 and productConfigured,
		tokens = tokens,
	}
end

-- keep the sim's offer flag in line with the profile and the product configuration
function ReviveFlow.sync(run, slot: number, profile, productConfigured: boolean)
	Run.setReviveOffer(run, slot, productConfigured or (profile ~= nil and profile.reviveTokens > 0))
end

-- consume one token and revive; false (token kept) when the player cannot be revived now
function ReviveFlow.useToken(run, slot: number, profile): boolean
	if not run or not profile or profile.reviveTokens <= 0 or not Run.canRobuxRevive(run, slot) then
		return false
	end
	if Run.command(run, slot, { op = "revive" }) then
		profile.reviveTokens -= 1
		return true
	end
	return false
end

return ReviveFlow
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="64">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server bootstrap (docs/DESIGN.md §3.1): hub, remotes, then every service (Services/Boot.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(script.Parent.Services.Net)
local Boot = require(script.Parent.Services.Boot)
local HubBuilder = require(script.Parent.World.HubBuilder)

local Version = require(ReplicatedStorage:WaitForChild("Shared").Version)

HubBuilder.build()
Net.init()
Boot.start(Net)

print(string.format("[%s %s] server ready", Version.name, Version.version))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Boot</string>
            <string name="Source"><![CDATA[-- Wires the server services together (docs/DESIGN.md §3.1). Main.server.luau calls Boot.start with the real Net
-- service; the Lune smoke test (tests/server.spec.luau) calls it with a recording fake.
local Players = game:GetService("Players")

local Services = script.Parent
local Profiles = require(Services.Profiles)
local Passes = require(Services.Passes)
local ProductInfo = require(Services.ProductInfo)
local Purchases = require(Services.Purchases)
local Policy = require(Services.Policy)
local Meta = require(Services.Meta)
local RunHost = require(Services.RunHost)
local Lobby = require(Services.Lobby)

local Boot = {}

function Boot.start(Net)
	local deps = {
		Net = Net,
		Profiles = Profiles,
		Passes = Passes,
		ProductInfo = ProductInfo,
		Purchases = Purchases,
		Meta = Meta,
		RunHost = RunHost,
		Lobby = Lobby,
	}
	Meta.init(deps)
	RunHost.init(deps)
	Lobby.init(deps)
	Passes.init(deps)
	Purchases.init(deps)
	ProductInfo.init()
	Policy.init()
	-- shutdown: the run in progress books every player's results before the profiles are saved and released
	Profiles.beforeClose(function()
		for _, player in Players:GetPlayers() do
			RunHost.onLeave(player)
		end
	end)
	Profiles.init() -- last: loading profiles fires the callbacks registered above

	-- leaving: the run books the player's results first, then the profile is saved and released
	Players.PlayerRemoving:Connect(function(player)
		RunHost.onLeave(player)
		Lobby.onLeave(player)
		Purchases.onLeave(player)
		Passes.onLeave(player)
		Policy.onLeave(player)
		Profiles.release(player)
	end)
	return deps
end

return Boot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">DataStoreAdapter</string>
            <string name="Source"><![CDATA[-- The profile DataStore behind ProfileStore's `backend.update` (docs/DESIGN.md §6.2): UpdateAsync with request
-- budget waits, or an in-memory store in Studio without API access (and with Tuning.FORCE_MEMORY_STORE).
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tuning = require(Shared.Config.Tuning)
local Profile = require(Shared.Sim.Profile)

local DataStoreAdapter = {}

DataStoreAdapter.STORE_NAME = "EmberNight_Profiles_v1"
DataStoreAdapter.BUDGET_WAIT_MAX = 10

local memory: { [string]: any } = {}
local useMemory = Tuning.FORCE_MEMORY_STORE == true
local store: DataStore? = nil
local onMemory: { () -> () } = {}

local function switchToMemory(why: string)
	if useMemory then
		return
	end
	useMemory = true
	warn("[EmberNight] profiles are kept in memory only (" .. why .. ")")
	for _, f in onMemory do
		task.spawn(f)
	end
end

-- true while profiles are not really saved (Studio without API access)
function DataStoreAdapter.isMemory(): boolean
	return useMemory
end

function DataStoreAdapter.onMemory(f: () -> ())
	table.insert(onMemory, f)
end

local function memoryUpdate(key: string, transform: (any) -> any): (boolean, any)
	local new = transform(Profile.deepCopy(memory[key]))
	if new ~= nil then
		memory[key] = Profile.deepCopy(new)
	end
	return true, new
end

-- an error that means "this place may not use DataStores" (unpublished place / API access off in Studio)
local function isAccessError(msg: string): boolean
	return string.find(msg, "403", 1, true) ~= nil
		or string.find(msg, "Studio", 1, true) ~= nil
		or string.find(msg, "publish", 1, true) ~= nil
end

local function waitBudget(kind: Enum.DataStoreRequestType)
	local waited = 0
	while waited < DataStoreAdapter.BUDGET_WAIT_MAX do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(kind)
		end)
		if not ok or budget > 0 then
			return
		end
		waited += task.wait(0.5)
	end
end

function DataStoreAdapter.init()
	if useMemory then
		return
	end
	if RunService:IsStudio() and game.GameId == 0 then
		switchToMemory("unpublished place in Studio")
		return
	end
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(DataStoreAdapter.STORE_NAME)
	end)
	if ok then
		store = res
	elseif RunService:IsStudio() then
		switchToMemory(tostring(res))
	else
		warn("[EmberNight] GetDataStore failed: " .. tostring(res))
	end
end

-- ProfileStore backend: UpdateAsync semantics, returns ok, result-or-error
DataStoreAdapter.backend = {
	update = function(key: string, transform: (any) -> any): (boolean, any)
		if useMemory then
			return memoryUpdate(key, transform)
		end
		local ds = store
		if not ds then
			return false, "no DataStore"
		end
		waitBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, res = pcall(function()
			return ds:UpdateAsync(key, function(old)
				return transform(old)
			end)
		end)
		if not ok and RunService:IsStudio() and isAccessError(tostring(res)) then
			switchToMemory(tostring(res))
			return memoryUpdate(key, transform)
		end
		return ok, res
	end,
}

return DataStoreAdapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[-- The party on this server (docs/DESIGN.md §2.1, §2.3): members in join order, leader, hero/land/heat selection,
-- ready state, start countdown, spectators while a run is in progress.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tuning = require(Shared.Config.Tuning)
local Profile = require(Shared.Sim.Profile)
local Stages = require(Shared.Sim.Data.Stages)
local Entitlements = require(script.Parent.Parent.Logic.Entitlements)

local Lobby = {}

type Member = { player: Player, hero: string, ready: boolean, joined: number }

local members: { Member } = {}
local stageId = "graveyard"
local heat = 0
local countdownToken = 0
local countdownEnd = 0
local deps: any = nil
local joinCounter = 0

local function find(player: Player): Member?
	for _, m in members do
		if m.player == player then
			return m
		end
	end
	return nil
end

function Lobby.leader(): Player?
	local m = members[1]
	return m and m.player
end

local function stageIndex(id: string): number
	for i, s in Stages.list do
		if s.id == id then
			return i
		end
	end
	return 1
end

-- keep the chosen land/heat valid for the current leader's profile
local function clampSelection()
	local leader = Lobby.leader()
	if not leader then
		return
	end
	local prof = deps.Profiles.get(leader)
	if not prof then
		return
	end
	if not Profile.stageUnlocked(prof, stageIndex(stageId)) then
		stageId = "graveyard"
	end
	heat = math.clamp(heat, 0, Profile.stageMaxHeat(prof, stageId))
end

function Lobby.broadcast()
	clampSelection()
	Lobby.revalidate()
	local list = {}
	local leader = Lobby.leader()
	for _, m in members do
		table.insert(list, {
			userId = m.player.UserId,
			name = m.player.DisplayName,
			hero = m.hero,
			ready = m.ready,
			leader = m.player == leader,
		})
	end
	local running = deps.RunHost.running()
	for _, m in members do
		local prof = deps.Profiles.get(m.player)
		local lprof = if leader then deps.Profiles.get(leader) else prof
		lprof = lprof or prof
		if prof then
			local stages = {}
			for i, s in Stages.list do
				table.insert(stages, {
					id = s.id,
					unlocked = Profile.stageUnlocked(lprof, i),
					maxHeat = Profile.stageMaxHeat(lprof, s.id),
					stars = Profile.stageStars(prof, s.id),
					best = Profile.stageBest(prof, s.id),
				})
			end
			deps.Net.ui(m.player, {
				t = "lobby",
				members = list,
				you = m.player.UserId,
				isLeader = m.player == leader,
				stage = stageId,
				heat = heat,
				stages = stages,
				heroes = Entitlements.heroes(prof, deps.Passes.get(m.player)),
				running = running,
				countdown = if countdownEnd > 0 then math.max(0, countdownEnd - os.clock()) else nil,
				profile = deps.Meta.view(m.player),
			})
		end
	end
end

local function cancelCountdown()
	if countdownEnd > 0 then
		countdownToken += 1
		countdownEnd = 0
	end
end

local function startNow()
	countdownEnd = 0
	if deps.RunHost.running() or #members == 0 then
		return
	end
	local parts = {}
	for i, m in members do
		if i > Tuning.MAX_PLAYERS then
			break
		end
		table.insert(parts, { player = m.player, hero = m.hero })
		m.ready = false
	end
	deps.RunHost.start(parts, stageId, heat)
	-- more members than seats (MaxPlayers should prevent it): they watch
	for i, m in members do
		if i > Tuning.MAX_PLAYERS then
			deps.RunHost.addSpectator(m.player)
		end
	end
	Lobby.broadcast()
end

-- a member may stop the leader's start countdown (un-ready) at most once per CANCEL_GAP seconds; spammed
-- un-ready toggles cannot keep the party from starting
local CANCEL_GAP = 20
local lastCancel: { [Player]: number } = {}

-- lobby commands only refresh the hub when something changed, and through Meta.push (coalesced, at most every
-- 0.2 s): a client spamming commands cannot turn into a stream of full lobby messages to every member
function Lobby.command(player: Player, c)
	local m = find(player)
	if not m then
		return
	end
	local isLeader = player == Lobby.leader()
	local running = deps.RunHost.running()
	local prof = deps.Profiles.get(player)
	if not prof then
		return
	end
	local changed = false
	if c.op == "selectHero" then
		-- allowed during a run (spectators / members pick for the next run)
		if m.hero ~= c.hero and Entitlements.heroAllowed(prof, deps.Passes.get(player), c.hero) then
			m.hero = c.hero
			prof.lastChar = c.hero
			changed = true
		end
	elseif c.op == "selectStage" then
		if not isLeader or running then
			return
		end
		local idx = stageIndex(c.stage)
		if
			(stageId ~= c.stage or heat ~= c.heat)
			and Profile.stageUnlocked(prof, idx)
			and c.heat <= Profile.stageMaxHeat(prof, c.stage)
		then
			stageId = c.stage
			heat = c.heat
			prof.stageSel = c.stage
			prof.stageHeat[c.stage] = c.heat
			cancelCountdown()
			changed = true
		end
	elseif c.op == "ready" then
		if running or m.ready == c.on then
			return
		end
		if not c.on and countdownEnd > 0 then
			local now = os.clock()
			if now - (lastCancel[player] or -math.huge) < CANCEL_GAP then
				return -- he already stopped a start a moment ago: the countdown runs on
			end
			lastCancel[player] = now
			cancelCountdown()
		end
		m.ready = c.on
		changed = true
	elseif c.op == "start" then
		if not isLeader or running or countdownEnd > 0 then
			return
		end
		m.ready = true
		for _, o in members do
			o.ready = true
		end
		if #members <= 1 then
			startNow()
			return
		end
		countdownToken += 1
		local token = countdownToken
		countdownEnd = os.clock() + Tuning.START_COUNTDOWN
		task.delay(Tuning.START_COUNTDOWN, function()
			if token == countdownToken then
				startNow()
			end
		end)
		changed = true
	end
	if changed then
		deps.Meta.push(player)
	end
end

function Lobby.onRunEnded()
	Lobby.broadcast()
end

function Lobby.init(d)
	deps = d
	-- a player joins the party once his profile is loaded
	deps.Profiles.onLoaded(function(player: Player)
		if find(player) or not player.Parent then
			return
		end
		joinCounter += 1
		local prof = deps.Profiles.get(player)
		local hero = prof.lastChar
		if not Entitlements.heroAllowed(prof, deps.Passes.get(player), hero) then
			hero = "aron"
		end
		table.insert(members, { player = player, hero = hero, ready = false, joined = joinCounter })
		Lobby.broadcast()
		if deps.RunHost.running() then
			deps.RunHost.addSpectator(player)
		end
	end)
end

-- the hero a member plays must still be allowed (a pass check can take a hero away after the cache guessed)
function Lobby.revalidate()
	for _, m in members do
		local prof = deps.Profiles.get(m.player)
		if prof and not Entitlements.heroAllowed(prof, deps.Passes.get(m.player), m.hero) then
			m.hero = "aron"
		end
	end
end

function Lobby.onLeave(player: Player)
	lastCancel[player] = nil
	for i, m in members do
		if m.player == player then
			table.remove(members, i)
			break
		end
	end
	cancelCountdown()
	Lobby.broadcast()
end

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Meta</string>
            <string name="Source"><![CDATA[-- Meta progression outside runs (docs/DESIGN.md §5.2, §6.3): forge buy/refund, cosmetics equip, settings, and the
-- profile view the client's hub screens show (heroes incl. passes, cosmetics, live shop prices, owned state).
-- Every command is validated by Shared/Server/Validate.luau first and checked against the profile here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)
local Cosmetics = require(Shared.Config.Cosmetics)
local Profile = require(Shared.Sim.Profile)
local Entitlements = require(script.Parent.Parent.Logic.Entitlements)

local Meta = {}

local deps: any = nil
local pushQueued = false

-- the shop as one player sees it: configured items with a live price, owned state
local function shopView(prof, passes)
	local items = {}
	for _, it in Products.list do
		if it.id > 0 and it.tab ~= "none" then
			local price = deps.ProductInfo.price(it.key)
			if price then
				table.insert(items, {
					key = it.key,
					tab = it.tab,
					kind = it.kind,
					price = price,
					owned = Entitlements.ownsItem(prof, passes, it.key),
					order = it.order,
				})
			end
		end
	end
	local revive = Products.get("revive")
	return {
		items = items,
		revivePrice = if revive then deps.ProductInfo.price("revive") else nil,
	}
end

-- the full profile view for the client (hub screens)
function Meta.view(player: Player)
	local prof = deps.Profiles.get(player)
	local v = deps.Profiles.baseView(player)
	if not prof or not v then
		return nil
	end
	local passes = deps.Passes.get(player)
	v.heroes = Entitlements.heroes(prof, passes)
	v.passHeroes = Entitlements.passHeroes(passes)
	v.passes = table.clone(passes)
	v.gold2x = Entitlements.gold2x(passes)
	v.cosmetics = Entitlements.cosmetics(prof, passes)
	v.equipped = Entitlements.equipped(prof, passes)
	v.shop = shopView(prof, passes)
	v.forgeRefund = prof.shopSpent
	return v
end

-- equipped cosmetics of a player (validated against ownership) for the arena
function Meta.equipped(player: Player)
	local prof = deps.Profiles.get(player)
	if not prof then
		return {}
	end
	return Entitlements.equipped(prof, deps.Passes.get(player))
end

-- profile changed: refresh the hub of everybody (coalesced, at most every PUSH_GAP seconds: a client spamming
-- commands cannot turn into a stream of lobby messages to all players)
local PUSH_GAP = 0.2
local lastPush = -math.huge
function Meta.push(_player: Player?)
	if pushQueued then
		return
	end
	pushQueued = true
	task.delay(math.max(0, lastPush + PUSH_GAP - os.clock()), function()
		pushQueued = false
		lastPush = os.clock()
		deps.Lobby.broadcast()
	end)
end

local SETTINGS_BOOL = { sfx = true, music = true, dmgNums = true, shake = true, lowFx = true }

function Meta.command(player: Player, c): boolean
	local prof = deps.Profiles.get(player)
	if not prof then
		return false
	end
	local op = c.op
	if op == "forgeBuy" then
		if deps.RunHost.inRun(player) then
			return true
		end
		if Profile.forgeBuy(prof, c.id) then
			Meta.push(player)
		end
		return true
	elseif op == "forgeRefund" then
		if deps.RunHost.inRun(player) then
			return true
		end
		if prof.shopSpent > 0 then
			Profile.forgeRefund(prof)
			Meta.push(player)
		end
		return true
	elseif op == "equip" then
		local passes = deps.Passes.get(player)
		if c.id == "" then
			prof.cosmetics.equipped[c.slot] = nil
		else
			local cos = Cosmetics.byId[c.id]
			if not cos or cos.slot ~= c.slot or not Entitlements.ownsCosmetic(prof, passes, c.id) then
				return true
			end
			prof.cosmetics.equipped[c.slot] = c.id
		end
		Meta.push(player)
		return true
	elseif op == "setting" then
		if SETTINGS_BOOL[c.key] and type(c.value) == "boolean" then
			prof.settings[c.key] = c.value
		elseif c.key == "camZoom" and type(c.value) == "number" and c.value == c.value then
			prof.settings.camZoom = math.clamp(math.floor(c.value * 20 + 0.5) / 20, 0.7, 1.3)
		else
			return true
		end
		Meta.push(player)
		return true
	elseif op == "lang" then
		prof.settings.lang = c.lang
		Meta.push(player)
		return true
	elseif op == "storySeen" then
		prof.storySeen[c.stage] = true
		return true
	elseif op == "buy" then
		deps.Purchases.buy(player, c.key)
		return true
	elseif op == "useRevive" then
		deps.Purchases.useRevive(player)
		return true
	end
	return false
end

function Meta.init(d)
	deps = d
	deps.Profiles.changed = Meta.push
	deps.Profiles.onLoaded(function(_player)
		Meta.push()
	end)
end

return Meta
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[-- Remotes (docs/DESIGN.md §3.1): creates ReplicatedStorage.Remotes, rate-limits and validates everything that comes
-- from clients, and offers send helpers. Other services register handlers in Net.handlers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Protocol = require(Shared.Net.Protocol)
local Codec = require(Shared.Net.Codec)
local RateLimit = require(Shared.Server.RateLimit)
local Validate = require(Shared.Server.Validate)

local Net = {}

Net.handlers = {
	move = nil :: ((Player, any) -> ())?,
	command = nil :: ((Player, any) -> ())?,
	query = nil :: ((Player, string) -> any)?,
}

local remotes: { [string]: Instance } = {}
local moveLimit = RateLimit.new(30, 30)
local cmdLimit = RateLimit.new(20, 20)
local queryLimit = RateLimit.new(4, 8)

function Net.init()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for name, class in Protocol.REMOTES do
		local r = Instance.new(class)
		r.Name = name
		r.Parent = folder
		remotes[name] = r
	end
	folder.Parent = ReplicatedStorage

	local move = remotes.Move :: UnreliableRemoteEvent
	move.OnServerEvent:Connect(function(player: Player, b: any)
		if not moveLimit:allow(player, os.clock()) then
			return
		end
		local m = Codec.decodeMove(b)
		if m and Net.handlers.move then
			Net.handlers.move(player, m)
		end
	end)

	local cmd = remotes.Cmd :: RemoteEvent
	cmd.OnServerEvent:Connect(function(player: Player, raw: any)
		if not cmdLimit:allow(player, os.clock()) then
			return
		end
		local c = Validate.command(raw)
		if c and Net.handlers.command then
			Net.handlers.command(player, c)
		end
	end)

	local query = remotes.Query :: RemoteFunction
	query.OnServerInvoke = function(player: Player, what: any)
		if type(what) ~= "string" or not queryLimit:allow(player, os.clock()) then
			return nil
		end
		if Net.handlers.query then
			return Net.handlers.query(player, what)
		end
		return nil
	end

	Players.PlayerRemoving:Connect(function(player)
		moveLimit:forget(player)
		cmdLimit:forget(player)
		queryLimit:forget(player)
	end)
end

function Net.ui(player: Player, msg: { [string]: any })
	(remotes.Ui :: RemoteEvent):FireClient(player, msg)
end

function Net.uiAll(msg: { [string]: any })
	(remotes.Ui :: RemoteEvent):FireAllClients(msg)
end

function Net.ev(player: Player, b: buffer)
	(remotes.Ev :: RemoteEvent):FireClient(player, b)
end

function Net.snap(player: Player, b: buffer)
	(remotes.Snap :: UnreliableRemoteEvent):FireClient(player, b)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Passes</string>
            <string name="Source"><![CDATA[-- Game pass ownership (docs/DESIGN.md §7.2): checked live with UserOwnsGamePassAsync on join (3 tries per pass),
-- the profile's passCache is the first guess until the check is done. A purchase (PromptGamePassPurchaseFinished
-- with wasPurchased, a server-side event) counts at once; it is not re-checked, because UserOwnsGamePassAsync
-- results are cached per server and can still say "not owned" right after a purchase. Only configured passes
-- (Config/Products.luau, id > 0) exist here.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)

local Passes = {}

local owned: { [Player]: { [string]: boolean } } = {}
local checked: { [Player]: boolean } = {}
local bought: { [Player]: { [string]: boolean } } = {} -- bought on this server (never overridden by a check)
local deps: any = nil

local function userOwns(userId: number, passId: number): boolean?
	for attempt = 1, 3 do
		local ok, res = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(userId, passId)
		end)
		if ok then
			return res == true
		end
		if attempt < 3 then
			task.wait(attempt)
		end
	end
	return nil -- unknown
end

local function configuredPasses()
	local out = {}
	for _, it in Products.list do
		if it.kind == "pass" and it.id > 0 then
			table.insert(out, it)
		end
	end
	return out
end

local function check(player: Player)
	if not deps.Profiles.waitLoaded(player, 60) then
		return
	end
	local prof = deps.Profiles.get(player)
	local t = owned[player] or {}
	owned[player] = t
	-- first guess from the cache
	for key in prof.passCache do
		if Products.configured(key) then
			t[key] = true
		end
	end
	deps.Profiles.changed(player)
	for _, it in configuredPasses() do
		local res = userOwns(player.UserId, it.id)
		if not player.Parent then
			return
		end
		if res ~= nil and not (bought[player] and bought[player][it.key]) then
			t[it.key] = res or nil
			prof.passCache[it.key] = res or nil
		end
	end
	checked[player] = true
	deps.Profiles.changed(player)
end

-- confirmed (or cached) pass keys of a player: { [key] = true }
function Passes.get(player: Player): { [string]: boolean }
	return owned[player] or {}
end

function Passes.isChecked(player: Player): boolean
	return checked[player] == true
end

function Passes.init(d)
	deps = d
	Players.PlayerAdded:Connect(check)
	for _, p in Players:GetPlayers() do
		task.spawn(check, p)
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, wasPurchased: boolean)
			if not wasPurchased then
				return
			end
			local it = Products.byPassId(passId)
			if not it then
				return
			end
			local t = owned[player] or {}
			owned[player] = t
			t[it.key] = true
			bought[player] = bought[player] or {}
			bought[player][it.key] = true
			local prof = deps.Profiles.get(player)
			if prof then
				prof.passCache[it.key] = true
			end
			deps.Net.ui(player, { t = "purchased", key = it.key })
			deps.Profiles.changed(player)
		end
	)
end

function Passes.onLeave(player: Player)
	owned[player] = nil
	checked[player] = nil
	bought[player] = nil
end

return Passes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Policy</string>
            <string name="Source"><![CDATA[-- PolicyService lookup per player (docs/DESIGN.md §8). The game has no paid random items, no external links and no
-- trading, so nothing depends on the result yet; it is kept so later features can respect it. Failures are ignored.
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")

local Policy = {}

local info: { [Player]: any } = {}

local function lookup(player: Player)
	local ok, res = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if ok and player.Parent then
		info[player] = res
	end
end

function Policy.get(player: Player): any
	return info[player]
end

function Policy.init()
	Players.PlayerAdded:Connect(lookup)
	for _, p in Players:GetPlayers() do
		task.spawn(lookup, p)
	end
end

function Policy.onLeave(player: Player)
	info[player] = nil
end

return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">ProductInfo</string>
            <string name="Source"><![CDATA[-- Live Robux prices (docs/DESIGN.md §7.1): MarketplaceService product info for every configured product and pass,
-- cached for 10 minutes and refreshed in the background. Items whose info cannot be fetched are hidden by the shop.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)

local ProductInfo = {}

ProductInfo.CACHE_TIME = 600

local cache: { [string]: { price: number?, t: number } } = {}
local fetching: { [string]: boolean } = {}

-- GetProductInfoAsync is the current name; older engines only know GetProductInfo (same arguments)
local function fetch(id: number, infoType: Enum.InfoType): any
	local ok, res = pcall(function()
		return (MarketplaceService :: any):GetProductInfoAsync(id, infoType)
	end)
	if not ok then
		ok, res = pcall(function()
			return (MarketplaceService :: any):GetProductInfo(id, infoType)
		end)
	end
	return if ok then res else nil
end

local function refresh(it: Products.Item)
	if fetching[it.key] then
		return
	end
	fetching[it.key] = true
	local info = fetch(it.id, if it.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
	local price = nil
	if type(info) == "table" and type(info.PriceInRobux) == "number" and info.PriceInRobux > 0 then
		local forSale = info.IsForSale
		if forSale ~= false then
			price = info.PriceInRobux
		end
	end
	local old = cache[it.key]
	-- a failed refresh keeps the last known price (Roblox web hiccups should not empty the shop)
	if price or (type(info) == "table" and old ~= nil) then
		-- fetched: a price, or an item that is no longer for sale (hidden until the next refresh)
		cache[it.key] = { price = price, t = os.clock() }
	elseif old then
		old.t = os.clock() - ProductInfo.CACHE_TIME + 60 -- retry in a minute
	else
		-- no price yet (fetch failed / not for sale): ask again in a minute, not only after CACHE_TIME
		cache[it.key] = { price = nil, t = os.clock() - ProductInfo.CACHE_TIME + 60 }
	end
	fetching[it.key] = nil
end

-- live price in Robux, or nil (not configured / not for sale / not fetched yet)
function ProductInfo.price(key: string): number?
	local it = Products.get(key)
	if not it then
		return nil
	end
	local c = cache[key]
	if not c or os.clock() - c.t > ProductInfo.CACHE_TIME then
		task.spawn(refresh, it)
	end
	return c and c.price
end

-- fetch every configured item once (yields; called in the background at start)
function ProductInfo.warm()
	for _, it in Products.list do
		if it.id > 0 then
			refresh(it)
		end
	end
end

function ProductInfo.init()
	task.spawn(function()
		while true do
			ProductInfo.warm()
			task.wait(ProductInfo.CACHE_TIME)
		end
	end)
end

return ProductInfo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Profiles</string>
            <string name="Source"><![CDATA[-- Player profiles in the DataStore (docs/DESIGN.md §6.2): load with session lock on join (kick when it cannot be
-- loaded), autosave every Tuning.AUTOSAVE seconds, save after runs and purchases, release on leave, save all on
-- shutdown. The logic lives in Server/Logic/ProfileStore.luau (Lune-tested); this module adds Roblox services.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tuning = require(Shared.Config.Tuning)
local Profile = require(Shared.Sim.Profile)
local Lang = require(Shared.Lang.Lang)
local ProfileStore = require(script.Parent.Parent.Logic.ProfileStore)
local DataStoreAdapter = require(script.Parent.DataStoreAdapter)

local Profiles = {}

local store: any = nil
local loaded: { [Player]: boolean } = {}
local loadedCallbacks: { (Player) -> () } = {}
local closeCallbacks: { () -> () } = {}
local SHUTDOWN_WAIT = 25

local function kickText(player: Player, de: string, en: string): string
	return if Lang.fromLocale(player.LocaleId) == "de" then de else en
end

local function onLost(player: Player)
	if player.Parent then
		player:Kick(
			kickText(
				player,
				"Dein Profil wurde auf einem anderen Server geöffnet. Bitte tritt erneut bei.",
				"Your profile was opened on another server. Please rejoin."
			)
		)
	end
end

local function load(player: Player)
	local data, err = store:load(player.UserId)
	if not player.Parent then
		-- left while loading: give the lock back at once
		if data then
			store:save(player.UserId, true)
		end
		return
	end
	if not data then
		if err == "newer" then
			player:Kick(
				kickText(
					player,
					"Dieser Server ist veraltet. Bitte tritt erneut bei.",
					"This server is out of date. Please rejoin."
				)
			)
		else
			player:Kick(
				kickText(
					player,
					"Dein Profil konnte nicht geladen werden. Bitte versuche es gleich noch einmal.",
					"Your profile could not be loaded. Please try again in a moment."
				)
			)
		end
		return
	end
	loaded[player] = true
	for _, f in loadedCallbacks do
		task.spawn(f, player)
	end
end

function Profiles.init()
	DataStoreAdapter.init()
	local jobId = game.JobId
	if jobId == "" then
		jobId = "studio-" .. HttpService:GenerateGUID(false)
	end
	store = ProfileStore.new({
		backend = DataStoreAdapter.backend,
		now = os.time,
		sleep = task.wait,
		jobId = jobId,
		lockStale = Tuning.LOCK_STALE,
		log = function(msg)
			warn("[EmberNight] " .. msg)
		end,
	})
	Players.PlayerAdded:Connect(function(player)
		load(player)
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(load, p)
	end
	-- autosave
	task.spawn(function()
		while true do
			task.wait(Tuning.AUTOSAVE)
			for player in loaded do
				task.spawn(Profiles.save, player)
			end
		end
	end)
	game:BindToClose(function()
		-- first book what is still open (the run in progress), then save and release every session
		for _, f in closeCallbacks do
			local ok, err = pcall(f)
			if not ok then
				warn("[EmberNight] shutdown: " .. tostring(err))
			end
		end
		local pending = 0
		for _, uid in store:users() do
			pending += 1
			task.spawn(function()
				store:save(uid, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < SHUTDOWN_WAIT do
			task.wait(0.1)
		end
	end)
	DataStoreAdapter.onMemory(function()
		for player in loaded do
			Profiles.changed(player)
		end
	end)
end

-- run f() at shutdown before the sessions are saved and released
function Profiles.beforeClose(f: () -> ())
	table.insert(closeCallbacks, f)
end

-- run f(player) for every player whose profile is loaded (now and later)
function Profiles.onLoaded(f: (Player) -> ())
	table.insert(loadedCallbacks, f)
	for player in loaded do
		task.spawn(f, player)
	end
end

function Profiles.isLoaded(player: Player): boolean
	return loaded[player] == true
end

-- wait (yielding) until the profile is loaded; false after `timeout` seconds or when the player left
function Profiles.waitLoaded(player: Player, timeout: number): boolean
	local t0 = os.clock()
	while not loaded[player] and player.Parent and os.clock() - t0 < timeout do
		task.wait(0.25)
	end
	return loaded[player] == true
end

-- the in-memory profile (nil while loading); mutate it, it is saved by autosave / Profiles.save
function Profiles.get(player: Player): any
	if not loaded[player] then
		return nil
	end
	return store:get(player.UserId)
end

function Profiles.store()
	return store
end

-- language of the player: profile setting, else his Roblox locale
function Profiles.lang(player: Player): string
	local p = Profiles.get(player)
	return (p and p.settings.lang) or Lang.fromLocale(player.LocaleId)
end

-- hook for "the profile changed, refresh the client" (set by Meta)
Profiles.changed = function(_player: Player) end

function Profiles.save(player: Player)
	if not loaded[player] then
		return
	end
	local ok, why = store:save(player.UserId)
	if not ok and why == "lost" then
		onLost(player)
	end
end

-- leaving: save and release the lock (called by Main after the run booked the player's results)
function Profiles.release(player: Player)
	if not loaded[player] then
		return
	end
	loaded[player] = nil
	store:save(player.UserId, true)
end

-- the yellow "not saved" label in Studio
function Profiles.memoryOnly(): boolean
	return DataStoreAdapter.isMemory()
end

-- the profile as the client sees it (passes = confirmed game pass keys, from Passes)
function Profiles.baseView(player: Player)
	local p = Profiles.get(player)
	if not p then
		return nil
	end
	return {
		gold = p.gold,
		stars = Profile.totalStars(p),
		stages = p.stages,
		stageHeat = p.stageHeat,
		lang = Profiles.lang(player),
		lastChar = p.lastChar,
		stats = p.stats,
		forge = p.shop, -- forge levels (`shop` in the profile, web name)
		shopSpent = p.shopSpent,
		achievements = p.achievements,
		evolved = p.evolved,
		bosses = p.bosses,
		settings = p.settings,
		reviveTokens = p.reviveTokens,
		memoryOnly = DataStoreAdapter.isMemory(),
		studio = RunService:IsStudio(),
	}
end

return Profiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Purchases</string>
            <string name="Source"><![CDATA[-- Robux purchases (docs/DESIGN.md §7.2, §7.3): MarketplaceService.ProcessReceipt (set once, here), purchase prompts
-- requested by clients (validated: configured, not owned, revive only while allowed), the revive flow during a run.
-- The grant itself is ProfileStore.grant (one DataStore write with the receipt ledger; Lune-tested).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)
local Entitlements = require(script.Parent.Parent.Logic.Entitlements)
local RateLimit = require(Shared.Server.RateLimit)

local Purchases = {}

local deps: any = nil
local promptLimit = RateLimit.new(0.5, 2) -- purchase prompts: 2 at once, then one every 2 s
local PROMPT_HOLD_MAX = 45 -- seconds of the last chance a player's revive prompts may hold, in total per run
local revivePrompts: { [Player]: number } = {} -- open revive prompts (os.clock when first opened)
local holdSpent: { [Player]: number } = {} -- hold seconds already used by closed prompts in this run
local holdRun: any = nil -- the run these tables belong to
local PROMPT_OPEN_MAX = 60 -- a product prompt that never reports back stops blocking a second one after this
local openPrompts: { [Player]: { [string]: number } } = {} -- open prompts of non-consumables (cosmetics)

-- a prompt closed (bought, cancelled, player gone): its time counts against the player's hold budget
local function closeRevivePrompt(player: Player)
	local t = revivePrompts[player]
	if t then
		holdSpent[player] = (holdSpent[player] or 0) + (os.clock() - t)
		revivePrompts[player] = nil
	end
end

local function updateHold()
	-- a new run (or none): prompts of the last run hold nothing, the budget starts again
	local cur = deps.RunHost.current()
	if cur ~= holdRun then
		holdRun = cur
		table.clear(revivePrompts)
		table.clear(holdSpent)
	end
	local now = os.clock()
	local any = false
	for player, t in revivePrompts do
		if now - t + (holdSpent[player] or 0) > PROMPT_HOLD_MAX or not player.Parent then
			closeRevivePrompt(player)
		else
			any = true
		end
	end
	deps.RunHost.holdLast(any)
end

local function processReceipt(info): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not deps.Profiles.waitLoaded(player, 15) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local store = deps.Profiles.store()
	local decision, item, reason = store:grant(player.UserId, tostring(info.PurchaseId), info.ProductId)
	if decision ~= "granted" then
		warn(
			string.format(
				"[EmberNight] receipt %s (product %s) not processed: %s",
				tostring(info.PurchaseId),
				tostring(info.ProductId),
				reason
			)
		)
		if reason == "save lost" then
			deps.Profiles.save(player) -- reports the lost session (kick)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if reason == "granted" and item then
		-- runtime effects after the grant is saved
		if item.grant and item.grant.revive then
			deps.RunHost.useReviveToken(player)
		end
		deps.Net.ui(player, { t = "purchased", key = item.key })
		deps.Profiles.changed(player)
	end
	if item and item.grant and item.grant.revive then
		closeRevivePrompt(player)
		updateHold()
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- client asks to buy `key` (Cmd { op = "buy", key })
function Purchases.buy(player: Player, key: string)
	if not promptLimit:allow(player, os.clock()) then
		return
	end
	local it = Products.get(key)
	local prof = deps.Profiles.get(player)
	if not it or not prof then
		return
	end
	local passes = deps.Passes.get(player)
	if Entitlements.ownsItem(prof, passes, key) then
		return
	end
	if it.kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(player, it.id)
		return
	end
	if it.grant and it.grant.revive then
		local offer = deps.RunHost.reviveOffer(player)
		if not (offer and offer.buy) then
			return
		end
		updateHold()
		-- re-asking does not restart the hold: the first opening counts, and the run's budget is shared
		if not revivePrompts[player] then
			revivePrompts[player] = os.clock()
		end
		updateHold()
	end
	if it.grant and it.grant.cosmetic then
		-- a non-consumable: no second prompt while one is open (two quick clicks would sell it twice)
		local open = openPrompts[player] or {}
		openPrompts[player] = open
		local t = open[key]
		if t and os.clock() - t < PROMPT_OPEN_MAX then
			return
		end
		open[key] = os.clock()
	end
	MarketplaceService:PromptProductPurchase(player, it.id)
end

-- client uses a stored revive token (Cmd { op = "useRevive" })
function Purchases.useRevive(player: Player)
	deps.RunHost.useReviveToken(player)
end

function Purchases.init(d)
	deps = d
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptProductPurchaseFinished:Connect(
		function(userId: number, productId: number, isPurchased: boolean)
			local player = Players:GetPlayerByUserId(userId)
			if not player then
				return
			end
			local it = Products.byProductId(productId)
			if it and openPrompts[player] then
				openPrompts[player][it.key] = nil
			end
			if it and it.grant and it.grant.revive and not isPurchased then
				closeRevivePrompt(player)
				updateHold()
			end
		end
	)
	-- safety: a prompt that never reports back does not hold the last chance forever
	task.spawn(function()
		while true do
			task.wait(5)
			if next(revivePrompts) then
				updateHold()
			end
		end
	end)
end

function Purchases.onLeave(player: Player)
	promptLimit:forget(player)
	openPrompts[player] = nil
	holdSpent[player] = nil
	if revivePrompts[player] then
		revivePrompts[player] = nil
		updateHold()
	end
end

return Purchases
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Replicator</string>
            <string name="Source"><![CDATA[-- Replication (docs/DESIGN.md §3.5): per step one event buffer per client (Ev, reliable), every second step the
-- snapshot packets (Snap, unreliable, interest region around the recipient's hero), Ui messages for sim events
-- (routed per player), own-hero state at most 10 Hz, run clock and boss bar at ~4 Hz.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Codec = require(Shared.Net.Codec)
local Views = require(Shared.Net.Views)

local Replicator = {}

local net: any = nil
local slots: { [Player]: number } = {}
local spectators: { [Player]: boolean } = {}
local heroSig: { [Player]: string } = {}

function Replicator.begin(_run, s: { [Player]: number }, Net)
	net = Net
	slots = s
	table.clear(spectators)
	table.clear(heroSig)
end

function Replicator.addSpectator(player: Player)
	spectators[player] = true
end

function Replicator.removeSpectator(player: Player)
	spectators[player] = nil
	heroSig[player] = nil
end

function Replicator.removePlayer(player: Player)
	heroSig[player] = nil
end

function Replicator.finish()
	table.clear(spectators)
	table.clear(heroSig)
end

-- where a recipient looks: his own hero, or (downed/fallen/spectating) the first active teammate
local function origin(run, slot: number?)
	local pl = slot and run.players[slot]
	if pl and pl.state ~= "fallen" and pl.state ~= "left" then
		return pl.x, pl.y
	end
	local a = run.act[1] or run.plist[1]
	return a.x, a.y
end

local function send(run, player: Player, slot: number?, step: number)
	local ox, oy = origin(run, slot)
	local b = Codec.encodeEvents(run.events, slot or 0, step, ox, oy)
	if b then
		net.ev(player, b)
	end
	local heroNow = false
	for _, e in run.events do
		local msg = Views.uiFromEvent(e, slot)
		if
			msg
			and (
				msg.slot == nil
				or msg.slot == slot
				or msg.t == "down"
				or msg.t == "revived"
				or msg.t == "left"
				or msg.t == "vote"
			)
		then
			net.ui(player, msg)
		end
		if slot and e.slot == slot and (e.k == "build" or e.k == "levelup" or e.k == "down" or e.k == "revived") then
			heroNow = true
		end
	end
	if step % 2 == 0 then
		for _, pk in Codec.encodeSnapshot(run, step, ox, oy) do
			net.snap(player, pk)
		end
	end
	if slot then
		local pl = run.players[slot]
		if pl and (heroNow or step % 3 == 0) then
			local sig = Views.heroSig(run, pl)
			if heroNow or sig ~= heroSig[player] then
				heroSig[player] = sig
				net.ui(player, Views.hero(run, pl))
			end
		end
	end
end

function Replicator.afterStep(run, step: number)
	for player, slot in slots do
		if player.Parent then
			send(run, player, slot, step)
		end
	end
	for player in spectators do
		if player.Parent then
			send(run, player, nil, step)
		end
	end
	if step % 8 == 0 then
		local info = Views.runInfo(run)
		for player in slots do
			net.ui(player, info)
		end
		for player in spectators do
			net.ui(player, info)
		end
	end
end

return Replicator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">RunHost</string>
            <string name="Source"><![CDATA[-- Owns the running sim (docs/DESIGN.md §3.2): fixed 1/30 s steps from a Heartbeat accumulator (at most 3 per frame),
-- network moves and commands into the sim, achievements every second, results into the profiles at the end.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tuning = require(Shared.Config.Tuning)
local Run = require(Shared.Sim.Run)
local Results = require(Shared.Sim.Results)
local Codec = require(Shared.Net.Codec)
local Products = require(Shared.Config.Products)
local Entitlements = require(script.Parent.Parent.Logic.Entitlements)
local ReviveFlow = require(script.Parent.Parent.Logic.ReviveFlow)

local Replicator = require(script.Parent.Replicator)

local RunHost = {}

local deps: any = nil
local run: any = nil
local slots: { [Player]: number } = {}
local seqs: { [Player]: { last: number, full: number } } = {}
local spectators: { [Player]: boolean } = {}
local acc = 0
local step = 0
local achT = 0
local cleared = false
local nextSeed = os.time() % 100000
local offers: { [Player]: string } = {} -- last revive offer sent (signature)

-- slot -> { hero, cos } for every player in the run (cosmetics are shown to everybody)
local function teamInfo()
	local team = {}
	if run then
		for player, slot in slots do
			team[slot] =
				{ hero = run.players[slot].heroId, cos = deps.Meta.equipped(player), name = player.DisplayName }
		end
		for i = 1, #run.players do
			if not team[i] then
				team[i] = { hero = run.players[i].heroId, cos = {}, name = "" }
			end
		end
	end
	return team
end

-- the running sim (tests and debugging only)
function RunHost.current(): any
	return run
end

function RunHost.running(): boolean
	return run ~= nil
end

local function setAnchored(player: Player, on: boolean)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.Anchored = on
	end
end

function RunHost.start(parts: { { player: Player, hero: string } }, stageId: string, heat: number)
	if run then
		return
	end
	local players = {}
	table.clear(slots)
	table.clear(seqs)
	table.clear(spectators)
	for i, p in parts do
		local prof = deps.Profiles.get(p.player) or { shop = {} }
		slots[p.player] = i
		table.insert(players, {
			slot = i,
			userId = p.player.UserId,
			heroId = p.hero,
			forge = table.clone(prof.shop),
			inputMode = "pos",
		})
	end
	nextSeed += 7919
	run = Run.new({ seed = nextSeed, stageId = stageId, heat = heat, players = players, reviveOffer = false })
	acc, step, achT, cleared = 0, 0, 1, false
	table.clear(offers)
	local reviveConfigured = Products.configured("revive")
	for player, slot in slots do
		ReviveFlow.sync(run, slot, deps.Profiles.get(player), reviveConfigured)
	end
	Replicator.begin(run, slots, deps.Net)
	local team = teamInfo()
	for player, slot in slots do
		setAnchored(player, true)
		local pl = run.players[slot]
		-- first time in this land: the client shows the land's story panel (premise on the very first run)
		local story = nil
		local prof = deps.Profiles.get(player)
		if prof and prof.storySeen and not prof.storySeen[stageId] then
			story = { premise = not prof.storySeen.premise }
			prof.storySeen[stageId] = true
			prof.storySeen.premise = true
		end
		deps.Net.ui(player, {
			team = team,
			t = "runStart",
			story = story,
			slot = slot,
			x = pl.x,
			y = pl.y,
			stage = stageId,
			heat = heat,
			solo = run.solo,
			hero = pl.heroId,
		})
	end
end

function RunHost.addSpectator(player: Player)
	if not run then
		return
	end
	spectators[player] = true
	Replicator.addSpectator(player)
	deps.Net.ui(player, { t = "spectate", stage = run.stage.id, time = run.t, team = teamInfo() })
end

local function gold2x(player: Player): boolean
	return Entitlements.gold2x(deps.Passes.get(player))
end

local function finishPlayer(player: Player, slot: number)
	local prof = deps.Profiles.get(player)
	if not prof then
		return
	end
	local summary = Results.finish(run, slot, prof, { gold2x = gold2x(player) })
	task.spawn(deps.Profiles.save, player)
	deps.Net.ui(player, { t = "results", summary = summary, profile = deps.Meta.view(player) })
end

local function endRun()
	for player, slot in slots do
		if player.Parent and run.players[slot].state ~= "left" then
			finishPlayer(player, slot)
			setAnchored(player, false)
		end
	end
	for player in spectators do
		if player.Parent then
			deps.Net.ui(player, { t = "runEnded" })
		end
	end
	Replicator.finish()
	run = nil
	table.clear(slots)
	table.clear(spectators)
	deps.Lobby.onRunEnded()
end

local function onStep()
	-- victory: land cleared for everyone in the run (web recordClear at the moment of the kill)
	if run.won and not cleared then
		cleared = true
		for player, slot in slots do
			local prof = deps.Profiles.get(player)
			if run.players[slot].state ~= "left" and prof then
				local clear = Results.recordClear(run, slot, prof)
				deps.Net.ui(player, { t = "clear", clear = clear })
			end
		end
	end
	achT -= Tuning.SIM_DT
	if achT <= 0 then
		achT = 1
		for player, slot in slots do
			local prof = deps.Profiles.get(player)
			if run.players[slot].state ~= "left" and prof then
				local new = Results.checkAchievements(run, slot, prof)
				for _, id in new do
					deps.Net.ui(player, { t = "achievement", id = id })
				end
			end
		end
	end
end

-- revive offer of the downed screen (§2.8, §7.3), sent when it changes
local function sendOffers()
	local configured = Products.configured("revive")
	for player, slot in slots do
		local o = ReviveFlow.offer(run, slot, deps.Profiles.get(player), configured)
		local price = if o.buy then deps.ProductInfo.price("revive") else nil
		-- the price is part of the signature: a price that arrives after the player went down still shows the button
		local sig = (if o.use then "u" else "")
			.. (if o.buy then "b" else "")
			.. tostring(o.tokens)
			.. "/"
			.. tostring(price)
		if offers[player] ~= sig then
			offers[player] = sig
			deps.Net.ui(player, {
				t = "reviveOffer",
				use = o.use,
				buy = o.buy,
				tokens = o.tokens,
				price = price,
			})
		end
	end
end

local function heartbeat(dt: number)
	if not run then
		return
	end
	acc += dt
	local n = 0
	while acc >= Tuning.SIM_DT and n < Tuning.MAX_STEPS_PER_FRAME do
		acc -= Tuning.SIM_DT
		n += 1
		Run.step(run, Tuning.SIM_DT)
		step += 1
		onStep()
		sendOffers()
		Replicator.afterStep(run, step)
		table.clear(run.events)
		if run.state == "over" then
			endRun()
			return
		end
	end
	if acc > Tuning.SIM_DT * Tuning.MAX_STEPS_PER_FRAME then
		acc = 0 -- the game slows down instead of spiralling
	end
end

local function onMove(player: Player, m)
	if not run then
		return
	end
	local slot = slots[player]
	if not slot then
		return
	end
	-- unwrap the 16-bit sequence into a monotonic number
	local s = seqs[player]
	if not s then
		s = { last = m.seq, full = m.seq }
		seqs[player] = s
	elseif Codec.seqNewer(m.seq, s.last) then
		s.full += (m.seq - s.last) % 65536
		s.last = m.seq
	else
		return
	end
	Run.setInput(run, slot, m.x, m.y, s.full, m.dirX, m.dirY, m.moving)
end

local RUN_OPS = {
	pick = true,
	reroll = true,
	skip = true,
	banish = true,
	chestClose = true,
	pause = true,
	resume = true,
	vote = true,
	giveup = true,
}

local function onCommand(player: Player, c)
	if RUN_OPS[c.op] then
		local slot = run and slots[player]
		if slot then
			Run.command(run, slot, c)
		end
		return
	end
	if deps.Meta.command(player, c) then
		return
	end
	deps.Lobby.command(player, c)
end

function RunHost.init(d)
	deps = d
	deps.Net.handlers.move = onMove
	deps.Net.handlers.command = onCommand
	deps.Net.handlers.query = function(player: Player, what: string)
		if what == "profile" then
			return deps.Meta.view(player)
		end
		return nil
	end
	RunService.Heartbeat:Connect(heartbeat)
end

-- a player leaves (called by Main before the profile is released)
function RunHost.onLeave(player: Player)
	spectators[player] = nil
	offers[player] = nil
	Replicator.removeSpectator(player)
	local slot = slots[player]
	if run and slot then
		-- leaving mid-run: booked as a defeat at this moment (§2.8 point 9)
		Run.removePlayer(run, slot)
		local prof = deps.Profiles.get(player)
		if prof then
			Results.finish(run, slot, prof, { gold2x = gold2x(player) })
		end
		slots[player] = nil
		Replicator.removePlayer(player)
		if run.state == "over" then
			endRun()
		end
	end
end

function RunHost.inRun(player: Player): boolean
	return run ~= nil and slots[player] ~= nil
end

function RunHost.reviveOffer(player: Player)
	local slot = slots[player]
	if not run or not slot then
		return nil
	end
	return ReviveFlow.offer(run, slot, deps.Profiles.get(player), Products.configured("revive"))
end

-- consume a stored revive token if it can revive the player now (after a purchase or on request)
function RunHost.useReviveToken(player: Player): boolean
	local slot = slots[player]
	local prof = deps.Profiles.get(player)
	if not run or not slot or not prof then
		return false
	end
	ReviveFlow.sync(run, slot, prof, Products.configured("revive"))
	local ok = ReviveFlow.useToken(run, slot, prof)
	if ok then
		task.spawn(deps.Profiles.save, player)
	end
	return ok
end

-- an open revive prompt keeps the last chance from running out (§7.3 point 6)
function RunHost.holdLast(on: boolean)
	if run then
		local _, anySlot = next(slots)
		if anySlot then
			Run.command(run, anySlot, { op = "holdLast", on = on })
		end
	end
end

return RunHost
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="78">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">HubBuilder</string>
            <string name="Source"><![CDATA[-- The hub (docs/DESIGN.md §2.2), built in code far above the arena: a round stone plaza with a campfire and the
-- spawn point. Players walk around with their own avatars. R1: simple version.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Tuning = require(ReplicatedStorage:WaitForChild("Shared").Config.Tuning)

local HubBuilder = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

function HubBuilder.build(): Model
	local o = Tuning.HUB_ORIGIN
	local origin = Vector3.new(o[1], o[2], o[3])
	local hub = Instance.new("Model")
	hub.Name = "Hub"

	local plaza = part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 120, 120),
		CFrame = CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(58, 52, 70),
		Material = Enum.Material.Slate,
	})
	plaza.Parent = hub

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(origin + Vector3.new(0, 1.5, 22))
	spawn.Color = Color3.fromRGB(90, 70, 110)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = hub

	-- campfire: logs + neon embers + light
	for i = 0, 3 do
		local log = part({
			Name = "Log",
			Size = Vector3.new(6, 1, 1),
			CFrame = CFrame.new(origin + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, i * math.pi / 4, 0),
			Color = Color3.fromRGB(80, 50, 30),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		log.Parent = hub
	end
	local ember = part({
		Name = "Ember",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		CFrame = CFrame.new(origin + Vector3.new(0, 2.6, 0)),
		Color = Color3.fromRGB(255, 140, 50),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Range = 40
	light.Brightness = 2
	light.Parent = ember
	local fire = Instance.new("Fire")
	fire.Heat = 6
	fire.Size = 5
	fire.Parent = ember
	ember.Parent = hub

	-- low wall so nobody falls off
	local n = 24
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local wall = part({
			Name = "Wall",
			Size = Vector3.new(16, 4, 2),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(a) * 59, 2, math.sin(a) * 59))
				* CFrame.Angles(0, -a + math.pi / 2, 0),
			Color = Color3.fromRGB(46, 40, 58),
			Material = Enum.Material.Slate,
		})
		wall.Parent = hub
	end

	hub.Parent = workspace
	return hub
end

return HubBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="80">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="81">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="82">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="83">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">App</string>
            <string name="Source"><![CDATA[-- Client application (docs/DESIGN.md §3.1): wires network messages to the arena views, the UI, audio and the camera.
-- The client renders and predicts only its own hero; every game rule runs on the server. Main.client.luau starts it
-- with the real ClientNet; tests/arena.spec.luau starts it with a fake net fed by the real server services.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Stages = require(Shared.Sim.Data.Stages)
local Achievements = require(Shared.Sim.Data.Achievements)
local Cosmetics = require(Shared.Config.Cosmetics)
local Mix = require(Shared.Audio.Mix)

local Controls = require(script.Parent.Input.Controls)
local CameraRig = require(script.Parent.World.CameraRig)
local Pool = require(script.Parent.World.Pool)
local EnemyView = require(script.Parent.World.EnemyView)
local HeroView = require(script.Parent.World.HeroView)
local Ground = require(script.Parent.World.Ground)
local Land = require(script.Parent.World.Land)
local TeleView = require(script.Parent.World.TeleView)
local ShotView = require(script.Parent.World.ShotView)
local PickupView = require(script.Parent.World.PickupView)
local FxView = require(script.Parent.World.FxView)
local Particles = require(script.Parent.World.Particles)
local DamageNumbers = require(script.Parent.World.DamageNumbers)
local ModelKit = require(script.Parent.World.ModelKit)
local LobbyUI = require(script.Parent.UI.Lobby)
local Hud = require(script.Parent.UI.Hud)
local LevelUpUI = require(script.Parent.UI.LevelUp)
local ResultsUI = require(script.Parent.UI.Results)
local Router = require(script.Parent.UI.Router)
local ReviveOffer = require(script.Parent.UI.ReviveOffer)
local StoryPanel = require(script.Parent.UI.StoryPanel)
local Names = require(script.Parent.UI.Names)
local Arrows = require(script.Parent.UI.Arrows)
local Downed = require(script.Parent.UI.Downed)
local Pause = require(script.Parent.UI.Pause)
local Kit = require(script.Parent.UI.Kit)
local Sfx = require(script.Parent.Audio.Sfx)
local Music = require(script.Parent.Audio.Music)

local App = {}
local ClientNet: any = nil
local player = Players.LocalPlayer
local tr = Lang.tr
Lang.setLang(Lang.fromLocale(player.LocaleId))

local inRun = false
local resultsOpen = false
local solo = true
local heroBySlot: { [number]: string } = {}
local langChosen = false
local lastHp: number? = nil
local S = 0.1 -- studs per sim px (Coords.S)

local function command(c)
	if c.op == "pick" then
		Sfx.play("item")
	end
	ClientNet.command(c)
end

local function setReset(enabled: boolean)
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCore("ResetButtonCallback", enabled)
			end)
			if ok then
				return
			end
			task.wait(1)
		end
	end)
end

local function heroPos(slot: number)
	return HeroView.position(ClientNet.interp, slot)
end

-- cosmetics of everybody in the run (team = slot -> { hero, cos })
local function applyTeam(team)
	if type(team) ~= "table" then
		return
	end
	for slot, info in team do
		if type(info) == "table" then
			local cos = info.cos or {}
			HeroView.setCosmetics(slot, cos, info.name)
			local c = cos.fx and Cosmetics.byId[cos.fx]
			local colors = nil
			if c and c.colors then
				colors = {}
				for _, hex in c.colors do
					table.insert(colors, Color3.fromHex(hex))
				end
			end
			ShotView.setFxColors(slot, colors)
		end
	end
end

local function clearArena()
	EnemyView.clear()
	HeroView.clear()
	TeleView.clear()
	ShotView.clear()
	PickupView.clear()
	FxView.clear()
	Ground.clear()
	ClientNet.interp:reset()
end

local function bindRunActions()
	-- cards: number keys; on a gamepad the D-pad (in co-op the cards are not GUI-selected, so the thumbstick keeps
	-- moving the hero while choosing)
	local pads = { Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadRight, Enum.KeyCode.DPadDown }
	for i, key in { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four } do
		Controls.bind("card" .. i, function()
			LevelUpUI.choose(i)
		end, key, pads[i])
	end
	Controls.bind("reroll", LevelUpUI.action, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	Controls.bind("skip", LevelUpUI.action, Enum.KeyCode.K, Enum.KeyCode.ButtonY)
	Controls.bind("banish", LevelUpUI.action, Enum.KeyCode.B)
	Controls.bind("pause", function()
		if Pause.isOpen() then
			Pause.close(true)
		elseif solo then
			command({ op = "pause" })
		else
			Pause.open(false)
		end
	end, Enum.KeyCode.P, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonStart) -- Start may be taken by the Roblox menu
end

local function unbindRunActions()
	for _, n in { "card1", "card2", "card3", "card4", "reroll", "skip", "banish", "pause" } do
		Controls.unbind(n)
	end
end

local function enterArena(stageId: string)
	clearArena()
	local stage = Stages.list[1]
	for _, s in Stages.list do
		if s.id == stageId then
			stage = s
		end
	end
	Ground.setStage(stage)
	Land.enter(stage)
	EnemyView.setStage(stage)
	FxView.setStage(stage)
	LevelUpUI.setStage(stage)
	inRun = true
	lastHp = nil
	Music.release()
	Music.setIntensity(1)
	CameraRig.setActive(true)
	LobbyUI.setVisible(false)
	Router.setEnabled(false)
	ResultsUI.hide()
	setReset(false)
	bindRunActions()
end

local function leaveArena()
	inRun = false
	clearArena()
	Land.leave()
	CameraRig.setActive(false)
	Hud.setVisible(false)
	Arrows.setVisible(false)
	Downed.hide()
	Pause.close(false)
	LevelUpUI.close()
	LevelUpUI.closeChest()
	LevelUpUI.victory(false)
	ReviveOffer.hide()
	StoryPanel.hide()
	setReset(true)
	unbindRunActions()
end

function App.start(net)
	ClientNet = net
	ClientNet.init()
	Controls.init()
	Sfx.init()
	Music.init()
	Music.setIntensity(0)
	Kit.onClick = function()
		Sfx.play("click")
	end
	Pool.prewarm("Ball", 400)
	Pool.prewarm("Block", 700)
	Pool.prewarm("Cylinder", 120)
	Pool.prewarm("Wedge", 8)
	Pool.prewarm("Ellipsoid", 160)
	ShotView.setHeroPosition(heroPos)
	PickupView.setHeroPosition(heroPos, function(slot)
		return ModelKit.heroColor(heroBySlot[slot])
	end)
	Router.init(command)
	Router.onChange = function(open)
		LobbyUI.setVisible(not open and not inRun and not resultsOpen)
	end
	LobbyUI.init(command, Router.open)
	Hud.init(command, function()
		Pause.open(false)
	end)
	LevelUpUI.init(command, Hud.time)
	Downed.init()
	ReviveOffer.init(command)
	StoryPanel.init()
	Pause.init(command)
	Arrows.init()
	ResultsUI.init(function()
		resultsOpen = false
		Music.release()
		Music.setIntensity(0)
		LobbyUI.setVisible(true)
		Router.setEnabled(true)
	end)
	App.listen()
	-- lobby state on start (the server also pushes it on join)
	task.defer(function()
		local view = ClientNet.query("profile")
		if view and view.lang then
			Lang.setLang(view.lang)
			LobbyUI.rerender()
			Router.rerender()
		end
	end)
end

function App.listen()
	-- ---------- Ui messages ----------
	ClientNet.onUi("lobby", function(m)
		if not langChosen and m.profile and m.profile.lang then
			Lang.setLang(m.profile.lang)
		end
		if m.profile and m.profile.settings then
			local st = m.profile.settings
			CameraRig.setZoom(st.camZoom or 1)
			Sfx.setEnabled(st.sfx ~= false)
			Music.setEnabled(st.music ~= false)
			DamageNumbers.setEnabled(st.dmgNums ~= false)
			CameraRig.setShakeEnabled(st.shake ~= false)
			Particles.setLowFx(st.lowFx == true)
			Land.setLowFx(st.lowFx == true)
		end
		LobbyUI.render(m)
		Router.update(m)
		if not inRun and not resultsOpen and not Router.isOpen() then
			LobbyUI.setVisible(true)
		end
	end)
	ClientNet.onUi("purchased", function(m)
		Router.toast(tr("Gekauft: {0}", Names.product(m.key)))
		if inRun then
			Hud.toast(tr("Gekauft: {0}", Names.product(m.key)))
		end
		Sfx.play("buy")
	end)
	ClientNet.onUi("reviveOffer", function(m)
		if inRun then
			ReviveOffer.show(m)
		end
	end)
	ClientNet.onUi("runStart", function(m)
		solo = m.solo
		heroBySlot[m.slot] = m.hero
		enterArena(m.stage)
		applyTeam(m.team)
		HeroView.start(m.slot, m.x, m.y, m.hero)
		CameraRig.snap(m.x, m.y)
		Hud.setTeam(m.team, m.slot)
		Hud.setVisible(true, m.solo)
		Downed.setSolo(m.solo)
		Arrows.setVisible(true)
		if m.story then
			StoryPanel.show(m.stage, m.story.premise == true)
		end
	end)
	ClientNet.onUi("spectate", function(m)
		solo = false
		enterArena(m.stage)
		applyTeam(m.team)
		Hud.setTeam(m.team, 0)
		Hud.setVisible(true, false)
		Downed.setSolo(false)
		Arrows.setVisible(true)
	end)
	ClientNet.onUi("hero", function(m)
		if lastHp and m.hp < lastHp and m.state == "active" then
			Sfx.play("hurt")
			Hud.hurt()
		end
		lastHp = m.hp
		Hud.hero(m)
		Downed.hero(m)
		Pause.setHero(m)
		HeroView.setSpeed(m.speed)
		HeroView.setState(m.slot, m.state)
	end)
	ClientNet.onUi("run", function(m)
		Hud.run(m)
		Downed.run(m)
		if m.state == "victory" then
			LevelUpUI.victory(true, m.vote)
		end
		for _, p in m.team do
			heroBySlot[p.slot] = p.hero
			HeroView.setHero(p.slot, p.hero)
			HeroView.setState(p.slot, p.state)
		end
	end)
	ClientNet.onUi("levelup", function(m)
		LevelUpUI.show(m, solo)
	end)
	ClientNet.onUi("levelupDone", function()
		LevelUpUI.close()
	end)
	ClientNet.onUi("chest", function(m)
		LevelUpUI.chest(m.res, solo)
		if m.res.evolved then
			task.delay(0.45, Sfx.play, "evolve")
		end
		for i in m.res.items or {} do
			task.delay(0.5 + (i - 1) * 0.22, Sfx.play, "item")
		end
	end)
	ClientNet.onUi("banner", Hud.banner)
	ClientNet.onUi("countdown", Hud.countdown)
	ClientNet.onUi("state", function(m)
		Hud.state(m.state)
		LevelUpUI.victory(m.state == "victory")
		if m.state == "paused" then
			Pause.open(true)
		elseif solo and Pause.isOpen() then
			Pause.close(false)
		end
		if solo and m.state == "play" then
			LevelUpUI.close()
			LevelUpUI.closeChest()
		end
	end)
	ClientNet.onUi("boss", function(m)
		EnemyView.bossSpawned(m.id, m.name)
	end)
	ClientNet.onUi("correct", function(m)
		HeroView.correct(m.x, m.y)
	end)
	ClientNet.onUi("down", function(m)
		HeroView.setState(m.slot, m.state)
	end)
	ClientNet.onUi("revived", function(m)
		HeroView.setState(m.slot, "active")
		if m.slot == HeroView.own().slot then
			ReviveOffer.hide()
			Downed.hide()
		end
	end)
	ClientNet.onUi("achievement", function(m)
		for _, a in Achievements.list do
			if a.id == m.id then
				Hud.achievement(a.name)
			end
		end
	end)
	ClientNet.onUi("results", function(m)
		leaveArena()
		resultsOpen = true
		LobbyUI.setVisible(false)
		ResultsUI.show(m.summary)
		if not m.summary.won then
			Music.sting("gameover")
		end
	end)
	ClientNet.onUi("runEnded", function()
		leaveArena()
		LobbyUI.setVisible(true)
		Router.setEnabled(true)
	end)

	-- ---------- world events ----------
	ClientNet.onEvent(function(e)
		if not inRun then
			return
		end
		local k = e.k
		local now = os.clock()
		if k == "kill" then
			EnemyView.kill(e.id)
			FxView.kill(e)
		elseif k == "despawn" then
			EnemyView.kill(e.id)
		elseif k == "dmg" then
			FxView.number(e)
		elseif k == "eshot+" then
			ShotView.eshot(e)
		elseif k == "eshot-" then
			ShotView.eshotGone(e.id)
		elseif k == "tele+" then
			TeleView.add(e, now)
		elseif k == "tele~" then
			TeleView.update(e.id, e.a, e.x, e.y)
		elseif k == "tele-" then
			TeleView.remove(e.id)
		elseif k == "haz+" then
			FxView.hazard(e)
		elseif k == "haz~" then
			FxView.hazardLife(e.id, e.life)
		elseif k == "haz-" then
			FxView.hazardGone(e.id)
		elseif k == "gem+" then
			PickupView.gem(e)
		elseif k == "pick+" then
			PickupView.pickup(e)
		elseif k == "gemPull" or k == "pick~" then
			PickupView.pull(e.id, e.slot)
		elseif k == "gemGot" or k == "pick-" then
			PickupView.remove(e.id)
		elseif k == "fire" then
			ShotView.fire(e)
		elseif k == "shot-" then
			ShotView.shotGone(e.id)
		elseif k == "orbit" then
			ShotView.orbit(e)
		elseif k == "aura" then
			ShotView.aura(e)
		elseif k == "arc" then
			ShotView.arc(e)
		elseif k == "pool" then
			ShotView.pool(e)
		elseif k == "shake" then
			local own = HeroView.own()
			if not e.x or ((e.x - own.x) ^ 2 + (e.y - own.y) ^ 2) < 700 * 700 then
				CameraRig.shake(e.amount)
			end
		elseif k == "prop-" then
			Ground.breakProp(e.cx, e.cy)
		elseif k == "boom" then
			FxView.boom(e)
		elseif k == "burst" then
			FxView.burst(e)
		elseif k == "text" then
			FxView.text(e)
		elseif k == "flash" then
			FxView.flash(e)
		elseif k == "sfx" then
			if e.name == "victory" then
				Music.sting("victory")
			else
				local own = HeroView.own()
				local dist = nil
				if e.x and own.slot > 0 then
					dist = math.sqrt((e.x - own.x) ^ 2 + (e.y - own.y) ^ 2) * S
				end
				Sfx.play(e.name, dist)
			end
		end
	end)
end

-- ---------- frame loop ----------
local arrowHx, arrowHy = 0, 0
local function shotArrow(x: number, y: number, vx: number, vy: number)
	Arrows.shot(x, y, vx, vy, arrowHx, arrowHy)
end
local function chestArrow(x: number, y: number)
	Arrows.add("chest", x, y, 20)
end

function App.frame(dt: number)
	if not inRun then
		return
	end
	local now = os.clock()
	local interp = ClientNet.interp
	interp:update(dt)
	local own = HeroView.own()
	if own.slot > 0 then
		local mx, my = Controls.move()
		-- the world is paused (solo dialogs, last chance, victory): the hero stands still
		if Hud.runState() ~= "play" or (LevelUpUI.isOpen() and solo) then
			mx, my = 0, 0
		end
		HeroView.updateOwn(dt, mx, my, FxView.inSlow(own.x, own.y, 12), interp:latestHeroes(), ClientNet.sendMove)
	end
	local visible = HeroView.render(interp, now, dt)
	EnemyView.update(interp, now, visible, dt)
	TeleView.render(now)
	ShotView.render(dt, now)
	PickupView.render(dt, now)
	FxView.render(dt)
	-- camera target: own hero, or (downed/fallen/spectating) the first visible teammate
	local cx, cy = own.x, own.y
	if own.slot == 0 or own.state == "fallen" then
		for slot = 1, 4 do
			local x, y = interp:hero(slot)
			if x and slot ~= own.slot then
				cx, cy = x, y
				break
			end
		end
	end
	Ground.update(cx, cy)
	Land.update(cx, cy)
	CameraRig.update(dt, cx, cy)
	Hud.update(dt)
	LevelUpUI.update()
	Downed.update()
	-- off-screen arrows: incoming shots, downed teammates, the boss, own chests
	Arrows.begin()
	if own.slot > 0 and own.state == "active" then
		arrowHx, arrowHy = own.x, own.y
		ShotView.eachEnemyShot(shotArrow)
	end
	for slot, h in interp:latestHeroes() do
		if slot ~= own.slot and h.downed then
			Arrows.add("downed", h.x, h.y, 80)
		end
	end
	local bx, by = EnemyView.bossPosition()
	if bx then
		Arrows.add("boss", bx, by :: number, 50)
	end
	if own.slot > 0 then
		PickupView.eachChest(own.slot, chestArrow)
	end
	Arrows.render(now)
	Music.setIntensity(Mix.intensity(true, Hud.bossActive(), Hud.time(), Hud.surgeOn()))
end

return App
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="85">
          <Properties>
            <string name="Name">Audio</string>
          </Properties>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Music</string>
              <string name="Source"><![CDATA[-- Music (docs/DESIGN.md §9): one looping Sound per track, cross-faded over Mix.FADE with TweenService; intensity 0 =
-- hub, 1-2 = battle (1 muffled by an EqualizerSoundEffect), 3 = boss; victory and game-over are stings that pause the
-- loops for their length. A track whose id is 0 is silent (nothing is created for it, nothing errors).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Mix = require(Shared.Audio.Mix)
local AudioIds = require(Shared.Config.AudioIds)

local Music = {}

local group: SoundGroup? = nil
local sounds: { [string]: Sound } = {}
local playing: { [string]: boolean } = {}
local eq: EqualizerSoundEffect? = nil
local current: string? = nil
local intensity = 0
local enabled = true
local holdUntil = 0
local STING_HOLD = 6

local function fade(s: Sound, to: number, sec: number, stopAfter: boolean)
	local tw =
		TweenService:Create(s, TweenInfo.new(sec, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Volume = to })
	if stopAfter then
		tw.Completed:Connect(function()
			if current == nil or sounds[current] ~= s then
				s:Stop()
				for k, v in sounds do
					if v == s then
						playing[k] = nil
					end
				end
			end
		end)
	end
	tw:Play()
end

local function sound(id: string): Sound?
	if sounds[id] then
		return sounds[id]
	end
	local asset = AudioIds.music[id]
	if type(asset) ~= "number" or asset <= 0 or not group then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "music_" .. id
	s.SoundId = "rbxassetid://" .. asset
	s.Looped = not Mix.STINGS[id]
	s.Volume = 0
	s.SoundGroup = group
	if id == "battle" then
		local e = Instance.new("EqualizerSoundEffect")
		e.LowGain = 0
		e.MidGain = 0
		e.HighGain = Mix.muffle(intensity)
		e.Parent = s
		eq = e
	end
	s.Parent = group
	sounds[id] = s
	return s
end

function Music.init()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "EN_Music"
	g.Volume = Mix.MASTER * Mix.MUSIC
	g.Parent = SoundService
	group = g
end

function Music.setEnabled(on: boolean)
	enabled = on
	if group then
		group.Volume = if on then Mix.MASTER * Mix.MUSIC else 0
	end
end

local function crossTo(id: string)
	if current == id then
		return
	end
	local old = current and sounds[current]
	current = id
	if old then
		fade(old, 0, Mix.FADE, true)
	end
	local s = sound(id)
	if s then
		if not playing[id] then
			playing[id] = true
			s.TimePosition = 0
			s:Play()
		end
		fade(s, Mix.TRACK_VOL[id] or 0.6, Mix.FADE, false)
	end
end

function Music.setIntensity(v: number)
	intensity = v
	if eq then
		local target = Mix.muffle(v)
		if eq.HighGain ~= target then
			TweenService:Create(eq, TweenInfo.new(0.8), { HighGain = target }):Play()
		end
	end
	if os.clock() < holdUntil then
		return
	end
	crossTo(Mix.trackFor(v))
end

function Music.intensity(): number
	return intensity
end

-- a short closing piece (victory / gameover): the loops fade out, the sting plays once
function Music.sting(id: string)
	if current then
		local old = sounds[current]
		if old then
			fade(old, 0, 0.6, true)
		end
		current = nil
	end
	holdUntil = os.clock() + STING_HOLD
	local s = sound(id)
	if s and enabled then
		s.Volume = Mix.TRACK_VOL[id] or 0.7
		s.TimePosition = 0
		s:Play()
	end
end

-- release the sting hold (back to the hub)
function Music.release()
	holdUntil = 0
	Music.setIntensity(intensity)
end

return Music
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[-- Sound effects (docs/DESIGN.md §9): executes Shared/Audio/Mix plans with a few pooled Sound objects per recording
-- in one SoundGroup. Positional sounds fade with the distance to the own hero. A recording whose id is 0 stays
-- silent: no Sound is created for it and nothing errors (Studio prints one note listing the missing ids).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Mix = require(Shared.Audio.Mix)
local AudioIds = require(Shared.Config.AudioIds)

local Sfx = {}

local group: SoundGroup? = nil
local pools: { [string]: { sounds: { Sound }, next: number } } = {}
local state = Mix.new(function()
	return math.random()
end)
local enabled = true
local gemCombo, gemAt = 0, -1
local noted = false

local function note()
	if noted then
		return
	end
	noted = true
	local missing = Mix.missing(AudioIds.sfx)
	local ok, studio = pcall(function()
		return RunService:IsStudio()
	end)
	if ok and studio and #missing > 0 then
		local total = 0
		for _ in AudioIds.sfx do
			total += 1
		end
		warn(
			string.format(
				"[EmberNight] %d of %d sound effect ids are 0 (silent): upload assets/audio/sfx, fill Config/AudioIds.luau",
				#missing,
				total
			)
		)
	end
end

function Sfx.init()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "EN_Sfx"
	g.Volume = Mix.MASTER
	g.Parent = SoundService
	group = g
	note()
end

function Sfx.setEnabled(on: boolean)
	enabled = on
	if group then
		group.Volume = if on then Mix.MASTER else 0
	end
end

local function pool(key: string)
	local p = pools[key]
	if p then
		return p
	end
	local id = AudioIds.sfx[key]
	p = { sounds = {}, next = 1 }
	pools[key] = p
	if type(id) ~= "number" or id <= 0 or not group then
		return p
	end
	for i = 1, Mix.MAX_COPIES do
		local s = Instance.new("Sound")
		s.Name = key .. i
		s.SoundId = "rbxassetid://" .. id
		s.SoundGroup = group
		s.Parent = group
		table.insert(p.sounds, s)
	end
	return p
end

local function start(v)
	local p = pool(v.key)
	local n = #p.sounds
	if n == 0 then
		return
	end
	local s = p.sounds[p.next]
	p.next = p.next % n + 1
	s.Volume = math.min(v.vol, 3)
	s.PlaybackSpeed = v.rate
	s.TimePosition = 0
	s:Play()
end

-- play a sound name; dist = studs from the own hero for positional sounds (nil = everywhere)
function Sfx.play(name: string, dist: number?)
	if not enabled then
		return
	end
	local now = os.clock()
	local combo = nil
	if name == "gem" then
		if now - gemAt > 0.6 then
			gemCombo = 0
		end
		gemCombo += 1
		gemAt = now
		combo = gemCombo
	end
	local plan = Mix.plan(state, name, now, { combo = combo, dist = dist })
	if not plan then
		return
	end
	for _, v in plan do
		if v.delay > 0 then
			task.delay(v.delay, start, v)
		else
			start(v)
		end
	end
end

-- how many voices the limits dropped (for the debug overlay and tests)
function Sfx.dropped(): number
	return state.dropped
end

return Sfx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">Device</string>
            <string name="Source"><![CDATA[-- Device class for readability and budgets (docs/DESIGN.md §4.4, §5.1): phones get bigger enemy shots, thicker
-- telegraph outlines, fewer damage numbers and particles; layouts read the screen size.
local UserInputService = game:GetService("UserInputService")

local Device = {}

-- the current camera viewport (1280 x 720 when unknown)
function Device.viewport(): Vector2
	local cam = workspace.CurrentCamera
	local ok, vp = pcall(function()
		return cam and cam.ViewportSize
	end)
	if ok and vp and vp.X > 0 and vp.Y > 0 then
		return vp
	end
	return Vector2.new(1280, 720)
end

-- touch-first device (phone or tablet without keyboard)
function Device.touch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- a small screen: phone (short side under 500 px)
function Device.phone(): boolean
	local vp = Device.viewport()
	return Device.touch() and math.min(vp.X, vp.Y) < 500
end

-- gamepad as the last input
function Device.gamepad(): boolean
	return UserInputService.GamepadEnabled
		and not UserInputService.TouchEnabled
		and not UserInputService.KeyboardEnabled
end

return Device
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="89">
          <Properties>
            <string name="Name">Input</string>
          </Properties>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Controls</string>
              <string name="Source"><![CDATA[-- Input (docs/DESIGN.md §5.4): the move vector comes from Roblox's PlayerModule control module (keyboard, touch
-- thumbstick, gamepad) - the camera never rotates, so x = mv.X and y = mv.Z. Fallback: WASD/arrows via
-- UserInputService. Actions are bound with ContextActionService only while they are relevant.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Controls = {}

local controlModule: any = nil
local actions: { [string]: (string) -> () } = {}

local function loadControlModule()
	local ok, pm = pcall(function()
		local ps = Players.LocalPlayer:WaitForChild("PlayerScripts")
		return require(ps:WaitForChild("PlayerModule", 10) :: any)
	end)
	if ok and pm then
		local ok2, controls = pcall(function()
			return pm:GetControls()
		end)
		if ok2 then
			controlModule = controls
		end
	end
end

local function keyboardVector(): (number, number)
	local x, y = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		y -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		y += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		x -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		x += 1
	end
	return x, y
end

-- move vector in sim axes (length <= 1)
function Controls.move(): (number, number)
	local x, y = 0, 0
	if controlModule then
		local ok, mv = pcall(function()
			return controlModule:GetMoveVector()
		end)
		if ok and typeof(mv) == "Vector3" then
			x, y = mv.X, mv.Z
		end
	end
	if x == 0 and y == 0 then
		x, y = keyboardVector()
	end
	local l = math.sqrt(x * x + y * y)
	if l > 1 then
		x, y = x / l, y / l
	end
	return x, y
end

-- bind an action (name -> handler) with keys/buttons; handler gets the name on key press
function Controls.bind(name: string, handler: (string) -> (), ...: Enum.KeyCode)
	actions[name] = handler
	ContextActionService:BindAction("EN_" .. name, function(_, state)
		if state == Enum.UserInputState.Begin then
			handler(name)
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, ...)
end

function Controls.unbind(name: string)
	if actions[name] then
		actions[name] = nil
		ContextActionService:UnbindAction("EN_" .. name)
	end
end

function Controls.init()
	task.spawn(loadControlModule)
end

return Controls
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="91">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client bootstrap (docs/DESIGN.md §3.1): starts the client application with the real remotes and binds its frame
-- update after the camera step.
local RunService = game:GetService("RunService")

local ClientNet = require(script.Parent.Net.ClientNet)
local App = require(script.Parent.App)

App.start(ClientNet)
RunService:BindToRenderStep("EmberNight", Enum.RenderPriority.Camera.Value + 1, App.frame)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="92">
          <Properties>
            <string name="Name">Net</string>
          </Properties>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">ClientNet</string>
              <string name="Source"><![CDATA[-- Client side of the remotes (docs/DESIGN.md §3.1): decodes snapshots into the interpolator, dispatches event
-- buffers and Ui messages to listeners, sends Move packets at 20 Hz and commands.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Codec = require(Shared.Net.Codec)
local Tuning = require(Shared.Config.Tuning)
local Interp = require(script.Parent.Interp)

local ClientNet = {}

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local moveRemote = remotes:WaitForChild("Move") :: UnreliableRemoteEvent
local snapRemote = remotes:WaitForChild("Snap") :: UnreliableRemoteEvent
local evRemote = remotes:WaitForChild("Ev") :: RemoteEvent
local uiRemote = remotes:WaitForChild("Ui") :: RemoteEvent
local cmdRemote = remotes:WaitForChild("Cmd") :: RemoteEvent
local queryRemote = remotes:WaitForChild("Query") :: RemoteFunction

ClientNet.interp = Interp.new(Tuning.INTERP_DELAY * Tuning.SIM_HZ, Tuning.SIM_HZ)

local evListeners: { (any) -> () } = {}
local uiListeners: { [string]: { (any) -> () } } = {}
local seq = 0
local moveAcc = 0

function ClientNet.onEvent(fn: (any) -> ())
	table.insert(evListeners, fn)
end

function ClientNet.onUi(t: string, fn: (any) -> ())
	uiListeners[t] = uiListeners[t] or {}
	table.insert(uiListeners[t], fn)
end

function ClientNet.command(cmd: { [string]: any })
	cmdRemote:FireServer(cmd)
end

function ClientNet.query(what: string): any
	local ok, res = pcall(function()
		return queryRemote:InvokeServer(what)
	end)
	return if ok then res else nil
end

-- called every frame by the hero controller; sends at MOVE_HZ
function ClientNet.sendMove(dt: number, x: number, y: number, dirX: number, dirY: number, moving: boolean)
	moveAcc += dt
	if moveAcc < 1 / Tuning.MOVE_HZ then
		return
	end
	moveAcc = 0
	seq = (seq + 1) % 65536
	moveRemote:FireServer(Codec.encodeMove(seq, x, y, dirX, dirY, moving))
end

function ClientNet.init()
	snapRemote.OnClientEvent:Connect(function(b)
		if typeof(b) ~= "buffer" then
			return
		end
		local ok, s = pcall(Codec.decodeSnapshot, b)
		if ok and s then
			ClientNet.interp:push(s)
		end
	end)
	evRemote.OnClientEvent:Connect(function(b)
		if typeof(b) ~= "buffer" then
			return
		end
		local ok, evs = pcall(Codec.decodeEvents, b)
		if not ok or not evs then
			warn("[EmberNight] bad event buffer", evs)
			return
		end
		for _, e in evs do
			for _, fn in evListeners do
				fn(e)
			end
		end
	end)
	uiRemote.OnClientEvent:Connect(function(msg)
		if type(msg) ~= "table" or type(msg.t) ~= "string" then
			return
		end
		local list = uiListeners[msg.t]
		if list then
			for _, fn in list do
				task.spawn(fn, msg)
			end
		end
	end)
end

return ClientNet
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">Interp</string>
              <string name="Source"><![CDATA[-- Snapshot buffer and interpolation (docs/DESIGN.md §3.5). Pure (no Roblox services): collects decoded snapshot
-- packets per tick, keeps the last few complete ticks and samples entity positions at
-- renderTick = latest - delay (linear between the two surrounding snapshots, held at the edges).
local Interp = {}
Interp.__index = Interp

local KEEP = 6

function Interp.new(delayTicks: number, tickRate: number)
	return setmetatable({
		delay = delayTicks,
		rate = tickRate,
		frames = {}, -- sorted by tick: { tick, parts, got, enemies = { [id] = e }, heroes = { [slot] = h } }
		lastRaw = -1,
		full = 0,
		latest = nil,
		renderTick = nil,
	}, Interp)
end

-- 16-bit tick -> monotonically increasing tick
function Interp.unwrap(self, raw: number): number
	if self.lastRaw < 0 then
		self.lastRaw = raw
		self.full = raw
		return raw
	end
	local d = (raw - self.lastRaw) % 65536
	if d >= 32768 then
		d -= 65536
	end
	local full = self.full + d
	if d > 0 then
		self.lastRaw = raw
		self.full = full
	end
	return full
end

function Interp.push(self, s)
	local tick = self:unwrap(s.tick)
	local frames = self.frames
	local f = nil
	for _, x in frames do
		if x.tick == tick then
			f = x
			break
		end
	end
	if not f then
		if self.latest and tick < self.latest - KEEP * 4 then
			return -- far too old
		end
		f = { tick = tick, parts = s.parts, got = 0, enemies = {}, heroes = {} }
		local i = #frames + 1
		while i > 1 and frames[i - 1].tick > tick do
			i -= 1
		end
		table.insert(frames, i, f)
		while #frames > KEEP do
			table.remove(frames, 1)
		end
	end
	f.got += 1
	for _, e in s.enemies do
		f.enemies[e.id] = e
	end
	for _, h in s.heroes do
		f.heroes[h.slot] = h
	end
	if not self.latest or tick > self.latest then
		self.latest = tick
	end
end

function Interp.update(self, dt: number)
	if not self.latest then
		return
	end
	local target = self.latest - self.delay
	if not self.renderTick or math.abs(self.renderTick - target) > 8 then
		self.renderTick = target
	else
		self.renderTick += dt * self.rate
		self.renderTick += (target - self.renderTick) * math.min(1, dt * 2)
	end
end

-- the two frames around renderTick and the blend factor
function Interp.bracket(self)
	local frames = self.frames
	local rt = self.renderTick
	if not rt or #frames == 0 then
		return nil, nil, 0
	end
	local a, b = nil, nil
	for i = #frames, 1, -1 do
		if frames[i].tick <= rt then
			a = frames[i]
			b = frames[i + 1]
			break
		end
	end
	if not a then
		return frames[1], nil, 0
	end
	if not b then
		return a, nil, 0
	end
	return a, b, (rt - a.tick) / (b.tick - a.tick)
end

-- calls fn(id, x, y, e) for every enemy at render time
function Interp.eachEnemy(self, fn: (number, number, number, any) -> ())
	local a, b, k = self:bracket()
	if not a then
		return
	end
	for id, e in a.enemies do
		local e2 = b and b.enemies[id]
		if e2 then
			fn(id, e.x + (e2.x - e.x) * k, e.y + (e2.y - e.y) * k, e2)
		else
			fn(id, e.x, e.y, e)
		end
	end
	if b then
		-- enemies that only exist in the newer frame (just spawned or entered the region)
		for id, e in b.enemies do
			if not a.enemies[id] then
				fn(id, e.x, e.y, e)
			end
		end
	end
end

function Interp.hero(self, slot: number)
	local a, b, k = self:bracket()
	if not a then
		return nil
	end
	local h = a.heroes[slot]
	local h2 = b and b.heroes[slot]
	if h and h2 then
		return h.x + (h2.x - h.x) * k, h.y + (h2.y - h.y) * k, h2
	elseif h2 then
		return h2.x, h2.y, h2
	elseif h then
		return h.x, h.y, h
	end
	return nil
end

-- newest known hero data (not delayed): for teammates' HUD and the leash
function Interp.latestHeroes(self)
	local f = self.frames[#self.frames]
	return f and f.heroes or {}
end

function Interp.reset(self)
	table.clear(self.frames)
	self.lastRaw = -1
	self.full = 0
	self.latest = nil
	self.renderTick = nil
end

return Interp
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="95">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">Achievements</string>
              <string name="Source"><![CDATA[-- Achievements (docs/DESIGN.md §5.2, web tpl_ach): all 31 with their gold reward and hero unlocks, then the grid of
-- discovered evolutions (weapon + passive recipe; the evolution's name once it was discovered, else ???).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Achievements = require(Shared.Sim.Data.Achievements)
local Cosmetics = require(Shared.Config.Cosmetics)
local Weapons = require(Shared.Sim.Data.Weapons)
local Passives = require(Shared.Sim.Data.Passives)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screen = { TITLE = Lang.key("Erfolge") }
local tr = Lang.tr

-- free cosmetics by achievement id
local rewardCos = {}
for _, c in Cosmetics.list do
	local kind, ref = string.match(c.source, "^(%a+):(.+)$")
	if kind == "achievement" then
		rewardCos[ref] = c
	end
end

function Screen.render(body: ScrollingFrame, msg, _command, _open)
	local have = msg.profile.achievements or {}
	local n = 0
	for _, a in Achievements.list do
		if have[a.id] then
			n += 1
		end
	end
	Kit.label(body, tr("{0} von {1} erreicht", n, #Achievements.list), {
		Font = Theme.title,
		TextColor3 = Theme.gold,
		LayoutOrder = 0,
	})
	for i, a in Achievements.list do
		local done = have[a.id] == true
		local row = Kit.panel(body, { Size = UDim2.new(1, -10, 0, 58), LayoutOrder = i })
		Kit.padding(row, 6)
		Kit.label(row, (if done then "✔ " else "○ ") .. tr(a.name), {
			Font = Theme.title,
			TextSize = 17,
			TextColor3 = if done then Theme.good else Theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -170, 0, 22),
		})
		local extra = ""
		if a.unlock then
			extra = "  · " .. tr("Freigeschaltet: {0}", tr(a.unlock))
		end
		local c = rewardCos[a.id]
		if c then
			extra ..= "  · " .. tr("Aussehen") .. ": " .. tr(c.name)
		end
		Kit.label(row, tr(a.text) .. extra, {
			TextSize = 13,
			TextColor3 = Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, -170, 0, 20),
		})
		Kit.label(row, "+" .. Lang.fmtNum(a.gold) .. " " .. tr("Gold"), {
			TextColor3 = Theme.gold,
			Size = UDim2.fromOffset(160, 40),
			Position = UDim2.new(1, -160, 0, 2),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end
	-- discovered evolutions
	local evolved = msg.profile.evolved or {}
	local base = #Achievements.list + 1
	Kit.label(body, tr("Entdeckte Entwicklungen"), {
		Font = Theme.title,
		TextColor3 = Theme.gold,
		LayoutOrder = base,
		Size = UDim2.new(1, -10, 0, 30),
	})
	for i, wid in Weapons.ORDER do
		local w = Weapons.byId[wid]
		local p = Passives.byId[w.evo.with]
		local known = evolved[wid] == true
		local row = Kit.panel(body, { Size = UDim2.new(1, -10, 0, 34), LayoutOrder = base + i })
		Kit.padding(row, 6)
		Kit.label(row, tr(w.name) .. " + " .. (if p then tr(p.name) else "?"), {
			TextSize = 15,
			TextColor3 = Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(0.55, 1),
		})
		Kit.label(row, "→ " .. (if known then tr(w.evo.name) else "???"), {
			Font = Theme.title,
			TextSize = 15,
			TextColor3 = if known then Theme.good else Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(0.45, 1),
			Position = UDim2.fromScale(0.55, 0),
		})
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Arrows</string>
              <string name="Source"><![CDATA[-- Off-screen arrows (docs/DESIGN.md §5.2): at the screen edge, pointing at things outside the view – enemy shots
-- that will reach the own hero within 1.2 s (red "!"), downed teammates (green ✚, with the bleed-out danger), the
-- boss (red crown) and the own chests (gold). A fixed pool of 12 arrows; the closest/most urgent win.
local Kit = require(script.Parent.Kit)
local CameraRig = require(script.Parent.Parent.World.CameraRig)
local Coords = require(script.Parent.Parent.World.Coords)

local Arrows = {}

type Arrow = { frame: Frame, head: TextLabel, icon: TextLabel }
type Target = { x: number, y: number, kind: string, prio: number }

local gui: ScreenGui = nil :: any
local pool: { Arrow } = {}
local MAX = 12
local MARGIN = 34
local LOOK = {
	shot = { "!", Color3.fromHex("#ff3d5a") },
	downed = { "✚", Color3.fromHex("#5dff8f") },
	boss = { "👑", Color3.fromHex("#ff5a6e") },
	chest = { "🎁", Color3.fromHex("#ffd23f") },
}
local targets: { Target } = {}

function Arrows.init()
	gui = Kit.screen("EN_Arrows", 3)
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	-- arrows work in viewport pixels: no UI scale
	local sc = gui:FindFirstChildOfClass("UIScale")
	if sc then
		sc:Destroy()
	end
	gui.Enabled = false
	for i = 1, MAX do
		local f = Kit.frame(gui, {
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(44, 44),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Visible = false,
			Name = "Arrow" .. i,
		})
		local head = Kit.label(f, "▲", {
			Size = UDim2.fromScale(1, 1),
			TextSize = 26,
			Font = Enum.Font.GothamBold,
			TextStrokeTransparency = 0.2,
		})
		local icon = Kit.label(f, "", {
			Size = UDim2.fromOffset(26, 26),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			TextSize = 18,
			Font = Enum.Font.GothamBold,
			TextStrokeTransparency = 0.3,
		})
		table.insert(pool, { frame = f, head = head, icon = icon })
	end
end

function Arrows.setVisible(on: boolean)
	gui.Enabled = on
	if not on then
		for _, a in pool do
			a.frame.Visible = false
		end
	end
end

-- collect targets for this frame
function Arrows.begin()
	table.clear(targets)
end

function Arrows.add(kind: string, x: number, y: number, prio: number)
	table.insert(targets, { x = x, y = y, kind = kind, prio = prio })
end

-- an enemy shot at (x, y) moving (vx, vy) px/s: an arrow if it reaches the hero (hx, hy) within 1.2 s
function Arrows.shot(x: number, y: number, vx: number, vy: number, hx: number, hy: number)
	local dx, dy = hx - x, hy - y
	local v2 = vx * vx + vy * vy
	if v2 < 1 then
		return
	end
	local t = (dx * vx + dy * vy) / v2 -- time of closest approach
	if t < 0 or t > 1.2 then
		return
	end
	local cx, cy = x + vx * t - hx, y + vy * t - hy
	if cx * cx + cy * cy > 60 * 60 then
		return
	end
	Arrows.add("shot", x, y, 100 - t * 50)
end

-- place the arrows for the targets that are off screen
function Arrows.render(now: number)
	if not gui.Enabled then
		return
	end
	local vp = workspace.CurrentCamera.ViewportSize
	local cxs, cys = vp.X / 2, vp.Y / 2
	table.sort(targets, function(a, b)
		return a.prio > b.prio
	end)
	local used = 0
	for _, tg in targets do
		if used >= MAX then
			break
		end
		local sx, sy, inside, behind = CameraRig.project(Coords.v3(tg.x, tg.y, 1))
		if inside then
			continue
		end
		if behind then
			sx, sy = cxs + (cxs - sx), cys + (cys - sy)
		end
		-- clamp along the ray from the screen centre to the edge (minus the margin)
		local dx, dy = sx - cxs, sy - cys
		local kx = if dx ~= 0 then (cxs - MARGIN) / math.abs(dx) else math.huge
		local ky = if dy ~= 0 then (cys - MARGIN) / math.abs(dy) else math.huge
		local k = math.min(kx, ky, 1)
		local px, py = cxs + dx * k, cys + dy * k
		used += 1
		local a = pool[used]
		local look = LOOK[tg.kind] or LOOK.shot
		a.frame.Visible = true
		a.frame.Position = UDim2.fromOffset(px, py)
		a.head.Rotation = math.deg(math.atan2(dy, dx)) + 90
		a.head.TextColor3 = look[2]
		a.icon.Text = look[1]
		a.icon.TextColor3 = look[2]
		-- incoming shots blink
		a.head.TextTransparency = if tg.kind == "shot" then 0.1 + 0.3 * (math.floor(now * 10) % 2) else 0.1
	end
	for i = used + 1, MAX do
		pool[i].frame.Visible = false
	end
end

return Arrows
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Downed</string>
              <string name="Source"><![CDATA[-- Downed / last chance / fallen overlay (docs/DESIGN.md §2.8, §5.2): a darkened screen edge, "Down!" with the
-- bleed-out bar and the revive progress a teammate is filling; in the last chance a big countdown; fallen heroes see
-- a small "spectating" line. The "Second Ember" button lives in ReviveOffer.luau right below this panel.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Tuning = require(Shared.Config.Tuning)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Downed = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local ui: { [string]: any } = {}
local state = "active"
local lastChance: number? = nil
local lastAt = 0
local solo = true

function Downed.init()
	gui = Kit.screen("EN_Downed", 4)
	gui.Enabled = false
	ui.shade = Kit.frame(gui, {
		BackgroundColor3 = Color3.fromRGB(30, 0, 10),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
	})
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.85),
		NumberSequenceKeypoint.new(0.7, 0.85),
		NumberSequenceKeypoint.new(1, 0),
	})
	g.Parent = ui.shade
	ui.panel = Kit.panel(gui, {
		Size = UDim2.fromOffset(420, 128),
		Position = UDim2.fromScale(0.5, 0.36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0.2,
		Visible = false,
	})
	ui.title = Kit.label(ui.panel, "", {
		Font = Theme.title,
		TextSize = 34,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 8),
		TextColor3 = Theme.bad,
		TextStrokeTransparency = 0.3,
	})
	ui.hint = Kit.label(ui.panel, "", {
		TextSize = 15,
		Size = UDim2.new(1, -24, 0, 20),
		Position = UDim2.fromOffset(12, 50),
		TextColor3 = Theme.dim,
	})
	local bleed, setBleed =
		Kit.bar(ui.panel, Theme.bad, { Size = UDim2.new(1, -40, 0, 12), Position = UDim2.fromOffset(20, 78) })
	ui.bleed = bleed
	ui.setBleed = setBleed
	local rev, setRev =
		Kit.bar(ui.panel, Theme.good, { Size = UDim2.new(1, -40, 0, 12), Position = UDim2.fromOffset(20, 100) })
	ui.rev = rev
	ui.setRev = setRev
	ui.fallen = Kit.label(gui, "", {
		Font = Theme.title,
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.new(0, 0, 1, -76),
		TextColor3 = Theme.dim,
		TextStrokeTransparency = 0.4,
		Visible = false,
	})
end

function Downed.setSolo(on: boolean)
	solo = on
end

local function show()
	local downed = state == "downed"
	local lc = lastChance ~= nil and state ~= "active"
	gui.Enabled = downed or lc or state == "fallen"
	ui.shade.Visible = downed or lc
	ui.panel.Visible = downed or lc
	ui.fallen.Visible = state == "fallen" and not lc
	ui.rev.Visible = downed and not solo
	ui.bleed.Visible = downed
end

-- own hero state (hero message)
function Downed.hero(m)
	state = m.state
	if state == "downed" then
		ui.title.Text = tr("Am Boden!")
		ui.hint.Text = if solo then "" else tr("Ein Mitspieler kann dich wiederbeleben.")
		ui.setBleed((m.bleed or 0) / Tuning.BLEED_OUT)
		ui.setRev(m.revive or 0)
	elseif state == "fallen" then
		ui.fallen.Text = tr("Gefallen – du schaust zu")
	end
	show()
end

-- run info: last chance seconds (nil when none)
function Downed.run(m)
	if m.state == "lastchance" and m.lastChance then
		lastChance = m.lastChance
		lastAt = os.clock()
	else
		lastChance = nil
	end
	show()
end

function Downed.hide()
	state = "active"
	lastChance = nil
	if gui then
		gui.Enabled = false
	end
end

function Downed.update()
	if lastChance and state ~= "active" then
		local left = math.max(0, lastChance - (os.clock() - lastAt))
		ui.title.Text = tr("Letzte Chance – {0} s", math.ceil(left))
		ui.hint.Text = tr("Die Glut erlischt …")
	end
end

return Downed
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Forge</string>
              <string name="Source"><![CDATA[-- Forge (docs/DESIGN.md §5.2, web tpl_shop): 17 permanent upgrades with level pips and price; refund everything
-- with a confirmation. Prices come from Sim/Profile.luau (same formula as the server, which decides).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Forge = require(Shared.Sim.Data.Forge)
local Profile = require(Shared.Sim.Profile)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screen = { TITLE = Lang.key("Schmiede") }
local tr = Lang.tr
local confirmRefund = false

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), open: (string) -> ())
	local view = msg.profile
	local p = { shop = view.forge or {} }
	Kit.label(
		body,
		tr("Dauerhafte Verbesserungen für alle Helden. Jeder Kauf macht alle weiteren Käufe etwas teurer."),
		{
			TextSize = 14,
			TextColor3 = Theme.dim,
			Size = UDim2.new(1, -10, 0, 36),
			LayoutOrder = 0,
		}
	)
	Kit.label(body, "● " .. Lang.fmtNum(view.gold) .. " " .. tr("Gold"), {
		Font = Theme.title,
		TextSize = 22,
		TextColor3 = Theme.gold,
		LayoutOrder = 1,
	})
	local grid = Kit.grid(body, 240, 112, { LayoutOrder = 2 })
	for i, it in Forge.list do
		local lvl = p.shop[it.id] or 0
		local card = Kit.panel(grid, { LayoutOrder = i })
		Kit.padding(card, 8)
		Kit.label(card, tr(it.name), { Font = Theme.title, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left })
		Kit.label(card, tr(it.text), {
			TextSize = 13,
			TextColor3 = Theme.dim,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		Kit.label(card, string.rep("■", lvl) .. string.rep("□", it.max - lvl), {
			TextColor3 = Theme.primary,
			Position = UDim2.fromOffset(0, 46),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		if lvl >= it.max then
			Kit.label(card, tr("MAX"), {
				Font = Theme.title,
				TextColor3 = Theme.good,
				Size = UDim2.fromOffset(100, 30),
				Position = UDim2.new(1, -100, 1, -30),
			})
		else
			local price = Profile.forgePrice(p, it)
			local b = Kit.button(card, "● " .. Lang.fmtNum(price), function()
				command({ op = "forgeBuy", id = it.id })
			end, { Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -110, 1, -36), TextSize = 16 })
			if view.gold < price then
				b.BackgroundColor3 = Theme.panel2
				b.TextColor3 = Theme.dim
			end
		end
	end
	if (view.forgeRefund or 0) > 0 then
		local row = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 3 })
		Kit.list(row, true, 10)
		if confirmRefund then
			Kit.label(row, tr("Wirklich alles zurückerstatten?") .. "  (+" .. Lang.fmtNum(view.forgeRefund) .. ")", {
				Size = UDim2.fromOffset(360, 44),
			})
			Kit.button(row, tr("Ja"), function()
				confirmRefund = false
				command({ op = "forgeRefund" })
			end, { BackgroundColor3 = Theme.bad, Size = UDim2.fromOffset(90, 44) })
			Kit.button(row, tr("Nein"), function()
				confirmRefund = false
				open("forge")
			end, { BackgroundColor3 = Theme.panel2, Size = UDim2.fromOffset(90, 44) })
		else
			Kit.button(row, tr("Alles zurückerstatten"), function()
				confirmRefund = true
				open("forge")
			end, { BackgroundColor3 = Theme.panel2, Size = UDim2.fromOffset(240, 44) })
		end
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">Heroes</string>
              <string name="Source"><![CDATA[-- Hero selection (docs/DESIGN.md §5.2, web tpl_chars): 9 heroes, earned by achievement or unlocked with a game
-- pass; locked heroes show their achievement and, if the pass is configured, a Robux button.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Heroes = require(Shared.Sim.Data.Heroes)
local Weapons = require(Shared.Sim.Data.Weapons)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Names = require(script.Parent.Names)
local Preview = require(script.Parent.Preview)

local Screen = { TITLE = Lang.key("Helden") }
local tr = Lang.tr

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), _open)
	local view = msg.profile
	local mine = nil
	for _, m in msg.members do
		if m.userId == msg.you then
			mine = m.hero
		end
	end
	local grid = Kit.grid(body, 180, 296, { LayoutOrder = 1 })
	for i, id in Heroes.ORDER do
		local h = Heroes.byId[id]
		local unlocked = table.find(msg.heroes, id) ~= nil
		local card =
			Kit.panel(grid, { LayoutOrder = i, BackgroundColor3 = if mine == id then Theme.panel2 else Theme.panel })
		Kit.padding(card, 8)
		Kit.list(card, false, 2)
		local skin = view.equipped and view.equipped.skin
		local pv =
			Preview.hero(card, id, if unlocked then skin else nil, { Size = UDim2.new(1, 0, 0, 78), LayoutOrder = 0 })
		if not unlocked then
			pv.ImageTransparency = 0.55
			pv.ImageColor3 = Color3.fromRGB(90, 80, 110)
		end
		Kit.label(
			card,
			tr(h.name),
			{ Font = Theme.title, TextSize = 22, TextColor3 = Names.heroColor(id), LayoutOrder = 1 }
		)
		Kit.label(
			card,
			tr(h.title),
			{ TextSize = 14, TextColor3 = Theme.dim, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 18) }
		)
		Kit.label(card, tr(h.text), { TextSize = 14, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 36) })
		local w = Weapons.byId[h.weapon]
		Kit.label(
			card,
			"⚔ " .. (if w then tr(w.name) else h.weapon),
			{ TextSize = 14, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 18) }
		)
		if mine == id then
			Kit.label(card, "✔ " .. tr("Gewählt"), { TextColor3 = Theme.good, Font = Theme.title, LayoutOrder = 5 })
		elseif unlocked then
			Kit.button(card, tr("Wählen"), function()
				command({ op = "selectHero", hero = id })
			end, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 5 })
		else
			Kit.label(card, "🔒 " .. Names.achievementHint(h.unlock or ""), {
				TextSize = 13,
				TextColor3 = Theme.dim,
				LayoutOrder = 5,
				Size = UDim2.new(1, 0, 0, 44),
			})
			Names.buyButton(card, view, "pass_hero_" .. id, command, { Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 6 })
		end
	end
	local all = Names.shopItem(view, "pass_heroes_all")
	if all and not all.owned and #msg.heroes < #Heroes.ORDER then
		local row = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 2 })
		Kit.list(row, true, 10)
		Kit.label(row, Names.product("pass_heroes_all") .. " – " .. Names.productDesc("pass_heroes_all"), {
			Size = UDim2.fromOffset(460, 44),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		Names.buyButton(row, view, "pass_heroes_all", command, { Size = UDim2.fromOffset(120, 44) })
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- In-run HUD (docs/DESIGN.md §5.2): XP bar with level, run clock, kills and gold, pause button (solo), weapon and
-- passive slots with level pips, boss bar with name, countdown/surge bar (icon, label, time, warning pulse), HP bar,
-- teammates with HP and downed/fallen state, banner, toasts, a red flash when hurt. Scale-based layout inside the
-- device safe area; touch screens get bigger buttons.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Heroes = require(Shared.Sim.Data.Heroes)
local Weapons = require(Shared.Sim.Data.Weapons)
local Passives = require(Shared.Sim.Data.Passives)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Device = require(script.Parent.Parent.Device)

local Hud = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local ui: { [string]: any } = {}
local bannerT = 0
local timeBase, timeAt = 0, 0
local runState = "play"
local countdown: any = nil
local command: (any) -> () = function(_) end
local openMenu: () -> () = function() end
local isSolo = true
local hurtT = 0
local buildSig = ""
local teamSig = ""
local toasts: { { frame: Frame, t: number } } = {}
local names: { [number]: string } = {}
local ownSlot = 0

local function args(a)
	if type(a) ~= "table" then
		return {}
	end
	local out = {}
	for i, v in a do
		out[i] = if type(v) == "string" then tr(v) else v
	end
	return out
end

local function corner(f: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = f
end

local function stroke(f: Instance, col: Color3, th: number, tr0: number?)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = th
	s.Transparency = tr0 or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
end

-- a framed bar: background, fill, optional text; returns frame, fill
local function bar(parent: Instance, col: Color3, props: { [string]: any }): (Frame, Frame)
	local bg = Kit.frame(parent, props)
	bg.BackgroundColor3 = Color3.fromRGB(16, 10, 24)
	bg.BackgroundTransparency = 0.15
	corner(bg, 6)
	stroke(bg, Color3.fromRGB(0, 0, 0), 2, 0.3)
	local fill = Kit.frame(bg, { BackgroundColor3 = col, Size = UDim2.fromScale(0, 1) })
	corner(fill, 6)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(col:Lerp(Color3.new(1, 1, 1), 0.25), col:Lerp(Color3.new(0, 0, 0), 0.25))
	g.Parent = fill
	return bg, fill
end

local function setFill(fill: Frame, v: number)
	fill.Size = UDim2.fromScale(math.clamp(v, 0, 1), 1)
end

-- menu = opens the pause screen without pausing (co-op)
function Hud.init(cmd, menu: (() -> ())?)
	command = cmd
	openMenu = menu or openMenu
	gui = Kit.screen("EN_Hud", 2)
	gui.Enabled = false
	local touch = Device.touch()
	-- hurt flash under everything
	ui.hurt = Kit.frame(gui, {
		BackgroundColor3 = Color3.fromRGB(255, 40, 70),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
	})
	-- XP bar across the top with the level
	local xpBg, xpFill = bar(gui, Theme.xp, { Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(8, 4) })
	ui.xpFill = xpFill
	ui.level = Kit.label(xpBg, "", {
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		TextSize = 12,
		Font = Theme.number,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.4,
	})
	ui.timer = Kit.label(gui, "0:00", {
		Font = Theme.title,
		TextSize = 34,
		Size = UDim2.fromOffset(180, 38),
		Position = UDim2.new(0.5, 0, 0, 20),
		AnchorPoint = Vector2.new(0.5, 0),
		TextStrokeTransparency = 0.35,
	})
	ui.stats = Kit.label(gui, "", {
		TextSize = 18,
		Font = Theme.number,
		Size = UDim2.fromOffset(260, 26),
		Position = UDim2.new(1, -10, 0, 24),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextStrokeTransparency = 0.4,
	})
	local pb = if touch then 56 else 44
	ui.pause = Kit.button(gui, "II", function()
		if not isSolo then
			openMenu()
		else
			command({ op = if runState == "paused" then "resume" else "pause" })
		end
	end, { Size = UDim2.fromOffset(pb, pb), Position = UDim2.fromOffset(8, 24), BackgroundColor3 = Theme.panel2 })
	-- build: weapons and passives under the pause button
	ui.build = Kit.frame(gui, {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(250, 76),
		Position = UDim2.fromOffset(8, 24 + pb + 6),
	})
	local wl = Kit.list(ui.build, false, 4)
	wl.HorizontalAlignment = Enum.HorizontalAlignment.Left
	ui.weapons = Kit.frame(ui.build, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1 })
	local l1 = Kit.list(ui.weapons, true, 4)
	l1.HorizontalAlignment = Enum.HorizontalAlignment.Left
	ui.passives = Kit.frame(ui.build, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 })
	local l2 = Kit.list(ui.passives, true, 4)
	l2.HorizontalAlignment = Enum.HorizontalAlignment.Left
	-- boss bar
	ui.boss = Kit.frame(gui, {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.46, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 64),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
	})
	local sc = Instance.new("UISizeConstraint")
	sc.MinSize = Vector2.new(260, 0)
	sc.MaxSize = Vector2.new(620, 100)
	sc.Parent = ui.boss
	ui.bossName = Kit.label(ui.boss, "", {
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.title,
		TextSize = 19,
		TextColor3 = Color3.fromRGB(255, 200, 210),
		TextStrokeTransparency = 0.3,
	})
	local _, bossFill = bar(ui.boss, Theme.boss, { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 22) })
	ui.bossFill = bossFill
	-- countdown / surge bar
	ui.cd = Kit.panel(gui, {
		Size = UDim2.fromOffset(340, 42),
		Position = UDim2.new(0.5, 0, 0, 64),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 0.2,
		Visible = false,
	})
	ui.cdIcon = Kit.frame(
		ui.cd,
		{ BackgroundTransparency = 1, Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(4, 4) }
	)
	ui.cdText = Kit.label(ui.cd, "", {
		Size = UDim2.new(1, -48, 0, 22),
		Position = UDim2.fromOffset(44, 2),
		TextSize = 16,
		Font = Theme.number,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local _, cdFill = bar(ui.cd, Theme.primary, { Size = UDim2.new(1, -52, 0, 8), Position = UDim2.fromOffset(44, 27) })
	ui.cdFill = cdFill
	-- banner and sub line
	ui.banner = Kit.label(gui, "", {
		Font = Theme.title,
		TextSize = 34,
		Size = UDim2.new(1, -40, 0, 42),
		Position = UDim2.new(0.5, 0, 0, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Theme.primary,
		TextStrokeTransparency = 0.3,
		Visible = false,
	})
	ui.bannerSub = Kit.label(gui, "", {
		TextSize = 18,
		Size = UDim2.new(1, -40, 0, 24),
		Position = UDim2.new(0.5, 0, 0, 194),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		TextStrokeTransparency = 0.4,
	})
	-- teammates
	ui.team = Kit.frame(gui, {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(210, 200),
		Position = UDim2.new(1, -10, 0, 58),
		AnchorPoint = Vector2.new(1, 0),
	})
	local tl = Kit.list(ui.team, false, 4)
	tl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	-- toasts (achievements, purchases) under the team
	ui.toasts = Kit.frame(gui, {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(280, 160),
		Position = UDim2.new(1, -10, 0, 250),
		AnchorPoint = Vector2.new(1, 0),
	})
	local tol = Kit.list(ui.toasts, false, 6)
	tol.HorizontalAlignment = Enum.HorizontalAlignment.Right
	-- HP bar at the bottom
	local hpBg, hpFill = bar(gui, Theme.hp, {
		Size = UDim2.fromOffset(300, 20),
		Position = UDim2.new(0.5, 0, 1, -32),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	ui.hpFill = hpFill
	ui.hpText = Kit.label(hpBg, "", {
		Size = UDim2.fromScale(1, 1),
		TextSize = 13,
		Font = Theme.number,
		TextStrokeTransparency = 0.4,
	})
end

function Hud.setVisible(on: boolean, solo: boolean?)
	gui.Enabled = on
	if solo ~= nil then
		isSolo = solo
	end
	ui.pause.Text = if isSolo then "II" else "☰"
	if not on then
		countdown = nil
		ui.boss.Visible = false
		ui.cd.Visible = false
		buildSig, teamSig = "", ""
		Kit.clear(ui.weapons)
		Kit.clear(ui.passives)
		Kit.clear(ui.team)
		for _, t in toasts do
			t.frame:Destroy()
		end
		table.clear(toasts)
	end
end

-- names of the run's players (slot -> display name) and the own slot
function Hud.setTeam(team: { [number]: any }?, slot: number?)
	table.clear(names)
	for s, info in team or {} do
		if type(info) == "table" and type(info.name) == "string" then
			names[s] = info.name
		end
	end
	ownSlot = slot or 0
	teamSig = ""
end

local function renderBuild(m)
	local parts = {}
	for _, w in m.weapons or {} do
		table.insert(parts, w.id .. w.level .. (if w.evo then "E" else ""))
	end
	for _, p in m.passives or {} do
		table.insert(parts, p.id .. p.level)
	end
	local sig = table.concat(parts, ",")
	if sig == buildSig then
		return
	end
	buildSig = sig
	Kit.clear(ui.weapons)
	Kit.clear(ui.passives)
	for i, w in m.weapons or {} do
		local d = Weapons.byId[w.id]
		Icons.tile(ui.weapons, "weapon", w.id, 36, { LayoutOrder = i }, w.level, if d then #d.levels + 1 else 8, w.evo)
	end
	for i, p in m.passives or {} do
		local d = Passives.byId[p.id]
		Icons.tile(ui.passives, "passive", p.id, 30, { LayoutOrder = i }, p.level, if d then d.max else 5)
	end
end

function Hud.hero(m)
	setFill(ui.hpFill, m.hp / math.max(1, m.maxHp))
	ui.hpText.Text = string.format("%d / %d", m.hp, m.maxHp)
	setFill(ui.xpFill, m.xp / math.max(1, m.xpNext))
	ui.level.Text = tr("Stufe {0}", m.level)
	ui.stats.Text = string.format("☠ %s    ● %s", Lang.fmtNum(m.kills), Lang.fmtNum(m.gold))
	renderBuild(m)
end

local function teamCard(p, i)
	local h = Heroes.byId[p.hero]
	local col = Color3.fromHex(if h then h.color else "#4f8cff")
	local card = Kit.panel(ui.team, {
		Size = UDim2.fromOffset(200, 42),
		BackgroundTransparency = 0.25,
		LayoutOrder = i,
	})
	local strip =
		Kit.frame(card, { BackgroundColor3 = col, Size = UDim2.new(0, 6, 1, -8), Position = UDim2.fromOffset(4, 4) })
	corner(strip, 3)
	local name = names[p.slot] or (if h then tr(h.name) else "?")
	local stateText = ""
	local stateCol = Theme.text
	if p.state == "downed" then
		stateText = "✚ " .. math.ceil(p.bleed or 0) .. " s"
		stateCol = Theme.good
	elseif p.state == "fallen" then
		stateText = "✖"
		stateCol = Theme.bad
	end
	Kit.label(card, name .. "  " .. tr("St. {0}", p.level or 1), {
		Size = UDim2.new(1, -70, 0, 18),
		Position = UDim2.fromOffset(14, 3),
		TextSize = 13,
		Font = Theme.number,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Kit.label(card, stateText, {
		Size = UDim2.fromOffset(56, 18),
		Position = UDim2.new(1, -60, 0, 3),
		TextSize = 13,
		Font = Theme.number,
		TextColor3 = stateCol,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local _, fill = bar(card, if p.state == "downed" then Theme.good else Theme.hp, {
		Size = UDim2.new(1, -22, 0, 8),
		Position = UDim2.fromOffset(14, 26),
	})
	setFill(fill, if p.state == "downed" then (p.revive or 0) else (p.hp or 0))
end

function Hud.run(m)
	timeBase, timeAt = m.time, os.clock()
	runState = m.state
	if m.boss then
		ui.boss.Visible = true
		setFill(ui.bossFill, m.boss.frac)
		ui.bossName.Text = (if m.boss.final then "👑 " else "") .. tr(m.boss.name)
	else
		ui.boss.Visible = false
	end
	ui.cd.Position = UDim2.new(0.5, 0, 0, if ui.boss.Visible then 108 else 64)
	-- teammates (everyone but me), rebuilt only when something visible changed
	local parts = {}
	local others = {}
	for _, p in m.team do
		if p.slot ~= ownSlot then
			table.insert(others, p)
			table.insert(
				parts,
				string.format(
					"%d%s%d%d%d",
					p.slot,
					p.state,
					math.floor((p.hp or 0) * 40),
					math.ceil(p.bleed or 0),
					math.floor((p.revive or 0) * 20)
				)
			)
		end
	end
	local sig = table.concat(parts, "|")
	if sig ~= teamSig then
		teamSig = sig
		Kit.clear(ui.team)
		if #m.team > 1 then
			for i, p in others do
				teamCard(p, i)
			end
		end
	end
	if isSolo then
		ui.pause.Text = if m.state == "paused" then "▶" else "II"
	end
end

function Hud.state(state: string)
	runState = state
	if isSolo then
		ui.pause.Text = if state == "paused" then "▶" else "II"
	end
end

function Hud.banner(m)
	local a = args(m.args)
	ui.banner.Text = if #a > 0 then tr(m.text, table.unpack(a)) else tr(m.text)
	ui.banner.Visible = true
	ui.banner.TextColor3 = if m.kind == "boss" then Theme.bad elseif m.kind == "win" then Theme.gold else Theme.primary
	if m.sub then
		ui.bannerSub.Text = if #a > 0 then tr(m.sub, table.unpack(a)) else tr(m.sub)
		ui.bannerSub.Visible = true
	else
		ui.bannerSub.Visible = false
	end
	bannerT = m.dur or 2.4
end

function Hud.countdown(m)
	if m.phase == "off" then
		countdown = nil
		ui.cd.Visible = false
		return
	end
	countdown = m
	ui.cd.Visible = true
	Kit.clear(ui.cdIcon)
	if m.icon then
		local t = Icons.tile(ui.cdIcon, "enemy", m.icon, 34)
		if m.tint and type(m.tint) == "string" and #m.tint == 7 then
			t.BackgroundColor3 = Color3.fromHex(m.tint):Lerp(Color3.new(0, 0, 0), 0.4)
		end
	end
end

-- a toast at the right (achievements, purchases); fades after 3 s
function Hud.toast(text: string, color: Color3?)
	local f = Kit.panel(ui.toasts, {
		Size = UDim2.fromOffset(270, 36),
		BackgroundTransparency = 0.15,
		LayoutOrder = math.floor(os.clock() * 10),
	})
	Kit.label(f, text, {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		TextSize = 15,
		Font = Theme.number,
		TextColor3 = color or Theme.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	table.insert(toasts, { frame = f, t = 3 })
	while #toasts > 4 do
		local old = table.remove(toasts, 1)
		if old then
			old.frame:Destroy()
		end
	end
end

function Hud.achievement(name: string)
	Hud.toast("🏆 " .. tr(name))
end

-- red flash at the screen edges when the own hero takes damage
function Hud.hurt()
	hurtT = 0.35
end

function Hud.bossActive(): boolean
	return ui.boss ~= nil and ui.boss.Visible
end

function Hud.surgeOn(): boolean
	return countdown ~= nil and countdown.kind ~= "boss" and countdown.phase == "on"
end

function Hud.runState(): string
	return runState
end

-- estimated sim time (run clock from the last "run" message, advancing while playing)
function Hud.time(): number
	return timeBase + (if runState == "play" then os.clock() - timeAt else 0)
end

-- per frame: timer, banner fade, countdown bar, toasts, hurt flash
function Hud.update(dt: number)
	if not gui.Enabled then
		return
	end
	local t = Hud.time()
	ui.timer.Text = Lang.fmtTime(t)
	if bannerT > 0 then
		bannerT -= dt
		if bannerT <= 0 then
			ui.banner.Visible = false
			ui.bannerSub.Visible = false
		end
	end
	if hurtT > 0 then
		hurtT -= dt
		ui.hurt.BackgroundTransparency = 1 - math.max(0, hurtT / 0.35) * 0.3
	end
	for i = #toasts, 1, -1 do
		local to = toasts[i]
		to.t -= dt
		if to.t <= 0 then
			to.frame:Destroy()
			table.remove(toasts, i)
		end
	end
	if countdown then
		local c = countdown
		local on = c.phase == "on"
		local left = if on then c["end"] - t else c.at - t
		local total = if on then c["end"] - c.at else c.at - c.start
		setFill(ui.cdFill, math.clamp(left / math.max(total, 0.1), 0, 1))
		local lt = Lang.fmtTime(math.max(0, math.ceil(left)))
		if c.kind == "boss" then
			ui.cdText.Text = tr("{0} in {1}", tr(c.label), lt)
		elseif on then
			ui.cdText.Text = tr("Ansturm! Noch {0}", lt)
		else
			ui.cdText.Text = tr("Ansturm in {0}", lt)
		end
		-- warning colours: the last 10 s before it starts pulse; a running surge is red
		local pulse = (not on and left <= 10 and math.floor(t * 4) % 2 == 0)
		ui.cdFill.BackgroundColor3 = if on then Theme.bad elseif pulse then Theme.gold else Theme.primary
		ui.cdText.TextColor3 = if on or pulse then Theme.gold else Theme.text
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[-- Icons without image uploads (docs/DESIGN.md §5.1): a rounded tile in the item's colour with a gradient and an
-- outline, a glyph (emoji or symbol, rendered by Roblox's text engine) and optional level pips. Used by the HUD
-- build slots, level-up cards, chest, pause screen, hero cards and the countdown bar.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enemies = require(Shared.Sim.Data.Enemies)
local Heroes = require(Shared.Sim.Data.Heroes)

local Icons = {}

-- glyph and colour per item
Icons.WEAPON = {
	wand = { "✨", "#b48cff" },
	whip = { "🗡️", "#e8eef8" },
	orbit = { "🔵", "#ffe27a" },
	aura = { "☀️", "#ff9a3c" },
	lightning = { "⚡", "#9fe8ff" },
	sickle = { "🌙", "#e8e0c8" },
	fire = { "🧪", "#ff7a2f" },
	nova = { "❄️", "#a8e4ff" },
	knives = { "🔪", "#d8f3ff" },
}
Icons.PASSIVE = {
	might = { "💪", "#ff7a6a" },
	armor = { "🛡️", "#9aa8c0" },
	heart = { "❤️", "#ff5a7a" },
	boots = { "👢", "#c8945a" },
	magnet = { "🧲", "#e05050" },
	hourglass = { "⏳", "#ffd27a" },
	lens = { "🔍", "#8fd8ff" },
	mirror = { "🪞", "#c8d8ff" },
	clover = { "🍀", "#5ddc6a" },
	elixir = { "💧", "#5ab8ff" },
	candle = { "🕯️", "#ffcf6a" },
	wing = { "🪶", "#e8f0ff" },
}
Icons.ENEMY = {
	bat = "🦇",
	slime = "🟢",
	skel = "💀",
	ghost = "👻",
	ghoul = "🧟",
	spitter = "🐸",
	cinder = "🔥",
	moth = "🦋",
	bell = "🔔",
	wraith = "🌀",
	brute = "👹",
	golem = "🗿",
	night = "🌑",
}
Icons.MISC = {
	gold = { "🪙", "#ffd23f" },
	heal = { "🧡", "#ff7a8a" },
	chest = { "🎁", "#d8a040" },
	surge = { "⚠️", "#ff5a6e" },
	boss = { "👑", "#ff5a6e" },
	skull = { "☠", "#ff5a6e" },
	revive = { "✚", "#5dff8f" },
	star = { "★", "#ffd23f" },
}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

-- the glyph and colour for an item kind ("weapon", "passive", "gold", "heal", "enemy", "hero", or a MISC key)
function Icons.look(kind: string, id: string?): (string, Color3)
	if kind == "weapon" and id and Icons.WEAPON[id] then
		local w = Icons.WEAPON[id]
		return w[1], hex(w[2])
	elseif kind == "passive" and id and Icons.PASSIVE[id] then
		local p = Icons.PASSIVE[id]
		return p[1], hex(p[2])
	elseif kind == "enemy" and id then
		return Icons.ENEMY[id] or "👾", hex(Enemies.COLORS[id] or "#ff5a6e")
	elseif kind == "hero" and id then
		local h = Heroes.byId[id]
		local w = h and Icons.WEAPON[h.weapon]
		return if w then w[1] else "★", hex(if h then h.color else "#4f8cff")
	end
	local m = Icons.MISC[if kind == "gold" or kind == "heal" then kind else (id or kind)] or Icons.MISC.star
	return m[1], hex(m[2])
end

-- an icon tile of `size` px; level/max draw pips under it (max 8); evo = golden frame
function Icons.tile(
	parent: Instance,
	kind: string,
	id: string?,
	size: number,
	props: { [string]: any }?,
	level: number?,
	max: number?,
	evo: boolean?
): Frame
	local glyph, col = Icons.look(kind, id)
	local f = Instance.new("Frame")
	f.Name = "Icon"
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = col:Lerp(Color3.fromRGB(20, 14, 30), 0.55)
	f.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(size * 0.22))
	c.Parent = f
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(col:Lerp(Color3.new(1, 1, 1), 0.15), col:Lerp(Color3.new(0, 0, 0), 0.55))
	g.Transparency = NumberSequence.new(0.35, 0.1)
	g.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = if evo then Color3.fromHex("#ffd23f") else col
	s.Thickness = if evo then 2.5 else 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	local t = Instance.new("TextLabel")
	t.Name = "Glyph"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = glyph
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Parent = f
	local pad = Instance.new("UIPadding")
	local p = UDim.new(0, math.floor(size * 0.14))
	pad.PaddingTop, pad.PaddingBottom, pad.PaddingLeft, pad.PaddingRight = p, p, p, p
	pad.Parent = t
	if level and max and max > 1 then
		local row = Instance.new("Frame")
		row.Name = "Pips"
		row.BackgroundTransparency = 1
		row.AnchorPoint = Vector2.new(0.5, 1)
		row.Position = UDim2.new(0.5, 0, 1, -1)
		row.Size = UDim2.new(1, -4, 0, math.max(3, math.floor(size * 0.1)))
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.HorizontalAlignment = Enum.HorizontalAlignment.Center
		l.Padding = UDim.new(0, 1)
		l.Parent = row
		local n = math.min(max, 8)
		for i = 1, n do
			local pip = Instance.new("Frame")
			pip.BorderSizePixel = 0
			pip.Size = UDim2.new(1 / n, -1, 1, 0)
			pip.BackgroundColor3 = if i <= level then Color3.fromHex("#ffd23f") else Color3.fromRGB(40, 30, 50)
			pip.LayoutOrder = i
			pip.Parent = row
		end
		row.Parent = f
	end
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Small UI builders (docs/DESIGN.md §5.1): panels, labels, buttons, bars. Scale-based layout, UIScale from the
-- screen height (base 720 px), minimum touch target 44 px.
local Players = game:GetService("Players")
local Theme = require(script.Parent.Theme)
local Device = require(script.Parent.Parent.Device)

local Kit = {}
-- called on every button press (the client plays the click sound here)
Kit.onClick = nil :: (() -> ())?

function Kit.screen(name: string, order: number?): ScreenGui
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = false
	g.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	g.DisplayOrder = order or 0
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local scale = Instance.new("UIScale")
	scale.Parent = g
	local function fit()
		local h = Device.viewport().Y
		-- touch screens never go below 0.72 so buttons stay finger-sized
		scale.Scale = math.clamp(h / 720, if Device.touch() then 0.72 else 0.6, 1.6)
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return g
end

-- the usable size of a ScreenGui in its own (scaled) units
function Kit.uiSize(g: ScreenGui): Vector2
	local vp = Device.viewport()
	local sc = g:FindFirstChildOfClass("UIScale")
	local s = if sc then sc.Scale else 1
	return Vector2.new(vp.X / s, (vp.Y - 36) / s)
end

function Kit.frame(parent: Instance, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Theme.panel
	f.BorderSizePixel = 0
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

function Kit.panel(parent: Instance, props: { [string]: any }?): Frame
	local f = Kit.frame(parent, props)
	f.BackgroundTransparency = f.BackgroundTransparency ~= 0 and f.BackgroundTransparency or 0.1
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = Theme.stroke
	s.Thickness = 1.5
	s.Transparency = 0.3
	s.Parent = f
	return f
end

function Kit.label(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = Theme.text
	t.Font = Theme.body
	t.TextSize = 18
	t.TextWrapped = true
	t.Size = UDim2.new(1, 0, 0, 24)
	for k, v in props or {} do
		(t :: any)[k] = v
	end
	t.Parent = parent
	return t
end

function Kit.button(parent: Instance, text: string, onClick: () -> (), props: { [string]: any }?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = Theme.primary
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Theme.title
	b.TextSize = 20
	b.Text = text
	b.Size = UDim2.fromOffset(160, 44)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = b
	for k, v in props or {} do
		(b :: any)[k] = v
	end
	b.Activated:Connect(function()
		if Kit.onClick then
			Kit.onClick()
		end
		onClick()
	end)
	b.Parent = parent
	return b
end

function Kit.list(parent: Instance, horizontal: boolean?, padding: number?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Parent = parent
	return l
end

-- a bar: returns the background frame and a setter (0..1)
function Kit.bar(parent: Instance, color: Color3, props: { [string]: any }?): (Frame, (number) -> ())
	local bg = Kit.frame(parent, props)
	bg.BackgroundColor3 = Color3.fromRGB(20, 14, 28)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = bg
	local fill = Kit.frame(bg, { BackgroundColor3 = color, Size = UDim2.fromScale(0, 1) })
	local c2 = Instance.new("UICorner")
	c2.CornerRadius = UDim.new(0, 6)
	c2.Parent = fill
	return bg, function(v: number)
		fill.Size = UDim2.fromScale(math.clamp(v, 0, 1), 1)
	end
end

function Kit.padding(parent: Instance, px: number)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, px)
	pad.PaddingBottom = UDim.new(0, px)
	pad.PaddingLeft = UDim.new(0, px)
	pad.PaddingRight = UDim.new(0, px)
	pad.Parent = parent
	return pad
end

-- a vertical scrolling list that grows with its content
function Kit.scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local sf = Instance.new("ScrollingFrame")
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 8
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new()
	sf.Size = UDim2.fromScale(1, 1)
	for k, v in props or {} do
		(sf :: any)[k] = v
	end
	sf.Parent = parent
	return sf
end

-- a centred window with a title and a close button; returns the window and its body (scrolling list)
function Kit.window(parent: Instance, title: string, onClose: () -> ()): (Frame, ScrollingFrame)
	-- 780 x 520 where it fits, otherwise the screen minus a margin (phones)
	local w = Kit.panel(parent, {
		Size = UDim2.new(1, -24, 1, -90),
		Position = UDim2.new(0.5, 0, 0.5, -20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0.04,
	})
	local sc = Instance.new("UISizeConstraint")
	sc.MaxSize = Vector2.new(780, 520)
	sc.Parent = w
	local head = Kit.frame(w, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52) })
	Kit.label(head, title, {
		Font = Theme.title,
		TextSize = 28,
		TextColor3 = Theme.primary,
		Size = UDim2.new(1, -140, 1, 0),
		Position = UDim2.fromOffset(18, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	Kit.button(head, "✕", onClose, {
		Size = UDim2.fromOffset(48, 44),
		Position = UDim2.new(1, -56, 0, 4),
		BackgroundColor3 = Theme.panel2,
	})
	local body = Kit.scroll(w, { Size = UDim2.new(1, -24, 1, -64), Position = UDim2.fromOffset(12, 56) })
	return w, body
end

-- a row of cards in a grid (cell size in px)
function Kit.grid(parent: Instance, cellW: number, cellH: number, props: { [string]: any }?): Frame
	local f = Kit.frame(
		parent,
		{ BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }
	)
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(cellW, cellH)
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	return f
end

function Kit.clear(f: Instance)
	for _, c in f:GetChildren() do
		if
			not c:IsA("UIListLayout")
			and not c:IsA("UICorner")
			and not c:IsA("UIStroke")
			and not c:IsA("UIPadding")
			and not c:IsA("UIGridLayout")
		then
			c:Destroy()
		end
	end
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">LevelUp</string>
              <string name="Source"><![CDATA[-- Level-up cards (solo: modal over a dimmed screen, the world is paused; co-op: a non-modal tray at the bottom with
-- the auto-pick timer, docs/DESIGN.md §2.5), reroll / skip / banish, the chest result (solo modal, co-op side panel)
-- and the victory vote. Cards show the item's icon, name, "NEW!" or the level and what it does; keys 1-4, R, K, B on
-- PC, gamepad selection moves between the cards. Card size follows the screen width (phones included).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Weapons = require(Shared.Sim.Data.Weapons)
local Passives = require(Shared.Sim.Data.Passives)
local Stages = require(Shared.Sim.Data.Stages)
local Story = require(Shared.Sim.Data.Story)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Device = require(script.Parent.Parent.Device)

local LevelUp = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local dim: Frame = nil :: any
local tray: Frame? = nil
local chestPanel: Frame? = nil
local victoryPanel: Frame? = nil
local stage: any = nil -- the run's land (victory text: outro, ending after the last land)
local command: (any) -> () = function(_) end
local offer: any = nil
local banishMode = false
local deadline: number? = nil
local timeNow: () -> number = os.clock
local timerLabel: TextLabel? = nil
local voteLabel: TextLabel? = nil
local voteEnd: number? = nil

function LevelUp.init(cmd, clock)
	command = cmd
	timeNow = clock
	gui = Kit.screen("EN_Cards", 5)
	dim = Kit.frame(gui, {
		BackgroundColor3 = Color3.fromRGB(8, 4, 16),
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 1, 80),
		Position = UDim2.fromOffset(0, -40),
		Visible = false,
		ZIndex = 0,
	})
end

-- name, tag line, description of an option
local function describe(o): (string, string, string)
	if o.kind == "weapon" then
		local d = Weapons.byId[o.id]
		if o.isNew then
			return tr(d.name), tr("NEU!"), tr(d.desc)
		end
		local lv = d.levels[o.level - 1]
		return tr(d.name), tr("Stufe {0}", o.level), if lv then tr(lv.t) else ""
	elseif o.kind == "passive" then
		local d = Passives.byId[o.id]
		return tr(d.name), if o.isNew then tr("NEU!") else tr("Stufe {0}", o.level), tr(d.desc)
	elseif o.kind == "gold" then
		return tr("{0} Gold", o.amount), "", tr("Alles ist ausgebaut – nimm Gold mit.")
	end
	return tr("Heiltrank"), "", tr("Stellt {0} Leben wieder her.", o.amount)
end

local function maxLevel(o): number
	if o.kind == "weapon" then
		local d = Weapons.byId[o.id]
		return if d then #d.levels + 1 else 8
	elseif o.kind == "passive" then
		local d = Passives.byId[o.id]
		return if d then d.max else 5
	end
	return 1
end

local function updateDim()
	dim.Visible = (offer ~= nil and offer.solo) or (chestPanel ~= nil and chestPanel:GetAttribute("solo") == true)
end

function LevelUp.close()
	if tray then
		tray:Destroy()
		tray = nil
	end
	offer = nil
	banishMode = false
	deadline = nil
	timerLabel = nil
	updateDim()
end

function LevelUp.choose(i: number)
	if not offer or not offer.options[i] then
		return
	end
	if banishMode then
		command({ op = "banish", i = i })
		banishMode = false
	else
		command({ op = "pick", i = i })
	end
end

function LevelUp.action(name: string)
	if not offer then
		return
	end
	if name == "reroll" and offer.rerolls > 0 then
		command({ op = "reroll" })
	elseif name == "skip" and offer.skips > 0 then
		command({ op = "skip" })
	elseif name == "banish" and offer.banishes > 0 then
		banishMode = not banishMode
		LevelUp.show(offer, offer.solo)
	end
end

function LevelUp.isOpen(): boolean
	return offer ~= nil
end

local function card(parent: Instance, i: number, o, w: number, h: number, compact: boolean, keys: boolean): TextButton
	local name, tag, desc = describe(o)
	local isNew = o.isNew == true
	local b = Kit.button(parent, "", function()
		LevelUp.choose(i)
	end, {
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = if banishMode then Color3.fromRGB(90, 24, 40) else Theme.panel2,
		AutoButtonColor = true,
		LayoutOrder = i,
	})
	local s = Instance.new("UIStroke")
	s.Color = if banishMode then Theme.bad elseif isNew then Theme.gold else Theme.stroke
	s.Thickness = if isNew then 2.5 else 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = b
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 140, 170))
	g.Parent = b
	local icon = if compact then 40 else 60
	local kind = if o.kind == "weapon" or o.kind == "passive" then o.kind else o.kind
	Icons.tile(b, kind, o.id, icon, {
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
	}, o.level, maxLevel(o))
	local y = icon + 12
	Kit.label(b, name, {
		Font = Theme.title,
		TextSize = if compact then 16 else 20,
		Size = UDim2.new(1, -10, 0, if compact then 18 else 24),
		Position = UDim2.fromOffset(5, y),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	y += if compact then 18 else 24
	if tag ~= "" then
		Kit.label(b, tag, {
			Font = Theme.number,
			TextSize = if compact then 12 else 14,
			Size = UDim2.new(1, -10, 0, 16),
			Position = UDim2.fromOffset(5, y),
			TextColor3 = if isNew then Theme.gold else Theme.xp,
		})
		y += 16
	end
	Kit.label(b, desc, {
		TextSize = if compact then 12 else 14,
		Size = UDim2.new(1, -14, 1, -(y + 6)),
		Position = UDim2.fromOffset(7, y + 2),
		TextColor3 = Theme.dim,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	if keys then
		Kit.label(b, tostring(i), {
			Font = Theme.number,
			TextSize = 14,
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.fromOffset(6, 6),
			TextColor3 = Theme.dim,
		})
	end
	return b
end

function LevelUp.show(m, solo: boolean)
	LevelUp.close()
	offer = m
	offer.solo = solo
	deadline = m.deadline
	local n = #m.options
	local sz = Kit.uiSize(gui)
	local keys = not Device.touch()
	local compact = not solo
	-- card size: as large as fits the width
	local cw = math.floor(math.min(if compact then 190 else 240, (sz.X - 60 - (n - 1) * 10) / math.max(1, n)))
	local ch = if compact then 160 else 230
	local rowW = n * cw + (n - 1) * 10
	local hasActions = m.rerolls > 0 or m.skips > 0 or m.banishes > 0
	local f = Kit.panel(gui, {
		Size = UDim2.fromOffset(rowW + 24, ch + (if compact then 48 else 64) + (if hasActions then 52 else 0)),
		Position = if solo then UDim2.fromScale(0.5, 0.5) else UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = if solo then Vector2.new(0.5, 0.5) else Vector2.new(0.5, 1),
		BackgroundTransparency = if solo then 0.05 else 0.25,
	})
	tray = f
	Kit.padding(f, 10)
	Kit.list(f, false, 8)
	timerLabel = Kit.label(f, if banishMode then tr("Verbannen") .. "?" else tr("Neue Stufe!"), {
		Font = Theme.title,
		TextSize = if compact then 20 else 26,
		Size = UDim2.new(1, 0, 0, if compact then 24 else 30),
		LayoutOrder = 1,
		TextColor3 = if banishMode then Theme.bad else Theme.gold,
		TextStrokeTransparency = 0.5,
	})
	local row = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ch), LayoutOrder = 2 })
	Kit.list(row, true, 10)
	local cards = {}
	for i, o in m.options do
		table.insert(cards, card(row, i, o, cw, ch, compact, keys))
	end
	for i, c in cards do
		c.NextSelectionLeft = cards[i - 1] or cards[#cards]
		c.NextSelectionRight = cards[i + 1] or cards[1]
	end
	local brow = Kit.frame(f, {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 3,
		Visible = hasActions,
	})
	Kit.list(brow, true, 8)
	local function act(label: string, count: number, key: string, name: string)
		if count > 0 then
			Kit.button(brow, tr(label) .. " (" .. count .. ")" .. (if keys then " [" .. key .. "]" else ""), function()
				LevelUp.action(name)
			end, {
				Size = UDim2.fromOffset(if compact then 150 else 180, 40),
				TextSize = if compact then 14 else 16,
				BackgroundColor3 = if name == "banish" and banishMode then Theme.bad else Theme.panel,
			})
		end
	end
	act("Neu würfeln", m.rerolls, "R", "reroll")
	act("Überspringen", m.skips, "K", "skip")
	act("Verbannen", m.banishes, "B", "banish")
	if solo and cards[1] then
		GuiService.SelectedObject = cards[1]
	end
	updateDim()
end

-- chest result (solo: modal with Continue; co-op: side panel for 3.5 s)
function LevelUp.chest(res, solo: boolean)
	if chestPanel then
		chestPanel:Destroy()
	end
	local rows = #res.items + (if res.evolved then 1 else 0)
	local h = 120 + rows * 46 + (if solo then 54 else 0)
	local f = Kit.panel(gui, {
		Size = UDim2.fromOffset(360, h),
		Position = if solo then UDim2.fromScale(0.5, 0.5) else UDim2.new(1, -12, 0.5, 0),
		AnchorPoint = if solo then Vector2.new(0.5, 0.5) else Vector2.new(1, 0.5),
		BackgroundTransparency = if solo then 0.05 else 0.2,
	})
	f:SetAttribute("solo", solo)
	chestPanel = f
	Kit.padding(f, 10)
	Kit.list(f, false, 6)
	Kit.label(f, if res.evolved then tr("ENTWICKLUNG!") else tr("Truhe!"), {
		Font = Theme.title,
		TextSize = 30,
		TextColor3 = Theme.gold,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 1,
		TextStrokeTransparency = 0.4,
	})
	local function itemRow(order: number, kind: string, id: string, text: string, evo: boolean)
		local r = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = order })
		Icons.tile(r, kind, id, 40, nil, nil, nil, evo)
		Kit.label(r, text, {
			Size = UDim2.new(1, -52, 1, 0),
			Position = UDim2.fromOffset(50, 0),
			TextSize = if evo then 18 else 16,
			Font = if evo then Theme.title else Theme.body,
			TextColor3 = if evo then Theme.gold else Theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
	end
	if res.evolved then
		local w = Weapons.byId[res.evolved]
		itemRow(2, "weapon", res.evolved, tr(w.evo.name), true)
	end
	for i, o in res.items do
		local name = if o.kind == "weapon" then Weapons.byId[o.id].name else Passives.byId[o.id].name
		itemRow(2 + i, o.kind, o.id, tr(name) .. " – " .. tr("Stufe {0}", o.level), false)
	end
	Kit.label(f, tr("+{0} Gold", res.gold), {
		Font = Theme.title,
		TextSize = 20,
		TextColor3 = Theme.gold,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 50,
	})
	if solo then
		local b = Kit.button(f, tr("Weiter"), function()
			f:Destroy()
			chestPanel = nil
			updateDim()
			command({ op = "chestClose" })
		end, { LayoutOrder = 60 })
		GuiService.SelectedObject = b
	else
		task.delay(3.5, function()
			if chestPanel == f then
				f:Destroy()
				chestPanel = nil
			end
		end)
	end
	updateDim()
end

function LevelUp.closeChest()
	if chestPanel then
		chestPanel:Destroy()
		chestPanel = nil
	end
	updateDim()
end

function LevelUp.setStage(st)
	stage = st
end

-- victory: continue endless or finish (co-op: a vote with its timer); like the web game it tells the land's outro,
-- and after the last land the ending of the story
function LevelUp.victory(on: boolean, voteSeconds: number?)
	if not on then
		if victoryPanel then
			victoryPanel:Destroy()
			victoryPanel = nil
		end
		voteLabel = nil
		voteEnd = nil
		return
	end
	if voteSeconds then
		voteEnd = os.clock() + voteSeconds
	end
	if victoryPanel then
		return
	end
	local last = stage ~= nil and stage == Stages.list[#Stages.list]
	local story = ""
	if stage and stage.outro then
		story = tr(stage.outro)
	end
	if last then
		story ..= "\n" .. tr(Story.ending)
	end
	local storyH = if story == "" then 0 elseif last then 92 else 40
	local f = Kit.panel(gui, {
		Size = UDim2.fromOffset(460, 196 + storyH),
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	victoryPanel = f
	Kit.padding(f, 10)
	Kit.list(f, false, 8)
	Kit.label(
		f,
		"★ " .. tr(if last then "Die Nacht ist besiegt!" elseif stage then "Land befreit!" else "Sieg!") .. " ★",
		{
			Font = Theme.title,
			TextSize = 34,
			TextColor3 = Theme.gold,
			Size = UDim2.new(1, 0, 0, 46),
			LayoutOrder = 1,
			TextStrokeTransparency = 0.4,
			TextScaled = true,
		}
	)
	if story ~= "" then
		Kit.label(f, story, {
			TextSize = 14,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, storyH - 8),
			LayoutOrder = 2,
		})
	end
	voteLabel = Kit.label(f, tr("Weiter im Endlosmodus oder beenden?"), {
		TextSize = 15,
		TextColor3 = Theme.dim,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 3,
	})
	local row = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 4 })
	Kit.list(row, true, 12)
	local b = Kit.button(row, tr("Endlos weiter"), function()
		command({ op = "vote", endless = true })
	end, { Size = UDim2.fromOffset(200, 46) })
	Kit.button(row, tr("Beenden"), function()
		command({ op = "vote", endless = false })
	end, { Size = UDim2.fromOffset(160, 46), BackgroundColor3 = Theme.panel2 })
	GuiService.SelectedObject = b
end

function LevelUp.update()
	if deadline and timerLabel then
		local left = math.max(0, deadline - timeNow())
		timerLabel.Text = tr("Neue Stufe!") .. "  ⏱ " .. math.ceil(left) .. " s"
	end
	if voteEnd and voteLabel then
		voteLabel.Text = tr("Abstimmung: noch {0} s", math.ceil(math.max(0, voteEnd - os.clock())))
	end
end

return LevelUp
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Lobby</string>
              <string name="Source"><![CDATA[-- Party panel in the hub (docs/DESIGN.md §2.2, §2.3): gold and stars, the party with leader crown and ready state,
-- the own hero and the chosen land (buttons open the Heroes / World map screens), Ready / Start, start countdown.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Heroes = require(Shared.Sim.Data.Heroes)
local Stages = require(Shared.Sim.Data.Stages)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Lobby = {}
local tr = Lang.tr

local gui: ScreenGui? = nil
local root: Frame? = nil
local command: (any) -> () = function(_) end
local open: (string) -> () = function(_) end
local last: any = nil

function Lobby.init(cmd: (any) -> (), openScreen: (string) -> ())
	command = cmd
	open = openScreen
	gui = Kit.screen("EN_Lobby", 1)
end

function Lobby.setVisible(on: boolean)
	if gui then
		gui.Enabled = on
	end
end

local function stageName(id: string): string
	for _, s in Stages.list do
		if s.id == id then
			return tr(s.name)
		end
	end
	return id
end

function Lobby.render(msg)
	last = msg
	if not gui then
		return
	end
	if root then
		root:Destroy()
	end
	local me = nil
	for _, m in msg.members do
		if m.userId == msg.you then
			me = m
		end
	end
	local r = Kit.panel(gui, {
		Size = UDim2.fromOffset(330, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(16, 16),
	})
	root = r
	Kit.padding(r, 10)
	Kit.list(r, false, 6)
	Kit.label(r, "Ember Night", {
		Font = Theme.title,
		TextSize = 30,
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = Theme.primary,
		LayoutOrder = 1,
	})
	local view = msg.profile or {}
	Kit.label(r, "● " .. Lang.fmtNum(view.gold or 0) .. "   ★ " .. tostring(view.stars or 0), {
		TextColor3 = Theme.gold,
		Font = Theme.number,
		LayoutOrder = 2,
	})
	-- party
	local party = {}
	for _, m in msg.members do
		local h = Heroes.byId[m.hero]
		table.insert(
			party,
			(if m.leader then "♛ " else "• ")
				.. m.name
				.. " – "
				.. (if h then tr(h.name) else m.hero)
				.. (if m.ready then "  ✔" else "")
		)
	end
	Kit.label(r, tr("Gruppe") .. " (" .. #msg.members .. "/4)\n" .. table.concat(party, "\n"), {
		Size = UDim2.new(1, 0, 0, 24 + 20 * #party),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 3,
	})
	local h = me and Heroes.byId[me.hero]
	local hrow = Kit.frame(r, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 4 })
	Kit.label(hrow, tr("Held") .. ": " .. (if h then tr(h.name) else "?"), {
		Size = UDim2.new(1, -120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.title,
	})
	Kit.button(hrow, tr("Ändern"), function()
		open("heroes")
	end, {
		Size = UDim2.fromOffset(110, 40),
		Position = UDim2.new(1, -110, 0, 2),
		BackgroundColor3 = Theme.panel2,
		TextSize = 16,
	})
	local srow = Kit.frame(r, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 5 })
	Kit.label(
		srow,
		stageName(msg.stage) .. " · " .. (if msg.heat > 0 then tr("Nachtstufe {0}", msg.heat) else tr("Normal")),
		{
			Size = UDim2.new(1, -120, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
		}
	)
	Kit.button(srow, if msg.isLeader then tr("Wählen") else tr("Ansehen"), function()
		open("map")
	end, {
		Size = UDim2.fromOffset(110, 40),
		Position = UDim2.new(1, -110, 0, 2),
		BackgroundColor3 = Theme.panel2,
		TextSize = 16,
	})
	local brow = Kit.frame(r, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 6 })
	Kit.list(brow, true, 10)
	if msg.running then
		Kit.label(brow, tr("Ein Lauf ist im Gang – du spielst den nächsten mit."), { Size = UDim2.new(1, 0, 0, 44) })
	else
		if #msg.members > 1 then
			Kit.button(brow, if me and me.ready then tr("Nicht bereit") else tr("Bereit"), function()
				command({ op = "ready", on = not (me and me.ready) })
			end, { BackgroundColor3 = Theme.panel2, Size = UDim2.fromOffset(150, 44) })
		end
		if msg.isLeader then
			Kit.button(brow, tr("Starten"), function()
				command({ op = "start" })
			end, { Size = UDim2.fromOffset(150, 44) })
		else
			Kit.label(brow, tr("Der Anführer startet."), { TextColor3 = Theme.dim, Size = UDim2.fromOffset(150, 44) })
		end
	end
	if msg.countdown then
		Kit.label(
			r,
			tr("Lauf beginnt in {0} …", math.ceil(msg.countdown)),
			{ TextColor3 = Theme.primary, LayoutOrder = 7 }
		)
	end
end

function Lobby.rerender()
	if last then
		Lobby.render(last)
	end
end

return Lobby
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Names</string>
              <string name="Source"><![CDATA[-- Display helpers shared by the hub screens: product and cosmetic names, price buttons, unlock conditions.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Products = require(Shared.Config.Products)
local Cosmetics = require(Shared.Config.Cosmetics)
local Heroes = require(Shared.Sim.Data.Heroes)
local Achievements = require(Shared.Sim.Data.Achievements)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Names = {}
local tr = Lang.tr

local achById = {}
for _, a in Achievements.list do
	achById[a.id] = a
end
Names.achById = achById

-- "Held freischalten: Kael", "Goldbeutel", ...
function Names.product(key: string): string
	local it = Products.byKey[key]
	if not it then
		return key
	end
	if it.heroes and #it.heroes == 1 then
		local h = Heroes.byId[it.heroes[1]]
		return tr("Held freischalten: {0}", if h then tr(h.name) else it.heroes[1])
	end
	return tr(it.name)
end

function Names.productDesc(key: string): string
	local it = Products.byKey[key]
	if not it then
		return ""
	end
	if it.grant and it.grant.gold then
		return tr(it.desc, Lang.fmtNum(it.grant.gold))
	end
	return tr(it.desc)
end

function Names.cosmetic(id: string): string
	local c = Cosmetics.byId[id]
	return if c then tr(c.name) else id
end

-- how a free cosmetic or a hero is earned
function Names.achievementHint(achId: string): string
	local a = achById[achId]
	if not a then
		return ""
	end
	return tr("Erfolg: {0}", tr(a.name)) .. " – " .. tr(a.text)
end

-- the shop entry of a configured item (from the profile view), or nil
function Names.shopItem(view, key: string)
	for _, it in view.shop.items do
		if it.key == key then
			return it
		end
	end
	return nil
end

-- a Robux price button (nothing when the item is not for sale or already owned)
function Names.buyButton(
	parent: Instance,
	view,
	key: string,
	command: (any) -> (),
	props: { [string]: any }?
): TextButton?
	local it = Names.shopItem(view, key)
	if not it or it.owned then
		return nil
	end
	local b = Kit.button(parent, "R$ " .. tostring(it.price), function()
		command({ op = "buy", key = key })
	end, props)
	b.BackgroundColor3 = Color3.fromRGB(0, 162, 90)
	return b
end

function Names.heroColor(id: string): Color3
	local h = Heroes.byId[id]
	return if h then Color3.fromHex(h.color) else Theme.text
end

return Names
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">Pause</string>
              <string name="Source"><![CDATA[-- Pause screen (docs/DESIGN.md §5.2, web tpl_pause): weapons with level and evolution hint, passives, the stats grid,
-- quick settings (sound, music, damage numbers, shake), give up with confirmation and continue. Solo: the world is
-- paused by the server; co-op: the menu button opens it without pausing anyone and "give up" leaves the run (the
-- hero falls and the player spectates).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Weapons = require(Shared.Sim.Data.Weapons)
local Passives = require(Shared.Sim.Data.Passives)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Pause = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local panel: Frame? = nil
local command: (any) -> () = function(_) end
local hero: any = nil
local settings: { [string]: any } = {}
local confirm = false
local solo = true
local open = false

local TOGGLES = {
	{ "sfx", Lang.key("Soundeffekte") },
	{ "music", Lang.key("Musik") },
	{ "dmgNums", Lang.key("Schadenszahlen") },
	{ "shake", Lang.key("Wackeln") },
}

function Pause.init(cmd)
	command = cmd
	gui = Kit.screen("EN_Pause", 8)
	gui.Enabled = false
end

function Pause.setHero(m)
	hero = m
	if open then
		Pause.render()
	end
end

function Pause.setSettings(s: { [string]: any }?)
	settings = s or {}
	if open then
		Pause.render()
	end
end

function Pause.isOpen(): boolean
	return open
end

local function pct(v: number): string
	local ps = if Lang.get() == "de" then " %" else "%"
	return (if v >= 0 then "+" else "") .. math.floor(v * 100 + 0.5) .. ps
end

function Pause.render()
	if panel then
		panel:Destroy()
		panel = nil
	end
	if not open then
		gui.Enabled = false
		return
	end
	gui.Enabled = true
	Kit.frame(gui, {
		BackgroundColor3 = Color3.fromRGB(8, 4, 16),
		BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 1, 80),
		Position = UDim2.fromOffset(0, -40),
		Name = "Dim",
	})
	local w, body = Kit.window(gui, tr("Pause"), function()
		Pause.close(true)
	end)
	panel = w
	Kit.list(body, false, 8)
	local h = hero or { weapons = {}, passives = {}, stats = {}, hp = 0 }
	local owned = {}
	for _, p in h.passives or {} do
		owned[p.id] = true
	end
	-- build: two columns
	local cols = Kit.frame(body, {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
	})
	local function column(title: string, x: number): Frame
		local c = Kit.frame(cols, {
			BackgroundTransparency = 1,
			Size = UDim2.new(0.5, -6, 0, 0),
			Position = UDim2.new(x, if x > 0 then 6 else 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		})
		local l = Kit.list(c, false, 4)
		l.HorizontalAlignment = Enum.HorizontalAlignment.Left
		Kit.label(c, tr(title), {
			Font = Theme.title,
			TextSize = 20,
			TextColor3 = Theme.primary,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0,
		})
		return c
	end
	local wc = column("Waffen", 0)
	local pc = column("Passive", 0.5)
	local function row(
		parent: Frame,
		order: number,
		kind: string,
		id: string,
		name: string,
		lv: string,
		small: string,
		evo: boolean
	)
		local r = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = order })
		Icons.tile(r, kind, id, 40, { Position = UDim2.fromOffset(0, 3) }, nil, nil, evo)
		Kit.label(r, name .. "  " .. lv, {
			Size = UDim2.new(1, -50, 0, 20),
			Position = UDim2.fromOffset(48, 2),
			TextSize = 15,
			Font = Theme.number,
			TextColor3 = if evo then Theme.gold else Theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		Kit.label(r, small, {
			Size = UDim2.new(1, -50, 0, 22),
			Position = UDim2.fromOffset(48, 22),
			TextSize = 12,
			TextColor3 = Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
	for i, wp in h.weapons or {} do
		local d = Weapons.byId[wp.id]
		if d then
			local max = #d.levels + 1
			local hint = if wp.evo
				then ""
				else tr(
					"Entwicklung: Stufe 8 + {0}{1}, dann Truhe",
					tr(Passives.byId[d.evo.with].name),
					if owned[d.evo.with] then " ✓" else ""
				)
			row(
				wc,
				i,
				"weapon",
				wp.id,
				tr(if wp.evo then d.evo.name else d.name),
				if wp.evo then tr("ENTWICKELT") else tr("Stufe {0}/{1}", wp.level, max),
				hint,
				wp.evo == true
			)
		end
	end
	for i, p in h.passives or {} do
		local d = Passives.byId[p.id]
		if d then
			row(pc, i, "passive", p.id, tr(d.name), tr("Stufe {0}/{1}", p.level, d.max), tr(d.desc), false)
		end
	end
	if #(h.passives or {}) == 0 then
		Kit.label(
			pc,
			tr("Noch keine"),
			{ TextColor3 = Theme.dim, LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Left }
		)
	end
	-- stats grid
	local s = h.stats or {}
	local grid = Kit.grid(body, 168, 28, { LayoutOrder = 2 })
	local function stat(i: number, label: string, value: string)
		local c = Kit.frame(grid, { BackgroundColor3 = Theme.panel2, BackgroundTransparency = 0.3, LayoutOrder = i })
		Kit.label(c, tr(label), {
			Size = UDim2.new(0.6, -6, 1, 0),
			Position = UDim2.fromOffset(6, 0),
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.dim,
		})
		Kit.label(c, value, {
			Size = UDim2.new(0.4, -6, 1, 0),
			Position = UDim2.fromScale(0.6, 0),
			TextSize = 13,
			Font = Theme.number,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end
	if s.maxHp then
		stat(1, "Leben", math.ceil(h.hp or 0) .. "/" .. s.maxHp)
		stat(2, "Rüstung", tostring(s.armor))
		stat(3, "Erholung", Lang.fmtDec(math.floor((s.regen or 0) * 10 + 0.5) / 10) .. "/s")
		stat(4, "Schaden", pct((s.might or 1) - 1))
		stat(5, "Fläche", pct((s.area or 1) - 1))
		stat(6, "Abklingzeit", pct((s.cooldown or 1) - 1))
		stat(7, "Geschosse", "+" .. tostring(s.amount or 0))
		stat(8, "Lauftempo", pct((s.speed or 150) / 150 - 1))
		stat(9, "Glück", pct((s.luck or 1) - 1))
		stat(10, "Krit", math.floor((s.crit or 0) * 100 + 0.5) .. (if Lang.get() == "de" then " %" else "%"))
		stat(11, "Wachstum", pct((s.growth or 1) - 1))
		stat(12, "Gier", pct((s.greed or 1) - 1))
	end
	-- quick settings
	local srow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3 })
	Kit.list(srow, true, 6)
	for _, t in TOGGLES do
		local key = t[1]
		local on = settings[key] ~= false
		local b = Kit.button(srow, tr(t[2]) .. ": " .. (if on then tr("An") else tr("Aus")), function()
			settings[key] = not on
			command({ op = "setting", key = key, value = not on })
			Pause.render()
		end, { Size = UDim2.fromOffset(176, 40), TextSize = 14 })
		b.BackgroundColor3 = if on then Theme.primary else Theme.panel2
	end
	-- actions
	local arow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 4 })
	Kit.list(arow, true, 12)
	Kit.button(arow, if confirm then tr("Wirklich aufgeben?") else tr("Aufgeben"), function()
		if confirm then
			confirm = false
			Pause.close(false)
			command({ op = "giveup" })
		else
			confirm = true
			Pause.render()
		end
	end, { Size = UDim2.fromOffset(220, 46), BackgroundColor3 = Theme.bad })
	local cont = Kit.button(arow, tr("Weiter"), function()
		Pause.close(true)
	end, { Size = UDim2.fromOffset(200, 46) })
	GuiService.SelectedObject = cont
end

-- solo: the server paused; co-op: opened from the menu button
function Pause.open(isSolo: boolean)
	solo = isSolo
	if open then
		return
	end
	open = true
	confirm = false
	Pause.render()
end

-- resume = ask the server to continue (solo)
function Pause.close(resume: boolean)
	if not open then
		return
	end
	open = false
	confirm = false
	Pause.render()
	for _, c in gui:GetChildren() do
		if c.Name == "Dim" then
			c:Destroy()
		end
	end
	if resume and solo then
		command({ op = "resume" })
	end
end

return Pause
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">Preview</string>
              <string name="Source"><![CDATA[-- 3D previews in the hub (docs/DESIGN.md §5.1): a ViewportFrame with a WorldModel holding a standalone copy of the
-- hero model (ModelKit.heroPreview) and its own camera; used by the hero cards and the cosmetics screen.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Config.Cosmetics)
local ModelKit = require(script.Parent.Parent.World.ModelKit)

local Preview = {}

local function color(hex: string?): Color3?
	local r, g, b = Cosmetics.parseHex(hex)
	return if r then Color3.new(r, g :: number, b :: number) else nil
end

-- a hero preview; skinId = an equipped/previewed skin cosmetic (nil = hero colours)
function Preview.hero(parent: Instance, heroId: string, skinId: string?, props: { [string]: any }?): ViewportFrame
	local vf = Instance.new("ViewportFrame")
	vf.BackgroundTransparency = 1
	vf.Size = UDim2.fromOffset(80, 80)
	vf.Ambient = Color3.fromRGB(170, 160, 190)
	vf.LightColor = Color3.fromRGB(255, 236, 214)
	vf.LightDirection = Vector3.new(-1, -1.4, -0.6)
	local skin = skinId and Cosmetics.byId[skinId]
	local pal: ModelKit.Palette = {
		body = (skin and color(skin.body)) or ModelKit.heroColor(heroId),
		accent = skin and color(skin.accent) or nil,
	}
	local wm = Instance.new("WorldModel")
	ModelKit.heroPreview(heroId, 1, pal, wm)
	wm.Parent = vf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.CFrame = CFrame.lookAt(Vector3.new(5.2, 3.4, 4.2), Vector3.new(0, 1.65, 0))
	cam.Parent = vf
	vf.CurrentCamera = cam
	for k, v in props or {} do
		(vf :: any)[k] = v
	end
	vf.Parent = parent
	return vf
end

return Preview
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- Results after a run (docs/DESIGN.md §5.2, web tpl_over): victory or fall, time / level / kills tiles, the gold
-- breakdown (collected, time bonus, boss bonus, double-gold pass, starter gift) with the total, new achievements and
-- the damage dealt per weapon. Fits phones (the window shrinks with the screen and scrolls).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Achievements = require(Shared.Sim.Data.Achievements)
local Weapons = require(Shared.Sim.Data.Weapons)
local Heroes = require(Shared.Sim.Data.Heroes)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Results = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local panel: Frame? = nil
local onClose: () -> () = function() end

function Results.init(close: () -> ())
	onClose = close
	gui = Kit.screen("EN_Results", 6)
end

function Results.hide()
	if panel then
		panel:Destroy()
		panel = nil
	end
end

local function tile(parent: Instance, order: number, label: string, value: string)
	local f = Kit.panel(parent, { BackgroundColor3 = Theme.panel2, BackgroundTransparency = 0.2, LayoutOrder = order })
	Kit.label(
		f,
		value,
		{ Font = Theme.title, TextSize = 24, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 6) }
	)
	Kit.label(
		f,
		tr(label),
		{ TextSize = 13, TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 38) }
	)
end

function Results.show(s)
	Results.hide()
	local w, body = Kit.window(gui, if s.won then "★ " .. tr("Sieg!") .. " ★" else tr("Gefallen"), function()
		Results.hide()
		onClose()
	end)
	panel = w
	Kit.list(body, false, 8)
	-- hero and headline tiles
	local top = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 64), LayoutOrder = 1 })
	Kit.list(top, true, 8)
	if s.heroId and Heroes.byId[s.heroId] then
		Icons.tile(top, "hero", s.heroId, 60, { LayoutOrder = 0 })
	end
	local tiles = Kit.frame(top, { BackgroundTransparency = 1, Size = UDim2.new(1, -70, 1, 0), LayoutOrder = 1 })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(1 / 3, -6, 1, 0)
	g.CellPadding = UDim2.fromOffset(6, 0)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = tiles
	tile(tiles, 1, "Zeit", Lang.fmtTime(s.t))
	tile(tiles, 2, "Stufe", tostring(s.level))
	tile(tiles, 3, "Besiegt", Lang.fmtNum(s.ownKills or s.kills))
	-- gold breakdown
	local function row(order: number, label: string, value: string, color: Color3?)
		local r = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 24), LayoutOrder = order })
		Kit.label(r, label, {
			Size = UDim2.fromScale(0.65, 1),
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color or Theme.text,
		})
		Kit.label(r, value, {
			Size = UDim2.fromScale(0.35, 1),
			Position = UDim2.fromScale(0.65, 0),
			TextSize = 16,
			Font = Theme.number,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = color or Theme.text,
		})
	end
	row(10, tr("Gesammelt"), "+" .. Lang.fmtNum(s.collected))
	row(11, tr("Zeitbonus"), "+" .. Lang.fmtNum(s.timeBonus))
	row(12, tr("Bossbonus"), "+" .. Lang.fmtNum(s.bossBonus))
	if s.pass2x and s.pass2x > 0 then
		row(13, tr("Doppeltes Gold"), "+" .. Lang.fmtNum(s.pass2x), Theme.gold)
	end
	if s.gift and s.gift > 0 then
		row(14, tr("Startgeschenk"), "+" .. Lang.fmtNum(s.gift), Theme.good)
	end
	Kit.label(body, "● " .. tr("+{0} Gold", Lang.fmtNum(s.total)), {
		Font = Theme.title,
		TextSize = 30,
		TextColor3 = Theme.gold,
		Size = UDim2.new(1, -10, 0, 38),
		LayoutOrder = 20,
		TextStrokeTransparency = 0.5,
	})
	-- new achievements
	if s.achievements and #s.achievements > 0 then
		Kit.label(
			body,
			tr("Neue Erfolge"),
			{ Font = Theme.title, TextSize = 18, TextColor3 = Theme.primary, LayoutOrder = 30 }
		)
		for i, id in s.achievements do
			for _, a in Achievements.list do
				if a.id == id then
					row(
						30 + i,
						"🏆 " .. tr(a.name),
						if a.gold and a.gold > 0 then "+" .. a.gold .. " ●" else "",
						Theme.gold
					)
				end
			end
		end
	end
	-- damage per weapon (top 5)
	local dmg = {}
	local maxD = 0
	for wid, v in s.dmgBy or {} do
		if Weapons.byId[wid] then
			table.insert(dmg, { id = wid, v = v })
			maxD = math.max(maxD, v)
		end
	end
	table.sort(dmg, function(a, b)
		return a.v > b.v
	end)
	if #dmg > 0 then
		Kit.label(
			body,
			tr("Schaden"),
			{ Font = Theme.title, TextSize = 18, TextColor3 = Theme.primary, LayoutOrder = 60 }
		)
		for i = 1, math.min(5, #dmg) do
			local d = dmg[i]
			local r =
				Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 30), LayoutOrder = 60 + i })
			Icons.tile(r, "weapon", d.id, 28)
			local bg, set =
				Kit.bar(r, Theme.primary, { Size = UDim2.new(1, -150, 0, 12), Position = UDim2.fromOffset(36, 9) })
			set(d.v / math.max(1, maxD))
			Kit.label(bg.Parent :: Instance, Lang.fmtNum(math.floor(d.v)), {
				Size = UDim2.fromOffset(100, 30),
				Position = UDim2.new(1, -100, 0, 0),
				TextSize = 14,
				Font = Theme.number,
				TextXAlignment = Enum.TextXAlignment.Right,
			})
		end
	end
	local b = Kit.button(body, tr("Zurück"), function()
		Results.hide()
		onClose()
	end, { LayoutOrder = 100, Size = UDim2.fromOffset(200, 46) })
	GuiService.SelectedObject = b
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">ReviveOffer</string>
              <string name="Source"><![CDATA[-- "Second Ember" while downed, fallen or in the last chance (docs/DESIGN.md §2.8, §7.3): a button that uses a stored
-- revive token, or (product configured, no token) one that asks the server to open the purchase prompt. The server
-- decides what is offered; the player must press the button himself (no automatic prompts, §7.4).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Kit = require(script.Parent.Kit)

local ReviveOffer = {}
local tr = Lang.tr

local gui: ScreenGui = nil :: any
local holder: Frame = nil :: any
local command: (any) -> () = function(_) end

function ReviveOffer.init(cmd: (any) -> ())
	command = cmd
	gui = Kit.screen("EN_Revive", 7)
	holder = Kit.frame(gui, {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 60),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	Kit.list(holder, true, 8)
end

function ReviveOffer.show(m)
	Kit.clear(holder)
	if m.use then
		Kit.button(holder, tr("Zweite Glut einsetzen ({0})", m.tokens), function()
			command({ op = "useRevive" })
		end, { Size = UDim2.fromOffset(320, 52), TextSize = 20 })
	elseif m.buy and m.price then
		local b = Kit.button(holder, tr("Zweite Glut") .. " – R$ " .. tostring(m.price), function()
			command({ op = "buy", key = "revive" })
		end, { Size = UDim2.fromOffset(320, 52), TextSize = 20 })
		b.BackgroundColor3 = Color3.fromRGB(0, 162, 90)
	end
end

function ReviveOffer.hide()
	if holder then
		Kit.clear(holder)
	end
end

return ReviveOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Router</string>
              <string name="Source"><![CDATA[-- Hub screens (docs/DESIGN.md §5.1, §5.2): one window at a time (heroes, world map, forge, achievements, stats,
-- shop, wardrobe, settings), the hub button bar, toasts and the "not saved" label. Every screen renders from the
-- last lobby message (party, lands, and the profile view built by Server/Services/Meta.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local GuiService = game:GetService("GuiService")
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Device = require(script.Parent.Parent.Device)

local Router = {}
local tr = Lang.tr

local SCREENS = {
	heroes = require(script.Parent.Heroes),
	map = require(script.Parent.WorldMap),
	forge = require(script.Parent.Forge),
	achievements = require(script.Parent.Achievements),
	stats = require(script.Parent.Stats),
	shop = require(script.Parent.Shop),
	wardrobe = require(script.Parent.Wardrobe),
	settings = require(script.Parent.Settings),
}
local BAR = {
	{ "heroes", Lang.key("Helden") },
	{ "map", Lang.key("Weltkarte") },
	{ "forge", Lang.key("Schmiede") },
	{ "wardrobe", Lang.key("Aussehen") },
	{ "achievements", Lang.key("Erfolge") },
	{ "stats", Lang.key("Statistik") },
	{ "shop", Lang.key("Shop") },
	{ "settings", Lang.key("Einstellungen") },
}

local gui: ScreenGui = nil :: any
local barGui: ScreenGui = nil :: any
local barRoot: Frame = nil :: any
local current: string? = nil
local window: Frame? = nil
local scrollPos = Vector2.zero
local last: any = nil
local command: (any) -> () = function(_) end
local enabled = true
local toastFrame: Frame = nil :: any

local function renderBar()
	Kit.clear(barRoot)
	local row = Kit.frame(barRoot, {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
	})
	Kit.list(row, true, 6)
	for i, b in BAR do
		local name, label = b[1], b[2]
		local btn = Kit.button(row, tr(label), function()
			if current == name then
				Router.close()
			else
				Router.open(name)
			end
		end, { Size = UDim2.fromOffset(108, 44), TextScaled = true, LayoutOrder = i })
		btn.BackgroundColor3 = if current == name then Theme.primary else Theme.panel2
		-- long labels ("Achievements", "Erfolge") shrink instead of overflowing
		local tc = Instance.new("UITextSizeConstraint")
		tc.MaxTextSize = 16
		tc.MinTextSize = 10
		tc.Parent = btn
		Kit.padding(btn, 4)
	end
	Kit.label(barRoot, tr("Nicht gespeichert (Studio ohne API-Zugriff)"), {
		TextColor3 = Color3.fromRGB(255, 225, 90),
		TextSize = 14,
		Size = UDim2.fromOffset(420, 20),
		Position = UDim2.new(1, -430, 0, 6),
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = last ~= nil and last.profile ~= nil and last.profile.memoryOnly == true,
	})
end

local function render()
	if window then
		local body = window:FindFirstChildWhichIsA("ScrollingFrame")
		if body then
			scrollPos = body.CanvasPosition
		end
		window:Destroy()
		window = nil
	end
	renderBar()
	if not current or not last or not last.profile then
		return
	end
	local screen = SCREENS[current]
	local w, body = Kit.window(gui, tr(screen.TITLE), Router.close)
	window = w
	Kit.list(body, false, 8)
	Kit.padding(body, 4)
	screen.render(body, last, command, Router.open)
	-- gamepad: keep the selection inside the window (first button of the screen)
	if Device.gamepad() then
		local sel = GuiService.SelectedObject
		if not sel or not sel:IsDescendantOf(w) then
			for _, d in body:GetDescendants() do
				if d:IsA("GuiButton") then
					GuiService.SelectedObject = d
					break
				end
			end
		end
	end
	task.defer(function()
		if body.Parent then
			body.CanvasPosition = scrollPos
		end
	end)
end

function Router.init(cmd: (any) -> ())
	command = cmd
	gui = Kit.screen("EN_Hub", 3)
	barGui = Kit.screen("EN_HubBar", 2)
	barRoot = Kit.frame(barGui, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	toastFrame = Kit.frame(Kit.screen("EN_Toasts", 9), {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 300),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	Kit.list(toastFrame, false, 6)
	renderBar()
end

-- called with true/false when a window opens or closes (the client hides the party panel meanwhile)
Router.onChange = nil :: ((boolean) -> ())?

function Router.open(name: string)
	if SCREENS[name] then
		if current ~= name then
			scrollPos = Vector2.zero
		end
		current = name
		render()
		if Router.onChange then
			Router.onChange(true)
		end
	end
end

function Router.close()
	current = nil
	render()
	if Router.onChange then
		Router.onChange(false)
	end
end

function Router.isOpen(): boolean
	return current ~= nil
end

-- new lobby message: re-render the open screen with the new data
function Router.update(msg)
	last = msg
	if enabled then
		render()
	end
end

-- hub visible (outside runs) or hidden
function Router.setEnabled(on: boolean)
	enabled = on
	gui.Enabled = on
	barGui.Enabled = on
	if not on then
		current = nil
	end
	render()
end

function Router.rerender()
	render()
end

-- a short message at the top of the screen (purchases, unlocks)
function Router.toast(text: string)
	local l = Kit.label(toastFrame, text, {
		Font = Theme.title,
		TextSize = 20,
		TextColor3 = Theme.gold,
		BackgroundTransparency = 0.15,
		BackgroundColor3 = Theme.panel,
		Size = UDim2.fromOffset(420, 36),
	})
	task.delay(3.5, function()
		l:Destroy()
	end)
end

return Router
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Settings (docs/DESIGN.md §5.2, web tpl_opts): language, sound, music, damage numbers, screen shake, camera
-- distance, reduced effects. Stored in the profile by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screen = { TITLE = Lang.key("Einstellungen") }
local tr = Lang.tr

local TOGGLES = {
	{ "sfx", Lang.key("Soundeffekte") },
	{ "music", Lang.key("Musik") },
	{ "dmgNums", Lang.key("Schadenszahlen") },
	{ "shake", Lang.key("Wackeln") },
	{ "lowFx", Lang.key("Weniger Effekte") },
}

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), open: (string) -> ())
	local s = msg.profile.settings or {}
	local lrow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 1 })
	Kit.list(lrow, true, 8)
	Kit.label(lrow, tr("Sprache"), { Size = UDim2.fromOffset(220, 44), TextXAlignment = Enum.TextXAlignment.Left })
	for _, l in { "de", "en" } do
		local b = Kit.button(lrow, if l == "de" then "Deutsch" else "English", function()
			Lang.setLang(l)
			command({ op = "lang", lang = l })
			open("settings")
		end, { Size = UDim2.fromOffset(130, 44) })
		b.BackgroundColor3 = if Lang.get() == l then Theme.primary else Theme.panel2
	end
	for i, t in TOGGLES do
		local key = t[1]
		local on = s[key] == true
		local row = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 1 + i })
		Kit.list(row, true, 8)
		Kit.label(row, tr(t[2]), { Size = UDim2.fromOffset(220, 44), TextXAlignment = Enum.TextXAlignment.Left })
		local b = Kit.button(row, if on then tr("An") else tr("Aus"), function()
			command({ op = "setting", key = key, value = not on })
		end, { Size = UDim2.fromOffset(130, 44) })
		b.BackgroundColor3 = if on then Theme.primary else Theme.panel2
	end
	local zrow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 20 })
	Kit.list(zrow, true, 8)
	local z = s.camZoom or 1
	Kit.label(
		zrow,
		tr("Kameraabstand"),
		{ Size = UDim2.fromOffset(220, 44), TextXAlignment = Enum.TextXAlignment.Left }
	)
	Kit.button(zrow, "−", function()
		command({ op = "setting", key = "camZoom", value = z - 0.15 })
	end, { Size = UDim2.fromOffset(60, 44) })
	Kit.label(zrow, math.floor(z * 100 + 0.5) .. " %", { Size = UDim2.fromOffset(80, 44) })
	Kit.button(zrow, "+", function()
		command({ op = "setting", key = "camZoom", value = z + 0.15 })
	end, { Size = UDim2.fromOffset(60, 44) })
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Robux shop (docs/DESIGN.md §7.1): tabs Gold, Heroes, Cosmetics, Passes. Only configured items with a live price
-- (from the server) are listed; owned passes and cosmetics show "owned". Prompts are opened by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Names = require(script.Parent.Names)

local Screen = { TITLE = Lang.key("Shop") }
local tr = Lang.tr

local TABS = {
	{ "gold", Lang.key("Gold") },
	{ "heroes", Lang.key("Helden") },
	{ "cosmetics", Lang.key("Aussehen") },
	{ "passes", Lang.key("Pässe") },
}
local tab = "gold"

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), open: (string) -> ())
	local view = msg.profile
	local trow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 0 })
	Kit.list(trow, true, 8)
	for _, t in TABS do
		local b = Kit.button(trow, tr(t[2]), function()
			tab = t[1]
			open("shop")
		end, { Size = UDim2.fromOffset(150, 44) })
		b.BackgroundColor3 = if tab == t[1] then Theme.primary else Theme.panel2
	end
	local items = {}
	for _, it in view.shop.items do
		if it.tab == tab then
			table.insert(items, it)
		end
	end
	table.sort(items, function(a, b)
		return a.order < b.order
	end)
	if #items == 0 then
		Kit.label(body, tr("Hier gibt es gerade nichts zu kaufen."), { TextColor3 = Theme.dim, LayoutOrder = 1 })
	end
	for i, it in items do
		local row = Kit.panel(body, { Size = UDim2.new(1, -10, 0, 62), LayoutOrder = i })
		Kit.padding(row, 8)
		Kit.label(row, Names.product(it.key), {
			Font = Theme.title,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -150, 0, 22),
		})
		Kit.label(row, Names.productDesc(it.key), {
			TextSize = 13,
			TextColor3 = Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, -150, 0, 20),
		})
		if it.owned then
			Kit.label(row, "✔ " .. tr("Besessen"), {
				TextColor3 = Theme.good,
				Font = Theme.title,
				Size = UDim2.fromOffset(130, 44),
				Position = UDim2.new(1, -130, 0, 0),
			})
		else
			Names.buyButton(
				row,
				view,
				it.key,
				command,
				{ Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -130, 0, 0) }
			)
		end
	end
	if tab == "gold" then
		Kit.label(body, tr("Gold gibt es auch in jedem Lauf. Alles in der Schmiede ist ohne Robux erreichbar."), {
			TextSize = 13,
			TextColor3 = Theme.dim,
			LayoutOrder = 99,
			Size = UDim2.new(1, -10, 0, 30),
		})
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">Stats</string>
              <string name="Source"><![CDATA[-- Lifetime statistics (docs/DESIGN.md §6.3): runs, wins, records, kills, gold, play time, evolutions, bosses.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screen = { TITLE = Lang.key("Statistik") }
local tr = Lang.tr

local ROWS = {
	{ "runs", Lang.key("Läufe") },
	{ "coopRuns", Lang.key("Gemeinsame Läufe") },
	{ "wins", Lang.key("Siege") },
	{ "bestTime", Lang.key("Bestzeit"), "time" },
	{ "bestLevel", Lang.key("Höchste Stufe") },
	{ "bestKills", Lang.key("Meiste Besiegte in einem Lauf") },
	{ "kills", Lang.key("Besiegt") },
	{ "bossKills", Lang.key("Bosse") },
	{ "evolutions", Lang.key("Entwicklungen") },
	{ "chests", Lang.key("Truhen") },
	{ "revivesGiven", Lang.key("Gefährten aufgerichtet") },
	{ "goldEarned", Lang.key("Gold verdient") },
	{ "playTime", Lang.key("Spielzeit"), "hours" },
}

function Screen.render(body: ScrollingFrame, msg, _command, _open)
	local st = msg.profile.stats or {}
	local grid = Kit.grid(body, 360, 40, { LayoutOrder = 1 })
	for i, r in ROWS do
		local v = st[r[1]] or 0
		local text
		if r[3] == "time" then
			text = Lang.fmtTime(v)
		elseif r[3] == "hours" then
			text = Lang.fmtDec(math.floor(v / 360) / 10) .. " h"
		else
			text = Lang.fmtNum(v)
		end
		local cell = Kit.panel(grid, { LayoutOrder = i })
		Kit.padding(cell, 6)
		Kit.label(cell, tr(r[2]), { TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(0.65, 1) })
		Kit.label(cell, text, {
			Font = Theme.number,
			TextColor3 = Theme.gold,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.35, 1),
			Position = UDim2.fromScale(0.65, 0),
		})
	end
	Kit.label(
		body,
		"★ "
			.. tostring(msg.profile.stars or 0)
			.. "   "
			.. tr("Wiederbelebungen übrig: {0}", msg.profile.reviveTokens or 0),
		{
			TextColor3 = Theme.dim,
			LayoutOrder = 2,
		}
	)
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">StoryPanel</string>
              <string name="Source"><![CDATA[-- Story panel (docs/DESIGN.md §2.3, web tpl_story): the first time a player enters a land, "Land N", its name, the
-- story's premise (very first land only) and the land's intro. Non-blocking: it closes with its button or after
-- STORY_TIME seconds (the server decides when it is shown and marks it seen).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Stages = require(Shared.Sim.Data.Stages)
local Story = require(Shared.Sim.Data.Story)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local StoryPanel = {}
local tr = Lang.tr

local STORY_TIME = 9
local gui: ScreenGui = nil :: any
local panel: Frame? = nil
local token = 0

function StoryPanel.init()
	gui = Kit.screen("EN_Story", 6)
end

function StoryPanel.hide()
	token += 1
	if panel then
		panel:Destroy()
		panel = nil
	end
end

function StoryPanel.show(stageId: string, premise: boolean)
	StoryPanel.hide()
	local idx, stage = 1, Stages.list[1]
	for i, s in Stages.list do
		if s.id == stageId then
			idx, stage = i, s
		end
	end
	local f = Kit.panel(gui, {
		Size = UDim2.fromOffset(480, if premise then 250 else 190),
		Position = UDim2.fromScale(0.5, 0.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	panel = f
	Kit.padding(f, 12)
	Kit.list(f, false, 6)
	Kit.label(
		f,
		tr("Land {0}", idx),
		{ TextSize = 14, TextColor3 = Theme.dim, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18) }
	)
	Kit.label(f, tr(stage.name), {
		Font = Theme.title,
		TextSize = 28,
		TextColor3 = Theme.gold,
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 34),
	})
	if premise then
		Kit.label(f, tr(Story.premise), {
			TextSize = 14,
			TextColor3 = Theme.dim,
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, 56),
		})
	end
	Kit.label(f, tr(stage.intro), { TextSize = 16, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 44) })
	Kit.button(
		f,
		tr("Los geht’s!"),
		StoryPanel.hide,
		{ Size = UDim2.fromOffset(180, 40), LayoutOrder = 5, TextSize = 18 }
	)
	token += 1
	local my = token
	task.delay(STORY_TIME, function()
		if token == my then
			StoryPanel.hide()
		end
	end)
end

return StoryPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Colours and fonts (web CSS: dark violet panels, ember orange primary, gold for currency).
local Theme = {
	panel = Color3.fromRGB(28, 20, 40),
	panel2 = Color3.fromRGB(44, 32, 62),
	stroke = Color3.fromRGB(120, 90, 160),
	text = Color3.fromRGB(244, 236, 255),
	dim = Color3.fromRGB(170, 160, 190),
	primary = Color3.fromRGB(255, 138, 60),
	gold = Color3.fromRGB(255, 210, 63),
	hp = Color3.fromRGB(255, 80, 100),
	xp = Color3.fromRGB(90, 184, 255),
	good = Color3.fromRGB(93, 255, 143),
	bad = Color3.fromRGB(255, 90, 110),
	boss = Color3.fromRGB(200, 60, 90),
	title = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	number = Enum.Font.GothamBold,
}
return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Wardrobe</string>
              <string name="Source"><![CDATA[-- Cosmetics (docs/DESIGN.md §7.1): hero skins, weapon colours and trails. Owned ones can be equipped (one per
-- slot); free ones show their achievement, paid ones a Robux button when configured. Visual only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Cosmetics = require(Shared.Config.Cosmetics)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Names = require(script.Parent.Names)

local Screen = { TITLE = Lang.key("Aussehen") }
local tr = Lang.tr

local SLOT_NAME = { skin = Lang.key("Heldenfarben"), fx = Lang.key("Waffenfarbe"), trail = Lang.key("Spur") }

local function swatch(parent: Instance, c)
	local hexes = if c.slot == "skin" then { c.body, c.accent } elseif c.slot == "fx" then c.colors else { c.color }
	local row = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
	Kit.list(row, true, 4).HorizontalAlignment = Enum.HorizontalAlignment.Left
	for _, hex in hexes do
		local r, g, b = Cosmetics.parseHex(hex)
		if r then
			local sw = Kit.frame(
				row,
				{ Size = UDim2.fromOffset(22, 22), BackgroundColor3 = Color3.new(r, g :: number, b :: number) }
			)
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = sw
		end
	end
	return row
end

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), _open)
	local view = msg.profile
	local owned = view.cosmetics or {}
	local equipped = view.equipped or {}
	local order = 0
	for _, slot in Cosmetics.SLOTS do
		order += 1
		Kit.label(
			body,
			tr(SLOT_NAME[slot]),
			{ Font = Theme.title, TextSize = 20, LayoutOrder = order, TextXAlignment = Enum.TextXAlignment.Left }
		)
		order += 1
		local grid = Kit.grid(body, 180, 128, { LayoutOrder = order })
		-- "none" card
		local none = Kit.panel(grid, { LayoutOrder = 0 })
		Kit.padding(none, 8)
		Kit.label(none, tr("Standard"), { Font = Theme.title })
		if equipped[slot] then
			Kit.button(none, tr("Anlegen"), function()
				command({ op = "equip", slot = slot, id = "" })
			end, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -40) })
		else
			Kit.label(none, "✔ " .. tr("Angelegt"), { TextColor3 = Theme.good, Position = UDim2.new(0, 0, 1, -30) })
		end
		local i = 0
		for _, c in Cosmetics.list do
			if c.slot == slot then
				local kind, ref = string.match(c.source, "^(%a+):(.+)$")
				local isOwned = owned[c.id] == true
				-- paid ones that cannot be bought here (not configured) and are not owned are hidden
				local shopItem = if kind == "product" then Names.shopItem(view, ref) else nil
				if isOwned or kind == "achievement" or shopItem then
					i += 1
					local card = Kit.panel(grid, { LayoutOrder = i })
					Kit.padding(card, 8)
					Kit.list(card, false, 4)
					Kit.label(card, tr(c.name), { Font = Theme.title, TextSize = 17, LayoutOrder = 1 })
					swatch(card, c).LayoutOrder = 2
					if equipped[slot] == c.id then
						Kit.label(card, "✔ " .. tr("Angelegt"), { TextColor3 = Theme.good, LayoutOrder = 3 })
					elseif isOwned then
						Kit.button(card, tr("Anlegen"), function()
							command({ op = "equip", slot = slot, id = c.id })
						end, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 3 })
					elseif kind == "achievement" then
						Kit.label(card, "🔒 " .. Names.achievementHint(ref), {
							TextSize = 12,
							TextColor3 = Theme.dim,
							LayoutOrder = 3,
							Size = UDim2.new(1, 0, 0, 40),
						})
					else
						Names.buyButton(card, view, ref, command, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 3 })
					end
				end
			end
		end
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">WorldMap</string>
              <string name="Source"><![CDATA[-- World map (docs/DESIGN.md §2.3, web tpl_map): 5 lands with stars and lock state, the leader picks land and
-- night level (only what the leader's profile unlocked); others see the choice.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lang = require(Shared.Lang.Lang)
local Stages = require(Shared.Sim.Data.Stages)
local Heat = require(Shared.Sim.Data.Heat)
local Story = require(Shared.Sim.Data.Story)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screen = { TITLE = Lang.key("Weltkarte") }
local tr = Lang.tr

function Screen.render(body: ScrollingFrame, msg, command: (any) -> (), _open)
	-- the story's premise until the first star (web: map premise); each land's intro is in its row
	if (msg.profile and msg.profile.stars or 0) == 0 then
		Kit.label(body, tr(Story.premise), {
			TextSize = 14,
			TextColor3 = Theme.dim,
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 40),
			LayoutOrder = -1,
		})
	end
	if not msg.isLeader then
		Kit.label(body, tr("Nur der Anführer wählt das Land."), { TextColor3 = Theme.dim, LayoutOrder = 0 })
	end
	for i, s in msg.stages do
		local st = Stages.list[i]
		local sel = s.id == msg.stage
		local row = Kit.panel(body, {
			Size = UDim2.new(1, -10, 0, 96),
			LayoutOrder = i,
			BackgroundColor3 = if sel then Theme.panel2 else Theme.panel,
		})
		Kit.padding(row, 8)
		-- land badge: ground colour with a speckle, the number in the middle
		local badge = Kit.frame(row, {
			Size = UDim2.fromOffset(64, 64),
			Position = UDim2.fromOffset(0, 8),
			BackgroundColor3 = Color3.fromHex(st.ground.base),
		})
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0.5, 0)
		bc.Parent = badge
		local bs = Instance.new("UIStroke")
		bs.Color = if sel then Theme.primary elseif s.unlocked then Color3.fromHex(st.ground.grass) else Theme.stroke
		bs.Thickness = if sel then 3 else 2
		bs.Parent = badge
		local spk = Kit.frame(badge, {
			Size = UDim2.fromScale(0.42, 0.3),
			Position = UDim2.fromScale(0.16, 0.56),
			BackgroundColor3 = Color3.fromHex(st.ground.speckle[1]),
		})
		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(0.5, 0)
		sc.Parent = spk
		Kit.label(badge, if s.unlocked then tostring(i) else "🔒", {
			Size = UDim2.fromScale(1, 1),
			Font = Theme.title,
			TextSize = 26,
			TextStrokeTransparency = 0.3,
		})
		local text = Kit.frame(row, {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -76, 1, 0),
			Position = UDim2.fromOffset(76, 0),
		})
		Kit.label(
			text,
			tr("Land {0}: {1}", i, tr(st.name)) .. "   " .. string.rep("★", s.stars) .. string.rep("☆", 3 - s.stars),
			{
				Font = Theme.title,
				TextSize = 20,
				TextColor3 = if s.unlocked then Theme.text else Theme.dim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, -150, 0, 26),
			}
		)
		local info = if s.unlocked
			then tr(st.intro)
			else tr("Befreie „{0}“, um „{1}“ freizuschalten.", tr(Stages.list[i - 1].name), tr(st.name))
		Kit.label(text, info, {
			TextSize = 13,
			TextColor3 = Theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, -150, 0, 48),
			Position = UDim2.fromOffset(0, 28),
		})
		if msg.isLeader and s.unlocked and not msg.running and not sel then
			Kit.button(row, tr("Wählen"), function()
				command({ op = "selectStage", stage = s.id, heat = math.min(msg.heat, s.maxHeat) })
			end, { Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -130, 0, 16) })
		elseif sel then
			Kit.label(row, "✔ " .. tr("Gewählt"), {
				TextColor3 = Theme.good,
				Font = Theme.title,
				Size = UDim2.fromOffset(130, 44),
				Position = UDim2.new(1, -130, 0, 16),
			})
		end
	end
	-- night level of the chosen land
	local cur = nil
	for _, s in msg.stages do
		if s.id == msg.stage then
			cur = s
		end
	end
	local hrow = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 10 })
	Kit.list(hrow, true, 6)
	Kit.label(hrow, tr("Nachtstufe"), { Size = UDim2.fromOffset(130, 44), Font = Theme.title })
	for h = 0, #Heat.list - 1 do
		local allowed = cur ~= nil and h <= cur.maxHeat
		local b = Kit.button(hrow, if h == 0 then tr("Normal") else tostring(h), function()
			if msg.isLeader and allowed and not msg.running then
				command({ op = "selectStage", stage = msg.stage, heat = h })
			end
		end, { Size = UDim2.fromOffset(if h == 0 then 90 else 52, 44), TextSize = 16 })
		b.BackgroundColor3 = if h == msg.heat
			then Theme.primary
			elseif allowed then Theme.panel2
			else Color3.fromRGB(30, 26, 36)
		b.TextColor3 = if allowed then Theme.text else Theme.dim
	end
	local hd = Heat.list[msg.heat + 1]
	if hd then
		Kit.label(body, tr("Gold ×{0}", Lang.fmtDec(hd.gold)), { TextColor3 = Theme.gold, LayoutOrder = 11 })
	end
end

return Screen
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="119">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">CameraRig</string>
              <string name="Source"><![CDATA[-- Arena camera (docs/DESIGN.md §4.1): scriptable, above and behind the followed hero, pitch 58 deg, FOV 40, never
-- rotates; distance grows on narrow screens so the 128 x 72 stud sim view fits; critically damped follow; shake.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tuning = require(ReplicatedStorage:WaitForChild("Shared").Config.Tuning)
local Coords = require(script.Parent.Coords)

local CameraRig = {}

local active = false
local pos = Vector3.zero
local vel = Vector3.zero
local shakeAmt, shakeT = 0, 0
local zoom = 1
local rng = Random.new()
local lastCF = CFrame.new(0, 100, 60)

function CameraRig.setActive(on: boolean)
	local cam = workspace.CurrentCamera
	active = on
	if on then
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = Tuning.CAM_FOV
	else
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
end

function CameraRig.isActive(): boolean
	return active
end

function CameraRig.setZoom(z: number)
	zoom = math.clamp(z, 0.7, 1.3)
end

function CameraRig.snap(x: number, y: number)
	pos = Coords.v3(x, y) + Vector3.new(0, 0, Tuning.CAM_AIM_SOUTH)
	vel = Vector3.zero
end

local shakeOn = true
function CameraRig.setShakeEnabled(on: boolean)
	shakeOn = on
end

function CameraRig.shake(amount: number)
	if not shakeOn then
		return
	end
	shakeAmt = math.max(shakeAmt, amount)
	shakeT = 0.25
end

-- distance so that the sim view width (2 * VIEW_HW px) fits horizontally at the ground plane
local function distance(cam: Camera): number
	local vp = cam.ViewportSize
	local aspect = if vp.Y > 0 then vp.X / vp.Y else 16 / 9
	local vfov = math.rad(Tuning.CAM_FOV)
	local hfov = 2 * math.atan(math.tan(vfov / 2) * aspect)
	local needW = 2 * Tuning.VIEW_HW * Tuning.STUDS_PER_PX
	local needH = 2 * Tuning.VIEW_HH * Tuning.STUDS_PER_PX
	local dW = needW / 2 / math.tan(hfov / 2)
	local dH = needH / 2 / math.tan(vfov / 2) * math.sin(math.rad(Tuning.CAM_PITCH))
	return math.max(Tuning.CAM_DIST * 0.8, dW, dH) * zoom
end

function CameraRig.update(dt: number, x: number, y: number)
	if not active then
		return
	end
	local cam = workspace.CurrentCamera
	-- aim a little south of the hero: the angled view shows more ground to the north than to the south; this way the
	-- south edge of the sim view (VIEW_HH) stays on screen
	local target = Coords.v3(x, y) + Vector3.new(0, 0, Tuning.CAM_AIM_SOUTH)
	-- critically damped spring, half-life 0.08 s
	local omega = math.log(2) / 0.08 * 1.5
	local diff = pos - target
	local exp = math.exp(-omega * dt)
	local temp = (vel + diff * omega) * dt
	vel = (vel - temp * omega) * exp
	pos = target + (diff + temp) * exp
	if (pos - target).Magnitude > 60 then
		pos = target
		vel = Vector3.zero
	end
	local pitch = math.rad(Tuning.CAM_PITCH)
	local d = distance(cam)
	local eye = pos + Vector3.new(0, math.sin(pitch) * d, math.cos(pitch) * d)
	local cf = CFrame.lookAt(eye, pos)
	if shakeT > 0 then
		shakeT -= dt
		local k = math.max(0, shakeT / 0.25) * shakeAmt * 0.04
		cf *= CFrame.new(rng:NextNumber(-k, k), rng:NextNumber(-k, k), 0)
		if shakeT <= 0 then
			shakeAmt = 0
		end
	end
	cam.CFrame = cf
	lastCF = cf
end

-- screen position (viewport px) of a world point seen by the arena camera, and whether it is inside the screen;
-- pure math on the last camera pose (the off-screen arrows need it for points far outside the view as well)
function CameraRig.project(p: Vector3): (number, number, boolean, boolean)
	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local rel = lastCF:PointToObjectSpace(p)
	local z = -rel.Z
	local th = math.tan(math.rad(Tuning.CAM_FOV) / 2)
	local aspect = if vp.Y > 0 then vp.X / vp.Y else 16 / 9
	local behind = z <= 0.1
	z = math.max(z, 0.1)
	local nx = rel.X / (z * th * aspect)
	local ny = rel.Y / (z * th)
	local sx, sy = (nx * 0.5 + 0.5) * vp.X, (0.5 - ny * 0.5) * vp.Y
	return sx, sy, not behind and math.abs(nx) <= 1 and math.abs(ny) <= 1, behind
end

return CameraRig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Coords</string>
              <string name="Source"><![CDATA[-- Sim (world px, x/y on the ground) <-> Roblox studs (docs/DESIGN.md §0, §4.1): X = x * 0.1, Z = y * 0.1, Y up.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Tuning = require(ReplicatedStorage:WaitForChild("Shared").Config.Tuning)

local Coords = {}
local S = Tuning.STUDS_PER_PX
Coords.S = S

function Coords.v3(x: number, y: number, h: number?): Vector3
	return Vector3.new(x * S, h or 0, y * S)
end

function Coords.cf(x: number, y: number, h: number?): CFrame
	return CFrame.new(x * S, h or 0, y * S)
end

-- rotation about Y for a sim angle a (0 = +x, pi/2 = +y = +Z)
function Coords.yaw(a: number): CFrame
	return CFrame.Angles(0, -a, 0)
end

function Coords.color(hex: string?): Color3
	if type(hex) ~= "string" or #hex < 7 then
		return Color3.new(1, 1, 1)
	end
	return Color3.fromHex(hex)
end

return Coords
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">DamageNumbers</string>
              <string name="Source"><![CDATA[-- Damage numbers and floating texts (docs/DESIGN.md §4.4): pooled BillboardGuis on their own anchor parts (max 40 on
-- PC, 20 on phones), rising 3 studs over 0.7 s and fading. Own hits and boss hits only (the server sends no others);
-- crits are gold and larger. The "damage numbers" setting turns numbers off (texts such as "+Gold" stay).
local Lang = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Lang.Lang)
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local Device = require(script.Parent.Parent.Device)

local DamageNumbers = {}

type Num = {
	part: BasePart,
	gui: BillboardGui,
	label: TextLabel,
	t: number,
	life: number,
	x: number,
	y: number,
	h: number,
}
local free: { Num } = {}
local active: { Num } = {}
local enabled = true
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromHex("#ffd23f")
local BOSS = Color3.fromHex("#ffb0c0")

local function make(): Num
	local part = Instance.new("Part")
	part.Name = "EN_Num"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = Pool.FAR
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(90, 30)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 300
	bb.Adornee = part
	local t = Instance.new("TextLabel")
	t.Name = "T"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextStrokeTransparency = 0.2
	t.TextStrokeColor3 = Color3.fromRGB(30, 10, 20)
	t.Parent = bb
	bb.Parent = part
	part.Parent = Pool.folder()
	return { part = part, gui = bb, label = t, t = 0, life = 0.7, x = 0, y = 0, h = 3 }
end

function DamageNumbers.setEnabled(on: boolean)
	enabled = on
end

local function cap(): number
	return if Device.phone() then 20 else 40
end

local function showNum(
	text: string,
	color: Color3,
	w: number,
	hgt: number,
	x: number,
	y: number,
	h: number,
	life: number
)
	if #active >= cap() then
		-- replace the oldest
		local old = table.remove(active, 1) :: Num
		old.gui.Enabled = false
		old.part.CFrame = Pool.FAR
		table.insert(free, old)
	end
	local n = table.remove(free) or make()
	n.label.Text = text
	n.label.TextColor3 = color
	n.label.TextTransparency = 0
	n.label.TextStrokeTransparency = 0.2
	n.gui.Size = UDim2.fromOffset(w, hgt)
	n.gui.Enabled = true
	n.t, n.life, n.x, n.y, n.h = 0, life, x, y, h
	n.part.CFrame = Coords.cf(x, y, h)
	table.insert(active, n)
end

-- e = dmg event { x, y, amount, crit, boss }
function DamageNumbers.number(e)
	if not enabled then
		return
	end
	-- a little sideways jitter so stacked hits stay readable
	local jx = (math.random() - 0.5) * 16
	local amount = math.floor(e.amount + 0.5)
	if e.crit then
		showNum(tostring(amount) .. "!", GOLD, 110, 38, e.x + jx, e.y, 3.4, 0.8)
	else
		showNum(tostring(amount), if e.boss and not e.own then BOSS else WHITE, 80, 28, e.x + jx, e.y, 3, 0.7)
	end
end

-- e = text event { x, y, text, arg, color }
function DamageNumbers.text(e)
	local s = if e.arg ~= nil then Lang.tr(e.text, e.arg) else Lang.tr(e.text)
	showNum(s, Coords.color(e.color), 160, 30, e.x, e.y, 4, 1.0)
end

function DamageNumbers.count(): number
	return #active
end

function DamageNumbers.render(dt: number)
	for i = #active, 1, -1 do
		local n = active[i]
		n.t += dt
		if n.t >= n.life then
			n.gui.Enabled = false
			n.part.CFrame = Pool.FAR
			table.remove(active, i)
			table.insert(free, n)
		else
			local k = n.t / n.life
			n.part.CFrame = Coords.cf(n.x, n.y, n.h + k * 3)
			if k > 0.6 then
				local a = (k - 0.6) / 0.4
				n.label.TextTransparency = a
				n.label.TextStrokeTransparency = 0.2 + 0.8 * a
			end
		end
	end
end

function DamageNumbers.clear()
	for _, n in active do
		n.gui.Enabled = false
		n.part.CFrame = Pool.FAR
		table.insert(free, n)
	end
	table.clear(active)
end

return DamageNumbers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">EnemyView</string>
              <string name="Source"><![CDATA[--!native
-- Enemies from interpolated snapshots (docs/DESIGN.md §3.5, §4.3): one primitive model per enemy (ModelKit), all
-- parts moved once per frame with workspace:BulkMoveTo. Enemies face their movement (or, standing or winding up,
-- the nearest hero); hit flash, frozen and slowed tint the body; elites and bosses stand on a gold ring, bosses wear
-- a crown and carry an aura light. Kills hide an enemy at once; ids not seen for 0.5 s are released. New
-- enemies rise out of the ground within 0.4 s.
local ModelKit = require(script.Parent.ModelKit)
local Coords = require(script.Parent.Coords)

local EnemyView = {}

type Slot = { rig: ModelKit.Rig, sig: string, seen: number, born: number, x: number, y: number, yaw: number }

local live: { [number]: Slot } = {}
local killed: { [number]: number } = {}
local bossNames: { [number]: string } = {}
local positions: { [number]: { x: number, y: number } } = {}
local tints: { [string]: string } = {}
local parts: { BasePart } = {}
local cframes: { CFrame } = {}
local S = Coords.S
local st = { moving = true, winding = false }
local heroes: { { x: number, y: number } } = {}
local atan2 = math.atan2
local RISE_TIME = 0.4 -- s
local RISE_DEPTH = 4 -- studs below the ground at spawn

function EnemyView.setStage(stage)
	tints = stage and stage.tints or {}
end

function EnemyView.bossSpawned(id: number, name: string)
	bossNames[id] = name
end

local function release(id: number)
	local s = live[id]
	if s then
		ModelKit.release(s.rig)
		live[id] = nil
	end
	positions[id] = nil
end

function EnemyView.kill(id: number)
	killed[id] = os.clock()
	release(id)
end

-- rendered position of an enemy (telegraphs follow it)
function EnemyView.position(id: number): (number?, number?)
	local p = positions[id]
	if p then
		return p.x, p.y
	end
	return nil, nil
end

-- the boss currently in view (for the off-screen arrow): x, y or nil
function EnemyView.bossPosition(): (number?, number?)
	for id, name in bossNames do
		local p = positions[id]
		if p and name then
			return p.x, p.y
		end
	end
	return nil, nil
end

function EnemyView.count(): number
	local n = 0
	for _ in live do
		n += 1
	end
	return n
end

function EnemyView.clear()
	for id in live do
		release(id)
	end
	table.clear(killed)
	table.clear(bossNames)
	table.clear(positions)
end

local function nearestHeroAngle(x: number, y: number): number?
	local best, bx, by = math.huge, 0, 0
	for _, h in heroes do
		local d = (h.x - x) ^ 2 + (h.y - y) ^ 2
		if d < best then
			best, bx, by = d, h.x, h.y
		end
	end
	if best == math.huge then
		return nil
	end
	return atan2(by - y, bx - x)
end

local function turn(from: number, to: number, k: number): number
	local d = (to - from + math.pi) % (2 * math.pi) - math.pi
	return from + d * k
end

-- heroList: positions of the visible heroes (for facing)
function EnemyView.update(interp, now: number, heroList: { { x: number, y: number } }?, dt: number?)
	heroes = heroList or {}
	local k = math.min(1, (dt or 1 / 60) * 10)
	table.clear(parts)
	table.clear(cframes)
	local n = 0
	interp:eachEnemy(function(id, x, y, e)
		local kt = killed[id]
		if kt then
			if now - kt < 1.5 then
				return
			end
			killed[id] = nil
		end
		local bossName = if e.boss then bossNames[id] else nil
		local sig = e.type .. (if e.elite then "E" else "") .. (bossName or "")
		local s = live[id]
		if s and s.sig ~= sig then
			release(id)
			s = nil
		end
		if not s then
			s = {
				rig = ModelKit.enemy(e.type, e.elite, bossName, tints),
				sig = sig,
				seen = now,
				born = if e.boss then -math.huge else now,
				x = x,
				y = y,
				yaw = nearestHeroAngle(x, y) or 0,
			}
			live[id] = s
		end
		local rig = s.rig
		local state = if e.flash then "flash" elseif e.frozen then "frozen" elseif e.slowed then "slowed" else ""
		ModelKit.tint(rig, state, ModelKit.enemyColor(e.type, tints, bossName))
		-- facing: movement direction, or the nearest hero while standing / winding up
		local dx, dy = x - s.x, y - s.y
		local want: number? = nil
		if e.winding or dx * dx + dy * dy < 0.04 then
			want = nearestHeroAngle(x, y)
		else
			want = atan2(dy, dx)
		end
		if want then
			s.yaw = turn(s.yaw, want, if e.winding then 1 else k)
		end
		s.seen = now
		s.x, s.y = x, y
		local p = positions[id]
		if p then
			p.x, p.y = x, y
		else
			positions[id] = { x = x, y = y }
		end
		st.winding = e.winding
		st.moving = true
		-- new enemies rise out of the ground (the perspective camera shows a strip beyond the sim's spawn line at the
		-- top of the screen; this way they never pop into view)
		local age = now - s.born
		local lift = if age < RISE_TIME then -RISE_DEPTH * (1 - age / RISE_TIME) ^ 2 else 0
		local base = CFrame.new(x * S, lift, y * S) * CFrame.Angles(0, -s.yaw, 0)
		n = ModelKit.pose(rig, base, now, st, parts, cframes, n)
	end)
	if n > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for id, s in live do
		if now - s.seen > 0.5 then
			release(id)
		end
	end
end

return EnemyView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">FxView</string>
              <string name="Source"><![CDATA[-- Short effects (docs/DESIGN.md §4.4): death bursts (particles in the enemy colour, bosses with a shock ring),
-- explosions (expanding ring + sparks), coloured bursts, ember and slime puddles (hazards), the bomb flash. Pooled
-- parts and shared particle emitters only. Damage numbers and texts are in DamageNumbers.luau.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enemies = require(Shared.Sim.Data.Enemies)
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local Particles = require(script.Parent.Particles)
local DamageNumbers = require(script.Parent.DamageNumbers)

local FxView = {}

local S = Coords.S
local FLAT = CFrame.Angles(0, 0, math.rad(90))
local list: { any } = {}
local hazards: { [number]: any } = {}
local EMBER = Color3.fromRGB(255, 110, 40)
local EMBER_HOT = Color3.fromRGB(255, 200, 90)
local SLIME = Color3.fromRGB(110, 210, 90)
local SLIME_DARK = Color3.fromRGB(40, 90, 40)
local WHITE = Color3.new(1, 1, 1)
local tints: { [string]: string } = {}

function FxView.setStage(stage)
	tints = stage and stage.tints or {}
end

local function add(part: BasePart, life: number, update)
	table.insert(list, { part = part, t = 0, life = life, update = update })
end

-- an expanding flat ring on the ground
local function ring(x: number, y: number, d: number, col: Color3, life: number, h: number?, tr0: number?)
	local p = Pool.get("Cylinder", Vector3.new(0.12, 0.2, 0.2), col, Enum.Material.Neon, tr0 or 0.3)
	local base = Coords.cf(x, y, h or 0.25) * FLAT
	add(p, life, function(part, k)
		local s = math.max(0.2, d * (0.25 + 0.75 * (1 - (1 - k) * (1 - k))))
		part.Size = Vector3.new(0.12, s, s)
		part.CFrame = base
		part.Transparency = (tr0 or 0.3) + (1 - (tr0 or 0.3)) * k
	end)
end

function FxView.boom(e)
	local col = Coords.color(e.color)
	ring(e.x, e.y, e.rad * 2 * S, col, 0.4)
	Particles.burst("spark", e.x, e.y, 0.8, col, 14)
end

function FxView.burst(e)
	local col = Coords.color(e.color)
	Particles.burst(if (e.n or 0) >= 40 then "big" else "spark", e.x, e.y, 1.2, col, math.min(40, e.n or 10))
end

-- e = kill event { x, y, type, elite, boss }
function FxView.kill(e)
	local hex = tints[e.type] or Enemies.COLORS[e.type] or "#ffffff"
	local col = Coords.color(hex)
	if e.boss then
		ring(e.x, e.y, 22, Color3.fromRGB(255, 220, 140), 0.7, 0.3, 0.1)
		Particles.burst("big", e.x, e.y, 2, col, 40)
		Particles.burst("big", e.x, e.y, 2, Color3.fromRGB(255, 220, 140), 30)
	else
		Particles.burst("puff", e.x, e.y, 1, col:Lerp(WHITE, 0.3), if e.elite then 10 else 4)
		Particles.burst("spark", e.x, e.y, 1, col, if e.elite then 12 else 5)
	end
end

-- bomb pickup: white shock ring around the collector
function FxView.flash(e)
	ring(e.x, e.y, 80, WHITE, 0.5, 0.4, 0.1)
end

function FxView.hazard(e)
	local d = e.rad * 2 * S
	local ember = e.kind == "ember"
	local col = if ember then EMBER else SLIME
	local p = Pool.get("Cylinder", Vector3.new(0.1, d, d), col, Enum.Material.Neon, if ember then 0.35 else 0.4)
	p.CFrame = Coords.cf(e.x, e.y, 0.1) * FLAT
	local rim = Pool.get(
		"Cylinder",
		Vector3.new(0.08, d * 1.08, d * 1.08),
		if ember then EMBER_HOT else SLIME_DARK,
		if ember then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		if ember then 0.6 else 0.35
	)
	rim.CFrame = Coords.cf(e.x, e.y, 0.07) * FLAT
	hazards[e.id] = { part = p, rim = rim, kind = e.kind, x = e.x, y = e.y, rad = e.rad, t = 0, life = e.life, d = d }
end

function FxView.hazardLife(id: number, life: number)
	local h = hazards[id]
	if h then
		h.life = h.t + life
	end
end

function FxView.hazardGone(id: number)
	local h = hazards[id]
	if h then
		Pool.put(h.part)
		Pool.put(h.rim)
		hazards[id] = nil
	end
end

-- is (x, y) inside a slime puddle? (own-hero prediction uses the sim's 0.55 slow)
function FxView.inSlow(x: number, y: number, r: number): boolean
	for _, h in hazards do
		if h.kind == "slow" then
			local rr = h.rad + r - 4
			if (x - h.x) ^ 2 + (y - h.y) ^ 2 < rr * rr then
				return true
			end
		end
	end
	return false
end

-- kept for App: numbers and texts live in DamageNumbers
FxView.number = DamageNumbers.number
FxView.text = DamageNumbers.text

function FxView.render(dt: number)
	for i = #list, 1, -1 do
		local f = list[i]
		f.t += dt
		if f.t >= f.life then
			Pool.put(f.part)
			table.remove(list, i)
		else
			f.update(f.part, f.t / f.life)
		end
	end
	for id, h in hazards do
		h.t += dt
		if h.t >= h.life + 0.5 then
			FxView.hazardGone(id)
		elseif h.kind == "ember" then
			-- flicker and the odd rising spark
			local fl = 0.3 + 0.12 * math.sin(h.t * 13 + id) + 0.05 * math.sin(h.t * 7.3)
			h.part.Transparency = if h.t > h.life then 0.3 + 0.7 * (h.t - h.life) / 0.5 else fl
			if math.random() < dt * 3 then
				local a, r = math.random() * 6.28, math.random() * h.rad
				Particles.burst("rise", h.x + math.cos(a) * r, h.y + math.sin(a) * r, 0.3, EMBER_HOT, 1)
			end
		elseif h.t > h.life then
			h.part.Transparency = 0.4 + 0.6 * (h.t - h.life) / 0.5
		end
	end
	DamageNumbers.render(dt)
end

function FxView.clear()
	for _, f in list do
		Pool.put(f.part)
	end
	table.clear(list)
	for id in hazards do
		FxView.hazardGone(id)
	end
	DamageNumbers.clear()
	Particles.clear()
end

return FxView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">Ground</string>
              <string name="Source"><![CDATA[-- Endless ground per land (docs/DESIGN.md §4.2): one plate re-centred on the camera target, world-anchored detail
-- grids (speckles and grass tufts every 8 studs, large soft patches every 32 studs, all by Util.hash2); decor models per 150 px chunk exactly where the web game draws
-- them (20 % of the chunks, kind/position by Util.hash2, land decorTint); braziers at the positions the sim uses
-- (Props.position) with an ember light on the nearest ones, broken ones hidden. Everything is pooled.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Props = require(Shared.Sim.Props)
local Util = require(Shared.Sim.Util)
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)
local ModelKit = require(script.Parent.ModelKit)

local Ground = {}

local PLATE = 1024 -- one ground plate, re-centred every SNAP studs
local SNAP = 256
local DECOR_CHUNK = 150 -- px (web drawDecor C)
local DECOR_MAX = 120
local BRAZIER_LIGHTS = 4
-- the view: wider at the far (top) edge because of the camera pitch
local VX, VUP, VDOWN = 1050, 1050, 700

-- detail grids (studs): world-anchored cells mapped onto a fixed ring of pooled parts, so a camera move only
-- re-places the cells that scrolled in. Fine grid: speckles and grass tufts; coarse grid: large soft patches.
type Grid = {
	cell: number,
	nx: number,
	ny: number,
	slots: { { key: number, parts: { BasePart } } },
	place: (g: any, slot: any, cx: number, cy: number) -> (),
}
local fine: Grid? = nil
local coarse: Grid? = nil
local plate: BasePart? = nil
local plateAt = Vector2.new(1e9, 1e9)
local stage: any = nil
local braziers: { [number]: { rig: ModelKit.Rig, light: PointLight?, x: number, y: number } } = {}
local broken: { [number]: boolean } = {}
local decor: { [number]: ModelKit.Rig } = {}
local decorCount = 0
local lastChunk = Vector2.new(1e9, 1e9)
local hash2 = Util.hash2
local FAR = Pool.FAR
local FLAT = CFrame.Angles(0, 0, math.rad(90))

local BRAZIER: ModelKit.Spec = {
	parts = {
		{
			shape = "Cylinder",
			size = Vector3.new(1.4, 0.25, 0.25),
			pos = Vector3.new(0.5, 0.7, 0),
			rot = Vector3.new(0, 0, 70),
			role = "dark",
		},
		{
			shape = "Cylinder",
			size = Vector3.new(1.4, 0.25, 0.25),
			pos = Vector3.new(-0.5, 0.7, 0),
			rot = Vector3.new(0, 0, 110),
			role = "dark",
		},
		{
			shape = "Cylinder",
			size = Vector3.new(0.7, 2.0, 2.0),
			pos = Vector3.new(0, 1.45, 0),
			rot = Vector3.new(0, 0, 90),
			role = "body",
		},
		{
			shape = "Ball",
			size = Vector3.new(1.6, 0.8, 1.6),
			pos = Vector3.new(0, 1.85, 0),
			role = "glow",
			mat = Enum.Material.Neon,
		},
	},
}

local function newGrid(cell: number, nx: number, ny: number, perSlot: { { string } }, place): Grid
	local g: Grid = { cell = cell, nx = nx, ny = ny, slots = {}, place = place }
	for i = 1, nx * ny do
		local parts = {}
		for _, sh in perSlot do
			table.insert(parts, Pool.get(sh[1], Vector3.one, nil, Enum.Material.SmoothPlastic, 0))
		end
		g.slots[i] = { key = -1, parts = parts }
	end
	return g
end

local function updateGrid(g: Grid, sx: number, sy: number)
	local c = g.cell
	local cx0 = math.floor(sx / c) - math.floor(g.nx / 2)
	local cy0 = math.floor(sy / c) - math.floor(g.ny * 0.55)
	for cx = cx0, cx0 + g.nx - 1 do
		for cy = cy0, cy0 + g.ny - 1 do
			local i = (cx % g.nx) * g.ny + (cy % g.ny) + 1
			local slot = g.slots[i]
			local key = Props.key(cx, cy)
			if slot.key ~= key then
				slot.key = key
				g.place(g, slot, cx, cy)
			end
		end
	end
end

local function placeFine(g: Grid, slot, cx: number, cy: number)
	local sp, tuft = slot.parts[1], slot.parts[2]
	local c = g.cell
	local h1, h2, h3, h4 = hash2(cx, cy, 21), hash2(cx, cy, 22), hash2(cx, cy, 23), hash2(cx, cy, 24)
	if h1 < 0.4 then
		local cols = stage.ground.speckle
		local size = 0.9 + h2 * 2.4
		sp.Size = Vector3.new(0.05 + h4 * 0.03, size, size * (0.7 + h2 * 0.5))
		sp.Color = Coords.color(stage.ground.base):Lerp(Coords.color(cols[math.floor(h3 * #cols) + 1]), 0.5)
		sp.CFrame = CFrame.new((cx + h2) * c, 0.02 + h4 * 0.02, (cy + h3) * c) * CFrame.Angles(0, h1 * 9, 0) * FLAT
	else
		sp.CFrame = FAR
	end
	if h4 < 0.3 then
		tuft.Size = Vector3.new(0.22, 0.7 + h1 * 0.6, 0.5 + h2 * 0.5)
		tuft.CFrame = CFrame.new((cx + h3) * c, 0.3, (cy + h1) * c) * CFrame.Angles(0, h2 * 6.28, (h4 - 0.2) * 0.8)
	else
		tuft.CFrame = FAR
	end
end

local function placeCoarse(g: Grid, slot, cx: number, cy: number)
	local p = slot.parts[1]
	local c = g.cell
	local h1, h2, h3 = hash2(cx, cy, 31), hash2(cx, cy, 32), hash2(cx, cy, 33)
	if h1 < 0.55 then
		local cols = stage.ground.speckle
		local base = Coords.color(stage.ground.base)
		local size = 12 + h3 * 18
		p.Size = Vector3.new(0.04, size, size * (0.6 + h2 * 0.5))
		p.Color = base:Lerp(Coords.color(cols[math.floor(h2 * #cols) + 1]), 0.28)
		p.CFrame = CFrame.new((cx + h2) * c, 0.01, (cy + h3) * c) * CFrame.Angles(0, h1 * 7, 0) * FLAT
	else
		p.CFrame = FAR
	end
end

function Ground.setStage(s)
	Ground.clear()
	stage = s
	local base = Coords.color(s.ground.base)
	plate = Pool.get("Block", Vector3.new(PLATE, 1, PLATE), base, Enum.Material.SmoothPlastic, 0)
	plateAt = Vector2.new(1e9, 1e9)
	coarse = newGrid(32, 8, 7, { { "Cylinder" } }, placeCoarse)
	fine = newGrid(8, 22, 20, { { "Cylinder" }, { "Block" } }, placeFine)
	for _, slot in (fine :: Grid).slots do
		slot.parts[2].Color = Coords.color(s.ground.grass)
	end
	lastChunk = Vector2.new(1e9, 1e9)
end

function Ground.breakProp(cx: number, cy: number)
	local key = Props.key(cx, cy)
	broken[key] = true
	local b = braziers[key]
	if b then
		ModelKit.release(b.rig)
		braziers[key] = nil
	end
end

-- decor per chunk like the web game's drawDecor: 20 % of the chunks, kind and position by hash
local function updateDecor(x: number, y: number)
	local C = DECOR_CHUNK
	local cx0, cx1 = math.floor((x - VX) / C), math.floor((x + VX) / C)
	local cy0, cy1 = math.floor((y - VUP) / C), math.floor((y + VDOWN) / C)
	local want = {}
	local kinds = stage.decor or {}
	if #kinds == 0 then
		return
	end
	for cx = cx0, cx1 do
		for cy = cy0, cy1 do
			if hash2(cx, cy, 3) <= 0.2 then
				local key = Props.key(cx, cy)
				want[key] = true
				if not decor[key] and decorCount < DECOR_MAX then
					local kind = kinds[math.floor(hash2(cx, cy, 4) * #kinds) + 1]
					local scale = 1.1 + hash2(cx, cy, 10) * 0.6
					local rig = ModelKit.decor(kind, scale, stage.decorTint)
					local px = (cx + 0.1 + hash2(cx, cy, 5) * 0.8) * C
					local py = (cy + 0.1 + hash2(cx, cy, 6) * 0.8) * C
					local base = Coords.cf(px, py) * CFrame.Angles(0, (hash2(cx, cy, 11) - 0.5) * 1.2, 0)
					for j, part in rig.parts do
						part.CFrame = base * rig.offs[j]
					end
					decor[key] = rig
					decorCount += 1
				end
			end
		end
	end
	for key, rig in decor do
		if not want[key] then
			ModelKit.release(rig)
			decor[key] = nil
			decorCount -= 1
		end
	end
end

local function updateBraziers(x: number, y: number)
	local C = Props.CHUNK
	local cx0, cx1 = math.floor((x - 1100) / C), math.floor((x + 1100) / C)
	local cy0, cy1 = math.floor((y - 1100) / C), math.floor((y + 800) / C)
	local want = {}
	for cx = cx0, cx1 do
		for cy = cy0, cy1 do
			local key = Props.key(cx, cy)
			if not broken[key] then
				local px, py = Props.position(cx, cy)
				if px then
					want[key] = true
					if not braziers[key] then
						local rig = ModelKit.build(
							BRAZIER,
							1,
							{ body = Color3.fromRGB(70, 66, 76), glow = Color3.fromRGB(255, 150, 60) }
						)
						local base = Coords.cf(px, py)
						for j, part in rig.parts do
							part.CFrame = base * rig.offs[j]
						end
						braziers[key] = { rig = rig, light = nil, x = px, y = py }
					end
				end
			end
		end
	end
	for key, b in braziers do
		if not want[key] then
			ModelKit.release(b.rig)
			braziers[key] = nil
		end
	end
	-- ember lights on the nearest braziers only (light budget, docs/DESIGN.md §4.4)
	local list = {}
	for _, b in braziers do
		table.insert(list, b)
	end
	table.sort(list, function(a, b)
		return (a.x - x) ^ 2 + (a.y - y) ^ 2 < (b.x - x) ^ 2 + (b.y - y) ^ 2
	end)
	for i, b in list do
		local on = i <= BRAZIER_LIGHTS
		if on and not b.light then
			local l = Instance.new("PointLight")
			l.Range = 12
			l.Brightness = 1.3
			l.Color = Color3.fromRGB(255, 160, 70)
			l.Shadows = false
			l.Parent = b.rig.parts[4]
			b.light = l
		elseif not on and b.light then
			(b.light :: PointLight):Destroy()
			b.light = nil
		end
	end
end

-- x, y in sim px (the camera target)
function Ground.update(x: number, y: number)
	if not stage then
		return
	end
	local sx, sy = x * Coords.S, y * Coords.S
	local px, py = math.floor(sx / SNAP + 0.5) * SNAP, math.floor(sy / SNAP + 0.5) * SNAP
	if px ~= plateAt.X or py ~= plateAt.Y then
		plateAt = Vector2.new(px, py);
		(plate :: BasePart).CFrame = CFrame.new(px, -0.5, py)
	end
	updateGrid(fine :: Grid, sx, sy)
	updateGrid(coarse :: Grid, sx, sy)
	local cx, cy = math.floor(x / DECOR_CHUNK), math.floor(y / DECOR_CHUNK)
	if cx ~= lastChunk.X or cy ~= lastChunk.Y then
		lastChunk = Vector2.new(cx, cy)
		updateDecor(x, y)
		updateBraziers(x, y)
	end
end

local function freeGrid(g: Grid?)
	if g then
		for _, slot in g.slots do
			for _, p in slot.parts do
				Pool.put(p)
			end
		end
	end
end

function Ground.clear()
	if plate then
		Pool.put(plate)
		plate = nil
	end
	freeGrid(fine)
	freeGrid(coarse)
	fine, coarse = nil, nil
	for key, b in braziers do
		ModelKit.release(b.rig)
		braziers[key] = nil
	end
	for key, rig in decor do
		ModelKit.release(rig)
		decor[key] = nil
	end
	decorCount = 0
	table.clear(broken)
	stage = nil
end

return Ground
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">HeroView</string>
              <string name="Source"><![CDATA[-- Heroes (docs/DESIGN.md §3.6, §4.3): the own hero is predicted locally every frame with the sim's movement rules
-- (speed, x0.55 in slime, leash) and sent at 20 Hz; teammates come from interpolated snapshots. Models from
-- ModelKit (body, head, cape, hat, weapon prop) in the hero or skin colours; every hero carries a warm "ember"
-- light, teammates show their name and HP above the head, downed heroes lie down inside a revive ring.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tuning = require(Shared.Config.Tuning)
local Cosmetics = require(Shared.Config.Cosmetics)
local ModelKit = require(script.Parent.ModelKit)
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)

local HeroView = {}

local S = Coords.S
local R = 1.35 -- hero model radius in studs
type Hero = {
	rig: ModelKit.Rig?,
	hero: string?,
	skin: string?,
	light: PointLight?,
	dome: BasePart?,
	ring: BasePart?,
	ringFill: BasePart?,
	trail: Trail?,
	trailId: string?,
	att: { Attachment }?,
	tag: BillboardGui?,
	tagFill: Frame?,
	tagName: TextLabel?,
	yaw: number,
	px: number,
	py: number,
}
local DOME = Color3.fromRGB(255, 150, 70)
local REVIVE = Color3.fromRGB(93, 255, 143)

local heroes: { [number]: Hero } = {}
local own = { slot = 0, x = 0, y = 0, speed = 150, state = "active", dirX = 1, dirY = 0, moving = false, face = 1 }
local correction: { x: number, y: number, t: number }? = nil
local heroIds: { [number]: string } = {}
local states: { [number]: string } = {}
local names: { [number]: string } = {}
local cosBySlot: { [number]: { skin: string?, fx: string?, trail: string? } } = {}
local bulkP: { BasePart } = {}
local bulkC: { CFrame } = {}
local visible: { { x: number, y: number } } = {}
local spots: { { x: number, y: number } } = {} -- reused entries of `visible`
local seen: { [number]: boolean } = {}
local stIdle = { moving = false }
local stMove = { moving = true }

-- equipped cosmetics of a hero (validated by the server): skin palette and trail; weapon colours are in ShotView
function HeroView.setCosmetics(slot: number, cos: { skin: string?, fx: string?, trail: string? }?, name: string?)
	cosBySlot[slot] = cos or {}
	if name then
		names[slot] = name
	end
end

local function color(hex: string?): Color3?
	local r, g, b = Cosmetics.parseHex(hex)
	return if r then Color3.new(r, g :: number, b :: number) else nil
end

local function removeTrail(h: Hero)
	if h.trail then
		h.trail:Destroy()
		h.trail = nil
	end
	if h.att then
		for _, a in h.att do
			a:Destroy()
		end
		h.att = nil
	end
	h.trailId = nil
end

local function applyTrail(h: Hero, id: string?)
	if h.trailId == id or not h.rig then
		return
	end
	removeTrail(h)
	local c = id and Cosmetics.byId[id]
	local col = c and color(c.color)
	if not col then
		return
	end
	local body = (h.rig :: ModelKit.Rig).parts[1]
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0, 0.6)
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 0, -0.6)
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(col)
	tr.LightEmission = 0.8
	tr.Lifetime = 0.45
	tr.FaceCamera = true
	tr.Transparency = NumberSequence.new(0.2, 1)
	tr.WidthScale = NumberSequence.new(1, 0.2)
	a0.Parent = body
	a1.Parent = body
	tr.Parent = body
	h.trail = tr
	h.att = { a0, a1 }
	h.trailId = id
end

function HeroView.own()
	return own
end

function HeroView.start(slot: number, x: number, y: number, heroId: string)
	own.slot = slot
	own.x, own.y = x, y
	own.state = "active"
	heroIds[slot] = heroId
	correction = nil
end

function HeroView.setSpeed(v: number)
	own.speed = v
end

function HeroView.setState(slot: number, state: string)
	states[slot] = state
	if slot == own.slot then
		own.state = state
	end
end

function HeroView.setHero(slot: number, heroId: string)
	heroIds[slot] = heroId
end

-- server correction: glide there over 0.1 s
function HeroView.correct(x: number, y: number)
	correction = { x = x, y = y, t = 0.1 }
end

local function makeTag(h: Hero, slot: number)
	local bb = Instance.new("BillboardGui")
	bb.Name = "EN_Tag"
	bb.Size = UDim2.fromOffset(110, 26)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 5.4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 400
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 14)
	name.Font = Enum.Font.GothamBold
	name.TextSize = 13
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.4
	name.Text = names[slot] or ""
	name.Parent = bb
	local bg = Instance.new("Frame")
	bg.BorderSizePixel = 0
	bg.BackgroundColor3 = Color3.fromRGB(20, 14, 28)
	bg.Size = UDim2.new(0.8, 0, 0, 6)
	bg.Position = UDim2.new(0.1, 0, 0, 16)
	bg.Parent = bb
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Color3.fromRGB(255, 80, 100)
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bg
	h.tag = bb
	h.tagFill = fill
	h.tagName = name
end

local function get(slot: number): Hero
	local h = heroes[slot]
	if not h then
		h = { rig = nil, hero = nil, yaw = 0, px = 0, py = 0 }
		heroes[slot] = h
	end
	local id = heroIds[slot]
	local cos = cosBySlot[slot] or {}
	if not h.rig or h.hero ~= id or h.skin ~= cos.skin then
		if h.rig then
			removeTrail(h)
			ModelKit.release(h.rig)
			h.light = nil
			h.tag = nil
		end
		h.hero = id
		h.skin = cos.skin
		local skin = cos.skin and Cosmetics.byId[cos.skin]
		local pal: ModelKit.Palette = {
			body = (skin and color(skin.body)) or ModelKit.heroColor(id),
			accent = skin and color(skin.accent) or nil,
		}
		h.rig = ModelKit.hero(id, R, pal)
		local rig = h.rig :: ModelKit.Rig
		local l = Instance.new("PointLight")
		l.Range = if slot == own.slot then 22 else 16
		l.Brightness = if slot == own.slot then 1.4 else 1
		l.Color = Color3.fromRGB(255, 170, 90)
		l.Shadows = false
		l.Parent = rig.parts[2]
		h.light = l
		if slot ~= own.slot then
			makeTag(h, slot);
			(h.tag :: BillboardGui).Parent = rig.parts[4]
		end
	end
	applyTrail(h, cos.trail)
	return h
end

local function showTrail(h: Hero, on: boolean)
	local tr = h.trail
	if tr and tr.Enabled ~= on then
		tr:Clear()
		tr.Enabled = on
	end
end

-- ember ward (co-op level-up, docs/DESIGN.md §2.5): translucent dome of WARD_RADIUS
local function ward(h: Hero, x: number, y: number, on: boolean)
	if on then
		if not h.dome then
			local d = Tuning.WARD_RADIUS * 2 * S
			h.dome = Pool.get("Ball", Vector3.one * d, DOME, Enum.Material.Neon, 0.85)
		end
		(h.dome :: BasePart).CFrame = CFrame.new(x * S, 0, y * S)
	elseif h.dome then
		Pool.put(h.dome)
		h.dome = nil
	end
end

-- revive ring around a downed hero: outline + filling progress
local function reviveRing(h: Hero, x: number, y: number, downed: boolean, frac: number)
	if downed then
		local d = Tuning.REVIVE_RADIUS * 2 * S
		if not h.ring then
			h.ring = Pool.get("Cylinder", Vector3.new(0.06, d, d), REVIVE, Enum.Material.Neon, 0.7)
			h.ringFill = Pool.get("Cylinder", Vector3.new(0.08, 0.2, 0.2), REVIVE, Enum.Material.Neon, 0.35)
		end
		local base = CFrame.new(x * S, 0.08, y * S) * CFrame.Angles(0, 0, math.rad(90));
		(h.ring :: BasePart).CFrame = base
		local f = math.max(0.2, d * math.clamp(frac, 0, 1))
		local fill = h.ringFill :: BasePart
		if math.abs(fill.Size.Y - f) > 0.05 then
			fill.Size = Vector3.new(0.08, f, f)
		end
		fill.CFrame = base * CFrame.new(0.02, 0, 0)
	elseif h.ring then
		Pool.put(h.ring)
		Pool.put(h.ringFill :: BasePart)
		h.ring = nil
		h.ringFill = nil
	end
end

local function turn(from: number, to: number, k: number): number
	local d = (to - from + math.pi) % (2 * math.pi) - math.pi
	return from + d * k
end

local function place(h: Hero, x: number, y: number, downed: boolean, moving: boolean, t: number, n: number): number
	local rig = h.rig :: ModelKit.Rig
	local base = CFrame.new(x * S, 0, y * S) * CFrame.Angles(0, -h.yaw, 0)
	if downed then
		base = base * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(80))
	end
	return ModelKit.pose(rig, base, t, if moving and not downed then stMove else stIdle, bulkP, bulkC, n)
end

-- leash: stay within LEASH_RADIUS of the centroid of the active heroes (latest snapshot data)
local function leash(x: number, y: number, latest): (number, number)
	local cx, cy, n = x, y, 1
	for slot, h in latest do
		if slot ~= own.slot and not h.downed and not h.fallen then
			cx += h.x
			cy += h.y
			n += 1
		end
	end
	if n < 2 then
		return x, y
	end
	cx /= n
	cy /= n
	local dx, dy = x - cx, y - cy
	local d = math.sqrt(dx * dx + dy * dy)
	local L = Tuning.LEASH_RADIUS
	if d > L then
		return cx + dx / d * L, cy + dy / d * L
	end
	return x, y
end

-- own hero: move, send, render. mx/my = move vector, slow = in a slime puddle
function HeroView.updateOwn(dt: number, mx: number, my: number, slow: boolean, latest, send)
	if own.slot == 0 then
		return
	end
	local l = math.sqrt(mx * mx + my * my)
	own.moving = own.state == "active" and l > 0.05
	if own.moving then
		local k = math.min(1, l) * (if slow then 0.55 else 1)
		own.dirX, own.dirY = mx / l, my / l
		own.x += own.dirX * own.speed * k * dt
		own.y += own.dirY * own.speed * k * dt
		if math.abs(own.dirX) > 0.1 then
			own.face = if own.dirX > 0 then 1 else -1
		end
	end
	if correction then
		local c = correction
		local k = math.min(1, dt / math.max(c.t, 1e-3))
		own.x += (c.x - own.x) * k
		own.y += (c.y - own.y) * k
		c.t -= dt
		if c.t <= 0 then
			own.x, own.y = c.x, c.y
			correction = nil
		end
	end
	own.x, own.y = leash(own.x, own.y, latest)
	send(dt, own.x, own.y, own.dirX, own.dirY, own.moving)
end

-- render all heroes; interp gives teammates. Returns the visible hero positions (enemies face them).
function HeroView.render(interp, t: number, dt: number?): { { x: number, y: number } }
	table.clear(seen)
	local latest = interp:latestHeroes()
	local n = 0
	local k = math.min(1, (dt or 1 / 60) * 14)
	table.clear(bulkP)
	table.clear(bulkC)
	table.clear(visible)
	if own.slot > 0 then
		local h = get(own.slot)
		if own.moving then
			h.yaw = turn(h.yaw, math.atan2(own.dirY, own.dirX), k)
		end
		local me = latest[own.slot]
		local downed = own.state == "downed"
		n = place(h, own.x, own.y, downed, own.moving, t, n)
		ward(h, own.x, own.y, me ~= nil and me.ward)
		reviveRing(h, own.x, own.y, downed, if me then me.revive or 0 else 0)
		showTrail(h, not downed)
		seen[own.slot] = true
		if own.state ~= "fallen" then
			local sp = spots[#visible + 1] or {} :: any
			spots[#visible + 1] = sp
			sp.x, sp.y = own.x, own.y
			table.insert(visible, sp)
		end
	end
	for slot = 1, Tuning.MAX_PLAYERS do
		if slot ~= own.slot then
			local x, y, data = interp:hero(slot)
			if x and data and not data.fallen then
				local h = get(slot)
				local dx, dy = x - h.px, y - h.py
				if dx * dx + dy * dy > 0.25 then
					h.yaw = turn(h.yaw, math.atan2(dy, dx), k)
				end
				h.px, h.py = x, y
				n = place(h, x, y, data.downed, data.moving, t, n)
				ward(h, x, y, data.ward)
				reviveRing(h, x, y, data.downed, data.revive or 0)
				showTrail(h, not data.downed)
				if h.tagFill then
					(h.tagFill :: Frame).Size = UDim2.fromScale(math.clamp(data.hp or 1, 0, 1), 1)
				end
				if h.tagName and names[slot] and (h.tagName :: TextLabel).Text ~= names[slot] then
					(h.tagName :: TextLabel).Text = names[slot]
				end
				seen[slot] = true
				local sp = spots[#visible + 1] or {} :: any
				spots[#visible + 1] = sp
				sp.x, sp.y = x, y
				table.insert(visible, sp)
			end
		end
	end
	if n > 0 then
		workspace:BulkMoveTo(bulkP, bulkC, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for slot, h in heroes do
		if not seen[slot] and h.rig then
			for _, p in (h.rig :: ModelKit.Rig).parts do
				p.CFrame = Pool.FAR
			end
			ward(h, 0, 0, false)
			reviveRing(h, 0, 0, false, 0)
			showTrail(h, false)
		end
	end
	return visible
end

-- world position of a hero (own: predicted; others: interpolated)
function HeroView.position(interp, slot: number): (number?, number?)
	if slot == own.slot then
		return own.x, own.y
	end
	local x, y = interp:hero(slot)
	return x, y
end

function HeroView.clear()
	for slot, h in heroes do
		ward(h, 0, 0, false)
		reviveRing(h, 0, 0, false, 0)
		removeTrail(h)
		if h.rig then
			ModelKit.release(h.rig)
		end
		heroes[slot] = nil
	end
	own.slot = 0
	table.clear(states)
end

return HeroView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">Land</string>
              <string name="Source"><![CDATA[-- Per-land lighting and atmosphere (docs/DESIGN.md §4.2): night (ClockTime 0), ambient light and an Atmosphere
-- tinted from the land's ground colours and mood, a soft ColorCorrection tint, Bloom so Neon parts glow, and one
-- area ParticleEmitter above the camera target for the land's weather (grave mist, falling ash, snow, dust, star
-- motes). The hub's lighting is restored when the run ends. "Reduced effects" turns the weather off.
local Lighting = game:GetService("Lighting")
local Pool = require(script.Parent.Pool)
local Coords = require(script.Parent.Coords)

local Land = {}

-- mood per land: ambient tint, atmosphere colour/decay, colour correction, weather particles
local MOOD = {
	graveyard = {
		ambient = "#5c8a86",
		atmo = "#7fa8a0",
		decay = "#1c2a2e",
		tint = "#e6fff6",
		density = 0.3,
		weather = { color = "#b8e8d8", size = 2.4, rate = 10, speed = 1.5, life = 6, alpha = 0.85, up = false },
	},
	ashwood = {
		ambient = "#9a6a58",
		atmo = "#c08060",
		decay = "#3a1a10",
		tint = "#fff0e0",
		density = 0.32,
		weather = {
			color = "#ff8a3c",
			size = 0.25,
			rate = 26,
			speed = 3,
			life = 5,
			alpha = 0.1,
			up = true,
			neon = true,
		},
	},
	frostlake = {
		ambient = "#7090c0",
		atmo = "#a8c8f0",
		decay = "#1a2a48",
		tint = "#eef6ff",
		density = 0.28,
		weather = { color = "#ffffff", size = 0.3, rate = 40, speed = 5, life = 5, alpha = 0.15, up = false },
	},
	ruins = {
		ambient = "#8a8068",
		atmo = "#b0a080",
		decay = "#2e2818",
		tint = "#fff8e6",
		density = 0.3,
		weather = { color = "#e8d8b0", size = 0.22, rate = 18, speed = 1.2, life = 6, alpha = 0.35, up = true },
	},
	nightheart = {
		ambient = "#6e5cb0",
		atmo = "#8a70d8",
		decay = "#160e30",
		tint = "#f2ecff",
		density = 0.34,
		weather = {
			color = "#b8a8ff",
			size = 0.3,
			rate = 22,
			speed = 1.8,
			life = 5,
			alpha = 0.1,
			up = true,
			neon = true,
		},
	},
}
Land.MOOD = MOOD

local saved: { [string]: any }? = nil
local atmo: Atmosphere? = nil
local cc: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local emitterPart: BasePart? = nil
local emitter: ParticleEmitter? = nil
local lowFx = false

local function save()
	if saved then
		return
	end
	saved = {
		ClockTime = Lighting.ClockTime,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Brightness = Lighting.Brightness,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
	}
end

local function effects()
	if not atmo then
		local a = Instance.new("Atmosphere")
		a.Name = "EN_Atmosphere"
		a.Parent = Lighting
		atmo = a
		local c = Instance.new("ColorCorrectionEffect")
		c.Name = "EN_Color"
		c.Parent = Lighting
		cc = c
		local b = Instance.new("BloomEffect")
		b.Name = "EN_Bloom"
		b.Intensity = 0.6
		b.Threshold = 1.2
		b.Size = 24
		b.Parent = Lighting
		bloom = b
	end
end

local function weather(w)
	if not emitterPart then
		local p = Pool.get("Block", Vector3.new(150, 1, 110), nil, Enum.Material.SmoothPlastic, 1)
		local e = Instance.new("ParticleEmitter")
		e.Name = "EN_Weather"
		e.Shape = Enum.ParticleEmitterShape.Box
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		e.EmissionDirection = Enum.NormalId.Bottom
		e.LockedToPart = false
		e.Parent = p
		emitterPart = p
		emitter = e
	end
	local e = emitter :: ParticleEmitter
	local col = Coords.color(w.color)
	e.Color = ColorSequence.new(col)
	e.LightEmission = if w.neon then 1 else 0.2
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, w.size),
		NumberSequenceKeypoint.new(1, w.size * 0.6),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, w.alpha),
		NumberSequenceKeypoint.new(0.8, w.alpha),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Lifetime = NumberRange.new(w.life * 0.7, w.life)
	e.Speed = NumberRange.new(w.speed * 0.6, w.speed)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Acceleration = if w.up then Vector3.new(0.4, 1.2, 0) else Vector3.new(0.3, -0.6, 0)
	e.EmissionDirection = if w.up then Enum.NormalId.Top else Enum.NormalId.Bottom
	e.Rate = if lowFx then 0 else w.rate
	e.Enabled = not lowFx
end

-- apply a land's lighting (stage = Stages entry)
function Land.enter(stage)
	save()
	effects()
	local m = MOOD[stage.id] or MOOD.graveyard
	local base = Coords.color(stage.ground.base)
	local amb = Coords.color(m.ambient)
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.Ambient = base:Lerp(amb, 0.6):Lerp(Color3.new(1, 1, 1), 0.15)
	Lighting.OutdoorAmbient = amb
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	local a = atmo :: Atmosphere
	a.Density = m.density
	a.Offset = 0.15
	a.Color = Coords.color(m.atmo)
	a.Decay = Coords.color(m.decay)
	a.Glare = 0
	a.Haze = 1.2
	local c = cc :: ColorCorrectionEffect
	c.TintColor = Coords.color(m.tint)
	c.Saturation = 0.12
	c.Contrast = 0.08
	c.Brightness = 0.02
	c.Enabled = true
	(bloom :: BloomEffect).Enabled = true
	weather(m.weather)
end

-- the hub's lighting back
function Land.leave()
	if saved then
		for k, v in saved do
			(Lighting :: any)[k] = v
		end
	end
	if atmo then
		(atmo :: Atmosphere).Density = 0
	end
	if cc then
		(cc :: ColorCorrectionEffect).Enabled = false
	end
	if bloom then
		(bloom :: BloomEffect).Enabled = false
	end
	if emitterPart then
		(emitter :: ParticleEmitter).Enabled = false
		(emitterPart :: BasePart).CFrame = Pool.FAR
	end
end

function Land.setLowFx(on: boolean)
	lowFx = on
	if emitter then
		(emitter :: ParticleEmitter).Enabled = not on
	end
end

-- the weather follows the camera target (sim px)
function Land.update(x: number, y: number)
	if emitterPart and not lowFx then
		(emitterPart :: BasePart).CFrame = CFrame.new(x * Coords.S, 26, y * Coords.S - 12)
	end
end

return Land
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">ModelKit</string>
              <string name="Source"><![CDATA[--!native
-- Stylized models from primitives (docs/DESIGN.md §4.3): every enemy type, the bosses (sprite model x scale + crown
-- + aura light; "Die Nacht" has its own model), heroes with a weapon prop, chests, gems and pickups, land decor.
-- A model is a list of pooled parts with offsets in units of the body radius r (studs) and a named animation per
-- part; `pose` appends world CFrames to the caller's BulkMoveTo arrays, so nothing allocates Instances per frame.
-- Axes: local +X = facing direction (sim angle 0), +Y = up, +Z = the model's right side.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enemies = require(Shared.Sim.Data.Enemies)
local Heroes = require(Shared.Sim.Data.Heroes)
local Stages = require(Shared.Sim.Data.Stages)
local Coords = require(script.Parent.Coords)
local Pool = require(script.Parent.Pool)

local ModelKit = {}

local rad = math.rad
local sin, cos = math.sin, math.cos
local V = Vector3.new
local NEON = Enum.Material.Neon
local ICE = Enum.Material.Ice

local bossR: { [string]: number } = {}
local bossTint: { [string]: string } = {}
local bossSprite: { [string]: string } = {}
for _, s in Stages.list do
	for _, b in s.bosses do
		bossR[b.name] = b.r
		bossTint[b.name] = b.tint
		bossSprite[b.name] = b.sprite
	end
end

-- enemy body radius in studs
function ModelKit.enemyRadius(etype: string, elite: boolean, bossName: string?): number
	if bossName and bossR[bossName] then
		return bossR[bossName] * Coords.S
	end
	local d = Enemies.byId[etype]
	local r = if d then d.r else 30
	if elite then
		r *= 1.55
	end
	return r * Coords.S
end

-- enemy body colour (boss tint > land tint > base colour)
function ModelKit.enemyColor(etype: string, tints: { [string]: string }?, bossName: string?): Color3
	if bossName and bossTint[bossName] then
		return Coords.color(bossTint[bossName])
	end
	local hex = (tints and tints[etype]) or Enemies.COLORS[etype] or "#ffffff"
	return Coords.color(hex)
end

function ModelKit.heroColor(heroId: string?): Color3
	local h = heroId and Heroes.byId[heroId]
	return Coords.color(if h then h.color else "#4f8cff")
end

-- the sprite a boss uses (slime, skel, wraith, golem, night)
function ModelKit.bossSprite(bossName: string?): string?
	return bossName and bossSprite[bossName]
end

-- ---------- model specs ----------
-- part = { shape, size (x r), pos (x r), rot (degrees, XYZ), role, mat?, tr?, anim? }
-- roles: body, dark, light, eye, white, black, gold, accent (hero skin accent), skin, glow (body colour, neon)
type PartSpec = {
	shape: string,
	size: Vector3,
	pos: Vector3,
	rot: Vector3?,
	role: string,
	mat: Enum.Material?,
	tr: number?,
	anim: string?,
}
export type Spec = { parts: { PartSpec }, light: number? }

local function P(shape, size, pos, role, extra): PartSpec
	local p: any = { shape = shape, size = size, pos = pos, role = role }
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	return p
end

